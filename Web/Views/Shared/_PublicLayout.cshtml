<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Urmi Eye Hospital</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/assets/images/favicon/favicon-32x32.png">
    <!-- Google Font: Poppins (matches Figma) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Site CSS for the public pages -->
    <link href="~/assets/css/site.css" rel="stylesheet" type="text/css" />

       <style>
        html, body {
            max-width: 100%;
            overflow-x: hidden;
        }

        * {
            box-sizing: border-box;
        }

        img {
            max-width: 100%;
            height: auto;
        }

        .site-footer-v2 { background: linear-gradient(135deg, #1E4D8C, #2B6CB0); color: #fff; padding: 60px 24px 0; }
        .footer-v2-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr; gap: 40px; padding-bottom: 40px; }
        .footer-v2-logo-badge { width: 40px; height: 40px; background: #fff; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; margin-bottom: 14px; }
        .footer-v2-about h3 { font-family: 'Poppins', sans-serif; font-size: 16px; font-weight: 700; line-height: 1.4; margin-bottom: 14px; }
        .footer-v2-about h3 span { font-size: 13px; font-weight: 600; opacity: 0.9; }
        .footer-v2-about p { font-size: 13px; line-height: 1.7; color: #D6E4F5; margin-bottom: 18px; max-width: 280px; }
        .footer-v2-icons { display: flex; gap: 10px; }
        .footer-v2-icons a { width: 34px; height: 34px; background: rgba(255,255,255,0.15); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #fff; text-decoration: none; }
        .footer-v2-icons a:hover { background: rgba(255,255,255,0.3); }

        .footer-v2-col h4 { font-size: 13px; font-weight: 700; letter-spacing: 0.03em; margin-bottom: 18px; display: flex; align-items: center; gap: 8px; }
        .footer-v2-col h4 .dot { width: 6px; height: 6px; border-radius: 50%; background: #F0A93C; display: inline-block; }
        .footer-v2-links { list-style: none; padding: 0; margin: 0; }
        .footer-v2-links li { margin-bottom: 10px; }
        .footer-v2-links a { color: #D6E4F5; font-size: 13px; text-decoration: none; }
        .footer-v2-links a:hover { color: #fff; text-decoration: underline; }

        .footer-v2-item { font-size: 13px; color: #D6E4F5; line-height: 1.6; margin-bottom: 16px; }
        .footer-v2-item .icon { margin-right: 6px; }
        .footer-v2-item strong { color: #fff; }
        .footer-v2-item a { color: #fff; text-decoration: none; }
        .footer-v2-maps-link { text-decoration: underline; font-size: 12px; }

        .footer-v2-bottom { border-top: 1px solid rgba(255,255,255,0.15); max-width: 1200px; margin: 0 auto; padding: 18px 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 12px; color: #D6E4F5; }
        .footer-v2-bottom .sep { opacity: 0.5; }
        .footer-v2-bottom-links { margin-left: auto; display: flex; gap: 18px; }
        .footer-v2-bottom-links a { color: #D6E4F5; text-decoration: none; font-size: 12px; }
        .footer-v2-bottom-links a:hover { color: #fff; }

        @@media (max-width: 900px) {
            .footer-v2-inner { grid-template-columns: 1fr 1fr; }
            .footer-v2-bottom { flex-direction: column; align-items: flex-start; }
            .footer-v2-bottom-links { margin-left: 0; }
        }
        @@media (max-width: 560px) {
            .footer-v2-inner { grid-template-columns: 1fr; }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ===== HEADER - TopAppBar Section ===== -->
    <header class="site-header" id="top">
        <div class="header-inner">
            <a href="/" class="logo">

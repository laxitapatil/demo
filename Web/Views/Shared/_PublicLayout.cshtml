<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Urmi Eye Hospital</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/assets/images/favicon/favicon-32x32.png">
    <!-- Google Font: Poppins (matches Figma) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Site CSS for the public pages -->
    <link href="~/assets/css/site.css" rel="stylesheet" type="text/css" />  
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ===== HEADER - TopAppBar Section ===== -->
    <header class="site-header">
        <div class="header-inner">
            <a href="/" class="logo">
                <img src="~/assets/images/logo.png" alt="Urmi Eye Hospital & Laser Centre" />
            </a>

            <nav class="main-nav">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li class="has-dropdown">
                        <a href="#">Facilities <span class="chevron">&#9662;</span></a>
                        <ul class="dropdown">
                            <li><a href="/Facilities/LaserRefractive">Laser Refractive</a></li>
                            <li><a href="/Facilities/RefractiveErrors">Refractive Errors</a></li>
                            <li><a href="/Facilities/CataractSurgery">Cataract Surgery</a></li>
                            <li><a href="/Facilities/GlaucomaSurgery">Glaucoma Surgery</a></li>
                            <li><a href="/Facilities/OptiLasik">OptiLasik</a></li>
                        </ul>
                    </li>
                    <li class="has-dropdown">
                        <a href="#">Treatment <span class="chevron">&#9662;</span></a>
                        <ul class="dropdown">
                            <li><a href="/Treatment/CataractSurgery">Cataract Surgery</a></li>
                            <li><a href="/Treatment/Glaucoma">Glaucoma</a></li>
                            <li><a href="/Treatment/OptiLasik">OptiLasik</a></li>
                            <li><a href="/Treatment/BladelessLasik">Bladeless Lasik</a></li>
                            <li><a href="/Treatment/Perimetry">Perimetry</a></li>
                            <li><a href="/Treatment/FloatersAndFlashes">Floaters &amp; Flashes</a></li>
                            <li><a href="/Treatment/YagLaser">Yag Laser</a></li>
                            <li><a href="/Treatment/ContactLenses">Contact Lenses</a></li>
                        </ul>
                    </li>
                    <li><a href="/Blog">Blogs</a></li>
                    <li><a href="/Gallery">Gallery</a></li>
                </ul>
            </nav>

            <a href="/Appointment/Book" class="btn-book-appointment">Book Appointment</a>
        </div>
    </header>

    <!-- ===== MAIN PAGE CONTENT ===== -->
    <main>
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-col footer-about">
                <h3><span class="eye-icon">&#128065;</span> Urmi Eye Hospital</h3>
                <p>
                    Your vision is our priority. Providing comprehensive eye care
                    with Dr. Anil Shah, utilizing state-of-the-art diagnostic and
                    surgical equipment.
                </p>
                <div class="footer-icons">
                    <a href="https://facebook.com" target="_blank" rel="noopener" class="icon-btn" aria-label="Facebook">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.891h-2.33v6.987C18.343 21.128 22 16.991 22 12z" /></svg>
                    </a>
                    <a href="https://instagram.com" target="_blank" rel="noopener" class="icon-btn" aria-label="Instagram">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c2.717 0 3.056.01 4.122.06 1.065.05 1.79.217 2.428.465a4.9 4.9 0 0 1 1.772 1.153 4.9 4.9 0 0 1 1.153 1.772c.248.637.415 1.363.465 2.428.05 1.066.06 1.405.06 4.122 0 2.717-.01 3.056-.06 4.122-.05 1.065-.217 1.79-.465 2.428a4.9 4.9 0 0 1-1.153 1.772 4.9 4.9 0 0 1-1.772 1.153c-.637.248-1.363.415-2.428.465-1.066.05-1.405.06-4.122.06-2.717 0-3.056-.01-4.122-.06-1.065-.05-1.79-.217-2.428-.465a4.9 4.9 0 0 1-1.772-1.153 4.9 4.9 0 0 1-1.153-1.772c-.248-.637-.415-1.363-.465-2.428C2.01 15.056 2 14.717 2 12c0-2.717.01-3.056.06-4.122.05-1.065.217-1.79.465-2.428a4.9 4.9 0 0 1 1.153-1.772A4.9 4.9 0 0 1 5.45.525C6.088.277 6.813.11 7.878.06 8.944.01 9.283 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 1 0 2.88 1.44 1.44 0 0 1 0-2.88z" /></svg>
                    </a>
                </div>
            </div>

            <div class="footer-col">
                <h4>QUICK CONTACT</h4>
                <p class="footer-item">
                    <span class="label">EMERGENCY HELP</span><br />
                    <a href="tel:+918238391749">+91 8238391749</a>
                </p>
                <p class="footer-item">
                    <span class="label">EMAIL US</span><br />
                    <a href="mailto:urmieye@yahoo.com">urmieye@yahoo.com</a>
                </p>
            </div>

            <div class="footer-col">
                <h4>OUR FACILITY</h4>
                <p class="footer-item">
                    <span class="label">HOSPITAL ADDRESS</span><br />
                    201/203, 2nd Floor, Rander Rd,<br />
                    Palanpur Patia, Surat,<br />
                    Gujarat 395009
                </p>
                <a href="#" class="view-on-maps">View on Maps &#8599;</a>
            </div>

            <div class="footer-col">
                <h4>STAY UPDATED</h4>
                <p>Join our health community for eye care tips and clinical updates.</p>
                <form class="newsletter-form" id="newsletterForm">
                    <input type="email" name="email" placeholder="Your Email Address" required />
                    <button type="submit">Subscribe</button>
                </form>
            </div>
        </div>

        <div class="footer-bottom">
            <a href="/Privacy">Privacy Policy</a>
            <a href="/Accessibility">Accessibility Statement</a>
            <a href="/Terms">Terms of Service</a>
            <span>&copy; @DateTime.Now.Year Urmi Eye Hospital &amp; Laser Centre. All rights reserved.</span>
        </div>
    </footer>

    <!-- Site JS -->
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
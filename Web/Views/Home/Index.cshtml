@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <title>Mulyankan | Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Favicon -->
    
    <!-- End of Favicon -->

    <link href="~/assets/fonts/inter/fonts.css" rel="stylesheet" type="text/css" />

    <!-- Bootstrap Css -->

    <link href="~/assets/plugins/bootstrap/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" type="text/css" />

    <link href="~/assets/plugins/flaticons/icons.css" rel="stylesheet" />

    <link href="~/assets/plugins/toastr/toastr.min.css" rel="stylesheet" />

    <!-- App Css-->
    <link href="~/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" />

    <style>
        .app-badge {
            width: 160px;
        }
    </style>
</head>

<body class="auth-body-bg">

    <div>
        <div class="container-fluid p-0">
            <div class="row g-0">
                <div class="col-xl-7 col-lg-6 d-lg-block d-none">
                    <div class="auth-full-bg pt-lg-5 p-4">
                        <div class="w-100">
                            <div class="bg-overlay"></div>
                            <div class="d-flex h-100 flex-column justify-content-end">
                                <div class="p-4">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="d-flex gap-3 flex-column">
                                                <div>
                                                    <h1 class="text-white fw-bold mb-0">
                                                        Hello Mulyankar! 👋
                                                    </h1>
                                                </div>
                                                <div>
                                                    <p class="font-size-20 mb-0 text-white">
                                                        Manage your property valuation workflows in one place.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end col -->

                <div class="col-xl-5 col-lg-6">
                    <div class="auth-full-page-content p-md-5 p-4 align-items-center justify-content-center row m-0">
                        <div class="col-lg-9">
                            <div class="d-flex flex-column h-100 gap-4">
                                <div>
                                    <a href="~/" class="d-block auth-logo">
                                        <img src="~/assets/images/logo-color.svg" alt="Mulyankan Logo" class="auth-logo-dark">
                                    </a>
                                </div>
                                <div>
                                    <div class="mb-4">
                                        <h2>Welcome Back !</h2>
                                        <p class="text-muted mb-0 font-size-16">Glad to see you again. Login to your account below!</p>
                                    </div>
                                    <div>
                                        <form id="loginForm" class="m-0">
                                            <div class="row gy-3">
                                                <div class="col-lg-12">
                                                    <div>
                                                        <input type="text" class="form-control" id="username" name="username" placeholder="Enter username">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="input-group auth-pass-inputgroup">
                                                        <input type="password" class="form-control border-end-0" id="password" name="password" placeholder="Enter password" aria-label="Password" aria-describedby="password-addon">
                                                        <span class="input-group-text bg-transparent password-addon" type="button"><i class="fi fi-rr-eye"></i></span>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <button type="submit" class="btn btn-primary waves-light w-100">Log In</button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                                <div class="text-center">
                                    <p class="mb-0 text-secondary">© <script>document.write(new Date().getFullYear())</script> Mulyankan - All Rights Reserved. Design & Develop by <a href="http://www.lynxsoftech.com/" target="_blank">Lynx Softech</a></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end col -->
            </div>
            <!-- end row -->
        </div>
        <!-- end container-fluid -->
    </div>

    <!-- JAVASCRIPT -->
    <script src="~/assets/plugins/jquery/jquery.min.js"></script>
    <script src="~/assets/plugins/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/assets/plugins/metismenu/metisMenu.min.js"></script>
    <script src="~/assets/plugins/simplebar/simplebar.min.js"></script>
    <script src="~/assets/plugins/node-waves/waves.min.js"></script>

    <script src="~/assets/plugins/validate/jquery.validate.min.js"></script>
    <script src="~/assets/plugins/toastr/toastr.min.js"></script>
    <script src="~/assets/plugins/sweetalert/sweetalert.min.js"></script>

    <!-- App js -->
    <script src="~/assets/js/app.js?@ViewData["jsVersion"]"></script>

    <script src="~/js/utility.js?@ViewData["jsVersion"]"></script>
    <script src="~/js/auth.js?@ViewData["jsVersion"]"></script>
    <script src="~/js/home/login.js?@ViewData["jsVersion"]"></script>
</body>
</html>


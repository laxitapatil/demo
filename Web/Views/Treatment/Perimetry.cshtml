@{
    ViewData["Title"] = "Perimetry";
    Layout = "_PublicLayout";
}
<link rel="stylesheet" href="~/css/treatment.css" />

<style>
    .trt2-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 24px 80px;
    }

    .trt2-eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #E8871E;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .trt2-hero {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 40px;
        align-items: center;
        margin-bottom: 50px;
    }

        .trt2-hero h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 32px;
            color: #0B1C30;
            margin-bottom: 16px;
        }

        .trt2-hero p {
            font-size: 14px;
            color: #6B7280;
            line-height: 1.8;
            margin-bottom: 14px;
        }

        .trt2-hero img {
            width: 100%;
            border-radius: 16px;
            height: 260px;
            object-fit: cover;
            display: block;
        }

    .trt2-section-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 22px;
        color: #0B1C30;
        margin-bottom: 24px;
    }

    .trt2-symptom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 50px;
    }

    .trt2-symptom-card {
        background: #fff;
        border: 1px solid #EEF1F5;
        border-radius: 12px;
        padding: 18px 20px;
    }

        .trt2-symptom-card h4 {
            font-size: 14px;
            font-weight: 700;
            color: #E8871E;
            margin-bottom: 8px;
            position: relative;
            padding-left: 16px;
        }

            .trt2-symptom-card h4::before {
                content: "";
                position: absolute;
                left: 0;
                top: 6px;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #E8871E;
            }

        .trt2-symptom-card p {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.6;
        }

    .trt2-care-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 50px;
    }

    .trt2-care-card {
        border-radius: 14px;
        padding: 22px 24px;
    }

        .trt2-care-card.dos {
            background: #EAF7EE;
        }

        .trt2-care-card.donts {
            background: #FDEDEC;
        }

        .trt2-care-card h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 16px;
            margin-bottom: 14px;
        }

        .trt2-care-card.dos h3 {
            color: #1E8E4C;
        }

        .trt2-care-card.donts h3 {
            color: #D8433A;
        }

        .trt2-care-card ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .trt2-care-card li {
            font-size: 13px;
            color: #374151;
            line-height: 1.8;
            padding-left: 22px;
            position: relative;
            margin-bottom: 4px;
        }

        .trt2-care-card.dos li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #1E8E4C;
            font-weight: 700;
        }

        .trt2-care-card.donts li::before {
            content: "✗";
            position: absolute;
            left: 0;
            color: #D8433A;
            font-weight: 700;
        }

    .trt2-exercise-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 50px;
    }

    .trt2-exercise-card {
        background: #fff;
        border: 1px solid #EEF1F5;
        border-radius: 12px;
        padding: 16px;
        text-align: center;
    }

        .trt2-exercise-card h4 {
            font-size: 13px;
            font-weight: 700;
            color: #0B1C30;
            margin-bottom: 8px;
        }

        .trt2-exercise-card p {
            font-size: 12px;
            color: #6B7280;
            line-height: 1.6;
        }

    .trt2-faq-item {
        border-bottom: 1px solid #EEF1F5;
        padding: 14px 0;
    }

        .trt2-faq-item summary {
            font-size: 14px;
            font-weight: 700;
            color: #0B1C30;
            cursor: pointer;
        }

        .trt2-faq-item p {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.7;
            margin-top: 10px;
        }

    .trt2-cta {
        background: #2B6CB0;
        border-radius: 20px;
        text-align: center;
        padding: 50px 24px;
        color: #fff;
        margin-top: 20px;
    }

        .trt2-cta h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 24px;
            margin-bottom: 10px;
        }

        .trt2-cta p {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 24px;
        }

        .trt2-cta a {
            background: #fff;
            color: #2B6CB0;
            font-weight: 700;
            padding: 12px 32px;
            border-radius: 9999px;
            text-decoration: none;
            display: inline-block;
        }

    @@media (max-width: 800px) {
        .trt2-hero {
            grid-template-columns: 1fr;
        }

        .trt2-symptom-grid {
            grid-template-columns: 1fr;
        }

        .trt2-care-split {
            grid-template-columns: 1fr;
        }

        .trt2-exercise-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="trt2-wrap">

    <div class="trt2-hero">
        <div>
            <p class="trt2-eyebrow">Diagnostic Test</p>
            <h1>Perimetry</h1>
            <p>Perimetry, also known as a visual field test, measures your full field of vision to detect blind spots or areas of vision loss, often used to monitor glaucoma.</p>
            <p>This quick, non-invasive test helps our specialists track changes in your peripheral vision over time.</p>
        </div>
        <img src="@Url.Content("~/assets/images/perimetry.jpg")" alt="Perimetry Test" />
    </div>

    <h2 class="trt2-section-title">Signs You May Need This Test</h2>
    <div class="trt2-symptom-grid">
        <div class="trt2-symptom-card">
            <h4>Reduced Peripheral Vision</h4>
            <p>Difficulty noticing objects or movement at the edges of your vision.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>Diagnosed Glaucoma</h4>
            <p>Ongoing monitoring is needed to track disease progression.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>Family History of Eye Disease</h4>
            <p>Increased risk factors may warrant regular visual field testing.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>Unexplained Vision Changes</h4>
            <p>Sudden or gradual changes that need further investigation.</p>
        </div>
    </div>

    <h2 class="trt2-section-title">Preparing for Your Test</h2>
    <div class="trt2-care-split">
        <div class="trt2-care-card dos">
            <h3>Before the Test</h3>
            <ul>
                <li>Get a good night's sleep beforehand</li>
                <li>Bring your glasses or contact lens prescription</li>
                <li>Inform your doctor of any medications you take</li>
                <li>Arrive a few minutes early to settle in</li>
            </ul>
        </div>
        <div class="trt2-care-card donts">
            <h3>During the Test</h3>
            <ul>
                <li>Don't rub your eyes before starting</li>
                <li>Avoid moving your head during the test</li>
                <li>Don't guess — only respond when you see the light</li>
                <li>Avoid rushing through the responses</li>
            </ul>
        </div>
    </div>

    <h2 class="trt2-section-title">What to Expect</h2>
    <div class="trt2-exercise-grid">
        <div class="trt2-exercise-card">
            <h4>Quick &amp; Painless</h4>
            <p>The test typically takes 5–10 minutes per eye.</p>
        </div>
        <div class="trt2-exercise-card">
            <h4>No Recovery Needed</h4>
            <p>You can resume normal activities immediately after.</p>
        </div>

@{
    ViewData["Title"] = "Glaucoma Treatment";
    Layout = "_PublicLayout";
}
<link rel="stylesheet" href="~/css/treatment.css" />

<style>
    .trt2-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 24px 80px;
    }

    .trt2-eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #E8871E;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .trt2-hero {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 40px;
        align-items: center;
        margin-bottom: 50px;
    }

        .trt2-hero h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 32px;
            color: #0B1C30;
            margin-bottom: 16px;
        }

        .trt2-hero p {
            font-size: 14px;
            color: #6B7280;
            line-height: 1.8;
            margin-bottom: 14px;
        }

        .trt2-hero img {
            width: 100%;
            border-radius: 16px;
            height: 260px;
            object-fit: cover;
            display: block;
        }

    .trt2-section-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 22px;
        color: #0B1C30;
        margin-bottom: 24px;
    }

    .trt2-symptom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 50px;
    }

    .trt2-symptom-card {
        background: #fff;
        border: 1px solid #EEF1F5;
        border-radius: 12px;
        padding: 18px 20px;
    }

        .trt2-symptom-card h4 {
            font-size: 14px;
            font-weight: 700;
            color: #E8871E;
            margin-bottom: 8px;
            position: relative;
            padding-left: 16px;
        }

            .trt2-symptom-card h4::before {
                content: "";
                position: absolute;
                left: 0;
                top: 6px;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #E8871E;
            }

        .trt2-symptom-card p {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.6;
        }

    .trt2-care-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 50px;
    }

    .trt2-care-card {
        border-radius: 14px;
        padding: 22px 24px;
    }

        .trt2-care-card.dos {
            background: #EAF7EE;
        }

        .trt2-care-card.donts {
            background: #FDEDEC;
        }

        .trt2-care-card h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 16px;
            margin-bottom: 14px;
        }

        .trt2-care-card.dos h3 {
            color: #1E8E4C;
        }

        .trt2-care-card.donts h3 {
            color: #D8433A;
        }

        .trt2-care-card ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .trt2-care-card li {
            font-size: 13px;
            color: #374151;
            line-height: 1.8;
            padding-left: 22px;
            position: relative;
            margin-bottom: 4px;
        }

        .trt2-care-card.dos li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #1E8E4C;
            font-weight: 700;
        }

        .trt2-care-card.donts li::before {
            content: "✗";
            position: absolute;
            left: 0;
            color: #D8433A;
            font-weight: 700;
        }

    .trt2-exercise-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 50px;
    }

    .trt2-exercise-card {
        background: #fff;
        border: 1px solid #EEF1F5;
        border-radius: 12px;
        padding: 16px;
        text-align: center;
    }

        .trt2-exercise-card h4 {
            font-size: 13px;
            font-weight: 700;
            color: #0B1C30;
            margin-bottom: 8px;
        }

        .trt2-exercise-card p {
            font-size: 12px;
            color: #6B7280;
            line-height: 1.6;
        }

    .trt2-faq-item {
        border-bottom: 1px solid #EEF1F5;
        padding: 14px 0;
    }

        .trt2-faq-item summary {
            font-size: 14px;
            font-weight: 700;
            color: #0B1C30;
            cursor: pointer;
        }

        .trt2-faq-item p {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.7;
            margin-top: 10px;
        }

    .trt2-cta {
        background: #2B6CB0;
        border-radius: 20px;
        text-align: center;
        padding: 50px 24px;
        color: #fff;
        margin-top: 20px;
    }

        .trt2-cta h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 24px;
            margin-bottom: 10px;
        }

        .trt2-cta p {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 24px;
        }

        .trt2-cta a {
            background: #fff;
            color: #2B6CB0;
            font-weight: 700;
            padding: 12px 32px;
            border-radius: 9999px;
            text-decoration: none;
            display: inline-block;
        }

    @@media (max-width: 800px) {
        .trt2-hero {
            grid-template-columns: 1fr;
        }

        .trt2-symptom-grid {
            grid-template-columns: 1fr;
        }

        .trt2-care-split {
            grid-template-columns: 1fr;
        }

        .trt2-exercise-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="trt2-wrap">

    <div class="trt2-hero">
        <div>
            <p class="trt2-eyebrow">Treatment</p>
            <h1>Glaucoma</h1>
            <p>Glaucoma is a group of eye conditions that damage the optic nerve, often due to elevated eye pressure, and is a leading cause of irreversible blindness if left untreated.</p>
            <p>Our specialists focus on early detection and personalized management to protect your vision and slow disease progression.</p>
        </div>
        <img src="@Url.Content("~/assets/images/glaucoma.jpg")" alt="Glaucoma Treatment" />
    </div>

    <h2 class="trt2-section-title">Common Symptoms</h2>
    <div class="trt2-symptom-grid">
        <div class="trt2-symptom-card">
            <h4>Gradual Vision Loss</h4>
            <p>Slow, often unnoticed loss of peripheral (side) vision in the early stages.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>Eye Pain or Pressure</h4>
            <p>A feeling of pressure or aching around the eyes, sometimes with headaches.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>Halos Around Lights</h4>
            <p>Seeing rainbow-colored rings around lights, especially at night.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>Redness &amp; Nausea</h4>
            <p>In acute cases, sudden eye redness, nausea, and blurred vision can occur.</p>
        </div>
    </div>

    <h2 class="trt2-section-title">Managing Your Condition</h2>
    <div class="trt2-care-split">
        <div class="trt2-care-card dos">
            <h3>The Do's</h3>
            <ul>
                <li>Use prescribed eye drops exactly as directed</li>
                <li>Attend regular eye pressure check-ups</li>
                <li>Exercise moderately to support eye health</li>
                <li>Protect your eyes from injury</li>
            </ul>
        </div>
        <div class="trt2-care-card donts">
            <h3>The Don'ts</h3>
            <ul>
                <li>Don't skip or delay your medication doses</li>
                <li>Don't ignore sudden vision changes</li>
                <li>Avoid high-pressure head-down exercises</li>
                <li>Don't self-adjust your treatment plan</li>
            </ul>
        </div>
    </div>

    <h2 class="trt2-section-title">Daily Eye Care Tips</h2>
    <div class="trt2-exercise-grid">
        <div class="trt2-exercise-card">
            <h4>Drop Reminders</h4>
            <p>Set daily alarms to stay consistent with your eye drop schedule.</p>
        </div>
        <div class="trt2-exercise-card">
            <h4>Track Your Vision</h4>
            <p>Note any changes in vision and report them at your next visit.</p>
        </div>
        <div class="trt2-exercise-card">
            <h4>Limit Caffeine</h4>
            <p>Excess caffeine can temporarily raise eye pressure — consume in moderation.</p>
        </div>
        <div class="trt2-exercise-card">
            <h4>Regular Check-ups</h4>
            <p>Routine visits help track eye pressure and optic nerve health over time.</p>
        </div>
    </div>

    <h2 class="trt2-section-title">Frequently Asked Questions</h2>
    <details class="trt2-faq-item" open>
        <summary>Can glaucoma be cured?</summary>
        <p>There's no cure, but with early diagnosis and consistent treatment, vision loss can often be slowed or prevented.</p>
    </details>
    <details class="trt2-faq-item">
        <summary>Is glaucoma treatment painful?</summary>
        <p>Most treatments, including eye drops and laser procedures, cause minimal discomfort.</p>
    </details>
    <details class="trt2-faq-item">
        <summary>How often should I get checked?</summary>
        <p>Typically every 6–12 months, though your doctor may recommend more frequent visits based on your risk factors.</p>
    </details>
    <details class="trt2-faq-item">
        <summary>Is glaucoma hereditary?</summary>
        <p>Family history does increase risk, so relatives of glaucoma patients should get screened regularly.</p>
    </details>

    <div class="trt2-cta">
        <h2>Protect Your Vision Today</h2>
        <p>Schedule a comprehensive glaucoma screening with our specialists.</p>
        <a href="   /Contact">Book an Appointment</a>
    </div>

</div>
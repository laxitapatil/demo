@{
    ViewData["Title"] = "Contact Lenses";
    Layout = "_PublicLayout";
}
<link rel="stylesheet" href="~/css/treatment.css" />

<style>
    .trt2-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 24px 80px;
    }

    .trt2-eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #E8871E;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .trt2-hero {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 40px;
        align-items: center;
        margin-bottom: 50px;
    }

        .trt2-hero h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 32px;
            color: #0B1C30;
            margin-bottom: 16px;
        }

        .trt2-hero p {
            font-size: 14px;
            color: #6B7280;
            line-height: 1.8;
            margin-bottom: 14px;
        }

        .trt2-hero img {
            width: 100%;
            border-radius: 16px;
            height: 260px;
            object-fit: cover;
            display: block;
        }

    .trt2-section-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 22px;
        color: #0B1C30;
        margin-bottom: 24px;
    }

    .trt2-symptom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 50px;
    }

    .trt2-symptom-card {
        background: #fff;
        border: 1px solid #EEF1F5;
        border-radius: 12px;
        padding: 18px 20px;
    }

        .trt2-symptom-card h4 {
            font-size: 14px;
            font-weight: 700;
            color: #E8871E;
            margin-bottom: 8px;
            position: relative;
            padding-left: 16px;
        }

            .trt2-symptom-card h4::before {
                content: "";
                position: absolute;
                left: 0;
                top: 6px;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #E8871E;
            }

        .trt2-symptom-card p {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.6;
        }

    .trt2-care-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 50px;
    }

    .trt2-care-card {
        border-radius: 14px;
        padding: 22px 24px;
    }

        .trt2-care-card.dos {
            background: #EAF7EE;
        }

        .trt2-care-card.donts {
            background: #FDEDEC;
        }

        .trt2-care-card h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 16px;
            margin-bottom: 14px;
        }

        .trt2-care-card.dos h3 {
            color: #1E8E4C;
        }

        .trt2-care-card.donts h3 {
            color: #D8433A;
        }

        .trt2-care-card ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .trt2-care-card li {
            font-size: 13px;
            color: #374151;
            line-height: 1.8;
            padding-left: 22px;
            position: relative;
            margin-bottom: 4px;
        }

        .trt2-care-card.dos li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #1E8E4C;
            font-weight: 700;
        }

        .trt2-care-card.donts li::before {
            content: "✗";
            position: absolute;
            left: 0;
            color: #D8433A;
            font-weight: 700;
        }

    .trt2-exercise-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 50px;
    }

    .trt2-exercise-card {
        background: #fff;
        border: 1px solid #EEF1F5;
        border-radius: 12px;
        padding: 16px;
        text-align: center;
    }

        .trt2-exercise-card h4 {
            font-size: 13px;
            font-weight: 700;
            color: #0B1C30;
            margin-bottom: 8px;
        }

        .trt2-exercise-card p {
            font-size: 12px;
            color: #6B7280;
            line-height: 1.6;
        }

    .trt2-faq-item {
        border-bottom: 1px solid #EEF1F5;
        padding: 14px 0;
    }

        .trt2-faq-item summary {
            font-size: 14px;
            font-weight: 700;
            color: #0B1C30;
            cursor: pointer;
        }

        .trt2-faq-item p {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.7;
            margin-top: 10px;
        }

    .trt2-cta {
        background: #2B6CB0;
        border-radius: 20px;
        text-align: center;
        padding: 50px 24px;
        color: #fff;
        margin-top: 20px;
    }

        .trt2-cta h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 24px;
            margin-bottom: 10px;
        }

        .trt2-cta p {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 24px;
        }

        .trt2-cta a {
            background: #fff;
            color: #2B6CB0;
            font-weight: 700;
            padding: 12px 32px;
            border-radius: 9999px;
            text-decoration: none;
            display: inline-block;
        }

    @@media (max-width: 800px) {
        .trt2-hero {
            grid-template-columns: 1fr;
        }

        .trt2-symptom-grid {
            grid-template-columns: 1fr;
        }

        .trt2-care-split {
            grid-template-columns: 1fr;
        }

        .trt2-exercise-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="trt2-wrap">

    <div class="trt2-hero">
        <div>
            <p class="trt2-eyebrow">Vision Care</p>
            <h1>Contact Lenses</h1>
            <p>We offer a full range of contact lens fittings, from daily disposables to specialty lenses for astigmatism and dry eyes, tailored to your lifestyle and vision needs.</p>
            <p>Our specialists guide you through selection, fitting, and proper care to ensure comfortable, clear vision.</p>
        </div>
        <img src="@Url.Content("~/assets/images/contact-lenses.jpg")" alt="Contact Lenses" />
    </div>

    <h2 class="trt2-section-title">Signs You May Need a Fitting</h2>
    <div class="trt2-symptom-grid">
        <div class="trt2-symptom-card">
            <h4>Glasses Interfering with Activities</h4>
            <p>Difficulty wearing glasses during sports or active routines.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>Dry or Irritated Eyes with Current Lenses</h4>
            <p>Discomfort that may be resolved with a better-suited lens type.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>Astigmatism or Special Prescriptions</h4>
            <p>Needs that require toric or specialty contact lenses.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>First-Time Contact Lens Wearer</h4>
            <p>Looking for guidance on getting started with contacts safely.</p>
        </div>
    </div>

    <h2 class="trt2-section-title">Contact Lens Care</h2>
    <div class="trt2-care-split">
        <div class="trt2-care-card dos">
            <h3>The Do's</h3>
            <ul>
                <li>Wash your hands before handling lenses</li>
                <li>Replace lenses as recommended by your doctor</li>
                <li>Use fresh solution each time you store lenses</li>
                <li>Attend regular contact lens check-ups</li>
            </ul>
        </div>
        <div class="trt2-care-card donts">
            <h3>The Don'ts</h3>
            <ul>
                <li>Don't sleep in lenses not approved for overnight wear</li>
                <li>Don't rinse lenses with tap water</li>
                <li>Avoid wearing lenses longer than recommended</li>
                <li>Don't share your contact lenses with others</li>
            </ul>
        </div>
    </div>

    <h2 class="trt2-section-title">Daily Lens Care Tips</h2>
    <div class="trt2-exercise-grid">
        <div class="trt2-exercise-card">
            <h4>Clean Storage Case</h4>
            <p>Rinse and air-dry your lens case daily to prevent buildup.</p>
        </div>
        <div class="trt2-exercise-card">
            <h4>Follow Wear Schedule</h4>
            <p>Stick to your prescribed daily, weekly, or monthly replacement schedule.</p>
        </div>
        <div class="trt2-exercise-card">
            <h4>Give Eyes a Break</h4>
            <p>Alternate with glasses occasionally to reduce eye strain.</p>
        </div>
        <div class="trt2-exercise-card">
            <h4>Keep Backup Glasses</h4>
            <p>Always have glasses on hand in case of eye irritation.</p>
        </div>
    </div>

    <h2 class="trt2-section-title">Frequently Asked Questions</h2>
    <details class="trt2-faq-item" open>
        <summary>How do I know which lenses are right for me?</summary>
        <p>Our specialists assess your prescription, eye shape, and lifestyle to recommend the best fit.</p>
    </details>
    <details class="trt2-faq-item">
        <summary>Can I sleep in my contact lenses?</summary>
        <p>Only if your lenses are specifically approved for extended or overnight wear — otherwise, it's not recommended.</p>
    </details>
    <details class="trt2-faq-item">
        <summary>How often should I replace my lenses?</summary>
        <p>This depends on the lens type — daily, bi-weekly, or monthly — as prescribed by your doctor.</p>
    </details>
    <details class="trt2-faq-item">
        <summary>What if my eyes feel irritated?</summary>
        <p>Remove your lenses immediately and consult your doctor if irritation persists.</p>
    </details>

    <div class="trt2-cta">
        <h2>Find Your Perfect Lens Fit</h2>
        <p>Schedule a contact lens consultation with our specialists today.</p>
        <a href="   /Contact">Book an Appointment</a>
    </div>

</div>
@{
    ViewData["Title"] = "Floaters & Flashes";
    Layout = "_PublicLayout";
}
<link rel="stylesheet" href="~/css/treatment.css" />

<style>
    .trt2-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 24px 80px;
    }

    .trt2-eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #E8871E;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .trt2-hero {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 40px;
        align-items: center;
        margin-bottom: 50px;
    }

        .trt2-hero h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 32px;
            color: #0B1C30;
            margin-bottom: 16px;
        }

        .trt2-hero p {
            font-size: 14px;
            color: #6B7280;
            line-height: 1.8;
            margin-bottom: 14px;
        }

        .trt2-hero img {
            width: 100%;
            border-radius: 16px;
            height: 260px;
            object-fit: cover;
            display: block;
        }

    .trt2-section-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 22px;
        color: #0B1C30;
        margin-bottom: 24px;
    }

    .trt2-symptom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 50px;
    }

    .trt2-symptom-card {
        background: #fff;
        border: 1px solid #EEF1F5;
        border-radius: 12px;
        padding: 18px 20px;
    }

        .trt2-symptom-card h4 {
            font-size: 14px;
            font-weight: 700;
            color: #E8871E;
            margin-bottom: 8px;
            position: relative;
            padding-left: 16px;
        }

            .trt2-symptom-card h4::before {
                content: "";
                position: absolute;
                left: 0;
                top: 6px;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #E8871E;
            }

        .trt2-symptom-card p {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.6;
        }

    .trt2-care-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 50px;
    }

    .trt2-care-card {
        border-radius: 14px;
        padding: 22px 24px;
    }

        .trt2-care-card.dos {
            background: #EAF7EE;
        }

        .trt2-care-card.donts {
            background: #FDEDEC;
        }

        .trt2-care-card h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 16px;
            margin-bottom: 14px;
        }

        .trt2-care-card.dos h3 {
            color: #1E8E4C;
        }

        .trt2-care-card.donts h3 {
            color: #D8433A;
        }

        .trt2-care-card ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .trt2-care-card li {
            font-size: 13px;
            color: #374151;
            line-height: 1.8;
            padding-left: 22px;
            position: relative;
            margin-bottom: 4px;
        }

        .trt2-care-card.dos li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #1E8E4C;
            font-weight: 700;
        }

        .trt2-care-card.donts li::before {
            content: "✗";
            position: absolute;
            left: 0;
            color: #D8433A;
            font-weight: 700;
        }

    .trt2-exercise-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 50px;
    }

    .trt2-exercise-card {
        background: #fff;
        border: 1px solid #EEF1F5;
        border-radius: 12px;
        padding: 16px;
        text-align: center;
    }

        .trt2-exercise-card h4 {
            font-size: 13px;
            font-weight: 700;
            color: #0B1C30;
            margin-bottom: 8px;
        }

        .trt2-exercise-card p {
            font-size: 12px;
            color: #6B7280;
            line-height: 1.6;
        }

    .trt2-faq-item {
        border-bottom: 1px solid #EEF1F5;
        padding: 14px 0;
    }

        .trt2-faq-item summary {
            font-size: 14px;
            font-weight: 700;
            color: #0B1C30;
            cursor: pointer;
        }

        .trt2-faq-item p {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.7;
            margin-top: 10px;
        }

    .trt2-cta {
        background: #2B6CB0;
        border-radius: 20px;
        text-align: center;
        padding: 50px 24px;
        color: #fff;
        margin-top: 20px;
    }

        .trt2-cta h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 24px;
            margin-bottom: 10px;
        }

        .trt2-cta p {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 24px;
        }

        .trt2-cta a {
            background: #fff;
            color: #2B6CB0;
            font-weight: 700;
            padding: 12px 32px;
            border-radius: 9999px;
            text-decoration: none;
            display: inline-block;
        }

    @@media (max-width: 800px) {
        .trt2-hero {
            grid-template-columns: 1fr;
        }

        .trt2-symptom-grid {
            grid-template-columns: 1fr;
        }

        .trt2-care-split {
            grid-template-columns: 1fr;
        }

        .trt2-exercise-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="trt2-wrap">

    <div class="trt2-hero">
        <div>
            <p class="trt2-eyebrow">Eye Condition</p>
            <h1>Floaters &amp; Flashes</h1>
            <p>Floaters and flashes are common visual disturbances, often caused by age-related changes in the eye's vitreous gel, but they can occasionally signal a more serious issue.</p>
            <p>Our specialists evaluate your symptoms to rule out retinal tears or detachment and provide the right guidance for your eye health.</p>
        </div>
        <img src="@Url.Content("~/assets/images/floaters-flashes.jpg")" alt="Floaters and Flashes" />
    </div>

    <h2 class="trt2-section-title">Common Symptoms</h2>
    <div class="trt2-symptom-grid">
        <div class="trt2-symptom-card">
            <h4>Floating Spots or Cobwebs</h4>
            <p>Small shapes drifting across your field of vision, especially against bright backgrounds.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>Sudden Flashes of Light</h4>
            <p>Brief flashes, especially noticeable in low light or peripheral vision.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>Increase in Floaters</h4>
            <p>A sudden rise in the number of floaters over a short period.</p>
        </div>
        <div class="trt2-symptom-card">
            <h4>Shadow or Curtain Effect</h4>
            <p>A dark shadow or curtain appearing in part of your vision — needs urgent evaluation.</p>
        </div>
    </div>

    <h2 class="trt2-section-title">Managing Your Symptoms</h2>
    <div class="trt2-care-split">
        <div class="trt2-care-card dos">
            <h3>The Do's</h3>
            <ul>
                <li>Get a dilated eye exam if symptoms are new or worsening</li>
                <li>Track when and how often symptoms occur</li>
                <li>Seek immediate care for sudden vision changes</li>
                <li>Attend all recommended follow-up exams</li>
            </ul>
        </div>
        <div class="trt2-care-card donts">
            <h3>The Don'ts</h3>
            <ul>
                <li>Don't ignore a sudden increase in floaters</li>
                <li>Don't delay care if you see a shadow or curtain effect</li>
                <li>Avoid rubbing your eyes excessively</li>
                <li>Don't self-diagnose without an exam</li>
            </ul>
        </div>
    </div>

    <h2 class="trt2-section-title">Daily Eye Care Tips</h2>
    <div class="trt2-exercise-grid">
        <div class="trt2-exercise-card">
            <h4>Monitor Changes</h4>
            <p>Keep a note of new symptoms to share with your doctor.</p>
        </div>
        <div class="trt2-exercise-card">
            <h4>Protect Your Eyes</h4>
            <p>Wear protective eyewear during sports or risky activities.</p>
        </div>
        <div class="trt2-exercise-card">
            <h4>Manage Health Conditions</h4>
            <p>Keep diabetes and blood pressure well controlled.</p>
        </div>
        <div class="trt2-exercise-card">
            <h4>Routine Eye Exams</h4>
            <p>Regular check-ups help catch retinal issues early.</p>
        </div>
    </div>

    <h2 class="trt2-section-title">Frequently Asked Questions</h2>
    <details class="trt2-faq-item" open>
        <summary>Are floaters always serious?</summary>
        <p>Most floaters are harmless, but a sudden increase or new flashes should be checked promptly.</p>
    </details>
    <details class="trt2-faq-item">
        <summary>Can floaters be treated?</summary>
        <p>In most cases no treatment is needed, though severe cases may be evaluated for specific procedures.</p>
    </details>
    <details class="trt2-faq-item">
        <summary>When should I seek urgent care?</summary>
        <p>If you notice a sudden shower of floaters, flashes, or a shadow/curtain in your vision, seek care immediately.</p>
    </details>
    <details class="trt2-faq-item">
        <summary>Do floaters go away on their own?</summary>
        <p>They often become less noticeable over time as your brain adapts, though they may not disappear completely.</p>
    </details>

    <div class="trt2-cta">
        <h2>Concerned About Floaters or Flashes?</h2>
        <p>Get a thorough evaluation from our retina specialists.</p>
        <a href="   /Contact">Book an Appointment</a>
    </div>

</div>
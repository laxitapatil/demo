@{
    ViewData["Title"] = "About Us";
    Layout = "_PublicLayout";
}

<section class="about-section">
    <div class="about-container">
        <div class="about-photo-wrap">
            <div class="about-photo">
                <img src="~/assets/images/doctor-about.jpg" alt="Dr. Anil R. Patel" />
            </div>
            <div class="about-badge">
                <span>25+</span>
                years of experience
            </div>
        </div>
        <div class="about-content">
            <h2>About Us</h2>
            <p>
                Since 2000, Urmi Eye Hospital has been a trusted name in advanced eye care in Surat.
                Founded by Dr. Anil R. Patel, we combine experienced specialists, modern technology,
                and compassionate care to deliver safe, personalized treatments that help patients
                achieve better vision and healthier eyes.
            </p>
        </div>
    </div>
</section>
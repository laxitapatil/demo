@{
    ViewData["Title"] = "Gallery";
    Layout = "_PublicLayout";
}

<style>
    .gal-hero {
        text-align: center;
        max-width: 700px;
        margin: 70px auto 50px;
        padding: 0 24px;
    }

        .gal-hero h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 34px;
            color: #0B1C30;
            margin-bottom: 14px;
        }

        .gal-hero p {
            font-size: 14px;
            color: #6B7280;
            line-height: 1.7;
        }

    .gal-grid {
        max-width: 1000px;
        margin: 0 auto 80px;
        padding: 0 24px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

        .gal-grid img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 12px;
            display: block;
        }

    .gal-cta {
        background: #E9F2FF;
        text-align: center;
        padding: 60px 24px;
    }

        .gal-cta h2 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 26px;
            color: #0B1C30;
            margin-bottom: 12px;
        }

        .gal-cta p {
            font-size: 14px;
            color: #6B7280;
            margin-bottom: 24px;
        }

        .gal-cta a {
            display: inline-block;
            background: #2B6CB0;
            color: #fff;
            padding: 14px 32px;
            border-radius: 9999px;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15px;
        }

            .gal-cta a:hover {
                background: #24578f;
            }

    @@media (max-width: 700px) {
        .gal-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<section class="gal-hero">
    <h1>Visual Excellence</h1>
    <p>Explore our state-of-the-art clinical facilities, advanced laser technology, and the compassionate care environment where clearer vision begins.</p>
</section>

<section class="gal-grid">
    <img src="~/assets/images/gallery/gallery-1.jpg" alt="Clinic facility" />
    <img src="~/assets/images/gallery/gallery-2.jpg" alt="Waiting area" />
    <img src="~/assets/images/gallery/gallery-3.jpg" alt="Diagnostic equipment" />
    <img src="~/assets/images/gallery/gallery-4.jpg" alt="Doctor reviewing scan" />
    <img src="~/assets/images/gallery/gallery-5.jpg" alt="Consultation room" />
    <img src="~/assets/images/gallery/gallery-6.jpg" alt="Reception team" />
</section>

<section class="gal-cta">
    <h2>Experience Clearer Vision</h2>
    <p>Take the first step towards visual freedom. Schedule your comprehensive consultation today.</p>
    <a href="   /Contact">Book an Appointment &rarr;</a>
</section>
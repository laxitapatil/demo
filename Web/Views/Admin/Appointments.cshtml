@{
    ViewData["Title"] = "Appointments";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Appointments &amp; Inquiries - Urmi Eye Hospital</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #F4F7FB;
            min-height: 100vh;
            display: flex;
            color: #1F2937;
        }

        .sidebar {
            width: 230px;
            background: #fff;
            min-height: 100vh;
            border-right: 1px solid #E5E9F0;
            padding: 22px 14px;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            z-index: 10;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 6px 22px 6px;
        }

        .brand-logo {
            width: 36px;
            height: 36px;
            background: #2B6CB0;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #fff;
            font-size: 15px;
        }

        .brand h2 {
            font-size: 13px;
            font-weight: 700;
            color: #0B1C30;
        }

        .brand p {
            font-size: 9px;
            color: #6B7280;
            text-transform: uppercase;
            letter-spacing: .03em;
        }

        .nav-section-label {
            font-size: 10px;
            font-weight: 700;
            color: #9AA5B1;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            padding: 8px 10px;
            margin-top: 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            color: #4B5563;
            text-decoration: none;
            margin-bottom: 1px;
        }

            .nav-item.active {
                background: #2B6CB0;
                color: #fff;
                font-weight: 600;
            }

            .nav-item.disabled {
                color: #C2C8D1;
                cursor: default;
            }

            .nav-item:not(.disabled):not(.active):hover {
                background: #F4F7FB;
            }

        .sidebar-user {
            margin-top: auto;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 10px;
            border-top: 1px solid #EEF1F5;
            margin-bottom: 8px;
        }

            .sidebar-user .avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: #2B6CB0;
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: 700;
            }

            .sidebar-user .name {
                font-size: 12px;
                font-weight: 600;
                color: #0B1C30;
            }

            .sidebar-user .role {
                font-size: 10px;
                color: #B7791F;
                font-weight: 600;
            }

        .btn-logout-sidebar {
            width: 100%;
            background: #FDECEA;
            color: #B42318;
            border: 1px solid #F5C2C0;
            padding: 9px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 12px;
            cursor: pointer;
            font-family: inherit;
        }

            .btn-logout-sidebar:hover {
                background: #FADBD8;
            }

        .main {
            margin-left: 230px;
            flex: 1;
        }

        .topbar {
            background: #fff;
            border-bottom: 1px solid #E5E9F0;
            padding: 14px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 5;
        }

        .search-box {
            flex: 1;
            max-width: 380px;
            background: #F4F7FB;
            border: 1px solid #E5E9F0;
            border-radius: 9px;
            padding: 9px 14px;
            font-size: 13px;
            color: #1F2937;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .search-box input {
                border: none;
                background: transparent;
                outline: none;
                font-family: inherit;
                font-size: 13px;
                width: 100%;
                color: #1F2937;
            }

                .search-box input::placeholder {
                    color: #9AA5B1;
                }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar-date {
            font-size: 12px;
            color: #4B5563;
            background: #F4F7FB;
            padding: 8px 12px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        .bell-wrap {
            position: relative;
            cursor: default;
            color: #6B7280;
        }

        .bell-dot {
            position: absolute;
            top: -2px;
            right: -2px;
            width: 7px;
            height: 7px;
            background: #E53E3E;
            border-radius: 50%;
            border: 1.5px solid #fff;
        }

        .btn-primary {
            background: #2B6CB0;
            color: #fff;
            border: none;
            padding: 9px 16px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
            white-space: nowrap;
        }

            .btn-primary:hover {
                background: #245a95;
            }

        .topbar-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #2B6CB0;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
        }

        .content {
            padding: 26px 28px;
        }

        .page-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 24px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .page-head-badges {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .badge-live {
            font-size: 10px;
            font-weight: 700;
            color: #1E8449;
            background: #E9F7EF;
            padding: 4px 10px;
            border-radius: 999px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .badge-live .dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #1E8449;
            }

        .page-head h1 {
            font-size: 26px;
            font-weight: 700;
            color: #0B1C30;
            margin-bottom: 8px;
            line-height: 1.2;
        }

        .page-head p.subtitle {
            font-size: 12.5px;
            color: #6B7280;
            max-width: 560px;
            line-height: 1.5;
        }

        .stat-pills {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .stat-pill {
            background: #fff;
            border-radius: 12px;
            padding: 10px 16px;
            box-shadow: 0 4px 14px rgba(11,28,48,0.05);
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 92px;
        }

            .stat-pill .swatch {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                flex-shrink: 0;
            }

            .stat-pill .lbl {
                font-size: 9.5px;
                font-weight: 700;
                color: #9AA5B1;
                text-transform: uppercase;
                letter-spacing: .03em;
            }

            .stat-pill .val {
                font-size: 16px;
                font-weight: 700;
                color: #0B1C30;
            }

        .section-tabs {
            display: flex;
            gap: 6px;
            background: #fff;
            border-radius: 12px;
            padding: 5px;
            box-shadow: 0 4px 14px rgba(11,28,48,0.05);
            margin-bottom: 20px;
            width: fit-content;
        }

        .section-tab {
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            color: #6B7280;
            background: transparent;
            border: none;
            padding: 10px 20px;
            border-radius: 9px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .section-tab.active {
                background: #2B6CB0;
                color: #fff;
            }

            .section-tab .count-chip {
                font-size: 10px;
                font-weight: 700;
                background: rgba(0,0,0,0.08);
                padding: 1px 7px;
                border-radius: 999px;
            }

            .section-tab.active .count-chip {
                background: rgba(255,255,255,0.25);
            }

        .section-panel {
            display: none;
        }

            .section-panel.active {
                display: block;
            }

        .toolbar {
            background: #fff;
            border-radius: 14px;
            padding: 18px;
            box-shadow: 0 6px 18px rgba(11,28,48,0.05);
            margin-bottom: 20px;
        }

        .toolbar-search {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #F4F7FB;
            border: 1px solid #E5E9F0;
            border-radius: 10px;
            padding: 11px 14px;
            font-size: 13px;
            margin-bottom: 12px;
        }

            .toolbar-search input {
                border: none;
                background: transparent;
                outline: none;
                font-family: inherit;
                font-size: 13px;
                width: 100%;
                color: #1F2937;
            }

        .toolbar-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
        }

        .toolbar-row-left {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .btn-outline {
            font-family: inherit;
            font-size: 12.5px;
            font-weight: 600;
            color: #4B5563;
            background: #fff;
            border: 1px solid #E5E9F0;
            padding: 9px 14px;
            border-radius: 9px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .btn-outline:hover {
                background: #F4F7FB;
            }

        .date-tabs {
            display: flex;
            gap: 4px;
            background: #F4F7FB;
            border-radius: 9px;
            padding: 3px;
        }

        .date-tab {
            font-family: inherit;
            font-size: 12px;
            font-weight: 600;
            color: #6B7280;
            background: transparent;
            border: none;
            padding: 7px 14px;
            border-radius: 7px;
            cursor: pointer;
        }

            .date-tab.active {
                background: #fff;
                color: #0B1C30;
                box-shadow: 0 2px 6px rgba(11,28,48,0.08);
            }

        .range-select-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .range-select {
            font-family: inherit;
            font-size: 12.5px;
            font-weight: 600;
            color: #4B5563;
            background: #fff;
            border: 1px solid #E5E9F0;
            padding: 9px 12px;
            border-radius: 9px;
            cursor: pointer;
            outline: none;
        }

        .custom-range-inputs {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .range-date-input {
            font-family: inherit;
            font-size: 12.5px;
            color: #4B5563;
            background: #fff;
            border: 1px solid #E5E9F0;
            padding: 8px 10px;
            border-radius: 9px;
            outline: none;
        }

        .range-to-label {
            font-size: 12px;
            color: #9AA5B1;
        }

        .list-wrap {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(11,28,48,0.05);
            overflow: hidden;
            margin-bottom: 20px;
        }

        .list-header-row {
            display: flex;
            align-items: center;
            padding: 14px 20px;
            border-bottom: 1px solid #EEF1F5;
            font-size: 10px;
            font-weight: 700;
            color: #9AA5B1;
            text-transform: uppercase;
            letter-spacing: .03em;
        }

        .col-patient {
            flex: 2.4;
        }

        .col-track {
            flex: 1.6;
        }

        .col-slot {
            flex: 1.4;
        }

        .col-status {
            flex: 1;
        }

        .col-actions {
            flex: 1.2;
            text-align: right;
        }

        .appt-row {
            display: flex;
            align-items: center;
            padding: 14px 20px;
            border-bottom: 1px solid #F4F6F9;
            cursor: default;
        }

            .appt-row:last-child {
                border-bottom: none;
            }

        .patient-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .mini-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .patient-name {
            font-weight: 600;
            color: #0B1C30;
            font-size: 13px;
        }

        .patient-sub {
            font-size: 10.5px;
            color: #9AA5B1;
        }

        .track-text {
            font-size: 12px;
            color: #4B5563;
        }

        .slot-text {
            font-size: 12px;
            color: #1F2937;
            font-weight: 600;
        }

        .slot-sub {
            font-size: 10.5px;
            color: #9AA5B1;
        }

        .status-pill {
            display: inline-block;
            font-size: 10.5px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 999px;
            white-space: nowrap;
        }

        .status-upcoming {
            background: #E8F1FD;
            color: #2B6CB0;
        }

        .status-past {
            background: #F1F3F6;
            color: #6B7280;
        }

        .status-pending {
            background: #FDF2E9;
            color: #B7791F;
        }

        .status-done {
            background: #E9F7EF;
            color: #1E8449;
        }

        .row-actions {
            display: flex;
            gap: 6px;
            justify-content: flex-end;
        }

        .empty-state, .empty-row {
            text-align: center;
            color: #9AA5B1;
            padding: 40px 0;
            font-size: 12.5px;
        }

        .list-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            font-size: 11.5px;
            color: #9AA5B1;
        }

            .list-footer button {
                font-family: inherit;
                font-size: 11.5px;
                background: none;
                border: none;
                color: #2B6CB0;
                font-weight: 600;
                cursor: pointer;
                padding: 4px 8px;
            }

                .list-footer button:disabled {
                    color: #C2C8D1;
                    cursor: default;
                }

        .inquiry-panel-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(11,28,48,0.05);
            padding: 20px;
        }

        .inquiry-item {
            border-bottom: 1px solid #F4F6F9;
            padding: 14px 4px;
        }

            .inquiry-item:last-child {
                border-bottom: none;
            }

        .inquiry-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
            gap: 8px;
        }

        .inquiry-who {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .inquiry-name {
            font-size: 13.5px;
            font-weight: 600;
            color: #0B1C30;
        }

        .type-badge {
            font-size: 9px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 999px;
            text-transform: uppercase;
            letter-spacing: .02em;
        }

        .type-contact {
            background: #EBF2FC;
            color: #2B6CB0;
        }

        .type-enquiry {
            background: #F3EBFB;
            color: #7C3AED;
        }

        .inquiry-desc {
            font-size: 12.5px;
            color: #6B7280;
            line-height: 1.5;
            margin-bottom: 8px;
        }

        .inquiry-meta {
            font-size: 10.5px;
            color: #9AA5B1;
        }

        .inquiry-actions {
            display: flex;
            gap: 8px;
            margin-top: 10px;
            align-items: center;
        }

        .btn-mini {
            font-family: inherit;
            font-size: 11px;
            font-weight: 600;
            padding: 7px 12px;
            border-radius: 7px;
            cursor: pointer;
            border: 1px solid #E5E9F0;
            background: #fff;
            color: #4B5563;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

            .btn-mini.primary {
                background: #2B6CB0;
                color: #fff;
                border-color: #2B6CB0;
            }

            .btn-mini:hover {
                opacity: 0.85;
            }

            .btn-mini:disabled {
                opacity: 0.5;
                cursor: default;
            }

        /* ---------- NEW BOOKING MODAL ---------- */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(11,28,48,0.45);
            align-items: center;
            justify-content: center;
            z-index: 100;
            padding: 20px;
        }

            .modal-overlay.open {
                display: flex;
            }

        .modal-box {
            background: #fff;
            border-radius: 16px;
            padding: 26px;
            width: 100%;
            max-width: 480px;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

            .modal-head h2 {
                font-size: 17px;
                font-weight: 700;
                color: #0B1C30;
            }

        .modal-close {
            background: #F4F7FB;
            border: none;
            border-radius: 8px;
            width: 30px;
            height: 30px;
            cursor: pointer;
            color: #6B7280;
            font-size: 14px;
        }

        .form-row {
            display: flex;
            gap: 12px;
        }

            .form-row .form-group {
                flex: 1;
            }

        .form-group {
            margin-bottom: 14px;
        }

        .form-label {
            font-size: 11.5px;
            font-weight: 700;
            color: #4B5563;
            display: block;
            margin-bottom: 6px;
        }

        .form-input, .form-textarea {
            width: 100%;
            font-family: inherit;
            font-size: 13px;
            color: #1F2937;
            background: #F4F7FB;
            border: 1px solid #E5E9F0;
            border-radius: 9px;
            padding: 10px 12px;
            outline: none;
        }

        .form-textarea {
            resize: vertical;
            min-height: 80px;
            line-height: 1.5;
        }

        .modal-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            justify-content: flex-end;
        }

        .btn-secondary {
            background: #fff;
            color: #4B5563;
            border: 1px solid #E5E9F0;
            padding: 10px 18px;
            border-radius: 9px;
            font-size: 12.5px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
        }

            .btn-secondary:hover {
                background: #F4F7FB;
            }

        .form-error {
            font-size: 11.5px;
            color: #B42318;
            margin-top: -6px;
            margin-bottom: 10px;
            display: none;
        }

        @@media (max-width: 900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
            }

            .col-track, .col-slot {
                display: none;
            }
        }
    </style>
</head>
<body>

    <script>
        (function () {
            const token = localStorage.getItem("token");
            if (!token) window.location.href = "/Admin/Login";
        })();
    </script>

    <div class="sidebar">
        <div class="brand">
            <div class="brand-logo">U</div>
            <div>
                <h2>Urmi Eye Hospital</h2>
                <p>Opti-LASIK Centre</p>
            </div>
        </div>

        <div class="nav-section-label">Clinical Operations</div>
        <a href="/Admin/Dashboard" class="nav-item">📊 Dashboard</a>
        <a href="/Admin/Appointments" class="nav-item active">📅 Appointments</a>
        <a href="/Admin/PatientFeedback" class="nav-item">⭐ Patient Feedback</a>
        <a href="/Admin/Subscribers" class="nav-item">📧 Subscribers</a>
        <a href="/Admin/Blog" class="nav-item">📰 News &amp; Blog</a>
        <a href="/Admin/Settings" class="nav-item">⚙️ Settings / Staff</a>
        <div class="sidebar-user">
            <div class="avatar">A</div>
            <div>
                <div class="name">Admin</div>
                <div class="role">SUPER ADMIN</div>
            </div>
        </div>
        <button class="btn-logout-sidebar" id="logoutBtn">Log Out</button>
    </div>

    <div class="main">
        <div class="topbar">
            <div class="search-box">🔍 <input type="text" id="globalSearch" placeholder="Search patients, phone, inquiries..."></div>
            <div class="topbar-right">
                <div class="topbar-date">📅 <span id="topbarDate"></span></div>
                <div class="bell-wrap">🔔<span class="bell-dot" id="bellDot" style="display:none;"></span></div>
                <button class="btn-primary" id="newBookingBtn">+ New Booking</button>
                <div class="topbar-avatar">A</div>
            </div>
        </div>

        <div class="content">
            <div class="page-head">
                <div>
                    <div class="page-head-badges">
                        <span class="badge-live"><span class="dot"></span>Real-time Clinical Registry</span>
                    </div>
                    <h1>Appointments &amp; Contact Inquiries</h1>
                    <p class="subtitle">Manage consultations, screenings, and incoming website messages from one place.</p>
                </div>
                <div class="stat-pills">
                    <div class="stat-pill"><span class="swatch" style="background:#2B6CB0;"></span><div><div class="lbl">Appointments</div><div class="val" id="statApptTotal">--</div></div></div>
                </div>
            </div>

            <div class="section-tabs">
                <button class="section-tab active" data-section="appointments">
                    📅 Appointments <span class="count-chip" id="apptTabCount">0</span>
                </button>
                <button class="section-tab" data-section="inquiries">
                    ✉️ Contact Inquiries <span class="count-chip" id="inqTabCount">0</span>
                </button>
            </div>

            <div class="section-panel active" id="panel-appointments">
                <div class="toolbar">
                    <div class="toolbar-search">
                        🔍 <input type="text" id="tableFilter" placeholder="Search by patient name, phone, or email...">
                    </div>
                    <div class="toolbar-row">
                        <div class="toolbar-row-left">
                            <button class="btn-outline" id="exportBtn">⬇ Export Excel/CSV</button>
                            <button class="btn-outline" id="dailyReportBtn">⬇ Today's Report</button>
                        </div>
                        <div class="date-tabs">
                            <button class="date-tab active" data-tab="all">All</button>
                            <button class="date-tab" data-tab="today">Today</button>
                            <button class="date-tab" data-tab="upcoming">Upcoming</button>
                            <button class="date-tab" data-tab="completed">Completed</button>
                        </div>

                        <div class="range-select-wrap">
                            <select id="rangeSelect" class="range-select">
                                <option value="none">Any time</option>
                                <option value="7d">Last 7 Days</option>
                                <option value="30d">Last 30 Days</option>
                                <option value="90d">Last 3 Months</option>
                                <option value="1y">Last Year</option>
                                <option value="custom">Custom range…</option>
                            </select>
                            <div class="custom-range-inputs" id="customRangeInputs" style="display:none;">
                                <input type="date" id="rangeFrom" class="range-date-input">
                                <span class="range-to-label">to</span>
                                <input type="date" id="rangeTo" class="range-date-input">
                                <button class="btn-outline" id="applyRangeBtn">Apply</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="list-wrap">
                    <div class="list-header-row">
                        <div class="col-patient">Patient</div>
                        <div class="col-track">Contact</div>
                        <div class="col-slot">Slot</div>
                        <div class="col-status">Status</div>
                        <div class="col-actions">Confirm</div>
                    </div>
                    <div id="appointmentsList">
                        <div class="empty-row">Loading...</div>
                    </div>
                    <div class="list-footer">
                        <span id="listFooterText"></span>
                        <span>
                            <button id="prevPageBtn" disabled>Previous</button>
                            <button id="nextPageBtn" disabled>Next</button>
                        </span>
                    </div>
                </div>
            </div>

            <div class="section-panel" id="panel-inquiries">
                <div class="toolbar">
                    <div class="toolbar-search">
                        🔍 <input type="text" id="inquiryFilter" placeholder="Search by name, email, or phone...">
                    </div>
                    <div class="toolbar-row">
                        <div class="toolbar-row-left"></div>
                        <div class="date-tabs">
                            <button class="date-tab active" data-inqtab="all">All</button>
                            <button class="date-tab" data-inqtab="pending">Pending</button>
                            <button class="date-tab" data-inqtab="done">Resolved</button>
                        </div>
                    </div>
                </div>

                <div class="inquiry-panel-card">
                    <div id="inquiriesList"><p class="empty-state">Loading...</p></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= NEW BOOKING MODAL ================= -->
    <div class="modal-overlay" id="bookingModal">
        <div class="modal-box">
            <div class="modal-head">
                <h2>New Booking</h2>
                <button class="modal-close" id="bookingModalCloseBtn">✕</button>
            </div>

            <div class="form-group">
                <label class="form-label">Patient Name</label>
                <input type="text" class="form-input" id="bookingName" placeholder="Full name">
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Mobile Number</label>
                    <input type="text" class="form-input" id="bookingMobile" placeholder="e.g. 9876543210">
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-input" id="bookingEmail" placeholder="name@example.com">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Date</label>
                    <input type="date" class="form-input" id="bookingDate">
                </div>
                <div class="form-group">
                    <label class="form-label">Time</label>
                    <input type="time" class="form-input" id="bookingTime">
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Note</label>
                <textarea class="form-textarea" id="bookingNote" placeholder="Reason for visit / clinical note..."></textarea>
            </div>

            <div class="form-error" id="bookingFormError">Name, date, and time are required.</div>

            <div class="modal-actions">
                <button class="btn-secondary" id="bookingCancelBtn">Cancel</button>
                <button class="btn-primary" id="bookingSaveBtn">Save Booking</button>
            </div>
        </div>
    </div>

    <script>
        const token = localStorage.getItem("token");
        const authHeaders = { "Authorization": "Bearer " + token };
        const authHeadersJson = { ...authHeaders, "Content-Type": "application/json" };
        const AVATAR_COLORS = ["#2B6CB0", "#B7412E", "#1E8449", "#7C3AED", "#B7791F", "#0E7490"];
        const PAGE_SIZE = 12;

        // Your API runs on a different port than this MVC app — every fetch must use the full URL.
        const API_BASE = "https://localhost:7130";

        /* ================= CONFIRM STATUS (local-storage stopgap) =================
           Your Appointment table has no status column yet, so "Confirmed" here is
           remembered only in this browser (localStorage), not saved to the database.
           Once a Status field + endpoint exist on the API, swap these three helpers
           for real fetch() calls and this will persist for every admin. */
        function getConfirmedSet() {
            try {
                return new Set(JSON.parse(localStorage.getItem("confirmedAppointments") || "[]"));
            } catch { return new Set(); }
        }
        function isConfirmed(id) {
            return getConfirmedSet().has(id);
        }
        function setConfirmed(id) {
            const set = getConfirmedSet();
            set.add(id);
            localStorage.setItem("confirmedAppointments", JSON.stringify([...set]));
        }

        function colorFor(str) {
            let h = 0;
            for (let i = 0; i < (str || "").length; i++) h = str.charCodeAt(i) + ((h << 5) - h);
            return AVATAR_COLORS[Math.abs(h) % AVATAR_COLORS.length];
        }
        function initials(name) {
            if (!name) return "?";
            const parts = name.trim().split(/\s+/);
            return ((parts[0]?.[0] || "") + (parts[1]?.[0] || "")).toUpperCase();
        }

        document.getElementById("logoutBtn").addEventListener("click", () => {
            localStorage.removeItem("token");
            localStorage.removeItem("refreshToken");
            window.location.href = "/Admin/Login";
        });

        document.getElementById("topbarDate").textContent =
            "Today, " + new Date().toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' });

        async function fetchJsonArray(url) {
            const res = await fetch(url, { headers: authHeaders });
            const raw = await res.text();
            let data = JSON.parse(raw);
            if (typeof data === "string") data = JSON.parse(data);
            return Array.isArray(data) ? data : [];
        }

        function isToday(dateStr) {
            const d = new Date(dateStr), now = new Date();
            return d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth() && d.getDate() === now.getDate();
        }
        function formatSlot(startTime) {
            const d = new Date(startTime);
            return d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }) + ', ' +
                d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
        }
        function relativeDay(startTime) {
            const d = new Date(startTime), now = new Date();
            const diffDays = Math.round((new Date(d.toDateString()) - new Date(now.toDateString())) / 86400000);
            if (diffDays === 0) return "Today";
            if (diffDays === 1) return "Tomorrow";
            if (diffDays === -1) return "Yesterday";
            return diffDays > 0 ? "In " + diffDays + " days" : Math.abs(diffDays) + " days ago";
        }
        function timeAgo(dateStr) {
            const mins = Math.floor((new Date() - new Date(dateStr)) / 60000);
            if (mins < 1) return "just now";
            if (mins < 60) return mins + "m ago";
            const hrs = Math.floor(mins / 60);
            if (hrs < 24) return hrs + "h ago";
            return Math.floor(hrs / 24) + "d ago";
        }

        document.querySelectorAll(".section-tab").forEach(btn => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".section-tab").forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                document.querySelectorAll(".section-panel").forEach(p => p.classList.remove("active"));
                document.getElementById("panel-" + btn.dataset.section).classList.add("active");
            });
        });
        (function () {
            const params = new URLSearchParams(window.location.search);
            if (params.get("tab") === "inquiries") {
                document.querySelector('.section-tab[data-section="inquiries"]').click();
            }
        })();

        let allAppointments = [];
        let activeTab = "all";
        let searchTerm = "";
        let currentPage = 0;
        let rangeMode = "none";
        let rangeFromDate = null;
        let rangeToDate = null;

        function getFilteredAppointments() {
            const now = new Date();
            let rows = allAppointments;
            if (activeTab === "today") rows = rows.filter(a => isToday(a.starttime));
            else if (activeTab === "upcoming") rows = rows.filter(a => new Date(a.starttime) >= now);
            else if (activeTab === "completed") rows = rows.filter(a => new Date(a.starttime) < now);

            if (rangeMode !== "none") {
                let from = null, to = null;
                if (rangeMode === "7d") { from = new Date(now); from.setDate(from.getDate() - 7); to = now; }
                else if (rangeMode === "30d") { from = new Date(now); from.setDate(from.getDate() - 30); to = now; }
                else if (rangeMode === "90d") { from = new Date(now); from.setDate(from.getDate() - 90); to = now; }
                else if (rangeMode === "1y") { from = new Date(now); from.setFullYear(from.getFullYear() - 1); to = now; }
                else if (rangeMode === "custom") { from = rangeFromDate; to = rangeToDate; }

                if (from) rows = rows.filter(a => new Date(a.starttime) >= from);
                if (to) {
                    const toEnd = new Date(to);
                    toEnd.setHours(23, 59, 59, 999);
                    rows = rows.filter(a => new Date(a.starttime) <= toEnd);
                }
            }

            if (searchTerm) {
                const t = searchTerm.toLowerCase();
                rows = rows.filter(a =>
                    (a.candidate_name || "").toLowerCase().includes(t) ||
                    (a.mobile_num || "").toLowerCase().includes(t) ||
                    (a.email || "").toLowerCase().includes(t)
                );
            }
            return rows.slice().sort((a, b) => new Date(b.starttime) - new Date(a.starttime));
        }

        function renderApptStats() {
            document.getElementById("statApptTotal").textContent = allAppointments.length;
            document.getElementById("apptTabCount").textContent = allAppointments.length;
        }

        function renderApptList() {
            const listEl = document.getElementById("appointmentsList");
            const rows = getFilteredAppointments();
            const now = new Date();

            if (!rows.length) {
                listEl.innerHTML = `<div class="empty-row">No matching appointments.</div>`;
                document.getElementById("listFooterText").textContent = "Showing 0 of " + allAppointments.length;
                document.getElementById("prevPageBtn").disabled = true;
                document.getElementById("nextPageBtn").disabled = true;
                return;
            }

            const totalPages = Math.ceil(rows.length / PAGE_SIZE);
            if (currentPage >= totalPages) currentPage = totalPages - 1;
            if (currentPage < 0) currentPage = 0;
            const pageRows = rows.slice(currentPage * PAGE_SIZE, currentPage * PAGE_SIZE + PAGE_SIZE);

            listEl.innerHTML = pageRows.map(a => {
                const name = a.candidate_name || "Unknown";
                const upcoming = new Date(a.starttime) >= now;
                return `
                <div class="appt-row" data-id="${a.id}">
                    <div class="col-patient patient-cell">
                        <div class="mini-avatar" style="background:${colorFor(name)};">${initials(name)}</div>
                        <div>
                            <div class="patient-name">${name}</div>
                            <div class="patient-sub">${a.note ? (a.note.length > 34 ? a.note.slice(0, 34) + '…' : a.note) : 'No note'}</div>
                        </div>
                    </div>
                    <div class="col-track">
                        <div class="track-text">${a.mobile_num ?? '—'}</div>
                        <div class="patient-sub">${a.email ?? '—'}</div>
                    </div>
                    <div class="col-slot">
                        <div class="slot-text">${relativeDay(a.starttime)}</div>
                        <div class="slot-sub">${formatSlot(a.starttime)}</div>
                    </div>
                    <div class="col-status">
                        <span class="status-pill ${upcoming ? 'status-upcoming' : 'status-past'}">${upcoming ? 'Upcoming' : 'Completed'}</span>
                    </div>
                    <div class="col-actions row-actions">
                        ${isConfirmed(a.id)
                            ? `<span class="status-pill status-done" style="white-space:nowrap;">✓ Confirmed</span>`
                            : `<button class="btn-outline confirm-btn" data-id="${a.id}" style="padding:6px 12px;font-size:11px;">Confirm</button>`
                        }
                    </div>
                </div>`;
            }).join("");

            listEl.querySelectorAll(".confirm-btn").forEach(btn => {
                btn.addEventListener("click", () => {
                    setConfirmed(Number(btn.dataset.id));
                    renderApptList();
                });
            });

            document.getElementById("listFooterText").textContent =
                `Showing ${pageRows.length} of ${rows.length} (page ${currentPage + 1} of ${totalPages})`;
            document.getElementById("prevPageBtn").disabled = currentPage <= 0;
            document.getElementById("nextPageBtn").disabled = currentPage >= totalPages - 1;
        }

        document.querySelectorAll(".date-tab[data-tab]").forEach(btn => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".date-tab[data-tab]").forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                activeTab = btn.dataset.tab;
                currentPage = 0;
                renderApptList();
            });
        });

        document.getElementById("rangeSelect").addEventListener("change", (e) => {
            rangeMode = e.target.value;
            const customWrap = document.getElementById("customRangeInputs");
            if (rangeMode === "custom") {
                customWrap.style.display = "flex";
                return;
            }
            customWrap.style.display = "none";
            rangeFromDate = null;
            rangeToDate = null;
            currentPage = 0;
            renderApptList();
        });

        document.getElementById("applyRangeBtn").addEventListener("click", () => {
            const fromVal = document.getElementById("rangeFrom").value;
            const toVal = document.getElementById("rangeTo").value;
            rangeFromDate = fromVal ? new Date(fromVal) : null;
            rangeToDate = toVal ? new Date(toVal) : null;
            currentPage = 0;
            renderApptList();
        });

        document.getElementById("tableFilter").addEventListener("input", (e) => {
            searchTerm = e.target.value;
            currentPage = 0;
            renderApptList();
        });
        document.getElementById("globalSearch").addEventListener("input", (e) => {
            document.getElementById("tableFilter").value = e.target.value;
            searchTerm = e.target.value;
            currentPage = 0;
            renderApptList();
        });

        document.getElementById("prevPageBtn").addEventListener("click", () => { currentPage--; renderApptList(); });
        document.getElementById("nextPageBtn").addEventListener("click", () => { currentPage++; renderApptList(); });

        function downloadCsv(rows, filename) {
            if (!rows.length) { alert("No rows to export."); return; }
            const header = "Name,Mobile,Email,Slot,Note\n";
            const body = rows.map(a =>
                `"${(a.candidate_name ?? '').replace(/"/g, '""')}","${a.mobile_num ?? ''}","${a.email ?? ''}","${formatSlot(a.starttime)}","${(a.note ?? '').replace(/"/g, '""')}"`
            ).join("\n");
            const blob = new Blob([header + body], { type: "text/csv" });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.href = url; link.download = filename; link.click();
            URL.revokeObjectURL(url);
        }

        document.getElementById("exportBtn").addEventListener("click", () => {
            downloadCsv(getFilteredAppointments(), "appointments.csv");
        });
        document.getElementById("dailyReportBtn").addEventListener("click", () => {
            downloadCsv(allAppointments.filter(a => isToday(a.starttime)), "daily-report-" + new Date().toISOString().slice(0, 10) + ".csv");
        });

        function loadAppointments() {
            return fetchJsonArray(API_BASE + "/api/appointment")
                .then(appointments => {
                    allAppointments = appointments;
                    renderApptStats();
                    renderApptList();
                })
                .catch(() => {
                    document.getElementById("appointmentsList").innerHTML =
                        '<div class="empty-row">Could not load appointments.</div>';
                });
        }
        loadAppointments();

        /* ================= NEW BOOKING MODAL ================= */
        const bookingModal = document.getElementById("bookingModal");

        function openBookingModal() {
            document.getElementById("bookingFormError").style.display = "none";
            document.getElementById("bookingName").value = "";
            document.getElementById("bookingMobile").value = "";
            document.getElementById("bookingEmail").value = "";
            document.getElementById("bookingDate").value = "";
            document.getElementById("bookingTime").value = "";
            document.getElementById("bookingNote").value = "";
            bookingModal.classList.add("open");
        }
        function closeBookingModal() {
            bookingModal.classList.remove("open");
        }

        document.getElementById("newBookingBtn").addEventListener("click", openBookingModal);
        document.getElementById("bookingModalCloseBtn").addEventListener("click", closeBookingModal);
        document.getElementById("bookingCancelBtn").addEventListener("click", closeBookingModal);
        bookingModal.addEventListener("click", (e) => { if (e.target === bookingModal) closeBookingModal(); });

        document.getElementById("bookingSaveBtn").addEventListener("click", async () => {
            const name = document.getElementById("bookingName").value.trim();
            const mobile = document.getElementById("bookingMobile").value.trim();
            const email = document.getElementById("bookingEmail").value.trim();
            const dateVal = document.getElementById("bookingDate").value;
            const timeVal = document.getElementById("bookingTime").value;
            const note = document.getElementById("bookingNote").value.trim();

            if (!name || !dateVal || !timeVal) {
                document.getElementById("bookingFormError").style.display = "block";
                return;
            }

            const startTime = new Date(`${dateVal}T${timeVal}`);
            const endTime = new Date(startTime.getTime() + 30 * 60000); // 30-minute default slot

            const payload = {
                candidate_name: name,
                mobile_num: mobile,
                email: email,
                starttime: startTime.toISOString(),
                endtime: endTime.toISOString(),
                note: note
            };

            const saveBtn = document.getElementById("bookingSaveBtn");
            saveBtn.disabled = true;
            saveBtn.textContent = "Saving...";

            try {
                const res = await fetch(API_BASE + "/api/appointment", {
                    method: "POST",
                    headers: authHeadersJson,
                    body: JSON.stringify(payload)
                });
                const bodyText = await res.text();
                if (!res.ok) {
                    console.error("STATUS:", res.status, res.statusText);
                    console.error("RESPONSE:", bodyText);
                    alert("HTTP " + res.status + " " + res.statusText + "\n\n" + bodyText.slice(0, 1500));
                    return;
                }
                closeBookingModal();
                loadAppointments();
            } catch (err) {
                console.error(err);
                alert("Network/JS error: " + err.message);
            } finally {
                saveBtn.disabled = false;
                saveBtn.textContent = "Save Booking";
            }
        });

        let allInquiries = [];
        let inquiryTab = "all";
        let inquirySearch = "";

        function getFilteredInquiries() {
            let rows = allInquiries;
            if (inquiryTab === "pending") rows = rows.filter(i => i.status === 0);
            else if (inquiryTab === "done") rows = rows.filter(i => i.status !== 0);

            if (inquirySearch) {
                const t = inquirySearch.toLowerCase();
                rows = rows.filter(i =>
                    (i.name || "").toLowerCase().includes(t) ||
                    (i.email || "").toLowerCase().includes(t) ||
                    (i.contact_no || "").toLowerCase().includes(t)
                );
            }
            return rows;
        }

        function renderInquiryStats() {
            const pending = allInquiries.filter(i => i.status === 0).length;
            document.getElementById("statInqPending").textContent = pending;
            document.getElementById("inqTabCount").textContent = pending;
        }

        function renderInquiries() {
            const list = document.getElementById("inquiriesList");
            const rows = getFilteredInquiries();
            if (!rows.length) { list.innerHTML = '<p class="empty-state">No matching inquiries.</p>'; return; }

            list.innerHTML = rows.map(i => {
                const name = i.name || "Unknown";
                const isEnquiry = i.type === 2;
                return `
                <div class="inquiry-item" data-id="${i.id}">
                    <div class="inquiry-top">
                        <div class="inquiry-who">
                            <div class="mini-avatar" style="background:${colorFor(name)};width:30px;height:30px;font-size:11px;">${initials(name)}</div>
                            <span class="inquiry-name">${name}</span>
                            <span class="type-badge ${isEnquiry ? 'type-enquiry' : 'type-contact'}">${isEnquiry ? 'Enquiry' : 'Contact'}</span>
                        </div>
                        <span class="status-pill ${i.status === 0 ? 'status-pending' : 'status-done'}">${i.status === 0 ? 'Pending' : 'Done'}</span>
                    </div>
                    <div class="inquiry-desc">${i.description ?? ''}</div>
                    <div class="inquiry-meta">${i.email ?? i.contact_no ?? ''} · ${timeAgo(i.created_date)}</div>
                    <div class="inquiry-actions">
                        <a class="btn-mini primary ${i.email ? '' : 'disabled'}" href="${i.email ? 'mailto:' + i.email : '#'}">↩ Reply Email</a>
                        <button class="btn-mini mark-read-btn" data-id="${i.id}" ${i.status !== 0 ? 'disabled' : ''}>
                            ${i.status === 0 ? 'Mark Read' : 'Marked Done'}
                        </button>
                    </div>
                </div>`;
            }).join("");

            list.querySelectorAll(".mark-read-btn").forEach(btn => {
                btn.addEventListener("click", async () => {
                    const id = btn.dataset.id;
                    btn.disabled = true;
                    btn.textContent = "Updating...";
                    try {
                        const res = await fetch(API_BASE + "/api/contactusenquiry", {
                            method: "PUT",
                            headers: authHeadersJson,
                            body: JSON.stringify({ Id: Number(id), Status: 1 })
                        });
                        if (!res.ok) throw new Error();
                        const inq = allInquiries.find(x => x.id == id);
                        if (inq) inq.status = 1;
                        renderInquiryStats();
                        renderInquiries();
                    } catch {
                        btn.disabled = false;
                        btn.textContent = "Mark Read";
                        alert("Could not update status — check console/network tab.");
                    }
                });
            });
        }

        document.querySelectorAll(".date-tab[data-inqtab]").forEach(btn => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".date-tab[data-inqtab]").forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                inquiryTab = btn.dataset.inqtab;
                renderInquiries();
            });
        });
        document.getElementById("inquiryFilter").addEventListener("input", (e) => {
            inquirySearch = e.target.value;
            renderInquiries();
        });

        fetchJsonArray(API_BASE + "/api/contactusenquiry")
            .then(inquiries => {
                allInquiries = inquiries;
                renderInquiryStats();
                renderInquiries();
            })
            .catch(() => {
                document.getElementById("inquiriesList").innerHTML = '<p class="empty-state">Could not load inquiries.</p>';
            });
    </script>
</body>
</html>
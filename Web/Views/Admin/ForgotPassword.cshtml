@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Urmi Eye Hospital</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #F4F7FB;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .card {
            max-width: 420px;
            width: 100%;
            background: #fff;
            border-radius: 20px;
            padding: 44px 40px;
            box-shadow: 0 20px 60px rgba(11, 28, 48, 0.12);
            text-align: center;
        }

        .icon-badge {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: linear-gradient(135deg, #FF9966, #FF5E62);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 8px 20px rgba(255, 94, 98, 0.35);
        }

            .icon-badge svg {
                width: 28px;
                height: 28px;
            }

        h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0B1C30;
            margin-bottom: 8px;
        }

        .card > .step > p.subtitle {
            font-size: 13px;
            color: #6B7280;
            margin-bottom: 28px;
            line-height: 1.6;
        }

        .field {
            margin-bottom: 18px;
            text-align: left;
        }

            .field label {
                display: block;
                font-size: 13px;
                font-weight: 600;
                color: #0B1C30;
                margin-bottom: 7px;
            }

            .field input {
                width: 100%;
                padding: 12px 14px;
                border: 1px solid #D1D9E6;
                border-radius: 9px;
                font-size: 14px;
                font-family: inherit;
            }

                .field input:focus {
                    outline: none;
                    border-color: #2B6CB0;
                }

        .btn-primary {
            width: 100%;
            background: #2B6CB0;
            color: #fff;
            border: none;
            padding: 14px;
            border-radius: 9999px;
            font-weight: 700;
            font-size: 15px;
            cursor: pointer;
            font-family: inherit;
            transition: background 0.2s;
        }

            .btn-primary:hover {
                background: #24578f;
            }

            .btn-primary:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: #2B6CB0;
            font-weight: 600;
            text-decoration: none;
        }

        .msg {
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 13px;
            margin-bottom: 18px;
            display: none;
            text-align: left;
        }

            .msg.error {
                background: #FDECEA;
                color: #B42318;
                border: 1px solid #F5C2C0;
            }

            .msg.success {
                background: #E6F4EA;
                color: #1E7B34;
                border: 1px solid #B7E4C7;
            }

        .step {
            display: none;
        }

            .step.active {
                display: block;
            }
    </style>
</head>
<body>

    <div class="card">

        <div class="step active" id="step1">
            <div class="icon-badge">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 15C13.1046 15 14 14.1046 14 13C14 11.8954 13.1046 11 12 11C10.8954 11 10 11.8954 10 13C10 14.1046 10.8954 15 12 15Z" fill="white" />
                    <path d="M12 15V17.5" stroke="white" stroke-width="1.8" stroke-linecap="round" />
                    <path d="M7 10V7.5C7 5.01472 9.01472 3 11.5 3H12.5C14.9853 3 17 5.01472 17 7.5V10" stroke="white" stroke-width="1.8" stroke-linecap="round" />
                    <rect x="5" y="10" width="14" height="10" rx="3" stroke="white" stroke-width="1.8" />
                </svg>
            </div>

            <h1>Forgot Password?</h1>
            <p class="subtitle">Enter your registered email address and we'll send you a one-time code (OTP) to reset your password.</p>

            <div class="msg error" id="step1Error"></div>
            <div class="msg success" id="step1Success"></div>

            <form id="emailForm">
                <div class="field">
                    <label>Email Address</label>
                    <input type="email" id="email" placeholder="admin@urmiayehospital.com" required />
                </div>

                <button type="submit" class="btn-primary" id="sendOtpBtn">Send Reset Code</button>
            </form>

            <a href="/Admin/Login" class="back-link">Back to Login</a>
        </div>

        <div class="step" id="step2">
            <div class="icon-badge">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 15C13.1046 15 14 14.1046 14 13C14 11.8954 13.1046 11 12 11C10.8954 11 10 11.8954 10 13C10 14.1046 10.8954 15 12 15Z" fill="white" />
                    <path d="M12 15V17.5" stroke="white" stroke-width="1.8" stroke-linecap="round" />
                    <path d="M7 10V7.5C7 5.01472 9.01472 3 11.5 3H12.5C14.9853 3 17 5.01472 17 7.5V10" stroke="white" stroke-width="1.8" stroke-linecap="round" />
                    <rect x="5" y="10" width="14" height="10" rx="3" stroke="white" stroke-width="1.8" />
                </svg>
            </div>

            <h1>Enter Reset Code</h1>
            <p class="subtitle">Check your email for the OTP code, then set your new password below.</p>

            <div class="msg error" id="step2Error"></div>

            <form id="resetForm">
                <div class="field">
                    <label>OTP Code</label>
                    <input type="text" id="otp" placeholder="6-digit code" required />
                </div>

                <div class="field">
                    <label>New Password</label>
                    <input type="password" id="newPassword" placeholder="Enter new password" required />
                </div>

                <button type="submit" class="btn-primary" id="resetBtn">Reset Password</button>
            </form>

            <a href="/Admin/Login" class="back-link">Back to Login</a>
        </div>
    </div>

    <script>
        const API_BASE = "https://localhost:7130";

        const step1 = document.getElementById("step1");
        const step2 = document.getElementById("step2");

        const emailForm = document.getElementById("emailForm");
        const sendOtpBtn = document.getElementById("sendOtpBtn");
        const step1Error = document.getElementById("step1Error");
        const step1Success = document.getElementById("step1Success");

        const resetForm = document.getElementById("resetForm");
        const resetBtn = document.getElementById("resetBtn");
        const step2Error = document.getElementById("step2Error");

        let savedEmail = "";

        emailForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const email = document.getElementById("email").value.trim();
            step1Error.style.display = "none";
            step1Success.style.display = "none";
            sendOtpBtn.disabled = true;
            sendOtpBtn.textContent = "Sending...";

            try {
                const res = await fetch(`${API_BASE}/api/authenticate/forget-password`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ Email: email })
                });

                const data = await res.json();

                if (!res.ok) {
                    throw new Error(data.detail || data.title || "Could not send reset code.");
                }

                savedEmail = email;
                step1Success.textContent = typeof data === "string" ? data : "OTP sent! Check your email.";
                step1Success.style.display = "block";

                setTimeout(() => {
                    step1.classList.remove("active");
                    step2.classList.add("active");
                }, 1200);

            } catch (err) {
                step1Error.textContent = err.message || "Something went wrong.";
                step1Error.style.display = "block";
            } finally {
                sendOtpBtn.disabled = false;
                sendOtpBtn.textContent = "Send Reset Code";
            }
        });

        resetForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const otp = document.getElementById("otp").value.trim();
            const newPassword = document.getElementById("newPassword").value;

            step2Error.style.display = "none";
            resetBtn.disabled = true;
            resetBtn.textContent = "Resetting...";

            try {
                const res = await fetch(`${API_BASE}/api/authenticate/reset-password`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        Email: savedEmail,
                        Otp: parseInt(otp, 10),
                        NewPassword: newPassword
                    })
                });

                const data = await res.json();

                if (!res.ok) {
                    throw new Error(data.detail || data.title || "Reset failed.");
                }

                alert("Password reset successful! Please log in with your new password.");
                window.location.href = "/Admin/Login";

            } catch (err) {
                step2Error.textContent = err.message || "Something went wrong.";
                step2Error.style.display = "block";
            } finally {
                resetBtn.disabled = false;
                resetBtn.textContent = "Reset Password";
            }
        });
    </script>
</body>
</html>
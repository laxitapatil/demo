        @if (ViewBag.Success == true)
        {
            <div class="apt-success">
                @ViewBag.Message
            </div>
        }
        else if (ViewBag.Message != null)
        {
            <div class="apt-success" style="background:#FEF2F2;color:#B91C1C;border-color:#FCA5A5;">
                @ViewBag.Message
            </div>
        }

        <form method="post" asp-action="Book" asp-controller="Appointment">
            <div class="apt-row">
                <div class="apt-field">
                    <input type="text" name="name" placeholder="Full Name" required />
                </div>
                <div class="apt-field">
                    <input type="tel" name="mobile" placeholder="Mobile Number" required />
                </div>
            </div>

            <div class="apt-field">
                <input type="email" name="email" placeholder="Email Address" required />
            </div>

            <div class="apt-field">
                <input type="text" name="address" placeholder="Street Address" required />
            </div>

            <div class="apt-row">
                <div class="apt-field">
                    <input type="text" name="city" placeholder="City" required />
                </div>
                <div class="apt-field">
                    <input type="text" name="pincode" placeholder="Pincode" required />
                </div>
            </div>

            <div class="apt-row">
                <div class="apt-field">
                    <input type="date" name="preferredDate" required />
                </div>
                <div class="apt-field">
                    <input type="time" name="preferredTime" required />
                </div>
            </div>

            <div class="apt-field">
                <textarea name="reason" rows="4" placeholder="Symptoms or Reason for Visit" required></textarea>
                <span class="apt-hint">Please describe your symptoms or the reason for your visit (e.g. blurred vision, check-up, etc.)</span>
            </div>

            <button type="submit" class="apt-submit">Submit Appointment &rarr;</button>
        </form>
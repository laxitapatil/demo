@{
    ViewData["Title"] = "Book Appointment";
    Layout = "_PublicLayout";
}

<style>
    .apt-hero {
        position: relative;
        width: 100%;
        padding: 70px 40px 140px;
        text-align: center;
        background: linear-gradient(180deg, #F7F9FB 0%, #E9F2FF 100%);
    }

    .apt-eyebrow {
        color: #2B6CB0;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .apt-hero h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 40px;
        color: #0B1C30;
        margin-bottom: 14px;
    }

    .apt-hero p {
        font-size: 15px;
        color: #6B7280;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .apt-wrap {
        max-width: 1000px;
        margin: -80px auto 80px;
        padding: 0 24px;
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        align-items: start;
        position: relative;
        z-index: 5;
    }

    .apt-card {
        background: #fff;
        border-radius: 16px;
        padding: 36px;
        box-shadow: 0 10px 32px rgba(43, 108, 176, 0.1);
    }

    .apt-card h2 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 20px;
        color: #0B1C30;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
    }

    .apt-card h2 .icon {
        background: #E9F2FF;
        color: #2B6CB0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
    }

    .apt-success {
        background: #E6F4EA;
        color: #1E7B34;
        border: 1px solid #B7E4C7;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 24px;
        font-size: 14px;
        text-align: center;
    }

    .apt-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 18px;
    }

    .apt-field {
        margin-bottom: 18px;
    }

    .apt-field input,
    .apt-field textarea {
        width: 100%;
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        padding: 13px 16px;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        background: #F9FAFB;
        color: #2A2A2A;
        resize: vertical;
    }

        .apt-field input:focus,
        .apt-field textarea:focus {
            outline: none;
            border-color: #2B6CB0;
            background: #fff;
        }

    .apt-hint {
        display: block;
        font-size: 12px;
        color: #9AA5B1;
        margin-top: 6px;
    }

    .apt-submit {
        background: #2B6CB0;
        color: #fff;
        border: none;
        padding: 14px 32px;
        border-radius: 9999px;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        transition: background 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .apt-submit:hover {
            background: #24578f;
        }

    .apt-sidebar {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .apt-side-card {
        background: #E9F2FF;
        border-radius: 16px;
        padding: 24px;
    }

        .apt-side-card.white {
            background: #fff;
            border: 1px solid #E5E9F0;
        }

        .apt-side-card h3 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 17px;
            color: #0B1C30;
            margin-bottom: 10px;
        }

        .apt-side-card > p {
            font-size: 13px;
            color: #4A5568;
            line-height: 1.6;
            margin-bottom: 18px;
        }

    .apt-contact {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 16px;
    }

    .apt-contact .icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    }

    .apt-contact .label {
        display: block;
        font-size: 11px;
        color: #6B7280;
        margin-bottom: 2px;
    }

    .apt-contact a,
    .apt-contact span.value {
        font-size: 14px;
        color: #0B1C30;
        font-weight: 600;
    }

    .apt-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .apt-badge {
        background: #F7F9FB;
        border: 1px solid #E5E9F0;
        border-radius: 9999px;
        padding: 6px 14px;
        font-size: 12px;
        color: #2B6CB0;
        font-weight: 600;
    }

    @@media (max-width: 900px) {
        .apt-wrap {
            grid-template-columns: 1fr;
            margin-top: -40px;
        }

        .apt-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="apt-hero">
    <p class="apt-eyebrow">BOOK NOW</p>
    <h1>Schedule Your Visit</h1>
    <p>Take the first step towards clearer vision. Complete the details below to request a prioritized appointment with our specialists.</p>
</section>

<div class="apt-wrap">
    <div class="apt-card">
        <h2><span class="icon">&#128100;</span> Personal Information</h2>

        @if (ViewBag.Success == true)
        {
            <div class="apt-success">
                Thank you! Your appointment request has been received. We'll contact you soon.
            </div>
        }

        <form method="post" asp-action="Book" asp-controller="Appointment">
            <div class="apt-row">
                <div class="apt-field">
                    <input type="text" name="name" placeholder="Full Name" required />
                </div>
                <div class="apt-field">
                    <input type="tel" name="mobile" placeholder="Mobile Number" required />
                </div>
            </div>

            <div class="apt-field">
                <input type="text" name="address" placeholder="Street Address" required />
            </div>

            <div class="apt-row">
                <div class="apt-field">
                    <input type="text" name="city" placeholder="City" required />
                </div>
                <div class="apt-field">
                    <input type="text" name="pincode" placeholder="Pincode" required />
                </div>
            </div>

            <div class="apt-field">
                <textarea name="reason" rows="4" placeholder="Symptoms or Reason for Visit" required></textarea>
                <span class="apt-hint">Please describe your symptoms or the reason for your visit (e.g. blurred vision, check-up, etc.)</span>
            </div>

            <button type="submit" class="apt-submit">Submit Appointment &rarr;</button>
        </form>
    </div>

    <aside class="apt-sidebar">
        <div class="apt-side-card">
            <h3>Need Immediate Assistance?</h3>
            <p>If you are experiencing severe pain or sudden vision loss, please call us directly.</p>
            <div class="apt-contact">
                <span class="icon">&#128222;</span>
                <div>
                    <span class="label">Emergency Line</span>
                    <a href="tel:+918238391749">+91 8238391749</a>
                </div>
            </div>
            <div class="apt-contact">
                <span class="icon">&#128205;</span>
                <div>
                    <span class="label">Main Clinic</span>
                    <span class="value">201/203, Rander Rd, Surat 395009</span>
                </div>
            </div>
        </div>

        <div class="apt-side-card white">
            <h3>Why Choose Urmi Eye Hospital</h3>
            <div class="apt-badges">
                <span class="apt-badge">&#9989; Board Certified</span>
                <span class="apt-badge">&#9889; Advanced Tech</span>
                <span class="apt-badge">&#11088; 5-Star Care</span>
            </div>
        </div>
    </aside>
</div>
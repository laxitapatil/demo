@{
    ViewData["Title"] = "Cataract Surgery";
    Layout = "_PublicLayout";
}

<style>
    .fac-hero {
        max-width: 1100px;
        margin: 60px auto;
        padding: 0 24px;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 40px;
        align-items: center;
    }

    .fac-hero-text .eyebrow {
        color: #2B6CB0;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .fac-hero-text h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 38px;
        color: #0B1C30;
        margin-bottom: 16px;
    }

    .fac-hero-text p {
        font-size: 15px;
        color: #4A5568;
        line-height: 1.7;
        margin-bottom: 14px;
    }

    .fac-hero-photo img {
        width: 100%;
        border-radius: 16px;
        object-fit: cover;
    }

    .fac-section {
        max-width: 1100px;
        margin: 0 auto 60px;
        padding: 0 24px;
    }

        .fac-section h2 {
            text-align: center;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 22px;
            color: #2B6CB0;
            margin-bottom: 24px;
        }

    .fac-symptom-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        max-width: 700px;
        margin: 0 auto;
    }

    .fac-symptom-card {
        background: #fff;
        border: 1px solid #E5E9F0;
        border-radius: 12px;
        padding: 20px 22px;
        display: flex;
        gap: 14px;
        align-items: flex-start;
    }

        .fac-symptom-card .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #F59E0B;
            margin-top: 6px;
            flex-shrink: 0;
        }

        .fac-symptom-card h4 {
            font-family: 'Poppins', sans-serif;
            font-size: 15px;
            color: #0B1C30;
            margin-bottom: 6px;
        }

        .fac-symptom-card p {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.6;
        }

    .fac-exercise-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .fac-exercise-card {
        background: #fff;
        border: 1px solid #E5E9F0;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }

        .fac-exercise-card .num {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #E9F2FF;
            color: #2B6CB0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px;
            font-weight: 700;
            font-size: 13px;
        }

        .fac-exercise-card h4 {
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            color: #0B1C30;
            margin-bottom: 8px;
        }

        .fac-exercise-card p {
            font-size: 12px;
            color: #6B7280;
            line-height: 1.5;
        }

    .fac-cta {
        background: #2B6CB0;
        border-radius: 16px;
        padding: 48px;
        text-align: center;
        color: #fff;
        max-width: 1100px;
        margin: 0 auto 60px;
    }

        .fac-cta h2 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 26px;
            margin-bottom: 12px;
        }

        .fac-cta p {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 24px;
        }

        .fac-cta a {
            display: inline-block;
            background: #fff;
            color: #2B6CB0;
            padding: 14px 32px;
            border-radius: 9999px;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15px;
        }

    @@media (max-width: 900px) {
        .fac-hero,
        .fac-symptom-grid {
            grid-template-columns: 1fr;
        }

        .fac-exercise-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="fac-hero">
    <div class="fac-hero-text">
        <p class="eyebrow">FACILITY</p>
        <h1>Cataract Surgery</h1>
        <p>
            In the normal eye, the lens is clear and transparent, but when a cataract develops it
            becomes cloudy and opaque, blocking light from properly reaching the retina and causing
            blurred or dim vision.
        </p>
        <p>
            Our surgeons perform safe, modern cataract removal procedures with advanced lens
            implants, offering quick recovery and improved vision clarity.
        </p>
        <a href="/Appointment/Contact" class="btn-primary" style="background:#2B6CB0;color:#fff;padding:12px 28px;border-radius:9999px;font-family:'Poppins',sans-serif;font-weight:700;font-size:14px;display:inline-block;margin-top:10px;">Book Consultation</a>
    </div>
    <div class="fac-hero-photo">
        <img src="~/assets/images/cataract-surgery.jpg" alt="Cataract Surgery" />
    </div>
</section>

<section class="fac-section">
    <h2>Common Symptoms</h2>
    <div class="fac-symptom-grid">
        <div class="fac-symptom-card">
            <span class="dot"></span>
            <div>
                <h4>Blurred Vision</h4>
                <p>Vision gradually becomes cloudy or hazy, like looking through a foggy window.</p>
            </div>
        </div>
        <div class="fac-symptom-card">
            <span class="dot"></span>
            <div>
                <h4>Sensitivity to Light</h4>
                <p>Bright lights and glare, especially while driving at night, become bothersome.</p>
            </div>
        </div>
        <div class="fac-symptom-card">
            <span class="dot"></span>
            <div>
                <h4>Faded Colors</h4>
                <p>Colors may appear less vibrant or slightly yellowed.</p>
            </div>
        </div>
        <div class="fac-symptom-card">
            <span class="dot"></span>
            <div>
                <h4>Frequent Prescription Changes</h4>
                <p>Needing frequent changes in eyeglass or contact lens prescriptions.</p>
            </div>
        </div>
    </div>
</section>

<section class="fac-section">
    <h2>Daily Eye Exercises</h2>
    <div class="fac-exercise-grid">
        <div class="fac-exercise-card">
            <div class="num">1</div>
            <h4>Blinking Exercise</h4>
            <p>Blink slowly and completely 10-15 times to keep eyes lubricated.</p>
        </div>
        <div class="fac-exercise-card">
            <div class="num">2</div>
            <h4>Palming</h4>
            <p>Cover closed eyes gently with palms for a minute to relax eye muscles.</p>
        </div>
        <div class="fac-exercise-card">
            <div class="num">3</div>
            <h4>Focus Shifting</h4>
            <p>Alternate focus between near and distant objects to keep vision sharp.</p>
        </div>
    </div>
</section>

<section class="fac-cta">
    <h2>Your Vision Transformation Starts Here</h2>
    <p>Schedule a free consultation with our specialists to discuss your cataract surgery options.</p>
    <a href="/Appointment/Contact">Book an Appointment</a>
</section>
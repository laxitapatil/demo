@{
    ViewData["Title"] = "OptiLASIK";
    Layout = "_PublicLayout";
}

<style>
    .fac-hero {
        max-width: 1100px;
        margin: 60px auto;
        padding: 0 24px;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 40px;
        align-items: center;
    }

    .fac-hero-text .eyebrow {
        color: #2B6CB0;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .fac-hero-text h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 38px;
        color: #0B1C30;
        margin-bottom: 16px;
    }

    .fac-hero-text p {
        font-size: 15px;
        color: #4A5568;
        line-height: 1.7;
        margin-bottom: 14px;
    }

    .fac-hero-photo img {
        width: 100%;
        border-radius: 16px;
        object-fit: cover;
    }

    .fac-band {
        background: #F7F9FB;
        padding: 50px 24px;
        margin-bottom: 60px;
    }

    .fac-band-inner {
        max-width: 1100px;
        margin: 0 auto;
    }

    .fac-band h2 {
        text-align: center;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 22px;
        color: #0B1C30;
        margin-bottom: 28px;
    }

    .fac-symptom-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .fac-symptom-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

        .fac-symptom-card .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #F59E0B;
            margin-top: 6px;
            flex-shrink: 0;
        }

        .fac-symptom-card h4 {
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            color: #0B1C30;
            margin-bottom: 6px;
        }

        .fac-symptom-card p {
            font-size: 12px;
            color: #6B7280;
            line-height: 1.5;
        }

    .fac-section {
        max-width: 1100px;
        margin: 0 auto 60px;
        padding: 0 24px;
    }

    .fac-dodont-title {
        text-align: center;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 22px;
        color: #0B1C30;
        margin-bottom: 24px;
    }

    .fac-dodont {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .fac-do,
    .fac-dont {
        border-radius: 12px;
        padding: 24px;
    }

    .fac-do {
        background: #E9F7EF;
        border: 1px solid #C6EBD3;
    }

    .fac-dont {
        background: #FDECEC;
        border: 1px solid #F5C6C6;
    }

        .fac-do h3,
        .fac-dont h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 16px;
            margin-bottom: 14px;
        }

    .fac-do h3 {
        color: #1E7B34;
    }

    .fac-dont h3 {
        color: #C0392B;
    }

    .fac-do ul li,
    .fac-dont ul li {
        list-style: none;
        font-size: 13px;
        color: #4A5568;
        margin-bottom: 10px;
        padding-left: 18px;
        position: relative;
    }

        .fac-do ul li::before {
            content: "\2713";
            position: absolute;
            left: 0;
            color: #1E7B34;
            font-weight: 700;
        }

        .fac-dont ul li::before {
            content: "\2715";
            position: absolute;
            left: 0;
            color: #C0392B;
            font-weight: 700;
        }

    .fac-exercise-band {
        background: #F7F9FB;
        padding: 50px 24px;
        margin-bottom: 60px;
    }

    .fac-exercise-band-inner {
        max-width: 1100px;
        margin: 0 auto;
        text-align: center;
    }

    .fac-exercise-band h2 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 22px;
        color: #0B1C30;
        margin-bottom: 8px;
    }

    .fac-exercise-band > .fac-exercise-band-inner > p {
        font-size: 13px;
        color: #6B7280;
        max-width: 600px;
        margin: 0 auto 32px;
    }

    .fac-exercise-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        text-align: left;
    }

    .fac-exercise-card {
        background: #fff;
        border: 1px solid #E5E9F0;
        border-radius: 12px;
        padding: 20px;
    }

        .fac-exercise-card h4 {
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            color: #0B1C30;
            margin-bottom: 8px;
        }

        .fac-exercise-card p {
            font-size: 12px;
            color: #6B7280;
            line-height: 1.5;
        }

    .fac-cta {
        background: #2B6CB0;
        border-radius: 16px;
        padding: 48px;
        text-align: center;
        color: #fff;
        max-width: 1100px;
        margin: 0 auto 60px;
    }

        .fac-cta h2 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 26px;
            margin-bottom: 12px;
            color: #fff;
        }

        .fac-cta p {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 24px;
        }

        .fac-cta a {
            display: inline-block;
            background: #fff;
            color: #2B6CB0;
            padding: 14px 32px;
            border-radius: 9999px;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15px;
        }

    @@media (max-width: 900px) {
        .fac-hero,
        .fac-dodont {
            grid-template-columns: 1fr;
        }

        .fac-symptom-grid {
            grid-template-columns: 1fr 1fr;
        }

        .fac-exercise-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="fac-hero">
    <div class="fac-hero-text">
        <p class="eyebrow">FACILITY</p>
        <h1>OptiLASIK</h1>
        <p>
            OptiLASIK is an advanced procedure that reshapes the cornea, mimicking the natural way
            light falls on it, so the light properly reaches the retina, improving vision and
            reducing dependency on glasses or contact lenses.
        </p>
        <p>
            Our precision laser technology ensures a fast, virtually painless procedure with quick
            visual recovery for most patients.
        </p>
    </div>
    <div class="fac-hero-photo">
        <img src="~/assets/images/optilasik.jpg" alt="OptiLASIK" />
    </div>
</section>

<section class="fac-band">
    <div class="fac-band-inner">
        <h2>Common Symptoms</h2>
        <div class="fac-symptom-grid">
            <div class="fac-symptom-card">
                <span class="dot"></span>
                <div>
                    <h4>Blurred Vision</h4>
                    <p>Difficulty focusing on near or distant objects clearly.</p>
                </div>
            </div>
            <div class="fac-symptom-card">
                <span class="dot"></span>
                <div>
                    <h4>Difficulty Seeing at Night</h4>
                    <p>Trouble seeing clearly in low-light or nighttime conditions.</p>
                </div>
            </div>
            <div class="fac-symptom-card">
                <span class="dot"></span>
                <div>
                    <h4>Frequent Headaches</h4>
                    <p>Eye strain from focusing effort causing recurring headaches.</p>
                </div>
            </div>
            <div class="fac-symptom-card">
                <span class="dot"></span>
                <div>
                    <h4>Glasses Dependency</h4>
                    <p>Relying heavily on glasses or contacts for daily activities.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="fac-section">
    <p class="fac-dodont-title">Do's &amp; Don'ts</p>
    <div class="fac-dodont">
        <div class="fac-do">
            <h3>The Do's</h3>
            <ul>
                <li>Follow post-op eye drop schedule</li>
                <li>Wear protective eyewear as advised</li>
                <li>Attend all follow-up appointments</li>
                <li>Rest your eyes for the first 24 hours</li>
            </ul>
        </div>
        <div class="fac-dont">
            <h3>The Don'ts</h3>
            <ul>
                <li>Don't rub your eyes after the procedure</li>
                <li>Avoid swimming pools for 2 weeks</li>
                <li>Don't skip prescribed medications</li>
                <li>Avoid strenuous activity immediately after</li>
            </ul>
        </div>
    </div>
</section>

<section class="fac-exercise-band">
    <div class="fac-exercise-band-inner">
        <h2>Daily Eye Exercises</h2>
        <p>Simple exercises to support eye comfort and recovery alongside your treatment.</p>
        <div class="fac-exercise-grid">
            <div class="fac-exercise-card">
                <h4>Blinking Exercise</h4>
                <p>Blink slowly 10-15 times to relieve dryness and refresh your eyes.</p>
            </div>
            <div class="fac-exercise-card">
                <h4>Rest and Recharge</h4>
                <p>Close your eyes for a few minutes periodically to reduce strain.</p>
            </div>
            <div class="fac-exercise-card">
                <h4>Eye Refrigeration</h4>
                <p>Use a cool compress to soothe eyes after extended screen use.</p>
            </div>
        </div>
    </div>
</section>

<section class="fac-cta">
    <h2>Your Vision Transformation Starts Here</h2>
    <p>Schedule a free consultation to see if OptiLASIK is the right choice for your vision goals.</p>
    <a href="/Appointment/Contact">Book an Appointment</a>
</section>
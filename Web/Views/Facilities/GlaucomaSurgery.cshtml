@{
    ViewData["Title"] = "Glaucoma Surgery";
    Layout = "_PublicLayout";
}

<style>
    .fac-hero {
        max-width: 1100px;
        margin: 60px auto;
        padding: 0 24px;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 40px;
        align-items: center;
    }

    .fac-hero-text .eyebrow {
        color: #2B6CB0;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .fac-hero-text h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 38px;
        color: #0B1C30;
        margin-bottom: 16px;
    }

    .fac-hero-text p {
        font-size: 15px;
        color: #4A5568;
        line-height: 1.7;
        margin-bottom: 14px;
    }

    .fac-hero-photo img {
        width: 100%;
        border-radius: 16px;
        object-fit: cover;
    }

    .fac-section {
        max-width: 1100px;
        margin: 0 auto 60px;
        padding: 0 24px;
        text-align: center;
    }

        .fac-section h2 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 22px;
            color: #2B6CB0;
            margin-bottom: 32px;
            letter-spacing: 1px;
        }

    .fac-symptom-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }

    .fac-symptom-card {
        text-align: center;
    }

        .fac-symptom-card .icon-circle {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: #E9F2FF;
            color: #2B6CB0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
            font-size: 22px;
        }

        .fac-symptom-card h4 {
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            color: #0B1C30;
            margin-bottom: 8px;
        }

        .fac-symptom-card p {
            font-size: 12px;
            color: #6B7280;
            line-height: 1.6;
        }

    .fac-exercise-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        text-align: left;
    }

    .fac-exercise-card {
        background: #fff;
        border: 1px solid #E5E9F0;
        border-radius: 12px;
        padding: 20px;
    }

        .fac-exercise-card h4 {
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            color: #0B1C30;
            margin-bottom: 8px;
        }

        .fac-exercise-card p {
            font-size: 12px;
            color: #6B7280;
            line-height: 1.5;
        }

    .fac-cta {
        background: #2B6CB0;
        border-radius: 16px;
        padding: 48px;
        text-align: center;
        color: #fff;
        max-width: 1100px;
        margin: 0 auto 60px;
    }

        .fac-cta h2 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 26px;
            margin-bottom: 12px;
            color: #fff;
        }

        .fac-cta p {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 24px;
        }

        .fac-cta a {
            display: inline-block;
            background: #fff;
            color: #2B6CB0;
            padding: 14px 32px;
            border-radius: 9999px;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15px;
        }

    @@media (max-width: 900px) {
        .fac-hero {
            grid-template-columns: 1fr;
        }

        .fac-symptom-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .fac-exercise-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="fac-hero">
    <div class="fac-hero-text">
        <p class="eyebrow">FACILITY</p>
        <h1>Glaucoma Surgery</h1>
        <p>
            It's an eye disease that can cause blindness. Often called the "Sneak Thief of Sight,"
            glaucoma usually has no early warning signs, making regular eye exams essential for
            early detection and treatment.
        </p>
        <p>
            Our surgical team offers advanced glaucoma treatments to lower eye pressure, protect
            the optic nerve, and preserve your vision for the long term.
        </p>
    </div>
    <div class="fac-hero-photo">
        <img src="~/assets/images/glaucoma-surgery.jpg" alt="Glaucoma Surgery" />
    </div>
</section>

<section class="fac-section">
    <h2>COMMON SYMPTOMS</h2>
    <div class="fac-symptom-grid">
        <div class="fac-symptom-card">
            <div class="icon-circle">&#128065;</div>
            <h4>Loss of Peripheral Vision</h4>
            <p>Gradual narrowing of side vision, often unnoticed until advanced.</p>
        </div>
        <div class="fac-symptom-card">
            <div class="icon-circle">&#128264;</div>
            <h4>Eye Pain</h4>
            <p>Severe eye pain, especially in acute angle-closure glaucoma.</p>
        </div>
        <div class="fac-symptom-card">
            <div class="icon-circle">&#128167;</div>
            <h4>Halos Around Lights</h4>
            <p>Seeing rainbow-colored halos around lights, especially at night.</p>
        </div>
        <div class="fac-symptom-card">
            <div class="icon-circle">&#128561;</div>
            <h4>Blurred Vision</h4>
            <p>Sudden blurred vision, sometimes with nausea and headache.</p>
        </div>
    </div>
</section>

<section class="fac-section">
    <h2>DAILY EYE EXERCISES</h2>
    <p style="max-width:600px;margin:0 auto 32px;font-size:13px;color:#6B7280;">While exercises don't cure glaucoma, these habits support overall eye comfort and health alongside your treatment.</p>
    <div class="fac-exercise-grid">
        <div class="fac-exercise-card">
            <h4>Blinking Exercise</h4>
            <p>Blink slowly 10-15 times to relieve dryness and reduce strain.</p>
        </div>
        <div class="fac-exercise-card">
            <h4>Palming Exercise</h4>
            <p>Rest closed eyes gently in cupped palms for a minute to relax them.</p>
        </div>
        <div class="fac-exercise-card">
            <h4>Neck and Eye Stretching</h4>
            <p>Gently roll your neck and shift eye focus to relieve tension.</p>
        </div>
    </div>
</section>

<section class="fac-cta">
    <h2>Your Vision Transformation Starts Here</h2>
    <p>Early detection is key. Schedule a consultation to protect your vision from glaucoma today.</p>
    <a href="/Appointment/Book">Book an Appointment</a>
</section>
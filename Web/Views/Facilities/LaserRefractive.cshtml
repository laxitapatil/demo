@{
    ViewData["Title"] = "Laser Refractive";
    Layout = "_PublicLayout";
}

<style>
    .fac-hero {
        max-width: 1100px;
        margin: 60px auto;
        padding: 0 24px;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 40px;
        align-items: center;
    }

    .fac-hero-text .eyebrow {
        color: #2B6CB0;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .fac-hero-text h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 38px;
        color: #0B1C30;
        margin-bottom: 16px;
    }

    .fac-hero-text p {
        font-size: 15px;
        color: #4A5568;
        line-height: 1.7;
        margin-bottom: 14px;
    }

    .fac-hero-photo img {
        width: 100%;
        border-radius: 16px;
        object-fit: cover;
    }

    .fac-section {
        max-width: 1100px;
        margin: 0 auto 60px;
        padding: 0 24px;
    }

        .fac-section h2 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 26px;
            color: #0B1C30;
            margin-bottom: 24px;
        }

    .fac-symptom-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .fac-symptom-card {
        background: #fff;
        border: 1px solid #E5E9F0;
        border-radius: 12px;
        padding: 20px 22px;
        display: flex;
        gap: 14px;
        align-items: flex-start;
    }

        .fac-symptom-card .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #F59E0B;
            margin-top: 6px;
            flex-shrink: 0;
        }

        .fac-symptom-card h4 {
            font-family: 'Poppins', sans-serif;
            font-size: 15px;
            color: #0B1C30;
            margin-bottom: 6px;
        }

        .fac-symptom-card p {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.6;
        }

    .fac-dodont {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .fac-do,
    .fac-dont {
        border-radius: 12px;
        padding: 24px;
    }

    .fac-do {
        background: #E9F7EF;
        border: 1px solid #C6EBD3;
    }

    .fac-dont {
        background: #FDECEC;
        border: 1px solid #F5C6C6;
    }

        .fac-do h3,
        .fac-dont h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 16px;
            margin-bottom: 14px;
        }

    .fac-do h3 {
        color: #1E7B34;
    }

    .fac-dont h3 {
        color: #C0392B;
    }

    .fac-do ul li,
    .fac-dont ul li {
        list-style: none;
        font-size: 13px;
        color: #4A5568;
        margin-bottom: 10px;
        padding-left: 18px;
        position: relative;
    }

        .fac-do ul li::before {
            content: "\2713";
            position: absolute;
            left: 0;
            color: #1E7B34;
            font-weight: 700;
        }

        .fac-dont ul li::before {
            content: "\2715";
            position: absolute;
            left: 0;
            color: #C0392B;
            font-weight: 700;
        }

    .fac-exercise-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .fac-exercise-card {
        background: #fff;
        border: 1px solid #E5E9F0;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }

        .fac-exercise-card h4 {
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            color: #0B1C30;
            margin-bottom: 8px;
        }

        .fac-exercise-card p {
            font-size: 12px;
            color: #6B7280;
            line-height: 1.5;
        }

    .fac-cta {
        background: #2B6CB0;
        border-radius: 16px;
        padding: 48px;
        text-align: center;
        color: #fff;
        max-width: 1100px;
        margin: 0 auto 60px;
    }

        .fac-cta h2 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 26px;
            margin-bottom: 12px;
        }

        .fac-cta p {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 24px;
        }

        .fac-cta a {
            display: inline-block;
            background: #fff;
            color: #2B6CB0;
            padding: 14px 32px;
            border-radius: 9999px;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15px;
        }

    @@media (max-width: 900px) {
        .fac-hero,
        .fac-symptom-grid,
        .fac-dodont {
            grid-template-columns: 1fr;
        }

        .fac-exercise-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<section class="fac-hero">
    <div class="fac-hero-text">
        <p class="eyebrow">FACILITY</p>
        <h1>Laser Refractive</h1>
        <p>
            Laser refractive surgery reshapes the cornea to correct common vision problems like
            nearsightedness, farsightedness, and astigmatism, reducing or eliminating dependency on
            glasses and contact lenses.
        </p>
        <p>
            Our advanced laser technology ensures precise, safe, and quick procedures with fast
            recovery times, performed by our experienced team of ophthalmologists.
        </p>
    </div>
    <div class="fac-hero-photo">
        <img src="~/assets/images/laser-refractive.jpg" alt="Laser Refractive Surgery" />
    </div>
</section>

<section class="fac-section">
    <h2>Common Symptoms</h2>
    <div class="fac-symptom-grid">
        <div class="fac-symptom-card">
            <span class="dot"></span>
            <div>
                <h4>Blurred Vision</h4>
                <p>Difficulty seeing objects clearly at certain distances, whether near or far.</p>
            </div>
        </div>
        <div class="fac-symptom-card">
            <span class="dot"></span>
            <div>
                <h4>Difficulty Reading</h4>
                <p>Struggling to focus on text, especially in low light or for extended periods.</p>
            </div>
        </div>
        <div class="fac-symptom-card">
            <span class="dot"></span>
            <div>
                <h4>Eye Strain / Headaches</h4>
                <p>Frequent headaches or tired eyes after visual tasks like reading or screen use.</p>
            </div>
        </div>
        <div class="fac-symptom-card">
            <span class="dot"></span>
            <div>
                <h4>Squinting Frequently</h4>
                <p>Needing to squint to bring objects into sharper focus.</p>
            </div>
        </div>
    </div>
</section>

<section class="fac-section">
    <div class="fac-dodont">
        <div class="fac-do">
            <h3>The Do's</h3>
            <ul>
                <li>Use prescribed eye drops as directed</li>
                <li>Wear protective eyewear when advised</li>
                <li>Attend all follow-up appointments</li>
                <li>Rest your eyes after the procedure</li>
            </ul>
        </div>
        <div class="fac-dont">
            <h3>The Don'ts</h3>
            <ul>
                <li>Don't rub your eyes after surgery</li>
                <li>Avoid swimming or hot tubs for 2 weeks</li>
                <li>Don't skip follow-up visits</li>
                <li>Avoid strenuous exercise immediately after</li>
            </ul>
        </div>
    </div>
</section>

<section class="fac-section">
    <h2>Daily Eye Exercises</h2>
    <div class="fac-exercise-grid">
        <div class="fac-exercise-card">
            <h4>Blinking Exercise</h4>
            <p>Blink slowly 10-15 times to relieve dryness and refresh your eyes.</p>
        </div>
        <div class="fac-exercise-card">
            <h4>Focus Shifting</h4>
            <p>Alternate focus between near and far objects to strengthen eye muscles.</p>
        </div>
        <div class="fac-exercise-card">
            <h4>Eye Rolling</h4>
            <p>Gently roll your eyes in circular motions to ease tension.</p>
        </div>
        <div class="fac-exercise-card">
            <h4>20-20-20 Rule</h4>
            <p>Every 20 minutes, look at something 20 feet away for 20 seconds.</p>
        </div>
    </div>
</section>

<section class="fac-cta">
    <h2>Your Vision Transformation Starts Here</h2>
    <p>Schedule a free consultation with our specialists to see if laser refractive surgery is right for you.</p>
    <a href="/Appointment/Book">Book an Appointment</a>
</section>
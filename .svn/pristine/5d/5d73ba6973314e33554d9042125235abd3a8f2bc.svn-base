using Api.Provider;
using AutoMapper;
using Core.Domain;
using Core.Request;
using Core.Response;
using Infrastructure;
using Infrastructure.Base;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Api.Controllers
{
    [Tags("CaseProperty")]
    [Authorize]
    [Route("api/case-property")]
    [ApiController]
    public class CasePropertyController : BaseController
    {
        private readonly string CASE_PROPERTY = "Case Property";
        private readonly string CASE = "Case";
        private readonly string STATE = "State";

        public CasePropertyController(IConfiguration configuration, IMapper mapper, DBContext dbContext)
            : base(configuration, mapper, dbContext) { }

        /// <summary>
        /// Get All Case Properties (Optional: Filter by Id, Case Id or Final Status)
        /// </summary>
        /// <param name="id">Optional case property id</param>
        /// <param name="caseId">Optional case id</param>
        /// <returns></returns>
        [Authorize]
        [HttpGet]
        public async Task<IActionResult> Get(int? id, string? caseId)
        {
            try
            {
                using CaseRepository repo = new(dbContext);

                Case? caseEntity = null;
                if (int.TryParse(caseId, out int intCaseId))
                {
                    caseEntity = await repo.SelectOne(intCaseId);
                }
                else
                {
                    caseEntity = await repo.SelectByCaseId(caseId);
                }
                if (caseEntity == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE), statusCode: StatusCodes.Status404NotFound);
   
                return Ok(await new CasePropertyRepository(dbContext).SelectAll(id, caseEntity.Id));
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get Case Property by Id
        /// </summary>
        /// <param name="id">Case property id</param>
        /// <returns></returns>
        [Authorize]
        [HttpGet("{id}")]
        public async Task<IActionResult> GetOne(int id)
        {
            try
            {
                using CasePropertyRepository repo = new(dbContext);
                CaseProperty? caseProperty = await repo.SelectOne(id);

                if (caseProperty == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_PROPERTY), statusCode: StatusCodes.Status404NotFound);

                return Ok(mapper.Map<CaseProperty, CasePropertyResponse>(caseProperty));
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get Case Properties by Case Id
        /// </summary>
        /// <param name="caseId">Case id</param>
        /// <returns></returns>
        [Authorize]
        [HttpGet("case/{caseId}")]
        public async Task<IActionResult> GetByCaseId(string caseId)
        {
            try
            {
                using CaseRepository repo = new(dbContext);

                Case? caseEntity = null;
                if (int.TryParse(caseId, out int intCaseId))
                {
                    caseEntity = await repo.SelectOne(intCaseId);
                }
                else
                {
                    caseEntity = await repo.SelectByCaseId(caseId);
                }
                if (caseEntity == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE), statusCode: StatusCodes.Status404NotFound);


                using CasePropertyRepository repoCaseProperty = new(dbContext);
                List<CaseProperty> properties = await repoCaseProperty.SelectByCaseId(caseEntity.Id);

                return Ok(mapper.Map<List<CaseProperty>, List<CasePropertyResponse>>(properties));
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Create Case Property
        /// </summary>
        /// <param name="request">Case property details</param>
        /// <returns></returns>
        [Authorize]
        [HttpPost]
        public async Task<IActionResult> Post(CasePropertyRequest request)
        {
            try
            {
                using CasePropertyRepository repo = new(dbContext);

                CaseProperty caseProperty = mapper.Map<CasePropertyRequest, CaseProperty>(request);
                caseProperty.Is_final = false;
                caseProperty.Created_by = TokenName;
                caseProperty.Created_date = CurrentTime;

                int result = await repo.Insert(caseProperty);

                return result > 0
                    ? Ok(mapper.Map<CaseProperty, CasePropertyResponse>(caseProperty))
                    : Problem(string.Format(MessageProvider.INSERT_FAILED, CASE_PROPERTY),
                        statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk_case_property_case"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE), statusCode: StatusCodes.Status404NotFound);

                if (ex.ToString().ToLower().Contains("fk_case_property_state"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_PROPERTY), statusCode: StatusCodes.Status404NotFound);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Update Case Property
        /// </summary>
        /// <param name="request">Case property details</param>
        /// <returns></returns>
        [Authorize]
        [HttpPut]
        public async Task<IActionResult> Put(CasePropertyRequest request)
        {
            try
            {
                if (!request.Id.HasValue || request.Id < 1)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_PROPERTY),
                        statusCode: StatusCodes.Status404NotFound);

                using CasePropertyRepository repo = new(dbContext);
                CaseProperty? caseProperty = await repo.SelectOne(request.Id.Value);

                if (caseProperty == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_PROPERTY),
                        statusCode: StatusCodes.Status404NotFound);

                caseProperty.Case_id = caseProperty.Case_id;
                caseProperty.Property_type = (short)request.Property_type;
                caseProperty.Name = request.Name.Trim();
                caseProperty.Distance = request.Distance;
                caseProperty.Size_sqft = request.Size_sqft;
                caseProperty.Address = request.Address.Trim();
                caseProperty.City = null;
                caseProperty.State_id = request.State_id;
                caseProperty.Pincode = null;
                caseProperty.Latitude = request.Latitude;
                caseProperty.Longitude = request.Longitude;
                caseProperty.Location = request.Location?.Trim();
                caseProperty.Valuation_amount = request.Valuation_amount;
                caseProperty.Is_final = request.Is_final ?? caseProperty.Is_final;
                //caseProperty.Report_doc_path = request.Report_doc_path?.Trim();
                //caseProperty.Report_pdf_path = request.Report_pdf_path?.Trim();
                //caseProperty.Report_updated_date = request.Report_updated_date;
                caseProperty.Note = request.Note?.Trim();
                caseProperty.Modified_by = TokenName;
                caseProperty.Modified_date = CurrentTime;

                int result = await repo.Update(caseProperty);

                return result > 0
                    ? Ok(mapper.Map<CaseProperty, CasePropertyResponse>(caseProperty))
                    : Problem(string.Format(MessageProvider.UPDATE_FAILED, CASE_PROPERTY),
                        statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk_case_property_case"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE), statusCode: StatusCodes.Status404NotFound);

                if (ex.ToString().ToLower().Contains("fk_case_property_state"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_PROPERTY), statusCode: StatusCodes.Status404NotFound);
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Delete Case Property
        /// </summary>
        /// <param name="id">Case property id</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(int id)
        {
            try
            {
                using CasePropertyRepository repo = new(dbContext);
                CaseProperty? caseProperty = await repo.SelectOne(id);

                if (caseProperty == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_PROPERTY), statusCode: StatusCodes.Status404NotFound);

                await repo.Delete(caseProperty);

                return Ok(string.Format(MessageProvider.DELETE_SUCCESS, CASE_PROPERTY));
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk"))
                    return Problem(MessageProvider.CHILD_FOUND,statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message,
                    statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Update Case Property Final Status
        /// </summary>
        /// <param name="id">Case property id</param>
        /// <returns></returns>
        [Authorize]
        [HttpPut("final-status/{id}")]
        public async Task<IActionResult> UpdateFinalStatus(int id, string? recordDocPath, string? recordPdfPath)
        {
            try
            {
                using CasePropertyRepository repo = new(dbContext);
                CaseProperty? caseProperty = await repo.SelectOne(id);

                if (caseProperty == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_PROPERTY),
                        statusCode: StatusCodes.Status404NotFound);
                bool? isFinal = !caseProperty.Is_final;
                if (isFinal == true)
                {
                    if (string.IsNullOrWhiteSpace(recordDocPath) || string.IsNullOrWhiteSpace(recordPdfPath))
                        return Problem(string.Format(MessageProvider.REPORT_REQUIRED), statusCode: StatusCodes.Status400BadRequest);

                    caseProperty.Report_doc_path = recordDocPath?.Trim();
                    caseProperty.Report_pdf_path = recordPdfPath?.Trim();
                    caseProperty.Report_updated_date = CurrentTime;
                }
                caseProperty.Is_final = !caseProperty.Is_final;
                caseProperty.Modified_by = TokenName;
                caseProperty.Modified_date = CurrentTime;

                int result = await repo.Update(caseProperty);

                return result > 0
                    ? Ok(string.Format(MessageProvider.UPDATE_SUCCESS, CASE_PROPERTY))
                    : Problem(string.Format(MessageProvider.UPDATE_FAILED, CASE_PROPERTY),
                        statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message,
                    statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get Property Type Dropdown List
        /// </summary>
        /// <returns></returns>
        [Authorize]
        [HttpGet("property-type")]
        public async Task<IActionResult> GetPropertyType()
        {
            try
            {
                using CasePropertyRepository repo = new(dbContext);
                return Ok(await repo.SelectPropertyType());
            }
            catch (Exception ex)
            {
                return Problem(ex.Message,
                    statusCode: StatusCodes.Status500InternalServerError);
            }
        }
    }
}
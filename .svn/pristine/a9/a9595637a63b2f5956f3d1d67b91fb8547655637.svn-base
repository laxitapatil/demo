//#region Toastr
function successToastr(message) {
    toastr.success(message);
}

function errorToastr(message) {
    toastr.error(message);
}
//#endregion Toastr

function openModal(url, modal) {
    $.ajax({
        url: url,
        async: false,
        success: function (data) {
            $("body").append(data);
            $("#" + modal).modal("show");
        }
    });
}


function showLoader() { $(".se-pre-con").css({ "display": "block" }); }

function hideLoader() { $(".se-pre-con").css({ "display": "none" }); }


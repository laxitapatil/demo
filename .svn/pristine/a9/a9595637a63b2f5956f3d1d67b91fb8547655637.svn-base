const ApiUrl = ConfigApiUrl + "api/";
const GLOBAL_DATE_FORMAT = "DD-MM-YYYY hh:mm A";

// Validate Hidden Items validation.
//$.validator.setDefaults({ ignore: [] });

// JQuery validation add new key regex for Regular Expression.
$.validator.addMethod(
    "regex",
    function (value, element, regexp) {
        return this.optional(element) || new RegExp(regexp).test(value);
    }
);

// JQuery validation add new key size for File size validation.
$.validator.addMethod(
    "size",
    function (value, element, size) {
        return this.optional(element) || element.files[0].size <= size
    }
);

$.validator.addMethod(
    "accept",
    function (t, e, i) {
        var a, r,
            n = "string" == typeof i ? i.replace(/\s/g, "").replace(/,/g, "|") : "image/*",
            s = this.optional(e);
        if (s) return s;
        if ("file" === $(e).attr("type") && (n = n.replace(/\*/g, ".*"), e.files && e.files.length))
            for (a = 0; e.files.length > a; a++)
                if (r = e.files[a], !r.type.match(RegExp(".?(" + n + ")$", "i"))) return !1;
        return !0
    }
);

$.validator.addMethod("greaterThanInput", function (value, element, param) { return value > $(param).val() })
$.validator.addMethod("compare", function (value, element, param) { return value === $(param).val() })
$.validator.addMethod("greaterThanEqual", function (value, element, param) { return value >= param })
$.validator.addMethod("lessThanEqual", function (value, element, param) { return value <= param })
$.validator.addMethod("notBlank", function (value) { return $.trim(value).length > 0; });


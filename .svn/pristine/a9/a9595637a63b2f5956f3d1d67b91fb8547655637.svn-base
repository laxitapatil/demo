function baseAPIRequest({ method, url, data = null, successCallback = "", errorCallback = "", event = null }) {

    let btn = null;
    let btn_html = null;

    // BEFORE SEND (loader)
    if (event && event.submitter) {
        btn = event.submitter;
        btn_html = btn.innerHTML;
        btn.innerHTML =
            '<span class="spinner-border spinner-border-sm mr-1"></span> Loading';
        btn.setAttribute("disabled", "true");
    }

    const options = {
        method: method,
        headers: {
            "Authorization": "Bearer " + localStorage.getItem("token"),
            "Accept": "application/json"
        }
    };

    // SEND REQUEST BODY
    if (data !== null) {

        // If FormData
        if (data instanceof FormData) {
            options.body = data;
        }
        // Normal JSON request
        else {
            options.headers["Content-Type"] = "application/json";
            options.body = JSON.stringify(data);
        }
    }

    return fetch(url, options)
        .then(async response => {

            //  ACCESS TOKEN EXPIRED
            if (response.status === 401 && localStorage.getItem("refreshToken")) {

                const refreshed = await refreshTokens(localStorage.getItem("refreshToken"));

                if (!refreshed) {
                    localStorage.clear();
                    location.href = "/";
                    return;
                }

                //  RETRY SAME REQUEST WITH NEW TOKEN
                options.headers["Authorization"] =
                    "Bearer " + localStorage.getItem("token");

                response = await fetch(url, options);
            }

            // STILL UNAUTHORIZED
            if (response.status === 401) {
                localStorage.clear();
                location.href = "/";
                return;
            }

            const text = await response.text();
            let parsed = null;

            if (!text) {
                parsed = null;
            } else {
                try {
                    parsed = JSON.parse(text);

                    if (typeof parsed === "string") {
                        parsed = JSON.parse(parsed);
                    }

                } catch {
                    parsed = text;
                }
            }

            if (!response.ok) {
                throw parsed;
            }

            if (successCallback) {
                typeof successCallback === "function"
                    ? successCallback(parsed)
                    : window[successCallback](parsed);
            }

            return parsed;
        })
        .catch(error => {
            if (errorCallback) {
                typeof errorCallback === "function"
                    ? errorCallback(error)
                    : window[errorCallback](error);
            }
        })
        .finally(() => {
            if (btn) {
                btn.innerHTML = btn_html;
                btn.removeAttribute("disabled");
            }
        });
}


let refreshTimer = null;


//  Refresh Token 
async function refreshTokens(refreshToken) {

    try {
        const response = await fetch(ApiUrl + "authenticate/refresh-token", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ refreshToken })
        });

        if (!response.ok) {
            console.error("Refresh API failed:", response.status);
            return false;
        }

        const data = await response.json();
        console.log("Refresh success:", data);

        if (data.token)
            AuthModule.setToken(data.token);

        if (data.refreshToken)
            AuthModule.setRefreshToken(data.refreshToken);

        return true;
    }
    catch (err) {
        console.error("Refresh exception:", err);
        return false;
    }
}

function callBaseGetAPI(url, successCallback, errorCallback, event = null) {
    return baseAPIRequest({
        method: "GET",
        url: ApiUrl + url,
        successCallback,
        errorCallback,
        event
    });
}

function callBasePostAPI(url, data, successCallback, errorCallback, event = null) {
    return baseAPIRequest({
        method: "POST",
        url: ApiUrl + url,
        data,
        successCallback,
        errorCallback,
        event
    });
}

function callBasePutAPI(url, data, successCallback, errorCallback, event = null) {
    return baseAPIRequest({
        method: "PUT",
        url: ApiUrl + url,
        data,
        successCallback,
        errorCallback,
        event
    });
}

function callBaseDeleteAPI(url, successCallback, errorCallback, event = null) {
    return baseAPIRequest({
        method: "DELETE",
        url: ApiUrl + url,
        successCallback,
        errorCallback,
        event
    });
}

function callBasePostFileAPI(url, formData, successCallback, errorCallback, event = null) {
    return baseAPIRequest({
        method: "POST",
        url: ApiUrl + url,
        data: formData,
        successCallback,
        errorCallback,
        event
    });
}

function callBasePutFileAPI(url, formData, successCallback, errorCallback, event = null) {
    return baseAPIRequest({
        method: "PUT",
        url: ApiUrl + url,
        data: formData,
        successCallback,
        errorCallback,
        event
    });
}


function commonError(error) {
    let errorMsg = "";

    // FIRST priority: Direct error object (parsed ProblemDetails)
    if (error && typeof error === "object") {
        if (error.detail) {
            errorMsg = error.detail;
        } else if (error.title) {
            errorMsg = error.title;
        } else if (error.message) {
            errorMsg = error.message;
        }
        //jQuery AJAX responseJSON
        else if (error.responseJSON && typeof error.responseJSON === "object") {
            if (error.responseJSON.detail) {
                errorMsg = error.responseJSON.detail;
            } else if (error.responseJSON.title) {
                errorMsg = error.responseJSON.title;
            } else {
                errorMsg = JSON.stringify(error.responseJSON);
            }
        }
        // responseText
        else if (error.responseText) {
            try {
                const json = JSON.parse(error.responseText);
                errorMsg = json.detail || json.title || error.responseText;
            } catch {
                errorMsg = error.responseText;
            }
        }
        else {
            errorMsg = JSON.stringify(error);
        }
    }
    // string error
    else if (typeof error === "string") {
        errorMsg = error;
    }

    else {
        errorMsg = "An unexpected error occurred.";
    }

    $("button[type='submit']").removeAttr("disabled");
    errorToastr(errorMsg);

    return errorMsg;
}

function isEmpty(str) {
    return (str == undefined || !str || str.length === 0);
}
function pad(width, string) {
    return (width <= string.length) ? string : pad(width, ' ' + string, ' ')
}


//message provider
class MessageProvider {
    static INSERT_SUCCESS = "'{0}' added successfully.";
    static UPDATE_SUCCESS = "'{0}' updated successfully.";
    static DELETE_SUCCESS = "'{0}' deleted successfully.";
    static NOT_FOUND = "'{0}' does not exist.";
    static SOMETHING_WRONG = "Something went wrong please try again.";
    static INVALID_REQUEST = "Invalid request.";
    static NOTIFICATION_SENT = "Notification Sent Successfully.";
    static CONTACT_US_MSG = "Thank you for contacting us! We will reach you soon.";

    static format(message, ...args) {
        return message.replace(/{(\d+)}/g, (match, index) => args[index] || '');
    }
}

function generateImageURL(baseFolder, ...folders) {
    let folderPath = folders.filter(folder => folder).join('/');
    var url = `${BASE_URL}${baseFolder}/${folderPath}`;
    return url;
}

function generateCaseDocURL(baseFolder) {
    var url = `${BASE_URL}${baseFolder}`;
    return url;
}
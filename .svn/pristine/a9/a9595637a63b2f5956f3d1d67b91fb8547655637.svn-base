function isLogin() {
    const token = AuthModule.getToken();
    if (!token || isEmpty(token)) {
        location.href = "/home/login";
    }
}

function logoutUser() {
    AuthModule.logout();
}

//Initialize Datatable with default presets
function setDataTable(selector, options = {}) {

    const defaultOptions = {
        searching: true,
        paging: true,
        lengthChange: true,

        layout: {
            topStart: null,
            topEnd: null,
            bottomStart: 'info',                  // "Showing X to Y..."
            bottomEnd: ['pageLength', 'paging'],  // Page Size + Pagination (RIGHT)
        },

        language: {
            lengthMenu: 'Page Size: _MENU_'
        },

        columnDefs: [
            { orderable: false, targets: 0 },
            { className: "dt-left", targets: "_all" }
        ],

        lengthMenu: [[20, 50, 100, 500, -1], [20, 50, 100, 500, "All"]],
    };

    const finalOptions = $.extend(true, {}, defaultOptions, options);

    return $(selector).DataTable(finalOptions);
}


function applyColumnFilters(api, options = {}) {
    const {
        noFilterColumns = [],
        selectFilterColumns = []
    } = options;

    api.columns().every(function (index) {
        const column = this;

        // Skip columns without filter
        if (noFilterColumns.includes(index)) return;

        const th = $(column.header());

        // Prevent duplicate filters
        if (th.find('input, select').length) return;

        // Get column title
        const title = th.text().trim();

        // SELECT FILTER
        if (selectFilterColumns.includes(index)) {
            const select = $('<select>', {
                class: 'form-select form-select-sm mt-1'
            }).append('<option value="">All</option>');

            column.data().unique().sort().each(function (d) {
                if (!d) return;

                // Remove HTML tags
                let text = $('<div>').html(d).text().trim();

                if (text) {
                    select.append(
                        $('<option>', { value: text, text: text })
                    );
                }
            });

            th.append(select);

            select.on('click', function (e) {
                e.stopPropagation();
            });

            select.on('change', function () {
                const val = $.fn.dataTable.util.escapeRegex(this.value);
                column.search(val ? `^${val}$` : '', true, false).draw();
            });
        }

        // INPUT FILTER
        else {
            const input = $('<input>', {
                type: 'text',
                placeholder: `Search`,
                class: 'form-control form-control-sm mt-1'
            });

            th.append(input);

            // STOP SORTING TRIGGER
            input.on('click', function (e) {
                e.stopPropagation();
            });

            input.on('keyup change clear', function () {
                if (column.search() !== this.value) {
                    column.search(this.value).draw();
                }
            });
        }
    });
}


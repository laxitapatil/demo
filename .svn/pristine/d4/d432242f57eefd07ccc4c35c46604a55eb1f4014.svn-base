@{
    ViewData["Title"] = "Branch Master";
    var bankId = ViewBag.BankId;
}
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1">Bank Branch</h4>
                <p class="m-0 text-secondary">Organize your bank branch list</p>
            </div>
            <div class="page-title-right d-flex align-items-center gap-2">
                <button type="button" class="btn btn-primary" data-bs-target="#bankBranchModal" data-bs-toggle="modal"><i class="fi fi-rr-plus-small me-2"></i>Add Branch</button>
            </div>
            <div class="page-title-right d-flex align-items-center gap-2">
                <a href="/Bank/Index" class="btn btn-light"><i class="fi-rr-arrow-small-left me-2"></i>Back to Banks</a>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card">
            <div class="card-body">
                <div>
                    <table id="tblBankBranch" class="table table-hover align-middle">
                        <thead>
                            <tr class="bg-light">
                                <th class="text-center">Action</th>
                                <th>Sr. No.</th>
                                <th>Branch Name</th>
                                <th>Bank Vertical</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* @Html.Partial("~/Views/BankBranch/_Create.cshtml") *@

@section Scripts {
    <script> let bankId = '@bankId'; </script>
    <script src="~/js/bank-branch/bank-branch.js?@ViewData["jsVersion"]"></script>
    @* <script src="~/js/bank-branch/bank-branch-create.js?@ViewData["jsVersion"]"></script> *@
}
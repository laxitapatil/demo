const CaseTypeModule = (() => {

    const CASE_TYPE_API = "case-type";
    const CASE_TYPE_TABLE = "#tblCaseType";

    const $caseTypeTable = $(CASE_TYPE_TABLE);
    let dataTable = null;

    function caseTypeInit() {
        caseTypeGet();
    }

    function caseTypeGet() {
        callBaseGetAPI(`${CASE_TYPE_API}/get`, caseTypeFill, commonError);
    }

    function caseTypeFill(data) {

        if (!Array.isArray(data)) {
            errorToastr("Case Type data not found.");
            return;
        }

        if (dataTable) {
            dataTable.clear().rows.add(data).draw();
            return;
        }

        dataTable = setDataTable($caseTypeTable, {
            data: data,
            scrollY: '600px',
            scrollCollapse: false,
            autoWidth: false,
            columnDefs: [
                {
                    targets: 0, // Action
                    width: '80px',
                    orderable: false,
                    className: "dt-center"
                },
                {
                    targets: 1, // Sr No
                    width: '60px',
                    orderable: false,
                    className: "dt-left"
                },
                {
                    targets: 3, // Status
                    orderable: false,
                    width: '80px',
                    className: "dt-center"
                }
            ],
            columns: [
                // ACTION
                {
                    data: "id",
                    orderable: false,
                    render: id => `
                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <a href="javascript:void(0);"
                                class="link-info"
                                onclick="CaseTypeModule.caseTypeEdit(${id})"
                                title="Edit Branch">
                                <i class="fi fi-rr-pencil"></i>
                            </a>
                            <a href="javascript:void(0);"
                                class="link-danger"
                                onclick="CaseTypeModule.caseTypeDelete(${id})"
                                title="Delete Branch">
                                <i class="fi fi-rr-trash"></i>
                            </a>
                        </div>
                    `
                },

                // SR NO
                {
                    data: null,
                    render: (_, __, ___, meta) =>
                        meta.row + meta.settings._iDisplayStart + 1
                },

                // NAME
                {
                    data: "name"
                },

                // STATUS
                {
                    data: "is_active",
                    render: function (isActive, type, row) {
                        return `
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                    type="checkbox"
                                    ${isActive ? "checked" : ""}
                                    onchange="CaseTypeModule.caseTypeStatusUpdate(${row.id}, this)">
                            </div>
                        `;
                    }
                }
            ],
            initComplete: function () {
                applyColumnFilters(this.api(), {
                    noFilterColumns: [0 ,1 ,3]
                });
            }
        });
    }

    function caseTypeEdit(id) {
        callBaseGetAPI(`${CASE_TYPE_API}/${encodeURIComponent(id)}`,
            function (data) {
                CaseTypeCreateModule.caseTypeDataGet(data);
                CaseTypeCreateModule.openCaseTypeModal(id);
            },
            commonError
        );
    }

    function caseTypeDelete(id) {
        lov.genericDelete(id, CASE_TYPE_API, "Case Type", caseTypeGet);
    }
    function caseTypeStatusUpdate(id, checkBox) {
        lov.confirmStatusToggle(id, CASE_TYPE_API, checkBox, caseTypeGet);
    }

    return {
        caseTypeInit,
        caseTypeEdit,
        caseTypeDelete,
        caseTypeStatusUpdate
    };

})();

$(document).ready(function () {
    const roles = AuthModule.getRolesFromToken();
    if (!roles.includes("Admin")) {
        return;
    }
    CaseTypeModule.caseTypeInit();
});
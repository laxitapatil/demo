using Core.Domain;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.Data;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class CaseStatusMasRepository : BaseRepository
    {
        private readonly DBContext _dbContext;

        public CaseStatusMasRepository(DBContext dBContext) => _dbContext = dBContext;

        #region AutoGenerated

        public async Task<int> Insert(CaseStatusMas caseStatus)
        {
            await _dbContext.CaseStatusMas.AddAsync(caseStatus);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(CaseStatusMas caseStatus)
        {
            _dbContext.CaseStatusMas.Update(caseStatus);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(CaseStatusMas caseStatus)
        {
            _dbContext.CaseStatusMas.Remove(caseStatus);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<JsonNode?> SelectAll(short? id, bool? isActive)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_is_active", isActive);
            using NpgsqlConnection connection = new(connectionString);
            string? response = await connection.QueryFirstAsync<string>("SELECT case_status_mas_selectall(@_id, @_is_active)", parameter);

            return string.IsNullOrWhiteSpace(response) ? JsonNode.Parse("[]") : JsonNode.Parse(response);
        }

        public async Task<CaseStatusMas?> SelectOne(short id) =>
            await _dbContext.CaseStatusMas.Where(x => x.Id == id).FirstOrDefaultAsync();

        public async Task<List<SelectListResponse>> SelectName()
        {
            return await _dbContext.CaseStatusMas
                .Where(caseStatus => caseStatus.Is_active)
                .OrderBy(caseStatus => caseStatus.Name)
                .Select(caseStatus => new SelectListResponse
                {
                    id = caseStatus.Id,
                    name = caseStatus.Name
                })
                .ToListAsync();
        }
        #endregion AutoGenerated
    }
}
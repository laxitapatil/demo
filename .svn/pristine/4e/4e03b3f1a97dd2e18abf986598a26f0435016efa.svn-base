const PropertyTypeModule = (() => {

    const PROPERTY_TYPE_API = "property-type";
    const PROPERTY_TYPE_TABLE = "#tblPropertyType";

    const $propertyTypeTable = $(PROPERTY_TYPE_TABLE);
    let dataTable = null;

    function propertyTypeInit() {
        propertyTypeGet();
    }

    function propertyTypeGet() {
        callBaseGetAPI(`${PROPERTY_TYPE_API}/get`, propertyTypeFill, commonError);
    }

    function propertyTypeFill(data) {

        if (!Array.isArray(data)) {
            errorToastr("Property Type data not found.");
            return;
        }

        if (dataTable) {
            dataTable.clear().rows.add(data).draw();
            return;
        }

        dataTable = setDataTable($propertyTypeTable, {
            data: data,
            scrollY: '600px',
            scrollCollapse: false,
            autoWidth: false,
            columnDefs: [
                {
                    targets: 0, // Action
                    width: '80px',
                    orderable: false,
                    className: "dt-center"
                },
                {
                    targets: 1, // Sr No
                    width: '60px',
                    orderable: false,
                    className: "dt-left"
                },
                {
                    targets: 3, // Status
                    orderable: false,
                    width: '80px',
                    className: "dt-center"
                }
            ],
            columns: [
                // ACTION
                {
                    data: "id",
                    orderable: false,
                    render: id => `
                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <a href="javascript:void(0);"
                                class="link-info"
                                onclick="PropertyTypeModule.propertyTypeEdit(${id})"
                                title="Edit Branch">
                                <i class="fi fi-rr-pencil"></i>
                            </a>
                            <a href="javascript:void(0);"
                                class="link-danger"
                                onclick="PropertyTypeModule.propertyTypeDelete(${id})"
                                title="Delete Branch">
                                <i class="fi fi-rr-trash"></i>
                            </a>
                        </div>
                    `
                },

                // SR NO
                {
                    data: null,
                    render: (_, __, ___, meta) =>
                        meta.row + meta.settings._iDisplayStart + 1
                },

                // NAME
                {
                    data: "name"
                },

                // STATUS
                {
                    data: "is_active",
                    render: function (isActive, type, row) {
                        return `
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                    type="checkbox"
                                    ${isActive ? "checked" : ""}
                                    onchange="PropertyTypeModule.propertyTypeStatusUpdate(${row.id}, this)">
                            </div>
                        `;
                    }
                }
            ],
            initComplete: function () {
                applyColumnFilters(this.api(), {
                    noFilterColumns: [0 ,1 ,3]
                });
            }
        });
    }//case

    function propertyTypeEdit(id) {
        callBaseGetAPI(`${PROPERTY_TYPE_API}/${encodeURIComponent(id)}`,
            function (data) {
                PropertyTypeCreateModule.propertyTypeDataGet(data);
                PropertyTypeCreateModule.openPropertyTypeModal(id);
            },
            commonError
        );
    }

    function propertyTypeDelete(id) {
        lov.genericDelete(id, PROPERTY_TYPE_API, "Property Type", propertyTypeGet);
    }
    function propertyTypeStatusUpdate(id, checkBox) {
        lov.confirmStatusToggle(id, PROPERTY_TYPE_API, checkBox, propertyTypeGet);
    }

    return {
        propertyTypeInit,
        propertyTypeEdit,
        propertyTypeDelete,
        propertyTypeStatusUpdate
    };

})();

$(document).ready(function () {
    const roles = AuthModule.getRolesFromToken();
    if (!roles.includes("Admin")) {
        return;
    }
    PropertyTypeModule.propertyTypeInit();
});
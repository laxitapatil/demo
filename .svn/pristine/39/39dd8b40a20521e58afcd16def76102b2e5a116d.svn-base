using AutoMapper;
using Core.Enumeration;
using Infrastructure.Base;
using Microsoft.AspNetCore.Mvc;
using System.Security.Claims;

namespace Api.Controllers
{
    public class BaseController : ControllerBase
    {
        protected readonly IConfiguration configuration;
        protected readonly IMapper mapper;
        protected readonly DBContext dbContext;

        public BaseController(IConfiguration configuration, IMapper mapper, DBContext dbContext)
        {
            this.configuration = configuration;
            this.mapper = mapper;
            this.dbContext = dbContext;
        }

        protected string TokenId
        {
            get => (HttpContext.User.Identity as ClaimsIdentity).Claims.ToList().Where(claim => claim.Type == "Id").First().Value;
        }

        protected int TokenUserId
        {
            get => Convert.ToInt32((HttpContext.User.Identity as ClaimsIdentity).Claims.ToList().Where(claim => claim.Type == "UserId").First().Value);
        }

        protected string TokenName
        {
            get => (HttpContext.User.Identity as ClaimsIdentity).Claims.ToList().Where(claim => claim.Type == "Name").First().Value;
        }

        protected RoleType TokenRole
        {
            get => Enum.Parse<RoleType>((HttpContext.User.Identity as ClaimsIdentity).Claims.ToList().Where(claim => claim.Type == ClaimTypes.Role).First().Value);
        }

        //protected int? TokenCompanyId
        //{
        //    get
        //    {
        //        Claim companyId = (HttpContext.User.Identity as ClaimsIdentity).Claims.ToList().Where(claim => claim.Type == "CompanyId").FirstOrDefault();
        //        return companyId == null ? null : Convert.ToInt32(companyId.Value);
        //    }
        //}

        //protected int? TokenCompanyPincode
        //{
        //    get
        //    {
        //        Claim pincodeId = (HttpContext.User.Identity as ClaimsIdentity).Claims.ToList().Where(claim => claim.Type == "CompanyPincodeId").FirstOrDefault();
        //        return pincodeId == null ? null : Convert.ToInt32(pincodeId.Value);
        //    }
        //}

        protected DateTime CurrentTime { get => DateTime.Now; }

        protected string RemoteIpAddress
        {
            get => Request.HttpContext.Connection.RemoteIpAddress == null ? string.Empty : Request.HttpContext.Connection.RemoteIpAddress.ToString();
        }
    }
}
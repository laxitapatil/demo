const CaseModule = (() => {

    const CASE_API = "case";
    const CASE_TABLE = "#tblCase";

    const $caseTable = $(CASE_TABLE);
    let dataTable = null;

    function caseInit() {
        bindEvents();
        caseGet();
        initEditor();
    }

    function bindEvents() {

        // Refresh button
        $(".btn-light").click(function (e) {
            e.preventDefault();
            caseGet();
        });

        // Search
        $("#searchCase").on("keyup", function () {
            if (dataTable)
                dataTable.search(this.value).draw();
        });

        // Filters
        $("#customerFilter, #bankFilter, #assigneeFilter, #typeFilter, #statusFilter, #sortBy")
            .on("change", function () {
                caseGet();
            });
    }

    function getFilterRequest() {

        return {
            from_date: null, 
            to_date: null,

            bank_id: getSelectedId("#bankFilter"),
            status: getSelectedId("#statusFilter"),
            visitor_id: getSelectedId("#assigneeFilter"),
            reporter_id: null, 

            search_text: $("#searchCase").val() || null,

            id: null,
            case_id: null
        };
    }

    function getSelectedId(selector) {
        const val = $(selector).val();
        if (!val || isNaN(val)) return null;
        return parseInt(val);
    }

    function caseGet() {
        callBasePostAPI(`${CASE_API}/get-by-filter`,getFilterRequest(),caseFill,commonError);
    }

    function caseFill(data) {

        if (!Array.isArray(data)) {
            errorToastr("Case data not found.");
            return;
        }

        if (dataTable) {
            dataTable.clear().rows.add(data).draw();
            return;
        }

        dataTable = setDataTable($caseTable, {
            data: data,
            scrollY: '500px',
            scrollCollapse: false,
            columns: [
                {
                    data: "case_id",
                    orderable: false,
                    render: case_id => `
                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <a href="/client/edit/${case_id}" class="link-info">
                                <i class="fi fi-rr-pencil"></i>
                            </a>
                        </div>
                    `
                },

                // CASE ID
                {
                    data: null,
                    render: function (data, type, row) {
                        return `
                            <a href="/Case/Details/${row.case_id}" class="fw-medium">
                                ${row.id}
                            </a>
                        `;
                    }
                },
                //{
                //    data: "created_date",
                //    render: function (_, __, row) {
                //        return `
                //            <span class="editable" data-field="tblCaseDate" data-type="date">${ lov.formatDateForInput(row.created_date) }</span>
                //        `;
                //    }

                //},
                { data: "created_date", render: d => lov.formatDate(d) },
                {
                    data: "bank_name",
                    render: function (_, __, row) {
                        return `
                            <div>
                                <p class="fw-medium mb-1">${row.bank_name || "-"}</p>
                                <p class="text-secondary m-0">ID: ${row.bank_case_id || "-"}</p>
                            </div>
                        `;
                    }
                },

                { data: "case_type_name" },
                {
                    data: "customer_name",
                    render: function (_, __, row) {
                        return `
                            <div>
                                <span class="d-block mb-1 editable" data-field="tblCustomerName" data-type="text">${row.customer_name}</span>
                                <i class="fi fi-rr-phone-call me-2"></i><span class=" link-secondary m-0  editable" data-field="tblCustomerContactNo" data-type="tel">${row.customer_contact}</span>
                            </div>
                        `;
                    }
                },

                {
                    data: "property_summary"
                },

                {
                    data: null,
                    render: row => `
                        <div>
                            <span class="d-block editable mb-1" data-type="select"
                                data-field="tblVisitor"
                                data-source="user?role=Visitor"
                                data-value="${row.visitor_id}">
                                ${row.visitor_name || "-"}
                            </span>
                            <span class="d-block editable" data-type="select"
                                data-field="tblReportMaker"
                                data-source="user?role=Report Maker"
                                data-value="${row.report_maker_id}">
                                ${row.report_maker_name || "-"}
                            </span>
                        </div>
                    `
                },
                { data: "visit_date", render: d => lov.formatDate(d) },
                {
                    data: "case_status_name",
                    render: function (status) {
                        return `<label class="badge bg-primary">${status}</label>`;
                    }
                },
                { data: "submit_date", render: d => lov.formatDate(d) },
                { data: "bill_date", render: d => lov.formatMonthYear(d) },
                { data: "fees" },
                { data: "modified_date", render: d => lov.formatDate(d) },
            ],
             initComplete: function () {
                applyColumnFilters(this.api(), {
                    noFilterColumns: [0,1, 3, 7, 10, 14],
                    selectFilterColumns: [4]
                });
            }
        });
    }

    function initEditor() {
        $('#tblCase').inlineEditor({
            save: function (data) {

                const caseId = data.row.find('td:eq(2)').text();

                console.log({
                    caseId,
                    field: data.field,
                    value: data.newValue,
                    text: data.displayText ?? data.newValue
                });

                // AJAX save
                /*
                $.post('/Cases/UpdateField', {
                    id: caseId,
                    field: data.field,
                    value: data.newValue
                });
                */
            }
        });

    }

    
    function caseDelete(caseId) {
        lov.genericDelete(caseId, CASE_API, "Case", caseGet);
    }

    function updateStatus(caseId, statusId) {
        callBasePutAPI(
            `${CASE_API}/update-status?caseId=${caseId}&satusId=${statusId}`,
            null,
            function () {
                successToastr("Status updated successfully.");
                caseGet();
            },
            commonError
        );
    }

    return {
        caseInit,
        caseDelete,
        updateStatus,
    };

})();

$(document).ready(CaseModule.caseInit);
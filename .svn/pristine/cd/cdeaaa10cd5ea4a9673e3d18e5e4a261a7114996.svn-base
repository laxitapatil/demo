@{
    Layout = null;
}

<div id="caseStatusModal" class="modal" tabindex="-1" role="dialog" aria-labelledby="caseStatusModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-1"> Update status </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="caseStatusForm" method="post">
                    <input type="hidden" id="caseId" name="caseId" />
                    <div class="row gy-3">
                        <div class="col-md-6">
                            <p class="mb-1">Case ID:</p>
                            <p class="mb-0 fw-bold text-primary" id="caseNo"></p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1">Customer Name:</p>
                            <p class="mb-0 fw-bold text-primary" id="customerName"></p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1">Case Status:</p>
                            <label class="badge badge-new m-0 font-size-14" id="currentStatus"></label>
                        </div>
                        <div class="col-md-6">
                            <label for="caseNextStatusId">Next Status:</label>
                            <select class="form-control select2" id="caseNextStatusId" name="caseNextStatusId">
                            </select>
                        </div>

                        <div class="col-md-6 d-none" id="visitorContainer">
                            <label>Visitor:</label>
                            <select class="form-control select2" id="visitorId" name="visitorId"></select>
                        </div>

                        <div class="col-md-6 d-none" id="reportMakerContainer">
                            <label>Report Maker:</label>
                            <select class="form-control select2" id="reportMakerId" name="reportMakerId"></select>
                        </div>

                        <div class="col-lg-12">
                            <label for="caseStatusNote">Note</label>
                            <textarea class="form-control" id="caseStatusNote" name="caseStatusNote" rows="3" placeholder="Note" maxlength="512"></textarea>
                        </div>
                        <div class="col-lg-12 d-flex justify-content-between align-items-center">
                            <div>
                                <button type="submit" class="btn btn-primary" id="saveStatusBtn"><i class="fi fi-rr-disk me-2"></i>Save</button>
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="fi fi-rr-cross-circle me-2"></i>Cancel</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

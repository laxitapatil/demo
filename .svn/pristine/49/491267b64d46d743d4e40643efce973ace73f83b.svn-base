const CaseModule = (() => {

    const CASE_API = "case";
    const CASE_TABLE = "#tblCase";

    const $caseTable = $(CASE_TABLE);
    let dataTable = null;

    function caseInit() {
        bindEvents();
        caseGet();
    }

    function bindEvents() {

        // Refresh button
        $(".btn-light").click(function (e) {
            e.preventDefault();
            caseGet();
        });

        // Search
        $("#searchCase").on("keyup", function () {
            if (dataTable)
                dataTable.search(this.value).draw();
        });

        // Filters
        $("#customerFilter, #bankFilter, #assigneeFilter, #typeFilter, #statusFilter, #sortBy")
            .on("change", function () {
                caseGet();
            });
    }

    function getFilterRequest() {

        return {
            from_date: null, 
            to_date: null,

            bank_id: getSelectedId("#bankFilter"),
            status: getSelectedId("#statusFilter"),
            visitor_id: getSelectedId("#assigneeFilter"),
            reporter_id: null, 

            search_text: $("#searchCase").val() || null,

            id: null,
            case_id: null
        };
    }

    function getSelectedId(selector) {
        const val = $(selector).val();
        if (!val || isNaN(val)) return null;
        return parseInt(val);
    }

    function caseGet() {
        callBasePostAPI(
            `${CASE_API}/get-by-filter`,
            getFilterRequest(),
            caseFill,
            commonError
        );
    }

    function caseFill(data) {

        if (!Array.isArray(data)) {
            errorToastr("Case data not found.");
            return;
        }

        if (dataTable) {
            dataTable.clear().rows.add(data).draw();
            return;
        }

        dataTable = setDataTable($caseTable, {
            data: data,
            scrollY: '500px',
            scrollCollapse: false,
            autoWidth: false,
            columnDefs: [
                { targets: 0, orderable: false, width: '60px', className: "dt-center" }
            ],
            columns: [

                // ACTION
                {
                    data: "case_id",
                    render: function (caseId, type, row) {
                        return `
                        <div class="dropdown text-center">
                            <a href="javascript:void(0)" class="link-secondary" data-bs-toggle="dropdown">
                                <i class="fi fi-rr-menu-dots"></i>
                            </a>
                            <ul class="dropdown-menu shadow-sm">
                                <li>
                                    <a class="dropdown-item"
                                       href="/Case/Details/${caseId}">
                                       <i class="fi fi-rr-eye me-2"></i>View
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       href="/Case/Edit/${caseId}">
                                       <i class="fi fi-rr-edit me-2"></i>Edit
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-danger"
                                       href="javascript:void(0)"
                                       onclick="CaseModule.caseDelete('${caseId}')">
                                       <i class="fi fi-rr-trash me-2"></i>Delete
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       href="javascript:void(0)"
                                       onclick="CaseModule.updateStatus('${caseId}', 5)">
                                       Mark as Hold
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       href="javascript:void(0)"
                                       onclick="CaseModule.updateStatus('${caseId}', 6)">
                                       Mark as Cancelled
                                    </a>
                                </li>
                            </ul>
                        </div>
                        `;
                    }
                },

                // SR NO
                {
                    data: null,
                    render: (_, __, ___, meta) =>
                        meta.row + meta.settings._iDisplayStart + 1
                },

                // CASE ID
                {
                    data: "case_id",
                    render: caseId =>
                        `<a href="/Case/Details/${caseId}" class="fw-medium">${caseId}</a>`
                },

                { data: "created_date" },

                {
                    data: "bank_name",
                    render: function (_, __, row) {
                        return `
                            <div>
                                <p class="fw-medium mb-1">${row.bank_name || "-"}</p>
                                <p class="text-secondary m-0">ID: ${row.bank_case_id || "-"}</p>
                            </div>
                        `;
                    }
                },

                { data: "case_type_name" },
                { data: "customer_name" },

                {
                    data: "property_summary"
                },

                {
                    data: null,
                    render: row => `
                        <div>
                            <p class="fw-medium mb-1">${row.visitor_name || "-"}</p>
                            <p class="fw-medium mb-0">${row.report_maker_name || "-"}</p>
                        </div>
                    `
                },

                {
                    data: "case_status_name",
                    render: function (status) {
                        return `<label class="badge bg-primary">${status}</label>`;
                    }
                },

                { data: "modified_date" },
                { data: "bill_date" },
                { data: "fees" }
            ]
        });
    }

    function caseDelete(caseId) {
        lov.genericDelete(caseId, CASE_API, "Case", caseGet);
    }

    function updateStatus(caseId, statusId) {
        callBasePutAPI(
            `${CASE_API}/update-status?caseId=${caseId}&satusId=${statusId}`,
            null,
            function () {
                successToastr("Status updated successfully.");
                caseGet();
            },
            commonError
        );
    }

    return {
        caseInit,
        caseDelete,
        updateStatus
    };

})();

$(document).ready(CaseModule.caseInit);
const CaseCreateModule = (() => {

    const CASE_API = "case";
    const $caseForm = $("#caseForm");

    let caseId = null;
    let caseUID = null;
    let isEditMode = false;
    let caseValidator = null;

    let properties = [];
    let propertyEditId = null;

    function caseCreateInit() {

        if (!$caseForm.length) return;

        loadDropdowns(() => detectEditMode());

        caseFormValidation();
        bindEvents();

        if (!isEditMode) {
            setDefaultDate();
        }
    }
    function bindEvents() {

        $("#btnSaveCase").on("click", caseSave);
        $("#btnSaveAddNewCase").on("click", caseSaveAddNew);
        $("#btnSaveProperty").on("click", saveProperty);

        $("#btnAddProperty").on("click", function () {
            resetPropertyForm();
        });

        $(document).on("click", ".btn-edit-property", function () {

            const propertyId = $(this).data("id");
            openPropertyModal(propertyId);

        });

        $(document).on("click", ".property-select", function () {

            $(".property-item").removeClass("active");
            $(this).closest(".property-item").addClass("active");

            const propertyId = $(this).closest(".property-item").data("id");

            loadProperty(propertyId);
        });
    }
    function loadDropdowns(callback) {

        lov.populateDropdown("case-type/name", "#caseCreateType", "Select");
        lov.populateDropdown("state/name", "#caseCreateState", "Select");
        lov.populateDropdown("bank/name", "#caseCreateBank", "Select");
        lov.populateDropdown("bank-branch/name", "#caseCreateBankBranch", "Select");
        lov.populateDropdown("bank-vertical/name", "#caseCreatebankDept", "Select");

        lov.populateUserDropdown("user?role=Visitor", "#caseCreateVisitor", "Select");
        lov.populateUserDropdown("user?role=Report Maker", "#caseCreateReportMaker", "Select");

        lov.populateDropdown("case-property/property-type", "#caseCreatepropertyType", "Select");

        if (callback) callback();
    }

    function loadProperty(propertyId) {

        const property = properties.find(p => p.id == propertyId);

        if (!property) return;

        $("#propertyTitle").text(property.name);
        $("#propertyName").val(property.name);
        $("#propertyAddress").val(property.address);
        $("#caseCreatepropertyType").val(property.property_type).trigger("change");
    }

    function openPropertyModal(propertyId) {

        const property = properties.find(p => p.id == propertyId);

        if (!property) return;

        propertyEditId = property.id;

        $("#propertyName").val(property.name);
        $("#propertyAddress").val(property.address);
        $("#caseCreatepropertyType").val(property.property_type).trigger("change");

        $("#propertyDistance").val(property.distance);
        $("#propertySize").val(property.size_sqft);

        const modal = new bootstrap.Modal(document.getElementById("propertyModal"));
        modal.show();
    }

    function saveProperty() {

        if (!caseUID) {
            errorToastr("Save case first before adding property");
            return;
        }

        const data = {

            id: propertyEditId,
            case_id: caseId,

            property_type: parseValue("#caseCreatepropertyType"),
            name: $("#propertyName").val()?.trim(),
            distance: $("#propertyDistance").val() || null,
            size_sqft: $("#propertySize").val() || null,
            address: $("#propertyAddress").val()?.trim(),

            city: $("#propertyCity").val(),
            state_id: parseValue("#caseCreateState"),
            pincode: $("#propertyPincode").val(),
            is_final: false,
            note: $("#propertyNote").val()?.trim()
        };

        if (propertyEditId) {

            callBasePutAPI(
                "case-property",
                data,
                propertyUpdateSuccess,
                commonError
            );

        } else {

            callBasePostAPI(
                "case-property",
                data,
                propertyInsertSuccess,
                commonError
            );
        }
    }

    function propertyInsertSuccess(response) {

        successToastr("Property added");

        properties.push(response);

        renderProperties();

        resetPropertyForm();

        bootstrap.Modal.getInstance(document.getElementById("propertyModal")).hide();
    }
    function propertyUpdateSuccess(response) {

        successToastr("Property updated");

        const index = properties.findIndex(p => p.id == response.id);

        if (index !== -1) {
            properties[index] = response;
        }

        renderProperties();

        resetPropertyForm();

        bootstrap.Modal.getInstance(document.getElementById("propertyModal")).hide();
    }

    function resetPropertyForm() {

        propertyEditId = null;

        $("#propertyName").val("");
        $("#propertyAddress").val("");
        $("#propertyDistance").val("");
        $("#propertySize").val("");
        $("#propertyNote").val("");

        $("#caseCreatepropertyType").val("").trigger("change");
    }

    function loadProperties(response) {

        if (!response || !response.properties) return;

        properties = response.properties;

        renderProperties();
    }

    function renderProperties() {

        const container = $("#propertyList");

        container.empty();

        if (!properties.length) return;

        let html = "";

        properties.forEach((p, index) => {

            html += `
            <li class="property-item ${index === 0 ? "active" : ""}" data-id="${p.id}">

                <a href="javascript:void(0);" class="property-select">
                    Property ${index + 1}
                </a>

                <button class="btn btn-sm btn-light btn-edit-property" data-id="${p.id}">
                    <i class="fi fi-rr-pencil"></i>
                </button>

            </li>`;
        });

        container.html(html);

        if (properties.length) {
            loadProperty(properties[0].id);
        }
    }

    function detectEditMode() {

        const segments = window.location.pathname
            .toLowerCase()
            .split("/")
            .filter(Boolean);

        if (segments.length === 3 &&
            segments[0] === "case" &&
            segments[1] === "edit") {

            const uid = segments[2];

            if (uid) {

                isEditMode = true;
                caseUID = uid;

                loadCaseDetails(uid);

                $("#btnSaveCase").text("Update");
                $(".page-title-box h4.mb-1").text("Edit Case");
            }
        }
    }

    function loadCaseDetails(uid) {

        callBaseGetAPI(
            `${CASE_API}/${uid}`,
            fillCaseForm,
            commonError
        );

        callBaseGetAPI(
            `${CASE_API}/case-details/${uid}`,
            loadProperties,
            commonError
        );
    }

    function fillCaseForm(data) {

        if (!data) return;

        caseId = data.id;
        caseUID = data.case_id;

        $("#caseID").val(data.id || "");
        $("#caseDate").val(data.bill_date || "");

        $("#caseCreateType").val(data.case_type).trigger("change");
        $("#caseCreateBank").val(data.bank_id).trigger("change");
        $("#caseCreateBankBranch").val(data.bank_branch_id).trigger("change");
        $("#caseCreatebankDept").val(data.bank_vertical_id).trigger("change");

        $("#caseCreateVisitor").val(data.visitor_id).trigger("change");
        $("#caseCreateReportMaker").val(data.report_maker_id).trigger("change");

        $("#bankCaseId").val(data.bank_case_id || "");

        $("#custName").val(data.customer_name || "");
        $("#custContactNo").val(data.customer_contact || "");

        if (data.priority === 1) $("#highPriority").prop("checked", true);
        else if (data.priority === 2) $("#mediumPriority").prop("checked", true);
        else $("#lowPriority").prop("checked", true);
    }

    function setDefaultDate() {

        const today = new Date().toISOString().split("T")[0];
        $("#caseDate").val(today);
    }

    function caseFormValidation() {

        caseValidator = $caseForm.validate({

            errorElement: "span",

            rules: {
                caseCreateType: { required: true },
                caseCreateBank: { required: true }
            },

            errorPlacement: function (error, element) {

                error.addClass("text-danger");
                error.insertAfter(element);
            }
        });
    }

    function caseSave(e) {

        e.preventDefault();

        if (!caseValidator.form()) return;

        const data = getFormData();

        if (isEditMode) {

            callBasePutAPI(
                CASE_API,
                data,
                updateSuccess,
                commonError
            );

        } else {

            callBasePostAPI(
                CASE_API,
                data,
                insertSuccess,
                commonError
            );
        }
    }

    function caseSaveAddNew(e) {

        e.preventDefault();

        if (!caseValidator.form()) return;

        callBasePostAPI(
            CASE_API,
            getFormData(),
            () => {
                successToastr("Case created successfully");
                resetForm();
            },
            commonError
        );
    }


    function getFormData() {

        return {

            id: caseId,
            case_id: caseUID,

            case_type: parseValue("#caseCreateType"),
            priority: getPriorityValue(),
            case_status_id: 1,

            bank_id: parseValue("#caseCreateBank"),
            bank_branch_id: parseValue("#caseCreateBankBranch"),
            bank_vertical_id: parseValue("#caseCreatebankDept"),

            visitor_id: parseValue("#caseCreateVisitor"),
            report_maker_id: parseValue("#caseCreateReportMaker"),

            bank_case_id: $("#bankCaseId").val()?.trim() || null,

            customer_name: $("#custName").val()?.trim() || null,
            customer_contact: $("#custContactNo").val()?.trim() || null,

            //property_name: !isEditMode ? $("#propertyName").val()?.trim() || null : null,
            //property_address: !isEditMode ? $("#propertyAddress").val()?.trim() || null : null,
            //property_type: !isEditMode ? parseValue("#caseCreatepropertyType") : null,

            bill_date: $("#caseDate").val() || null
        };
    }

    function parseValue(selector) {

        const val = $(selector).val();
        return val ? parseInt(val) : null;
    }

    function getPriorityValue() {

        if ($("#highPriority").is(":checked")) return 1;
        if ($("#mediumPriority").is(":checked")) return 2;
        if ($("#lowPriority").is(":checked")) return 3;

        return 2;
    }


    function insertSuccess(response) {

        successToastr("Case created successfully");

        if (response && response.case_id) {
            caseUID = response.case_id;
        }

        window.location.href = "/case";
    }

    function updateSuccess() {

        successToastr("Case updated successfully");
        window.location.href = "/case";
    }

    function resetForm() {

        $caseForm[0].reset();

        caseId = null;
        caseUID = null;
        isEditMode = false;

        if (caseValidator) {
            caseValidator.resetForm();
        }

        setDefaultDate();
    }

    return {
        caseCreateInit
    };

})();

$(document).ready(CaseCreateModule.caseCreateInit);
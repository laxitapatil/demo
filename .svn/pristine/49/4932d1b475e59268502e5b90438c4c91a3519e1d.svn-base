        /// <summary>
        /// Create Case with document
        /// </summary>
        /// <param name="request">Case details</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPost("create-with-documents")]
        public async Task<IActionResult> CreateWithDocuments([FromForm] CaseWithDocumentRequest request)
        {
            using var transaction = await dbContext.Database.BeginTransactionAsync();
            var uploadedFiles = new List<string>();

            try
            {
                using var caseRepo = new CaseRepository(dbContext);

                // first case will create
                var caseEntity = mapper.Map<Case>(request);

                caseEntity.Case_id = Guid.NewGuid().ToString("N");
                caseEntity.Priority = (short)CasePriority.Medium;
                caseEntity.Case_status_id = request.Visitor_id.HasValue
                    ? (short)CaseStatusEnum.SiteVisit
                    : (short)CaseStatusEnum.New;

                caseEntity.Bill_date = request.Bill_date ?? CurrentTime;
                caseEntity.Created_by = TokenName;
                caseEntity.Created_date = CurrentTime;

                int caseResult = await caseRepo.Insert(caseEntity);

                if (caseResult <= 0)
                {
                    await transaction.RollbackAsync();
                    return Problem(string.Format(MessageProvider.INSERT_FAILED, CASE),
                        statusCode: StatusCodes.Status500InternalServerError);
                }

                // after that, property will create
                int propertyId = 0;

                if (!string.IsNullOrWhiteSpace(request.Property_address) && request.Property_type.HasValue)
                {
                    using var propertyRepo = new CasePropertyRepository(dbContext);

                    var property = new CaseProperty
                    {
                        Case_id = caseEntity.Id,
                        Property_type_id = request.Property_type.Value,
                        Name = request.Property_name ?? "Property",
                        Address = request.Property_address.Trim(),
                        Note = request.Property_notes,
                        Is_final = false,
                        Created_by = TokenName,
                        Created_date = CurrentTime
                    };

                    propertyId = await propertyRepo.Insert(property);
                }

                // storing status info in case status log
                using (var statusLogRepo = new CaseStatusLogRepository(dbContext))
                {
                    await statusLogRepo.Insert(new CaseStatusLog
                    {
                        Case_id = caseEntity.Id,
                        Case_status_id = caseEntity.Case_status_id,
                        Remark = request.Visitor_id.HasValue ? "Visitor Assigned." : "Created new case.",
                        Last_modified_by = TokenName,
                        Last_modified_date = CurrentTime
                    });
                }

                // fetching bank code
                using var bankRepo = new BankRepository(dbContext);

                string? bankCode = await bankRepo.SelectBankCode(caseEntity.Bank_id);
                if (string.IsNullOrWhiteSpace(bankCode))
                {
                    await transaction.RollbackAsync();
                    return Problem("Bank Code not found", statusCode: 400);
                }

                // collect files
                var files = new List<IFormFile>();

                if (request.Files?.Any() == true)
                    files.AddRange(request.Files);

                if (request.File_path?.Any() == true)
                    files.AddRange(request.File_path);

                if (!files.Any() && Request.Form?.Files?.Count > 0)
                    files.AddRange(Request.Form.Files);

                if (!files.Any())
                    return BadRequest("No files received.");

                // process files
                // process files
                var documents = new List<CaseDocument>();

                int uploadedCount = 0;
                int skippedCount = 0;
                List<string> errors = new();

                foreach (var file in files)
                {
                    var fileName = file.FileName;

                    if (string.IsNullOrWhiteSpace(fileName) || fileName == "blob")
                    {
                        fileName = $"IMG_{Guid.NewGuid()}.jpg";
                    }

                    var validation = ValidateFile(file);

                    if (!validation.isValid)
                    {
                        skippedCount++;
                        errors.Add($"{file.FileName}: {validation.errorMessage}");
                        continue; 
                    }

                    try
                    {
                        string uploadedPath = await _fileUpload.UploadCaseDocument(
                            file,
                            caseEntity.Id,
                            bankCode,
                            caseEntity.Created_date
                        );

                        if (uploadedPath.Length > MAX_FILE_PATH_LENGTH)
                        {
                            await _fileUpload.DeleteCaseDocument(uploadedPath);

                            skippedCount++;
                            errors.Add($"{file.FileName}: {validation.errorMessage}");
                            continue;
                        }

                        uploadedFiles.Add(uploadedPath);

                        documents.Add(new CaseDocument
                        {
                            Case_id = caseEntity.Id,
                            Property_id = propertyId,
                            Title = Path.GetFileNameWithoutExtension(fileName),
                            Doc_type = (short)request.Doc_type,
                            File_path = uploadedPath,
                            Created_by = TokenName,
                            Created_date = CurrentTime
                        });

                        uploadedCount++;
                    }
                    catch
                    {
                        skippedCount++;
                        errors.Add($"{file.FileName}: Upload failed");
                    }
                }
                if (!documents.Any())
                {
                    await transaction.CommitAsync();

                    var response = mapper.Map<CaseResponse>(caseEntity);

                    return Ok(new
                    {
                        caseData = response,
                        uploaded = 0,
                        skipped = skippedCount,
                        errors = errors
                    });
                }

                // save documents
                using var docRepo = new CaseDocumentRepository(dbContext);
                await docRepo.InsertBulk(documents);

                await transaction.CommitAsync();

                var responseFinal = mapper.Map<CaseResponse>(caseEntity);

                return Ok(new
                {
                    caseData = responseFinal,
                    uploaded = uploadedCount,
                    skipped = skippedCount,
                    errors = errors
                });
            }
            catch (Exception ex)
            {
                await transaction.RollbackAsync();

                foreach (var file in uploadedFiles)
                    await _fileUpload.DeleteCaseDocument(file);

                string error = ex.ToString().ToLower();

                if (error.Contains("uk_case_case_uid"))
                    return Problem(string.Format(MessageProvider.ALREADY_EXISTS, CASE), statusCode: 400);

                if (error.Contains("fk_case_bank"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK), statusCode: 400);

                if (error.Contains("fk_case_bank_branch"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_BRANCH), statusCode: 400);

                if (error.Contains("fk_case_bank_vertical"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_VERTICAL), statusCode: 400);

                if (error.Contains("fk_case_case_type"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_TYPE), statusCode: 400);

                if (error.Contains("fk_case_status"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_STATUS), statusCode: 400);

                if (error.Contains("fk_case_visitor"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, VISITOR_ID), statusCode: 400);

                if (error.Contains("fk_case_report_maker"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, REPORT_MAKER), statusCode: 400);

                return Problem(ex.Message, statusCode: 500);
            }
        }
       
        #region private method
        private IActionResult? UpdateCaseStatus(Case caseEntity, CaseStatusEnum newStatus)
        {
            var currentStatus = (CaseStatusEnum)caseEntity.Case_status_id;

            // Role based Restriction
            if (!TokenRole.Contains(RoleType.Admin))
            {
                var allowedStatuses = new List<CaseStatusEnum>();

                if (TokenRole.Contains(RoleType.Visitor))
                {
                    allowedStatuses.Add(CaseStatusEnum.ReportInProgress);
                    allowedStatuses.Add(CaseStatusEnum.Query);
                }

                if (TokenRole.Contains(RoleType.ReportMaker))
                {
                    allowedStatuses.Add(CaseStatusEnum.UnderReview);
                    allowedStatuses.Add(CaseStatusEnum.SiteVisit);
                    allowedStatuses.Add(CaseStatusEnum.Query);
                }

                if (!allowedStatuses.Contains(newStatus))
                {
                    return Problem($"You are not allowed to change status to '{newStatus}'.",
                        statusCode: StatusCodes.Status403Forbidden);
                }
            }

            // Allow reopening completed case
            if (currentStatus == CaseStatusEnum.Completed && newStatus == CaseStatusEnum.UnderReview)
            {
                caseEntity.Case_status_id = (short)newStatus;
                return null;
            }
            // If case is completed or cancelled then no further changes allowed
            //if (currentStatus == CaseStatusEnum.Completed || currentStatus == CaseStatusEnum.Cancelled)
            //{
            //    return Problem($"The case cannot be updated because it is '{currentStatus}'.", statusCode: StatusCodes.Status400BadRequest);
            //}

            if (newStatus == CaseStatusEnum.Cancelled || newStatus == CaseStatusEnum.Completed || newStatus == CaseStatusEnum.Hold || newStatus == CaseStatusEnum.Query)
            {
                caseEntity.Case_status_id = (short)newStatus;
                return null;
            }

            // If case is on Hold then allow any next status
            if (currentStatus == CaseStatusEnum.Hold)
            {
                caseEntity.Case_status_id = (short)newStatus;
                return null;
            }

            switch (currentStatus)
            {
                case CaseStatusEnum.New:
                    if (newStatus == CaseStatusEnum.SiteVisit)
                    {
                        caseEntity.Case_status_id = (short)newStatus;
                        return null;
                    }
                    break;

                case CaseStatusEnum.SiteVisit:
                    if (newStatus == CaseStatusEnum.ReportInProgress)
                    {
                        caseEntity.Case_status_id = (short)newStatus;
                        return null;
                    }
                    break;

                case CaseStatusEnum.ReportInProgress:
                    if (newStatus == CaseStatusEnum.UnderReview || newStatus == CaseStatusEnum.SiteVisit)
                    {
                        caseEntity.Case_status_id = (short)newStatus;
                        return null;
                    }
                    break;

                case CaseStatusEnum.UnderReview:

                    // Approve report
                    if (newStatus == CaseStatusEnum.Completed)
                    {
                        caseEntity.Case_status_id = (short)newStatus;
                        return null;
                    }

                    // Send back for correction
                    if (newStatus == CaseStatusEnum.ReportInProgress)
                    {
                        caseEntity.Case_status_id = (short)newStatus;
                        caseEntity.Submit_date = null;
                        return null;
                    }

                    if (newStatus == CaseStatusEnum.Query)
                    {
                        caseEntity.Case_status_id = (short)newStatus;
                        return null;
                    }

                    break;

                case CaseStatusEnum.Query:

                    // Back to working
                    if (newStatus == CaseStatusEnum.ReportInProgress)
                    {
                        caseEntity.Case_status_id = (short)newStatus;
                        return null;
                    }

                    // Optional: direct review again
                    if (newStatus == CaseStatusEnum.UnderReview)
                    {
                        caseEntity.Case_status_id = (short)newStatus;
                        return null;
                    }

                    break;
            }

            return Problem($"Invalid case status transition from '{currentStatus}' to '{newStatus}'.", statusCode: StatusCodes.Status400BadRequest);
        }

        private (bool isValid, string errorMessage) ValidateFile(IFormFile file)
        {
            if (file == null || file.Length == 0)
                return (false, "File is required.");

            string extension = Path.GetExtension(file.FileName).ToLower();

            string[] allowedExtensions =
            { ".jpg", ".jpeg", ".png", ".avif", ".heic", ".webp", ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".csv", ".mp3", ".wav", ".m4a"};

            if (!allowedExtensions.Contains(extension))
                return (false, "File type is not allowed.");

            long fileSize = file.Length;

            if (new[] { ".jpg", ".jpeg", ".png", ".avif", ".webp", ".heic" }.Contains(extension))
            {
                if (fileSize > 10 * 1024 * 1024)
                    return (false, "Image size cannot exceed 10 MB.");
            }
            else
            {
                if (fileSize > 25 * 1024 * 1024)
                    return (false, "Document size cannot exceed 25 MB.");
            }

            return (true, "");
        }
        #endregion

    }
}
using Core.Domain;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class CaseRepository : BaseRepository
    {
        public CaseRepository(DBContext dbContext) : base(dbContext) { }


        #region CRUD

        public async Task<int> Insert(Case caseEntity)
        {
            await dbContext.Set<Case>().AddAsync(caseEntity);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(Case caseEntity)
        {
            dbContext.Set<Case>().Update(caseEntity);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(Case caseEntity)
        {
            dbContext.Set<Case>().Remove(caseEntity);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<Case?> SelectOne(int id)
        {
            return await dbContext.Set<Case>()
                .Where(x => x.Id == id)
                .FirstOrDefaultAsync();
        }

        public async Task<Case?> SelectByCaseId(string caseId)
        {
            return await dbContext.Set<Case>()
                .Where(x => x.Case_id == caseId)
                .FirstOrDefaultAsync();
        }

        public async Task<Case?> SelectByCaseNo(string caseNo)
        {
            return await dbContext.Set<Case>()
                .Where(x => x.Case_no == caseNo)
                .FirstOrDefaultAsync();
        }

        public async Task<JsonNode?> SelectAll(
            int? id,
            string? caseId,
            string? caseNo,
            int? caseType,
            short? priority,
            int? caseStatusId,
            int? bankId,
            int? assignTo
            )
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_case_id", caseId);
            parameter.Add("_case_no", caseNo);
            parameter.Add("_case_type", caseType);
            parameter.Add("_priority", priority);
            parameter.Add("_case_status_id", caseStatusId);
            parameter.Add("_bank_id", bankId);
            parameter.Add("_assign_to", assignTo);

            string? response = await connection.QueryFirstAsync<string>(
                @"SELECT public.case_selectall(
                    @_id, 
                    @_case_id, 
                    @_case_no, 
                    @_case_type, 
                    @_priority, 
                    @_case_status_id, 
                    @_bank_id, 
                    @_assign_to)",
                parameter
            );

            return string.IsNullOrWhiteSpace(response)
                ? JsonNode.Parse("[]")
                : JsonNode.Parse(response);
        }
        #endregion

        #region Dropdown list

        public async Task<List<SelectListResponse>> SelectCaseDropdown()
        {
            return await dbContext.Set<Case>()
                .OrderByDescending(x => x.Created_date)
                .Select(x => new SelectListResponse
                {
                    id = (short)x.Id,
                    name = x.Case_no
                })
                .ToListAsync();
        }

        #endregion
    }
}
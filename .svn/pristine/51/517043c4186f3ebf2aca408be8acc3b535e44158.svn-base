using Core.Domain;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.Data;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class PropertyTypeMasRepository : BaseRepository
    {
        public PropertyTypeMasRepository(DBContext dbContext) : base(dbContext) { }


        #region AutoGenerated

        public async Task<int> Insert(PropertyTypeMas propertyTypeMas)
        {
            await dbContext.PropertyTypeMas.AddAsync(propertyTypeMas);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(PropertyTypeMas propertyTypeMas)
        {
            dbContext.PropertyTypeMas.Update(propertyTypeMas);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(PropertyTypeMas propertyTypeMas)
        {
            dbContext.PropertyTypeMas.Remove(propertyTypeMas);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<JsonNode?> SelectAll(short? id, bool? isActive)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_is_active", isActive);
            string? response = await connection.QueryFirstAsync<string>("SELECT property_type_mas_selectall(@_id, @_is_active)", parameter);
            return string.IsNullOrWhiteSpace(response) ? JsonNode.Parse("[]") : JsonNode.Parse(response);
        }

        public async Task<PropertyTypeMas?> SelectOne(short id) =>
            await dbContext.PropertyTypeMas.Where(x => x.Id == id).FirstOrDefaultAsync();

        public async Task<List<SelectListResponse>> SelectName()
        {
            return await dbContext.PropertyTypeMas
                .Where(propertyType => propertyType.Is_active)
                .OrderBy(propertyType => propertyType.Name)
                .Select(propertyType => new SelectListResponse
                {
                    id = propertyType.Id,
                    name = propertyType.Name
                })
                .ToListAsync();
        }

        #endregion AutoGenerated

    }
}
const CaseCreateModule = (() => {

    const CASE_API = "case";
    const $caseForm = $("#caseForm");

    let caseId = null;
    let caseUID = null;
    let isEditMode = false;
    let caseValidator = null;

    function caseCreateInit() {

        caseFormValidation();

        $("#btnSaveCase").on("click", caseSave);
        $("#btnSaveAddNewCase").on("click", caseSaveAddNew);

        setDefaultDate();
    }

    function setDefaultDate() {

        const today = new Date().toISOString().split("T")[0];
        $("#caseDate").val(today);
    }

    function resetForm() {

        $caseForm[0].reset();

        caseId = null;
        caseUID = null;
        isEditMode = false;

        if (caseValidator) {
            caseValidator.resetForm();
            $(".is-invalid").removeClass("is-invalid");
        }
    }

    function caseFormValidation() {

        caseValidator = $caseForm.validate({
            errorElement: "span",
            rules: {
                caseType: { required: true },
                bank: { required: true },
                propertyName: { required: true },
                propertyAddress: { required: true }
            },
            messages: {
                caseType: "Please select Case Type",
                bank: "Please select Bank",
                propertyName: "Please enter Property Name",
                propertyAddress: "Please enter Property Address"
            },
            errorPlacement: function (error, element) {
                error.insertAfter(element);
                error.addClass("text-danger");
            }
        });
    }

    function getPriorityValue() {

        if ($("#highPriority").is(":checked")) return 1;
        if ($("#mediumPriority").is(":checked")) return 2;
        if ($("#lowPriority").is(":checked")) return 3;

        return 2; // default medium
    }

    function getFormData() {

        return {
            id: caseId,
            case_id: caseUID,
            case_type: parseInt($("#caseType").val()),
            priority: getPriorityValue(),
            case_status_id: 1, // New (default)
            bank_id: parseInt($("#bank").val()),
            bank_branch_id: $("#bankBranch").val() ? parseInt($("#bankBranch").val()) : null,
            bank_vertical_id: $("#bankDept").val() ? parseInt($("#bankDept").val()) : null,
            bank_case_id: $("#bankCaseId").val()?.trim(),
            visitor_id: $("#caseVisitor").val() ? parseInt($("#caseVisitor").val()) : null,
            report_maker_id: $("#caseReportMaker").val() ? parseInt($("#caseReportMaker").val()) : null,
            customer_name: $("#custName").val()?.trim(),
            customer_contact: $("#custContactNo").val()?.trim(),
            bill_date: $("#caseDate").val(),

            property_name: $("#propertyName").val()?.trim(),
            property_address: $("#propertyAddress").val()?.trim(),
            property_type: $("#propertyType").val() ? parseInt($("#propertyType").val()) : null
        };
    }

    function caseSave(event) {

        event.preventDefault();

        if (!caseValidator.form()) return;

        const data = getFormData();

        if (isEditMode) {

            callBasePutAPI(CASE_API, data, updateSuccess, commonError);

        } else {

            callBasePostAPI(CASE_API, data, insertSuccess, commonError);
        }
    }

    function caseSaveAddNew(event) {

        event.preventDefault();

        if (!caseValidator.form()) return;

        const data = getFormData();

        callBasePostAPI(CASE_API, data, function () {

            successToastr(
                MessageProvider.format(
                    MessageProvider.INSERT_SUCCESS,
                    "Case"
                )
            );

            resetForm();

        }, commonError);
    }

    function insertSuccess(response) {

        successToastr(
            MessageProvider.format(
                MessageProvider.INSERT_SUCCESS,
                "Case"
            )
        );

        caseUID = response.case_id;

        window.location.href = "/case";
    }

    function updateSuccess() {

        successToastr(
            MessageProvider.format(
                MessageProvider.UPDATE_SUCCESS,
                "Case"
            )
        );

        window.location.href = "/case";
    }

    function caseEdit(uid) {

        callBaseGetAPI(`${CASE_API}/${uid}`,
            function (data) {

                if (!data) {
                    errorToastr("Case not found");
                    return;
                }

                caseId = data.id;
                caseUID = data.case_id;
                isEditMode = true;

                $("#caseType").val(data.case_type).trigger("change");
                $("#bank").val(data.bank_id).trigger("change");
                $("#bankBranch").val(data.bank_branch_id).trigger("change");
                $("#bankDept").val(data.bank_vertical_id).trigger("change");
                $("#bankCaseId").val(data.bank_case_id);
                $("#custName").val(data.customer_name);
                $("#custContactNo").val(data.customer_contact);

                if (data.priority === 1)
                    $("#highPriority").prop("checked", true);
                else if (data.priority === 2)
                    $("#mediumPriority").prop("checked", true);
                else
                    $("#lowPriority").prop("checked", true);

            },
            commonError
        );
    }

    return {
        caseCreateInit,
        caseEdit
    };

})();

$(document).ready(CaseCreateModule.caseCreateInit);
const ReportModule = (() => {

    const REPORT_API = "report/case-analysis";
    const REPORT_TABLE = "#tblReport";

    const $reportTable = $(REPORT_TABLE);
    let dataTable = null;

    function reportInit() {
        lov.setDefaultDateRange();
        setDefaultBillingMonth();  
        loadDropdowns();   
        reportGet();

        $("#reportFilterBankId").on("change", loadBranches);

        $("#reportFilterForm").on("submit", function (e) {
            e.preventDefault();
            reportGet();
        });

        $("#btnResetFilters").on("click", function () {
            $("#reportFilterForm")[0].reset();
            $("#reportFilterForm .select2").val(null).trigger("change");
            reportGet();
        });

        $("#reportFilterSearchText").on("keypress", function (e) {
            if (e.which === 13) {
                e.preventDefault();
                reportGet();
            }
        });
    }

    // Populate all filters
    function loadDropdowns() {
        lov.populateDropdown("bank/name", "#reportFilterBankId", "All");
        lov.populateUserDropdown("user?role=Visitor", "#reportFilterVisitorId", "All");
        lov.populateUserDropdown("user?role=Report Maker", "#reportFilterReporterId", "All");
        lov.populateDropdown("case-type/name", "#reportFilterCaseTypeId", "All");
        lov.populateDropdown("case-status/name", "#reportFilterStatusId", "All");
        $("#reportFilterBranchId").empty().append(`<option value="">All</option>`);
    }
    function loadBranches() {

        const bankId = $("#reportFilterBankId").val();

        if (!bankId) {
            $("#reportFilterBranchId").empty().append(`<option value="">All</option>`).trigger("change");
            return;
        }

        lov.populateDropdown(`bank-branch/name?bankId=${bankId}`, "#reportFilterBranchId", "All");
    }
    function setDefaultBillingMonth() {
        const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, '0');

        $("#reportFilterBillingMonth").val(`${year}-${month}`);
    }
    function reportGet() {

        const billingMonth = $("#reportFilterBillingMonth").val();

        const request = {
            from_date: $("#fromDate").val() || null,
            to_date: $("#toDate").val() || null,
            bank_id: $("#reportFilterBankId").val() || null,
            branch_id: $("#reportFilterBranchId").val() || null,
            visitor_id: $("#reportFilterVisitorId").val() || null,
            reporter_id: $("#reportFilterReporterId").val() || null,
            case_type: $("#reportFilterCaseTypeId").val() || null,
            status_id: $("#reportFilterStatusId").val() || null,
            billing_month: billingMonth
                ? new Date(billingMonth + "-01").toISOString()
                : null,
            search_text: $("#reportFilterSearchText").val()?.trim() || null
        };

        callBasePostAPI(REPORT_API, request, reportFill, commonError);
    }
    function reportFill(data) {

        if (!Array.isArray(data)) {
            errorToastr("Report data not found.");
            return;
        }

        if (dataTable) {
            dataTable.clear().rows.add(data).draw();
            return;
        }

        dataTable = setDataTable($reportTable, {
            data: data,
            scrollX: true,
            scrollY: '600px',
            scrollCollapse: false,
            autoWidth: false,

            columns: [
                {
                    data: null,
                    render: (_, __, ___, meta) =>
                        meta.row + meta.settings._iDisplayStart + 1
                },

                { data: "id" },
                { data: "created_date", render: d => d ? formatDate(d) : "" },
                { data: "bank", render: d => d ?? "" },
                { data: "case_type_mas", render: d => d ?? "" },
                { data: "bank_case_id", render: d => d ?? "" },
                { data: "property_type", render: d => d ?? "" },
                { data: "bill_date", render: d => d ? lov.formatMonthYear(d) : "" },
                { data: "fees", render: d => d ?? "" },
                { data: "customer_name", render: d => d ?? "" },
                { data: "customer_contact", render: d => d ?? "" },
                { data: "address", render: d => d ?? "" },
                { data: "visitor_name", render: d => d ?? "" },
                { data: "report_maker_name", render: d => d ?? "" },
                { data: "visit_date", render: d => d ? formatDate(d) : "" },
                { data: "case_status", render: d => d ?? "" },
                { data: "submit_date", render: d => d ? formatDate(d) : "" },
                { data: "days", render: d => d ?? "" },
                { data: "latitude", render: d => d ?? "" },
                { data: "distance", render: d => d ?? "" },
                { data: "branch", render: d => d ?? "" },
                { data: "size_sqft", render: d => d ?? "" }
            ],

            initComplete: function () {
                applyColumnFilters(this.api(), {
                    noFilterColumns: [0,1],
                    selectFilterColumns: [3,5,11,12,14]
                });
            }
        });
    }

    function formatDate(date) {
        if (!date) return "";
        return moment(date).format("DD-MM-YYYY");
    }

    return {
        reportInit
    };

})();

$(document).ready(ReportModule.reportInit);
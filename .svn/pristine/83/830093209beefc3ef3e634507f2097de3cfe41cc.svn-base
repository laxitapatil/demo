const CaseTypeModule = (() => {

    const CASE_TYPE_API = "case-type";
    const CASE_TYPE_TABLE = "#tblCaseType";

    const $caseTypeTable = $(CASE_TYPE_TABLE);
    let dataTable = null;

    function caseTypeInit() {
        caseTypeGet();
    }

    function caseTypeGet() {
        callBaseGetAPI(`${CASE_TYPE_API}/get`, caseTypeFill, commonError);
    }

    function caseTypeFill(data) {

        if (!Array.isArray(data)) {
            errorToastr("Case Type data not found.");
            return;
        }

        if (dataTable) {
            dataTable.clear().rows.add(data).draw();
            return;
        }

        dataTable = setDataTable($caseTypeTable, {
            data: data,
            scrollY: '600px',
            scrollCollapse: false,
            autoWidth: false,
            columnDefs: [
                {
                    targets: 0, // Action
                    width: '80px',
                    orderable: false,
                    className: "dt-center"
                },
                {
                    targets: 1, // Sr No
                    width: '60px',
                    orderable: false,
                    className: "dt-left"
                },
                {
                    targets: 3, // Status
                    orderable: false,
                    width: '80px',
                    className: "dt-center"
                }
            ],
            columns: [
                // ACTION
                {
                    data: "id",
                    render: function (id) {
                        return `
                            <div class="dropdown text-center">
                                <a href="javascript:void(0);" 
                                   class="fw-semibold font-size-18 link-secondary"
                                   data-bs-toggle="dropdown">
                                    <i class="fi fi-rr-menu-dots"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-item"
                                           onclick="CaseTypeModule.caseTypeEdit(${id})">
                                           <i class="fi fi-rr-edit me-2"></i> Edit
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger"
                                           onclick="CaseTypeModule.caseTypeDelete(${id})">
                                           <i class="fi fi-rr-trash me-2"></i> Delete
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        `;
                    }
                },

                // SR NO
                {
                    data: null,
                    render: (_, __, ___, meta) =>
                        meta.row + meta.settings._iDisplayStart + 1
                },

                // NAME
                {
                    data: "name"
                },

                // STATUS
                {
                    data: "is_active",
                    render: function (isActive, type, row) {
                        return `
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                    type="checkbox"
                                    ${isActive ? "checked" : ""}
                                    onchange="CaseTypeModule.caseTypeStatusUpdate(${row.id})">
                            </div>
                        `;
                    }
                }
            ],
            initComplete: function () {
                applyColumnFilters(this.api(), {
                    noFilterColumns: [0, 3]
                });
            }
        });
    }

    function caseTypeEdit(id) {
        callBaseGetAPI(`${CASE_TYPE_API}/${encodeURIComponent(id)}`,
            function (data) {
                CaseTypeCreateModule.caseTypeDataGet(data);
                CaseTypeCreateModule.openCaseTypeModal(id);
            },
            commonError
        );
    }

    function caseTypeDelete(id) {
        lov.genericDelete(id, CASE_TYPE_API, "Case Type", caseTypeGet);
    }
    function caseTypeStatusUpdate(id) {
        lov.genericStatusUpdate(id, CASE_TYPE_API, caseTypeGet);
    }

    return {
        caseTypeInit,
        caseTypeEdit,
        caseTypeDelete,
        caseTypeStatusUpdate
    };

})();

$(document).ready(CaseTypeModule.caseTypeInit);
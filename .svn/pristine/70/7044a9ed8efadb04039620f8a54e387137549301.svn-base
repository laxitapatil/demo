using Api.Provider;
using AutoMapper;
using Core.Domain;
using Core.Request;
using Core.Response;
using Infrastructure;
using Infrastructure.Base;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Api.Controllers
{
    [Tags("Bank Vertical")]
    [Authorize]
    [Route("api/bank-vertical")]
    [ApiController]
    public class BankVerticalController : BaseController
    {
        private readonly string BANK_VERTICAL = "Bank Vertical";
        private readonly string BANK_BRANCH = "Branch";

        public BankVerticalController(IConfiguration configuration, IMapper mapper, DBContext dbContext)
            : base(configuration, mapper, dbContext) { }

        /// <summary>
        /// Get All Bank Verticals (Optional: Filter by Id, Branch Id, Bank Id or Active Status)
        /// </summary>
        /// <param name="id">Optional bank vertical id</param>
        /// <param name="branchId">Optional branch id filter</param>
        /// <param name="bankId">Optional bank id filter</param>
        /// <param name="isActive">Optional active status filter</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin,Staff")]
        [HttpGet]
        public async Task<IActionResult> Get(int? id, int? branchId, int? bankId, bool? isActive)
        {
            try
            {
                return Ok(await new BankVerticalRepository(dbContext).SelectAll(id, branchId, bankId, isActive));
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get Bank Vertical by Id
        /// </summary>
        /// <param name="id">Bank vertical id</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin,Staff")]
        [HttpGet("{id}")]
        public async Task<IActionResult> GetOne(int id)
        {
            try
            {
                using BankVerticalRepository repo = new(dbContext);
                BankVertical? bankVertical = await repo.SelectOne(id);

                if (bankVertical == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_VERTICAL),
                        statusCode: StatusCodes.Status404NotFound);

                var response = mapper.Map<BankVertical, BankVerticalResponse>(bankVertical);
                return Ok(response);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get Bank Vertical from branch id
        /// </summary>
        /// <param name="branchId">Optional branch id to filter verticals</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin,Staff")]
        [HttpGet("name")]
        public async Task<IActionResult> GetNane(int? branchId)
        {
            try
            {
                using BankVerticalRepository repo = new(dbContext);
                return Ok(await repo.SelectVerticalByBranch(branchId));
            }
            catch (Exception ex)
            {
                return Problem(ex.Message,
                    statusCode: StatusCodes.Status500InternalServerError);
            }
        }
        /// <summary>
        /// Create Bank Vertical
        /// </summary>
        /// <param name="request">Bank vertical details</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPost]
        public async Task<IActionResult> Post(BankVerticalRequest request)
        {
            try
            {
                using BankVerticalRepository repo = new(dbContext);
                using BankBranchRepository branchRepo = new(dbContext);

                // Check if branch exists
                BankBranch? branch = await branchRepo.SelectOne(request.Branch_id);
                if (branch == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_BRANCH),statusCode: StatusCodes.Status404NotFound);

                // Check if vertical name already exists for this branch
                BankVertical? existingVertical = await repo.SelectByName(request.Branch_id, request.Name.Trim());
                if (existingVertical != null)
                    return Problem($"Bank vertical with name '{request.Name}' already exists for this branch.",
                        statusCode: StatusCodes.Status400BadRequest);

                BankVertical bankVertical = mapper.Map<BankVerticalRequest, BankVertical>(request);
                bankVertical.Name = request.Name.Trim();
                bankVertical.Modified_by = TokenName;
                bankVertical.Modified_date = CurrentTime;

                int result = await repo.Insert(bankVertical);

                if (result > 0)
                {
                    var response = mapper.Map<BankVertical, BankVerticalResponse>(bankVertical);
                    return Ok(response);
                }

                return Problem(string.Format(MessageProvider.INSERT_FAILED, BANK_VERTICAL),
                    statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("uk_bank_vertical"))
                    return Problem($"Bank vertical with name '{request.Name}' already exists for this branch.",
                        statusCode: StatusCodes.Status400BadRequest);

                if (ex.ToString().ToLower().Contains("fk_bank_vertical_branch"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_BRANCH), statusCode: StatusCodes.Status404NotFound);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Update Bank Vertical
        /// </summary>
        /// <param name="request">Bank vertical details</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPut]
        public async Task<IActionResult> Put(BankVerticalRequest request)
        {
            try
            {
                if (!request.Id.HasValue || request.Id < 1)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_VERTICAL),statusCode: StatusCodes.Status404NotFound);

                using BankVerticalRepository repo = new(dbContext);
                using BankBranchRepository branchRepo = new(dbContext);

                BankVertical? bankVertical = await repo.SelectOne(request.Id.Value);
                if (bankVertical == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_VERTICAL),statusCode: StatusCodes.Status404NotFound);

                // Check if branch exists
                BankBranch? branch = await branchRepo.SelectOne(request.Branch_id);
                if (branch == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_BRANCH), statusCode: StatusCodes.Status404NotFound);

                // Check if new name already exists for this branch (excluding current vertical)
                BankVertical? existingVertical = await repo.SelectByName(request.Branch_id, request.Name.Trim());
                if (existingVertical != null && existingVertical.Id != bankVertical.Id)
                    return Problem($"Bank vertical with name '{request.Name}' already exists for this branch.",
                        statusCode: StatusCodes.Status400BadRequest);

                bankVertical.Name = request.Name.Trim();
                bankVertical.Branch_id = request.Branch_id;
                bankVertical.Is_active = request.Is_active;
                bankVertical.Modified_by = TokenName;
                bankVertical.Modified_date = CurrentTime;

                int result = await repo.Update(bankVertical);

                if (result > 0)
                {
                    var response = mapper.Map<BankVertical, BankVerticalResponse>(bankVertical);
                    return Ok(response);
                }

                return Problem(string.Format(MessageProvider.UPDATE_FAILED, BANK_VERTICAL),
                    statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("uk_bank_vertical"))
                    return Problem($"Bank vertical with name '{request.Name}' already exists for this branch.",
                        statusCode: StatusCodes.Status400BadRequest);

                if (ex.ToString().ToLower().Contains("fk_bank_vertical_branch"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_BRANCH), statusCode: StatusCodes.Status404NotFound);


                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Delete Bank Vertical
        /// </summary>
        /// <param name="id">Bank vertical id</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(int id)
        {
            try
            {
                using BankVerticalRepository repo = new(dbContext);
                BankVertical? bankVertical = await repo.SelectOne(id);

                if (bankVertical == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_VERTICAL),
                        statusCode: StatusCodes.Status404NotFound);

                await repo.Delete(bankVertical);

                return Ok(string.Format(MessageProvider.DELETE_SUCCESS, BANK_VERTICAL));
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk"))
                    return Problem(MessageProvider.CHILD_FOUND,
                        statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message,
                    statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Update Bank Vertical Active Status
        /// </summary>
        /// <param name="id">Bank vertical id</param>
        /// <param name="isActive">Active status</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPut("update-status/{id}")]
        public async Task<IActionResult> UpdateStatus(int id, [FromQuery] bool isActive)
        {
            try
            {
                using BankVerticalRepository repo = new(dbContext);
                BankVertical? bankVertical = await repo.SelectOne(id);

                if (bankVertical == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_VERTICAL),
                        statusCode: StatusCodes.Status404NotFound);

                bankVertical.Is_active = isActive;
                bankVertical.Modified_by = TokenName;
                bankVertical.Modified_date = CurrentTime;

                int result = await repo.Update(bankVertical);

                return result > 0
                    ? Ok(string.Format(MessageProvider.UPDATE_SUCCESS, BANK_VERTICAL))
                    : Problem(string.Format(MessageProvider.UPDATE_FAILED, BANK_VERTICAL),
                        statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message,
                    statusCode: StatusCodes.Status500InternalServerError);
            }
        }

    }
}
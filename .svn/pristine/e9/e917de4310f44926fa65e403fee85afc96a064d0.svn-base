using Core.Domain;
using Core.Request;
using Dapper;
using Infrastructure.Base;
using Microsoft.AspNetCore.Identity;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.ComponentModel.Design;
using System.Data;

namespace Infrastructure
{
    public class UserRepository : Base.BaseRepository
    {
        private readonly UserManager<AspNetUsers> _userManager;
        private readonly RoleManager<IdentityRole> _roleManager;

        public UserRepository(UserManager<AspNetUsers> userManager, RoleManager<IdentityRole> roleManager, DBContext dbContext) : base(dbContext)
        {
            _userManager = userManager;
            _roleManager = roleManager;
        }


        #region Users Methods


        // Select
        public async Task<string> SelectAll(string? id, int? userId, string? role, bool? isActive)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_user_id", userId);
            parameter.Add("_role", role);
            parameter.Add("_is_active", isActive);

            return await connection.QueryFirstAsync<string>("SELECT aspnet_users_selectall(@_id, @_user_id, @_role, @_is_active)", parameter);
        }

        public async Task<string> SelectName(string? role, int? userId)
        {
            DynamicParameters parameter = new();
            parameter.Add("_role", role);
            parameter.Add("_user_id", userId);

            return await connection.QueryFirstAsync<string>("SELECT aspnet_users_selectname(@_role, @_user_id)", parameter);
        }


        public async Task<AspNetUsers> SelectOne(string id) =>
            await _userManager.FindByIdAsync(id);

        public async Task<AspNetUsers> SelectOneByUserid(int userId) =>
            await dbContext.Users.FirstOrDefaultAsync(u => u.User_id == userId);

        public async Task<AspNetUsers> SelectByUsername(string userName) =>
            await _userManager.FindByNameAsync(userName);

        public async Task<AspNetUsers> SelectByEmail(string email) =>
            await _userManager.FindByEmailAsync(email);

        public async Task<string> SelectUserHashPassword(AspNetUsers user, string password) =>
            _userManager.PasswordHasher.HashPassword(user, password);


        // Insert
        public async Task<IdentityResult> InsertUser(AspNetUsers users, string role)
        {
            IdentityResult result = await _userManager.CreateAsync(users, users.PasswordHash);

            if (result.Succeeded)
                result = await _userManager.AddToRoleAsync(users, role);

            return result;
        }

        public async Task<IdentityResult> InsertUserRole(AspNetUsers user, string role) =>
            await _userManager.AddToRoleAsync(user, role);


        // Update
        public async Task<IdentityResult> Update(AspNetUsers user) =>
            await _userManager.UpdateAsync(user);


        public async Task<IdentityResult> UpdatePassword(AspNetUsers users, string password)
        {
            users.PasswordHash = await SelectUserHashPassword(users, password);
            return await _userManager.UpdateAsync(users);
        }


        // Delete
        public async Task<IdentityResult> DeleteUserRole(AspNetUsers user, string role) =>
            await _userManager.RemoveFromRoleAsync(user, role);

        public async Task<IdentityResult> DeleteUserRole(AspNetUsers user, IEnumerable<string> roles) =>
            await _userManager.RemoveFromRolesAsync(user, roles);

        public async Task<IdentityResult> Delete(AspNetUsers user) =>
            await _userManager.DeleteAsync(user);

        //public async Task<int> Delete(string userId)
        //{
        //    DynamicParameters parameter = new();
        //    parameter.Add("Id", userId);

        //    using SqlConnection db = new(connectionString);
        //    return await db.ExecuteAsync("AspNetUsers_Delete", parameter, commandType: CommandType.StoredProcedure);
        //}


        // Others
        public async Task<IdentityResult> ChangePassword(AspNetUsers user, string currentPassword, string newPassword) =>
            await _userManager.ChangePasswordAsync(user, currentPassword, newPassword);

        public async Task<string> ResetPasswordToken(AspNetUsers user) =>
            await _userManager.GeneratePasswordResetTokenAsync(user);

        public async Task<bool> CheckPassword(AspNetUsers user, string password) =>
            await _userManager.CheckPasswordAsync(user, password);


        #endregion Users Methods


        #region Role Methods


        // Select
        public async Task<IList<IdentityRole>> SelectAllRole() =>
            await _roleManager.Roles.ToListAsync();
        
        public async Task<IList<string>> SelectUserRole(AspNetUsers user) =>
            await _userManager.GetRolesAsync(user);

        public async Task<IdentityRole> SelectRoleByName(string roleName) =>
            await _roleManager.FindByNameAsync(roleName);


        // Insert
        public async Task<IdentityResult> InsertRole(IdentityRole role) =>
            await _roleManager.CreateAsync(role);


        #endregion Role Methods
    }
}
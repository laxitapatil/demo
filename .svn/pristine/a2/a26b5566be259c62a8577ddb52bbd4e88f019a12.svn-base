using System.ComponentModel.DataAnnotations.Schema;

namespace Core.Domain
{
    [Table("case_property")]
    public class CaseProperty
    {
        [DatabaseGenerated(DatabaseGeneratedOption.Identity)]
        [Column("id")]
        public int Id { get; set; }

        [Column("case_id")]
        public int Case_id { get; set; }

        [Column("property_type")]
        public short Property_type { get; set; }

        [Column("name")]
        public string Name { get; set; }

        [Column("distance")]
        public float? Distance { get; set; }

        [Column("size_sqft")]
        public float? Size_sqft { get; set; }

        [Column("address")]
        public string Address { get; set; }

        [Column("city")]
        public string City { get; set; } 

        [Column("state_id")]
        public int State_id { get; set; }

        [Column("pincode")]
        public string? Pincode { get; set; } 

        [Column("latitude")]
        public float? Latitude { get; set; }

        [Column("longitude")]
        public float? Longitude { get; set; }

        [Column("location")]
        public string? Location { get; set; }

        [Column("valuation_amount")]
        public float? Valuation_amount { get; set; }

        [Column("is_final")]
        public bool? Is_final { get; set; }

        [Column("report_doc_path")]
        public string? Report_doc_path { get; set; }

        [Column("report_pdf_path")]
        public string? Report_pdf_path { get; set; }

        [Column("report_updated_date")]
        public DateTime? Report_updated_date { get; set; }

        [Column("note")]
        public string? Note { get; set; }

        [Column("created_by")]
        public string Created_by { get; set; } 

        [Column("created_date")]
        public DateTime Created_date { get; set; }

        [Column("modified_by")]
        public string? Modified_by { get; set; }

        [Column("modified_date")]
        public DateTime? Modified_date { get; set; }
    }
}
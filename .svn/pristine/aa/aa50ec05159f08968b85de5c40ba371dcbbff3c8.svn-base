    [Tags("Authenticate")]
    [Route("api/authenticate")]
    [ApiController]
    public class AuthenticateController : BaseController
    {
        private readonly UserRepository _repoUser;
        private readonly EmailProvider _emailProvider;
        private readonly TokenRepository _repoToken;

        public AuthenticateController(IConfiguration configuration, IMapper mapper, DBContext dbContext,
            UserRepository repoUser, EmailProvider emailProvider, TokenRepository repoToken) : base(configuration, mapper, dbContext)
        {
            _repoUser = repoUser;
            _emailProvider = emailProvider;
            _repoToken = repoToken;
        }

        /// <summary>
        /// The Login API is used to authenticate a user and generate an access token
        /// Auto Login for Admin access only.
        /// </summary>
        /// <param name="req">Login request</param>
        /// <returns>200 OK - User with access token, 401 Unauthorized, 400 Bad request</returns>
        [Authorize(Roles = "Admin")]
        [HttpPost("auto-login")]
        public async Task<IActionResult> AutoLogin(LoginRequest req)
        {
            AspNetUserLogs logs = new()
            {
                Location = RemoteIpAddress,
                User_name = req.UserName,
                Access_type = HttpContext.Request.Headers.Where(a => a.Key == "User-Agent").FirstOrDefault().Value.ToString(),
                Task_category = "auto-login",
                Created_date = CurrentTime
            };

            try
            {

                AspNetUsers user = await _repoUser.SelectByUsername(req.UserName);

                if (user == null || !await _repoUser.CheckPassword(user, req.Password))
                {
                    await insertLogs(logs, StatusCodes.Status401Unauthorized, MessageProvider.INVALID_CREDENTIALS);
                    return Problem(MessageProvider.INVALID_CREDENTIALS, statusCode: StatusCodes.Status401Unauthorized);
                }

                var ipAddress = GetIpAddress();

                // NEW refresh-token-based auth
                var tokens = await _repoToken.GenerateTokensAsync(user, ipAddress);

                // await insertLogs(logs, StatusCodes.Status200OK, "Success");
                return Ok(tokens);
            }
            catch (Exception ex)
            {
                await insertLogs(logs, StatusCodes.Status500InternalServerError, ex.ToString());
                return Problem(ex.ToString(), statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// The Login API is used to authenticate a user and generate an access token.
        /// </summary>
        /// <param name="req">Login request</param>
        /// <returns>200 OK - User with access token, 401 Unauthorized, 400 Bad request</returns>
        [HttpPost("login")]
        public async Task<IActionResult> Login(LoginRequest req)
        {
            AspNetUserLogs logs = new()
            {
                Location = RemoteIpAddress,
                User_name = req.UserName,
                Access_type = HttpContext.Request.Headers["User-Agent"].ToString(),
                Task_category = "login",
                Created_date = CurrentTime
            };

            try
            {
                AspNetUsers user = await _repoUser.SelectByUsername(req.UserName);

                if (user == null || !await _repoUser.CheckPassword(user, req.Password))
                {
                    await insertLogs(logs, StatusCodes.Status401Unauthorized, MessageProvider.INVALID_CREDENTIALS);
                    return Problem(MessageProvider.INVALID_CREDENTIALS, statusCode: StatusCodes.Status401Unauthorized);
                }

                var ipAddress = GetIpAddress();

                // NEW refresh-token-based auth
                var tokens = await _repoToken.GenerateTokensAsync(user, ipAddress);

                await insertLogs(logs, StatusCodes.Status200OK, "Success");
                return Ok(tokens);
            }
            catch (Exception ex)
            {
                await insertLogs(logs, StatusCodes.Status500InternalServerError, ex.ToString());
                return Problem(ex.ToString(), statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        // RefreshToken Api
        [HttpPost("refresh-token")]
        public async Task<IActionResult> RefreshToken([FromBody] RefreshRequest request)
        {
            if (string.IsNullOrEmpty(request.RefreshToken))
                return BadRequest("Refresh token is required");

            var ipAddress = GetIpAddress();

            var response = await _repoToken.RefreshTokenAsync(request.RefreshToken, ipAddress);

            if (response == null)
                return Unauthorized("Invalid or expired refresh token");

            return Ok(response);
        }




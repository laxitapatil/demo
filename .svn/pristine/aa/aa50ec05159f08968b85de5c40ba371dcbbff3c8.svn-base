        /// <summary>
        /// The Forgot Password API is used to initiate the password reset process for a user.
        /// </summary>
        /// <param name="req">Forget password request</param>
        /// <returns>200 OK - Message, 400 Bad request.</returns>
        [HttpPost("forget-password")]
        public async Task<IActionResult> ForgetPassword(VerifyUserRequest req)
        {
            AspNetUserLogs logs = new()
            {
                Location = RemoteIpAddress,
                User_name = req.Email,
                Access_type = HttpContext.Request.Headers.Where(a => a.Key == "User-Agent").FirstOrDefault().Value.ToString(),
                Task_category = "forget-password",
                Created_date = CurrentTime
            };

            try
            {
                AspNetUsers user = await _repoUser.SelectByEmail(req.Email);

                if (user == null)
                {
                    await insertLogs(logs, StatusCodes.Status400BadRequest, MessageProvider.USER_NOT_FOUND);
                    return Problem(MessageProvider.USER_NOT_FOUND, statusCode: StatusCodes.Status400BadRequest);
                }

                user.Otp = new Random().Next(100000, 999999);
                user.Otp_created_date = CurrentTime;
                IdentityResult result = await _repoUser.Update(user);

                if (!result.Succeeded)
                {
                    await insertLogs(logs, StatusCodes.Status400BadRequest, string.Join(", ", result.Errors.Select(e => e.Description)));
                    return Problem(string.Join(", ", result.Errors.Select(e => e.Description)), statusCode: StatusCodes.Status400BadRequest);
                }

                //string code = await repoUser.GenerateResetPasswordLink(user);
                //code = code.Replace("/", "@@@");          // Char '/' replace with '@@@' and back in reset password

                EmailResetResponse emailResetResponse = new()
                {
                    Otp = user.Otp.Value,
                    IsAdmin = false,
                    Name = user.UserName
                };

                bool isMailSent = await _emailProvider.ResetPassword(user.Email, user.Name, emailResetResponse.Otp);

                if (isMailSent)
                    return Ok(MessageProvider.FORGET_EMAIL_SENT);
                else
                    return Problem(MessageProvider.EMAIL_ERROR, statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                await insertLogs(logs, StatusCodes.Status500InternalServerError, ex.ToString());
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// The Reset Password API allows users to reset their password after initiating the password reset process.
        /// </summary>
        /// <param name="req">Reset password request</param>
        /// <returns>200 OK - User role, 400 Bad request.</returns>
        [HttpPost("reset-password")]
        public async Task<IActionResult> ResetPassword(ResetPasswordRequest req)
        {
            AspNetUserLogs logs = new()
            {
                Location = RemoteIpAddress,
                User_name = req.Email,
                Access_type = HttpContext.Request.Headers.Where(a => a.Key == "User-Agent").FirstOrDefault().Value.ToString(),
                Task_category = "reset-password",
                Created_date = CurrentTime
            };

            try
            {
                AspNetUsers user = await _repoUser.SelectByEmail(req.Email);

                if (user == null)
                {
                    await insertLogs(logs, StatusCodes.Status400BadRequest, MessageProvider.USER_NOT_FOUND);
                    return Problem(MessageProvider.USER_NOT_FOUND, statusCode: StatusCodes.Status400BadRequest);
                }

                if (user.Otp == null || user.Otp != req.Otp)
                    return Problem(MessageProvider.INVALID_OTP, statusCode: StatusCodes.Status400BadRequest);

                IdentityResult result = await _repoUser.UpdatePassword(user, req.NewPassword);

                if (result.Succeeded)
                {
                    await insertLogs(logs, StatusCodes.Status200OK, "Success");
                    return Ok(MessageProvider.USER_PASSWORD_UPDATE_SUCCESS);
                }
                else
                {
                    await insertLogs(logs, StatusCodes.Status400BadRequest, string.Join(", ", result.Errors.Select(e => e.Description)));
                    return Problem(string.Join(", ", result.Errors.Select(e => e.Description)), statusCode: StatusCodes.Status400BadRequest);
                }
            }
            catch (Exception ex)
            {
                await insertLogs(logs, StatusCodes.Status500InternalServerError, ex.ToString());
                return Problem(ex.Message.ToString(), statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        [Authorize]
        [HttpPost("revoke-token")]
        public async Task<IActionResult> RevokeToken([FromBody] RefreshRequest request)
        {
            if (string.IsNullOrEmpty(request.RefreshToken))
                return BadRequest("Refresh token is required");

            var ipAddress = GetIpAddress();

            var success = await _repoToken.RevokeTokenAsync(request.RefreshToken, ipAddress);

            if (!success)
                return NotFound("Token not found or already revoked");

            return Ok("Token revoked successfully");
        }



using Api.Provider;
using AutoMapper;
using Core.Domain;
using Core.Request;
using Core.Response;
using Infrastructure;
using Infrastructure.Base;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Api.Controllers
{
    [Tags("Property Type")]
    [Authorize]
    [Route("api/property-type")]
    [ApiController]
    public class PropertyTypeMasController : BaseController
    {
        private readonly string PROPERTY_TYPE_MAS = "Property Type";

        public PropertyTypeMasController(IConfiguration configuration, IMapper mapper, DBContext dbContext)
            : base(configuration, mapper, dbContext) { }

        /// <summary>
        /// Get list of property types based on filter criteria.
        /// </summary>
        /// <param name="id"></param>
        /// <param name="isActive"></param>
        /// <returns></returns>
        [Authorize]
        [HttpGet("get")]
        public async Task<IActionResult> Get(short? id, bool? isActive)
        {
            try
            {
                return Ok(await new PropertyTypeMasRepository(dbContext).SelectAll(id, isActive));
            }
            catch (Exception ex)
            {
                return Problem(ex.ToString(), statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get list of property type id and name for active property types.
        /// </summary>
        /// <returns></returns>
        [Authorize]       
        [HttpGet("name")]
        public async Task<IActionResult> GetName()
        {
            try
            {
                using PropertyTypeMasRepository repoPropertyType = new(dbContext);
                var response = await repoPropertyType.SelectName();
                return Ok(response);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Add a new property type.
        /// </summary>
        /// <param name="request"></param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPost]
        public async Task<IActionResult> Post(PropertyTypeMasRequest request)
        {
            try
            {
                PropertyTypeMas propertyTypeMas = mapper.Map<PropertyTypeMasRequest, PropertyTypeMas>(request);
                using PropertyTypeMasRepository repoPropertyType = new(dbContext);

                propertyTypeMas.Modified_by = TokenName;
                propertyTypeMas.Modified_date= CurrentTime;

                int result = await repoPropertyType.Insert(propertyTypeMas);

                return result > 0
                    ? Ok(mapper.Map<PropertyTypeMas, PropertyTypeMasResponse>(propertyTypeMas))
                    : Problem(string.Format(MessageProvider.INSERT_FAILED, PROPERTY_TYPE_MAS), statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                string error = ex.ToString().ToLower();

                if (error.Contains("uk_state_name"))
                    return Problem(string.Format(MessageProvider.ALREADY_EXISTS, PROPERTY_TYPE_MAS),statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }

        }

        /// <summary>
        /// Update details of a property Type.
        /// </summary>
        /// <param name="request"></param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPut]
        public async Task<IActionResult> Put(PropertyTypeMasRequest request)
        {
            try
            {
                if (!request.Id.HasValue || request.Id < 1)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, PROPERTY_TYPE_MAS), statusCode: StatusCodes.Status404NotFound);

                using PropertyTypeMasRepository repoPropertyType = new(dbContext);
                PropertyTypeMas? propertyTypeMas = await repoPropertyType.SelectOne(request.Id.Value);

                if (propertyTypeMas == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, PROPERTY_TYPE_MAS), statusCode: StatusCodes.Status404NotFound);

                propertyTypeMas.Name = request.Name;
                propertyTypeMas.Is_active = request.Is_active;
           
                propertyTypeMas.Modified_by = TokenName;
                propertyTypeMas.Modified_date = CurrentTime;


                int result = await repoPropertyType.Update(propertyTypeMas);
                return result > 0
                     ? Ok(mapper.Map<PropertyTypeMas, PropertyTypeMasResponse>(propertyTypeMas))
                     : Problem(string.Format(MessageProvider.UPDATE_FAILED, PROPERTY_TYPE_MAS), statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                string error = ex.ToString().ToLower();

                if (error.Contains("uk_state_name"))
                    return Problem(string.Format(MessageProvider.ALREADY_EXISTS, "State Name"), statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }

        }

        /// <summary>
        /// Delete a property type. If any child record found then it will not delete and return error message.
        /// </summary>
        /// <param name="id"></param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(short id)
        {
            try
            {
                using PropertyTypeMasRepository repoPropertyType = new(dbContext);
                PropertyTypeMas? propertyTypeMas = await repoPropertyType.SelectOne(id);

                if (propertyTypeMas == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, PROPERTY_TYPE_MAS), statusCode: StatusCodes.Status404NotFound);

                await repoPropertyType.Delete(propertyTypeMas);
                return Ok(string.Format(MessageProvider.DELETE_SUCCESS, PROPERTY_TYPE_MAS));
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk"))
                    return Problem(MessageProvider.CHILD_FOUND, statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get details of a property type based on id.
        /// </summary>
        /// <param name="id"></param>
        /// <returns></returns>
        [HttpGet("{id}")]
        public async Task<IActionResult> GetOne(short id)
        {
            try
            {
                using PropertyTypeMasRepository repoPropertyType = new(dbContext);
                var propertyTypeMas = await repoPropertyType.SelectOne(id);

                if (propertyTypeMas == null)
                    return NotFound(string.Format(MessageProvider.NOT_FOUND, PROPERTY_TYPE_MAS));

                return Ok(mapper.Map<PropertyTypeMas, PropertyTypeMasResponse>(propertyTypeMas));
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Update active/inactive status of a property type. If active then it will be inactive and vice versa.
        /// </summary>
        /// <param name="id"></param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPut("update-status/{id}")]
        public async Task<IActionResult> UpdateStatus(short id)
        {
            try
            {
                using PropertyTypeMasRepository repoPropertyType = new(dbContext);
                PropertyTypeMas? propertyTypeMas = await repoPropertyType.SelectOne(id);

                if (propertyTypeMas == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, PROPERTY_TYPE_MAS), statusCode: StatusCodes.Status404NotFound);

                propertyTypeMas.Is_active = !propertyTypeMas.Is_active;
                propertyTypeMas.Modified_by = TokenName;
                propertyTypeMas.Modified_date = CurrentTime;

                int result = await repoPropertyType.Update(propertyTypeMas);

                if (result > 0)
                    return Ok(mapper.Map<PropertyTypeMas, PropertyTypeMasResponse>(propertyTypeMas));
                else
                    return Problem(string.Format(MessageProvider.UPDATE_FAILED, PROPERTY_TYPE_MAS),
                        statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                return Problem(ex.ToString(), statusCode: StatusCodes.Status500InternalServerError);
            }
        }

    }
}
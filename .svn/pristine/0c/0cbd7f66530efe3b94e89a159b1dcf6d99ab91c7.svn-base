using System.ComponentModel.DataAnnotations;

namespace Core.Request
{
    public class CaseStatusLogRequest
    {
        public int? Id { get; set; }

        [Required(ErrorMessage = "Please select Case.")]
        public int Case_id { get; set; }

        [Required(ErrorMessage = "Please enter Case Status Log.")]
        public int Case_status_id { get; set; }

        [MaxLength(64, ErrorMessage = "Max length reached for Remark.")]
        public string? Remark { get; set; }
    }
}
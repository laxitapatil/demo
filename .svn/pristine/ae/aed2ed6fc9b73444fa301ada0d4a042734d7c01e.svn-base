using Core.Domain;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.Data;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class StateMasRepository : BaseRepository
    {
        private readonly DBContext _dbContext;

        public StateMasRepository(DBContext dBContext) => _dbContext = dBContext;

        #region AutoGenerated

        public async Task<int> Insert(StateMas stateMas)
        {
            await _dbContext.StateMas.AddAsync(stateMas);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(StateMas stateMas)
        {
            _dbContext.StateMas.Update(stateMas);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(StateMas stateMas)
        {
            _dbContext.StateMas.Remove(stateMas);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<JsonNode?> SelectAll(int? id, bool? isActive)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_is_active", isActive);
            using NpgsqlConnection connection = new(connectionString);
            string? response = await connection.QueryFirstAsync<string>("SELECT state_mas_selectall(@_id, @_is_active)", parameter);
            return string.IsNullOrWhiteSpace(response) ? JsonNode.Parse("[]") : JsonNode.Parse(response);
        }

        public async Task<StateMas?> SelectOne(int id) =>
            await _dbContext.StateMas.Where(x => x.Id == id).FirstOrDefaultAsync();

        public async Task<List<SelectListResponse>> SelectName()
        {
            return await _dbContext.StateMas
                .Where(state => state.Is_active)
                .OrderBy(state => state.Name)
                .Select(state => new SelectListResponse
                {
                    id = (short)state.Id,
                    name = state.Name
                })
                .ToListAsync();
        }

        #endregion AutoGenerated

    }
}
<div class="modal fade" id="caseModal" tabindex="-1" aria-labelledby="caseModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="caseModalLabel">Create Case</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="quickCaseForm" method="post">
                    <div class="row gy-2">

                        <!-- Case Info -->
                        <div class="col-lg-4">
                            <label>Case Date<span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="caseDate" name="caseDate" />
                        </div>

                        <div class="col-lg-4 caseIdWrapper d-none">
                            <label>Case ID</label>
                            <input type="text" class="form-control" id="caseID" name="caseID" />
                        </div>

                        <div class="col-lg-4">
                            <label>Case Type<span class="text-danger">*</span></label>
                            <select class="form-control select2" select2="true" id="caseTypeId" name="caseTypeId" data-dropdown-parent="#caseModal">
                            </select>
                        </div>

                        <div class="col-lg-4">
                            <label>Visitor</label>
                            <select class="form-control select2" select2="true" id="caseVisitor" name="caseVisitor" data-dropdown-parent="#caseModal">
                            </select>
                        </div>
                        <!-- Bank Info -->
                        <div class="col-lg-4">
                            <label>Bank<span class="text-danger">*</span></label>
                            <select class="form-control select2" select2="true" id="bank" name="bank" data-dropdown-parent="#caseModal">
                            </select>
                        </div>

                        <div class="col-lg-4">
                            <label>Bank Branch</label>
                            <select class="form-control select2" select2="true" id="bankBranch" name="bankBranch" data-dropdown-parent="#caseModal">
                                <option value="">Select</option>
                            </select>
                        </div>

                        <div class="col-lg-4">
                            <label>Bank Case ID<span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="bankCaseId" name="bankCaseId" placeholder="ID given by bank" />
                        </div>


                        <div class="">
                            <hr />
                        </div>

                        <!-- Customer -->
                        <div class="col-lg-6">
                            <label>Customer Name</label>
                            <input type="text" class="form-control" id="custName" name="custName" placeholder="Full name " />
                        </div>

                        <div class="col-lg-6">
                            <label>Contact No.</label>
                            <input type="number" class="form-control" id="custContactNo" name="custContactNo" placeholder="10 Digit Number" />
                        </div>

                        <div class="col-lg-4">
                            <label>Property Type<span class="text-danger">*</span></label>
                            <select class="form-control select2" id="propertyType" name="propertyType" data-dropdown-parent="#caseModal">
                            </select>
                        </div>

                        <div class="col-lg-8">
                            <label>Property Name<span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="propertyName" name="propertyName" />
                        </div>

                        <div class="col-lg-6">
                                <label class="form-label">Address<span class="text-danger">*</span></label>
                                <textarea class="form-control" id="propertyAddress" name="propertyAddress" rows="2"></textarea>
                            </div>

                            <div class="col-lg-6">
                                <label class="form-label">Notes</label>
                                <textarea class="form-control" id="propertyNotes" name="propertyNotes" rows="2"></textarea>
                            </div>

                        <div class="col-lg-8">
                            <button type="button" id="btnSaveQuickCase" class="btn btn-primary">
                                <i class="fi fi-rr-disk me-2"></i>Save 
                            </button>
                            @* <button type="button" id="saveAndRedirect" class="btn btn-secondary">
                                <i class="fi fi-rr-disk me-2"></i>Save & Next
                            </button> *@
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                                <i class="fi fi-rr-cross-circle me-2"></i>Cancel
                            </button>
                        </div>

                        <div class="col-lg-2">
                            <label id="fileCountOnCreate" class="text-primary text-center p-2 d-block mt-1">
                                No files selected
                            </label>
                        </div>
                        <div class="col-lg-2">
                            <div id="bankDocDropZoneOnCreate" class="upload-drop-zone text-center p-2">

                                <input type="file" id="bankDocInputOnCreate" name="bankDocInputOnCreate" accept=".jpg,.jpeg,.png,.avif,.heic,.webp,.pdf,.doc,.docx,.xls,.xlsx,.csv,.mp3,.wav,.m4a" multiple hidden>
                                <button type="button" class="btn btn-outline-primary w-100 mb-1" id="btnAddBankDocOnCreate">
                                    <i class="fi fi-rr-plus-small me-2"></i>Add Bank Doc
                                </button>
                                <small class="text-muted">or drag & drop here</small>

                            </div>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
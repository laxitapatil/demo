<div id="caseHistoryModal" class="modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Case History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <!-- Case Summary -->
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <strong>Customer Name:</strong>
                                <div id="historyCustomer"> </div>
                            </div>
                            <div class="col-md-3">
                                <strong>Contact No:</strong>
                                <div id="historyContact"> </div>
                            </div>
                            <div class="col-md-3">
                                <strong>Visitor:</strong>
                                <div id="historyVisitor"> </div>
                            </div>
                            <div class="col-md-3">
                                <strong>Report Maker:</strong>
                                <div id="historyReporter"> </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Log Table -->
                <table id="tblCaseHistory" class="table table-bordered table-sm">
                    <thead class="bg-light">
                        <tr>
                            <th>#</th>
                            <th>Status</th>
                            <th>Remark</th>
                            <th>Last Modified Date</th>
                            <th>Last Modified By</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

        </div>

    </div>
</div>

using Core.Domain;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.Data;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class CaseStatusLogRepository : BaseRepository
    {
        public CaseStatusLogRepository(DBContext dbContext) : base(dbContext) { }


        #region AutoGenerated
        public async Task<int> Insert(CaseStatusLog caseStatusLog)
        {
            await dbContext.CaseStatusLogs.AddAsync(caseStatusLog);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(CaseStatusLog caseStatusLog)
        {
            dbContext.CaseStatusLogs.Update(caseStatusLog);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(CaseStatusLog caseStatusLog)
        {
            dbContext.CaseStatusLogs.Remove(caseStatusLog);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<JsonNode?> SelectAll(int? id, int? caseId)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_case_id", caseId);
            string? response = await connection.QueryFirstAsync<string>("SELECT case_status_log_selectall(@_id, @_case_id)", parameter);
            return string.IsNullOrWhiteSpace(response) ? JsonNode.Parse("[]") : JsonNode.Parse(response);
        }

        public async Task<CaseStatusLog?> SelectOne(int id) =>
            await dbContext.CaseStatusLogs.Where(x => x.Id == id).FirstOrDefaultAsync();

        #endregion AutoGenerated
    }
}
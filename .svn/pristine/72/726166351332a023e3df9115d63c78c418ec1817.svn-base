(function ($) {

    $.fn.inlineEditor = function (options) {

        const settings = $.extend({
            editableSelector: '.editable',
            save: null
        }, options);

        let editing = false;

        const getAllEditables = ($table) =>
            $table.find(settings.editableSelector + ':visible');

        const startEdit = ($el) => {
            if (editing) return;
            editing = true;

            const type = $el.data('type') || 'text';
            const field = $el.data('field');
            const oldValue = $el.data('value') ?? $el.text().trim();
            const displayText = $el.text().trim();

            $el.data('oldValue', oldValue);

            // TEXT / NUMBER / DATE
            if (type !== 'select') {
                const $input = $('<input>', {
                    type: type,
                    class: 'form-control form-control-sm',
                    value: displayText
                });

                $el.html($input);
                $input.focus();
                bindInputEvents($el, $input);
                return;
            }

            // SELECT DROPDOWN
            const $select = $('<select class="form-select form-select-sm"></select>');
            $el.html($select);

            loadSelectOptions($el, $select, oldValue);
        };

        const loadSelectOptions = ($el, $select, selectedValue) => {

            $.ajax({
                url: ApiUrl + $el.data('source'),
                type: 'GET',
                headers: {
                    "Authorization": "Bearer " + localStorage.getItem("token"),
                    "Accept": "application/json"
                },
                dataType: 'json',
                success: function (response) {

                    // 🔑 If API returns JSON as STRING
                    let items = response;

                    if (typeof response === 'string') {
                        try {
                            items = JSON.parse(response);
                        } catch (e) {
                            console.error('Invalid JSON string:', response);
                            return;
                        }
                    }

                    // Safety check
                    if (!Array.isArray(items)) {
                        console.error('Expected array, got:', items);
                        return;
                    }

                    // Bind options
                    items.forEach(item => {
                        $('<option>', {
                            value: item.user_id,          // UUID
                            text: item.name,         // Display name
                            selected: item.user_id == selectedValue
                        }).appendTo($select);
                    });

                    $select.focus();
                    bindSelectEvents($el, $select);
                },
                error: function () {
                    alert('Failed to load dropdown data');
                    cancelEdit($el);
                }
            });
        };

        const bindSelectEvents = ($el, $select) => {

            $select.on('keydown blur', function (e) {

                if (e.key === 'Tab' && e.shiftKey) {
                    e.preventDefault();
                    finishSelectEdit($el, 'prev');
                    return;
                }

                if (e.key === 'Tab') {
                    e.preventDefault();
                    finishSelectEdit($el, 'next');
                    return;
                }

                if (e.key === 'Enter') {
                    finishSelectEdit($el);
                    return;
                }

                if (e.key === 'Escape') {
                    cancelEdit($el);
                    return;
                }

                if (e.type === 'blur') {
                    finishSelectEdit($el);
                }
            });
        };

        const finishSelectEdit = ($el, move = null) => {
            const oldValue = $el.data('oldValue');
            const $select = $el.find('select');

            const newValue = $select.val();
            const newText = $select.find('option:selected').text();

            $el
                .data('value', newValue)
                .text(newText);

            editing = false;

            // Save only if changed
            if (newValue != oldValue && typeof settings.save === 'function') {
                settings.save({
                    field: $el.data('field'),
                    oldValue,
                    newValue,
                    displayText: newText,
                    row: $el.closest('tr')
                });
            }

            if (move === 'next') focusNext($el);
            if (move === 'prev') focusPrev($el);
        };

        const cancelEdit = ($el) => {
            const oldValue = $el.data('oldValue');
            const oldText = $el.text();

            $el.text(oldText);
            editing = false;
        };

        const finishEdit = ($el, move = null) => {
            const oldValue = $el.data('oldValue');
            const newValue = $el.find('input').val().trim();

            $el.text(newValue);
            editing = false;

            if (newValue !== oldValue && typeof settings.save === 'function') {
                const $row = $el.closest('tr');

                settings.save({
                    table: $el.closest('table').attr('id'),
                    field: $el.data('field'),
                    oldValue,
                    newValue,
                    row: $row
                });
            }

            if (move === 'next') focusNext($el);
            if (move === 'prev') focusPrev($el);
        };

        const focusNext = ($current) => {
            const $table = $current.closest('table');
            const $all = getAllEditables($table);
            const index = $all.index($current);

            if (index < $all.length - 1) {
                setTimeout(() => startEdit($($all[index + 1])), 50);
            }
        };

        const focusPrev = ($current) => {
            const $table = $current.closest('table');
            const $all = getAllEditables($table);
            const index = $all.index($current);

            if (index > 0) {
                setTimeout(() => startEdit($($all[index - 1])), 50);
            }
        };

        const bindInputEvents = ($el, $input) => {

            const oldValue = $el.data('oldValue');

            $input.on('keydown blur', function (e) {

                // SHIFT + TAB → previous
                if (e.key === 'Tab' && e.shiftKey) {
                    e.preventDefault();
                    finishEdit($el, 'prev');
                    return;
                }

                // TAB → next
                if (e.key === 'Tab') {
                    e.preventDefault();
                    finishEdit($el, 'next');
                    return;
                }

                // ENTER → save
                if (e.key === 'Enter') {
                    finishEdit($el);
                    return;
                }

                // ESC → cancel
                if (e.key === 'Escape') {
                    $el.text(oldValue);
                    editing = false;
                    return;
                }

                // BLUR → save
                if (e.type === 'blur') {
                    finishEdit($el);
                }
            });
        };

        return this.each(function () {
            const $table = $(this);

            $table.on('click', settings.editableSelector, function (e) {
                e.preventDefault();
                startEdit($(this));
            });
        });
    };

})(jQuery);
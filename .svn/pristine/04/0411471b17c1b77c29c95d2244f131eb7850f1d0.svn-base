const CaseModalCreateModule = (() => {

    const CASE_API = "case";

    let validator = null;

    function init() {

        formValidation();
        $('#caseModal').on('shown.bs.modal', function () {
            loadDropdowns();
        });
        $("#bank").on("change", loadBranches);

        $('#caseModal').on('shown.bs.modal', function () {

            setDefaultValues();
            loadDropdowns();

        });

        $("#btnSaveQuickCase").on("click", saveQuickCase);
        $("#btnAddMoreProperty").on("click", saveAndRedirect);

        $("#caseModal").on("hidden.bs.modal", resetForm);
    }
    function setDefaultValues() {

        const today = new Date();
        const formattedDate = today.toISOString().split("T")[0];

        $("#caseDate").val(formattedDate);
        $("#caseID").val(""); // empty until save
    }
    function loadDropdowns() {

        lov.populateDropdown( "case-type/name", "#caseType", "Select Case Type" );
        lov.populateDropdown( "bank/name", "#bank", "Select Bank" );
        lov.populateDropdown("case-property/property-type", "#propertyType", "Select Property Type" );
        lov.populateUserDropdown( "user?role=Visitor", "#caseVisitor", "Select Visitor" );
        lov.populateUserDropdown( "user?role=Report Maker", "#caseReportMaker", "Select Report Maker" );
    }
    function loadBranches() {

        const bankId = $("#bank").val();

        if (!bankId) {
            $("#bankBranch").empty().append(`<option value="">Select Bank Branch</option>`);
            return;
        }

        lov.populateDropdown( `bank-branch/name?bankId=${bankId}`, "#bankBranch", "Select Bank Branch" );
    }
    function formValidation() {

        validator = $("#caseModal").find("form").validate({
            errorElement: "span",
            rules: {
                caseType: { required: true },
                bank: { required: true },
                propertyName: { required: true },
                propertyAddress: { required: true }
            },
            messages: {
                caseType: "Select Case Type",
                bank: "Select Bank",
                propertyName: "Enter Property Name",
                propertyAddress: "Enter Property Address"
            },
            errorPlacement: function (error, element) {
                error.insertAfter(element);
                error.addClass("text-danger");
            }
        });
    }
    
    function getPriority() {

        if ($("#highPriority").is(":checked")) return 1;
        if ($("#mediumPriority").is(":checked")) return 2;
        if ($("#lowPriority").is(":checked")) return 3;

        return 2;
    }

    function getFormData() {

        return {
            case_type: parseInt($("#caseType").val()),
            priority: getPriority(),
            case_status_id: 1,
            bank_id: parseInt($("#bank").val()),
            bank_branch_id: $("#bankBranch").val() || null,
            bank_case_id: $("#bankCaseId").val(),
            visitor_id: $("#caseVisitor").val() || null,
            report_maker_id: $("#caseReportMaker").val() || null,
            customer_name: $("#custName").val(),
            customer_contact: $("#custContactNo").val(),
            bill_date: $("#caseDate").val(),
            property_name: $("#propertyName").val(),
            property_address: $("#propertyAddress").val(),
            property_type: $("#propertyType").val() || null
        };
    }

    function saveQuickCase() {

        if (!validator.form()) return;

        const data = getFormData();

        callBasePostAPI(CASE_API, data,
            function () {

                successToastr("Case created successfully");
                $("#caseModal").modal("hide");

                CaseModule.caseInit(); // reload list
            },
            commonError
        );
    }

    function saveAndRedirect() {

        if (!validator.form()) return;

        const data = getFormData();

        callBasePostAPI(CASE_API, data,
            function (response) {

                successToastr("Case created successfully");

                window.location.href = "/case/create/" + response.case_id;
            },
            commonError
        );
    }

    function resetForm() {

        $("#caseModal input").val("");
        $("#caseModal select").val("").trigger("change");

        if (validator) {
            validator.resetForm();
            $(".is-invalid").removeClass("is-invalid");
        }
    }

    return {
        init
    };

})();

$(document).ready(CaseModalCreateModule.init);
CREATE OR REPLACE FUNCTION public.dashboard_case_statistics()
    RETURNS jsonb
    LANGUAGE 'plpgsql'
    COST 100
    VOLATILE PARALLEL UNSAFE
AS $BODY$
/*
    select dashboard_case_statistics();
*/
BEGIN
    RETURN (
        SELECT jsonb_build_object(

            'new_cases',
                COALESCE((
                    SELECT COUNT(*) 
                    FROM public."case"
                    WHERE case_status_id = 1
                ), 0),

            'site_visit_cases',
                COALESCE((
                    SELECT COUNT(*) 
                    FROM public."case"
                    WHERE case_status_id = 2
                ), 0),

            'report_in_progress_cases',
                COALESCE((
                    SELECT COUNT(*) 
                    FROM public."case"
                    WHERE case_status_id = 3
                ), 0),

            'under_review_cases',
                COALESCE((
                    SELECT COUNT(*) 
                    FROM public."case"
                    WHERE case_status_id = 4
                ), 0),

            'completed_cases',
                COALESCE((
                    SELECT COUNT(*) 
                    FROM public."case"
                    WHERE case_status_id = 5
                ), 0),

            'hold_cancelled_cases',
                COALESCE((
                    SELECT COUNT(*) 
                    FROM public."case"
                    WHERE case_status_id IN (6,7)
                ), 0)

        )
    );
END;
$BODY$;

ALTER FUNCTION public.dashboard_case_statistics()
    OWNER TO postgres;

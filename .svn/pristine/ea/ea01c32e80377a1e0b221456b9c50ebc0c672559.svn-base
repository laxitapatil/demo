using Core.Domain;
using Core.Enumeration;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.ComponentModel.DataAnnotations;
using System.Reflection;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class CaseDocumentRepository : BaseRepository
    {
        public CaseDocumentRepository(DBContext dbContext) : base(dbContext) { }


        #region CRUD

        public async Task<int> Insert(CaseDocument caseDocument)
        {
            await dbContext.Set<CaseDocument>().AddAsync(caseDocument);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(CaseDocument caseDocument)
        {
            dbContext.Set<CaseDocument>().Update(caseDocument);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(CaseDocument caseDocument)
        {
            dbContext.Set<CaseDocument>().Remove(caseDocument);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<CaseDocument?> SelectOne(int id)
        {
            return await dbContext.Set<CaseDocument>()
                .Where(x => x.Id == id)
                .FirstOrDefaultAsync();
        }

        public async Task<JsonNode?> SelectAll(int? id, int? propertyId)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_property_id", propertyId);

            string? response = await connection.QueryFirstAsync<string>( @"SELECT public.case_document_selectall(@_id, @_property_id)", parameter );
            return string.IsNullOrWhiteSpace(response) ? JsonNode.Parse("[]") : JsonNode.Parse(response);
        }

        #endregion

        #region Dropdown

        public async Task<List<SelectListResponse>> SelectDocumentType()
        {
            var documentType = Enum.GetValues(typeof(DocumentType))
                .Cast<DocumentType>()
                .Select(type =>
                {
                    var displayAttribute = type
                        .GetType()
                        .GetMember(type.ToString())
                        .First()
                        .GetCustomAttributes<DisplayAttribute>()
                        .FirstOrDefault();

                    return new SelectListResponse
                    {
                        id = (short)type,
                        name = displayAttribute?.Name ?? type.ToString()
                    };
                })
                .ToList();

            return await Task.FromResult(documentType);
        }

        #endregion
    }
}
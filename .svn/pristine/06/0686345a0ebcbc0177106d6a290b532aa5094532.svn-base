using System.ComponentModel.DataAnnotations;

namespace Core.Request
{
    public class PropertyTypeMasRequest
    {
        public short? Id { get; set; }

        [Required(ErrorMessage = "Please enter Property Type.")]
        [MaxLength(64, ErrorMessage = "Max length reached for Property Type.")]
        public string Name { get; set; }

        [Required(ErrorMessage = "Please specify if Property Type is active.")]
        public bool Is_active { get; set; }
    }
}
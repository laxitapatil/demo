$(document).ready(function () {
    fillCaseTable();

    $('#tblCase').inlineEditor({
        save: function (data) {

            const caseId = data.row.find('td:eq(2)').text();

            console.log({
                caseId,
                field: data.field,
                value: data.newValue,
                text: data.displayText ?? data.newValue
            });

            // AJAX save
            /*
            $.post('/Cases/UpdateField', {
                id: caseId,
                field: data.field,
                value: data.newValue
            });
            */
        }
    });

});
function fillCaseTable(){
    setDataTable("#tblCase", options = {
        scrollY: '500px', // fixed height
        scrollCollapse: false,
        columnDefs: [
            {
                targets: 0,
                orderable: false,
                width: '30px',
            }
        ],
        autoWidth: false
    });
}
using Dapper;
using Infrastructure.Base;
using Npgsql;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class DashboardRepository : BaseRepository
    {
        private readonly DBContext _dbContext;

        public DashboardRepository(DBContext dBContext) => _dbContext = dBContext;

        public async Task<JsonNode?> SelectDashboardStatistics(int? userId)
        {
            DynamicParameters parameter = new();
            parameter.Add("_user_id", userId);

            using NpgsqlConnection connection = new(connectionString);
            string? response = await connection.QueryFirstAsync<string>("SELECT dashboard_statistics(@_user_id)", parameter);
            return string.IsNullOrWhiteSpace(response) ? JsonNode.Parse("[]") : JsonNode.Parse(response);
        }

    }
}
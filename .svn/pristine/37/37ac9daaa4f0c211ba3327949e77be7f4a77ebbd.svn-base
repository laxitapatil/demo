using Core.Domain;
using Core.Enumeration;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.ComponentModel.DataAnnotations;
using System.Reflection;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class CaseDocumentRepository : BaseRepository
    {
        private readonly DBContext _dbContext;

        public CaseDocumentRepository(DBContext dBContext)
        {
            _dbContext = dBContext;
        }

        #region CRUD

        public async Task<int> Insert(CaseDocument caseDocument)
        {
            await _dbContext.Set<CaseDocument>().AddAsync(caseDocument);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(CaseDocument caseDocument)
        {
            _dbContext.Set<CaseDocument>().Update(caseDocument);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(CaseDocument caseDocument)
        {
            _dbContext.Set<CaseDocument>().Remove(caseDocument);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<CaseDocument?> SelectOne(int id)
        {
            return await _dbContext.Set<CaseDocument>()
                .Where(x => x.Id == id)
                .FirstOrDefaultAsync();
        }

        public async Task<JsonNode?> SelectAll(int? id, int? caseId, int? propertyId, short? docType)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_case_id", caseId);
            parameter.Add("_property_id", propertyId);
            parameter.Add("_doc_type", docType);

            using NpgsqlConnection connection = new(connectionString);
            string? response = await connection.QueryFirstAsync<string>(
                @"SELECT public.case_document_selectall(@_id, @_case_id, @_property_id, @_doc_type)",
                parameter
            );

            return string.IsNullOrWhiteSpace(response)
                ? JsonNode.Parse("[]")
                : JsonNode.Parse(response);
        }

        #endregion

        #region Dropdown

        public async Task<List<SelectListResponse>> SelectDocumentType()
        {
            var documentType = Enum.GetValues(typeof(DocumentType))
                .Cast<DocumentType>()
                .Select(type =>
                {
                    var displayAttribute = type
                        .GetType()
                        .GetMember(type.ToString())
                        .First()
                        .GetCustomAttributes<DisplayAttribute>()
                        .FirstOrDefault();

                    return new SelectListResponse
                    {
                        id = (short)type,
                        name = displayAttribute?.Name ?? type.ToString()
                    };
                })
                .ToList();

            return await Task.FromResult(documentType);
        }

        #endregion
    }
}
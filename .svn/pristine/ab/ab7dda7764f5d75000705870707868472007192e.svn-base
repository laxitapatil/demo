using Api.Provider;
using AutoMapper;
using Core.Domain;
using Core.Request;
using Core.Response;
using Infrastructure;
using Infrastructure.Base;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Api.Controllers
{
    [Tags("State")]
    [Authorize]
    [Route("api/state")]
    [ApiController]
    public class StateMasController : BaseController
    {
        private readonly string STATE_MAS = "State";

        public StateMasController(IConfiguration configuration, IMapper mapper, DBContext dbContext)
            : base(configuration, mapper, dbContext) { }

        /// <summary>
        /// Get list of states.
        /// </summary>
        /// <param name="id"></param>
        /// <param name="isActive"></param>
        /// <returns></returns>
        [Authorize]
        [HttpGet("get")]
        public async Task<IActionResult> Get(int? id, bool? isActive)
        {
            try
            {
                return Ok(await new StateMasRepository(dbContext).SelectAll(id, isActive));
            }
            catch (Exception ex)
            {
                return Problem(ex.ToString(), statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get name of state 
        /// </summary>
        /// <returns></returns>
        [Authorize]       
        [HttpGet("name")]
        public async Task<IActionResult> GetName()
        {
            try
            {
                using StateMasRepository repoState = new(dbContext);
                var response = await repoState.SelectName();
                return Ok(response);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }


        /// <summary>
        /// Create a new State.
        /// </summary>
        /// <returns>200 - Success message, 401 Unauthorized, 400 Bad request - Error message, 500 Internal Server Error - Error message</returns>
        [Authorize(Roles = "Admin")]
        [HttpPost]
        public async Task<IActionResult> Post(StateMasRequest request)
        {
            try
            {
                StateMas stateMas = mapper.Map<StateMasRequest, StateMas>(request);
                using StateMasRepository repoState = new(dbContext);

                stateMas.Modified_by = TokenName;
                stateMas.Modified_date= CurrentTime;

                int result = await repoState.Insert(stateMas);

                return result > 0
                    ? Ok(mapper.Map<StateMas, StateMasResponse>(stateMas))
                    : Problem(string.Format(MessageProvider.INSERT_FAILED, STATE_MAS), statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                string error = ex.ToString().ToLower();

                if (error.Contains("uk_state_name"))
                    return Problem(string.Format(MessageProvider.ALREADY_EXISTS, "State Name"),statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }

        }

        /// <summary>
        /// Update details of a state.
        /// </summary>
        /// <param name="request"></param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPut]
        public async Task<IActionResult> Put(StateMasRequest request)
        {
            try
            {
                if (!request.Id.HasValue || request.Id < 1)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, STATE_MAS), statusCode: StatusCodes.Status404NotFound);

                using StateMasRepository repoState = new(dbContext);
                StateMas? stateMas = await repoState.SelectOne(request.Id.Value);

                if (stateMas == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, STATE_MAS), statusCode: StatusCodes.Status404NotFound);

                stateMas.Name = request.Name;
                stateMas.Is_active = request.Is_active;
           
                stateMas.Modified_by = TokenName;
                stateMas.Modified_date = CurrentTime;


                int result = await repoState.Update(stateMas);
                return result > 0
                     ? Ok(mapper.Map<StateMas, StateMasResponse>(stateMas))
                     : Problem(string.Format(MessageProvider.UPDATE_FAILED, STATE_MAS), statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                string error = ex.ToString().ToLower();

                if (error.Contains("uk_state_name"))
                    return Problem(string.Format(MessageProvider.ALREADY_EXISTS, "State Name"), statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }

        }

        /// <summary>
        /// Delete a state.
        /// </summary>
        /// <param name="id"></param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(int id)
        {
            try
            {
                using StateMasRepository repoState = new(dbContext);
                StateMas? stateMas = await repoState.SelectOne(id);

                if (stateMas == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, STATE_MAS), statusCode: StatusCodes.Status404NotFound);

                await repoState.Delete(stateMas);
                return Ok(string.Format(MessageProvider.DELETE_SUCCESS, STATE_MAS));
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk"))
                    return Problem(MessageProvider.CHILD_FOUND, statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get details of a state by id.
        /// </summary>
        /// <param name="id"></param>
        /// <returns></returns>
        [HttpGet("{id}")]
        public async Task<IActionResult> GetOne(int id)
        {
            try
            {
                using StateMasRepository repoState = new(dbContext);
                var stateMas = await repoState.SelectOne(id);

                if (stateMas == null)
                    return NotFound(string.Format(MessageProvider.NOT_FOUND, STATE_MAS));

                return Ok(mapper.Map<StateMas, StateMasResponse>(stateMas));
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Activate/Deactivate a state.
        /// </summary>
        /// <param name="id"></param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPut("update-status/{id}")]
        public async Task<IActionResult> UpdateStatus(short id)
        {
            try
            {
                using StateMasRepository repoState = new(dbContext);
                StateMas? stateMas = await repoState.SelectOne(id);

                if (stateMas == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, STATE_MAS), statusCode: StatusCodes.Status404NotFound);

                stateMas.Is_active = !stateMas.Is_active;
                stateMas.Modified_by = TokenName;
                stateMas.Modified_date = CurrentTime;

                int result = await repoState.Update(stateMas);

                if (result > 0)
                    return Ok(mapper.Map<StateMas, StateMasResponse>(stateMas));
                else
                    return Problem(string.Format(MessageProvider.UPDATE_FAILED, STATE_MAS),
                        statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                return Problem(ex.ToString(), statusCode: StatusCodes.Status500InternalServerError);
            }
        }

    }
}
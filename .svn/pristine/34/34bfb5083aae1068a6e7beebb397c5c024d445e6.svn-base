using Core.Domain;
using Core.Enumeration;
using Core.Request;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class CaseRepository : BaseRepository
    {
        public CaseRepository(DBContext dbContext) : base(dbContext) { }


        #region CRUD

        public async Task<int> Insert(Case caseEntity)
        {
            await dbContext.Set<Case>().AddAsync(caseEntity);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(Case caseEntity)
        {
            dbContext.Set<Case>().Update(caseEntity);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(Case caseEntity)
        {
            dbContext.Set<Case>().Remove(caseEntity);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<Case?> SelectOne(int id)
        {
            return await dbContext.Set<Case>()
                .Where(x => x.Id == id)
                .FirstOrDefaultAsync();
        }

        public async Task<Case?> SelectByCaseId(string caseId)
        {
            return await dbContext.Set<Case>()
                .Where(x => x.Case_id == caseId)
                .FirstOrDefaultAsync();
        }

        public async Task<JsonNode?> SelectPropetryDetails(int caseId)
        {
            DynamicParameters parameter = new();
            parameter.Add("_case_id", caseId);
            string? response = await connection.QueryFirstAsync<string>(@"SELECT public.case_wise_property_details(@_case_id)", parameter);
            return string.IsNullOrWhiteSpace(response) ? JsonNode.Parse("[]") : JsonNode.Parse(response);
        }

        public async Task<JsonNode?> SelectAll(CaseFilterRequest request)
        {
            DynamicParameters parameter = new();
            parameter.Add("_from_date", request.From_date);
            parameter.Add("_to_date", request.To_date);
            parameter.Add("_bank_id", request.Bank_id);
            parameter.Add("_case_status_id", request.Status);
            parameter.Add("_visitor_id", request.Visitor_id);
            parameter.Add("_reporter_id", request.Reporter_id);
            parameter.Add("_search_text", request.Search_text);
            parameter.Add("_id", request.id);
            parameter.Add("_case_id", request.case_id);

            string? response = await connection.QueryFirstAsync<string>(@"SELECT public.case_selectall(@_from_date, @_to_date, @_bank_id, @_case_status_id, @_visitor_id, @_reporter_id, @_search_text, @_id, @_case_id)", parameter );

            return string.IsNullOrWhiteSpace(response)? JsonNode.Parse("[]") : JsonNode.Parse(response);
        }
        #endregion

        public async Task<List<SelectListResponse>> SelectPriorityType()
        {
            var typeValues = Enum.GetValues(typeof(CasePriority))
                .Cast<CasePriority>()
                .Select(status => new SelectListResponse
                {
                    id = (short)status,
                    name = status.ToString()
                })
                .ToList();

            return await Task.FromResult(typeValues);
        }
    }
}
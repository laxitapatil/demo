using Api.Provider;
using AutoMapper;
using Core.Domain;
using Core.Request;
using Core.Response;
using Infrastructure;
using Infrastructure.Base;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Api.Controllers
{
    [Tags("Case Type")]
    [Authorize]
    [Route("api/case-type")]
    [ApiController]
    public class CaseTypeMasController : BaseController
    {
        private readonly string CASE_TYPE_MAS = "Case Type";

        public CaseTypeMasController(IConfiguration configuration, IMapper mapper, DBContext dbContext)
            : base(configuration, mapper, dbContext) { }

        /// <summary>
        /// Get list of case types based on filter criteria.
        /// </summary>
        /// <param name="id"></param>
        /// <param name="isActive"></param>
        /// <returns></returns>
        [Authorize]
        [HttpGet("get")]
        public async Task<IActionResult> Get(short? id, bool? isActive)
        {
            try
            {
                return Ok(await new CaseTypeMasRepository(dbContext).SelectAll(id, isActive));
            }
            catch (Exception ex)
            {
                return Problem(ex.ToString(), statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get list of case type id and name for active case types.
        /// </summary>
        /// <returns></returns>
        [Authorize]       
        [HttpGet("name")]
        public async Task<IActionResult> GetName()
        {
            try
            {
                using CaseTypeMasRepository repoCaseType = new(dbContext);
                var response = await repoCaseType.SelectName();
                return Ok(response);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Add a new case type.
        /// </summary>
        /// <param name="request"></param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPost]
        public async Task<IActionResult> Post(CaseTypeMasRequest request)
        {
            try
            {
                CaseTypeMas caseTypeMas = mapper.Map<CaseTypeMasRequest, CaseTypeMas>(request);
                using CaseTypeMasRepository repoCaseType = new(dbContext);

                caseTypeMas.Modified_by = TokenName;
                caseTypeMas.Modified_date= CurrentTime;

                int result = await repoCaseType.Insert(caseTypeMas);

                return result > 0
                    ? Ok(mapper.Map<CaseTypeMas, CaseTypeMasResponse>(caseTypeMas))
                    : Problem(string.Format(MessageProvider.INSERT_FAILED, CASE_TYPE_MAS), statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                string error = ex.ToString().ToLower();

                if (error.Contains("uk_state_name"))
                    return Problem(string.Format(MessageProvider.ALREADY_EXISTS, CASE_TYPE_MAS),statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }

        }

        /// <summary>
        /// Update details of a Case Type.
        /// </summary>
        /// <param name="request"></param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPut]
        public async Task<IActionResult> Put(CaseTypeMasRequest request)
        {
            try
            {
                if (!request.Id.HasValue || request.Id < 1)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_TYPE_MAS), statusCode: StatusCodes.Status404NotFound);

                using CaseTypeMasRepository repoCaseType = new(dbContext);
                CaseTypeMas? caseTypeMas = await repoCaseType.SelectOne(request.Id.Value);

                if (caseTypeMas == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_TYPE_MAS), statusCode: StatusCodes.Status404NotFound);

                caseTypeMas.Name = request.Name;
                caseTypeMas.Is_active = request.Is_active;
           
                caseTypeMas.Modified_by = TokenName;
                caseTypeMas.Modified_date = CurrentTime;


                int result = await repoCaseType.Update(caseTypeMas);
                return result > 0
                     ? Ok(mapper.Map<CaseTypeMas, CaseTypeMasResponse>(caseTypeMas))
                     : Problem(string.Format(MessageProvider.UPDATE_FAILED, CASE_TYPE_MAS), statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                string error = ex.ToString().ToLower();

                if (error.Contains("uk_state_name"))
                    return Problem(string.Format(MessageProvider.ALREADY_EXISTS, "State Name"), statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }

        }

        /// <summary>
        /// Delete a case type. If any child record found then it will not delete and return error message.
        /// </summary>
        /// <param name="id"></param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(short id)
        {
            try
            {
                using CaseTypeMasRepository repoCaseType = new(dbContext);
                CaseTypeMas? caseTypeMas = await repoCaseType.SelectOne(id);

                if (caseTypeMas == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_TYPE_MAS), statusCode: StatusCodes.Status404NotFound);

                await repoCaseType.Delete(caseTypeMas);
                return Ok(string.Format(MessageProvider.DELETE_SUCCESS, CASE_TYPE_MAS));
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk"))
                    return Problem(MessageProvider.CHILD_FOUND, statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get details of a case type based on id.
        /// </summary>
        /// <param name="id"></param>
        /// <returns></returns>
        [HttpGet("{id}")]
        public async Task<IActionResult> GetOne(short id)
        {
            try
            {
                using CaseTypeMasRepository repoCaseType = new(dbContext);
                var caseTypeMas = await repoCaseType.SelectOne(id);

                if (caseTypeMas == null)
                    return NotFound(string.Format(MessageProvider.NOT_FOUND, CASE_TYPE_MAS));

                return Ok(mapper.Map<CaseTypeMas, CaseTypeMasResponse>(caseTypeMas));
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Update active/inactive status of a case type. If active then it will be inactive and vice versa.
        /// </summary>
        /// <param name="id"></param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPut("update-status/{id}")]
        public async Task<IActionResult> UpdateStatus(short id)
        {
            try
            {
                using CaseTypeMasRepository repoCaseType = new(dbContext);
                CaseTypeMas? caseTypeMas = await repoCaseType.SelectOne(id);

                if (caseTypeMas == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_TYPE_MAS), statusCode: StatusCodes.Status404NotFound);

                caseTypeMas.Is_active = !caseTypeMas.Is_active;
                caseTypeMas.Modified_by = TokenName;
                caseTypeMas.Modified_date = CurrentTime;

                int result = await repoCaseType.Update(caseTypeMas);

                if (result > 0)
                    return Ok(mapper.Map<CaseTypeMas, CaseTypeMasResponse>(caseTypeMas));
                else
                    return Problem(string.Format(MessageProvider.UPDATE_FAILED, CASE_TYPE_MAS),
                        statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                return Problem(ex.ToString(), statusCode: StatusCodes.Status500InternalServerError);
            }
        }

    }
}
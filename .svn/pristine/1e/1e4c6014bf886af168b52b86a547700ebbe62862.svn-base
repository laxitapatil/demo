using Core.Domain;
using Core.Enumeration;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.ComponentModel.DataAnnotations;
using System.Reflection;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class BankRepository : BaseRepository
    {
        public BankRepository(DBContext dbContext) : base(dbContext) { }


        #region AutoGenerated

        public async Task<int> Insert(Bank bank)
        {
            await dbContext.Set<Bank>().AddAsync(bank);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(Bank bank)
        {
            dbContext.Set<Bank>().Update(bank);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(Bank bank)
        {
            dbContext.Set<Bank>().Remove(bank);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<Bank?> SelectOne(int id)
        {
            return await dbContext.Set<Bank>()
                .Where(x => x.Id == id)
                .FirstOrDefaultAsync();
        }

        public async Task<Bank?> SelectByName(string name)
        {
            return await dbContext.Set<Bank>()
                .Where(x => x.Name == name)
                .FirstOrDefaultAsync();
        }

        public async Task<string?> SelectBankCode(int bankId)
        {
            return await dbContext.Set<Bank>()
                .Where(b => b.Id == bankId)
                .Select(b => b.Code)
                .FirstOrDefaultAsync();
        }
        public async Task<JsonNode?> SelectAll(int? id, bool? isActive)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_is_active", isActive);

            string? response = await connection.QueryFirstAsync<string>( @"SELECT public.bank_selectall(@_id, @_is_active)", parameter );

            return string.IsNullOrWhiteSpace(response)? JsonNode.Parse("[]"): JsonNode.Parse(response);
        }


        #endregion

        #region Dropdown

        public async Task<List<SelectListResponse>> SelectName()
        {
            return await dbContext.Banks
                .Where(bank => bank.Is_active)
                .OrderBy(bank => bank.Name)
                .Select(bank => new SelectListResponse
                {
                    id = (short)bank.Id,
                    name = bank.Name
                })
                .ToListAsync();
        }

        public async Task<List<SelectListResponse>> SelectTemplateType()
        {
            var templateType = Enum.GetValues(typeof(TemplateType))
                .Cast<TemplateType>()
                .Select(type =>
                {
                    var displayAttribute = type
                        .GetType()
                        .GetMember(type.ToString())
                        .First()
                        .GetCustomAttributes<DisplayAttribute>()
                        .FirstOrDefault();

                    return new SelectListResponse
                    {
                        id = (short)type,
                        name = displayAttribute?.Name ?? type.ToString()
                    };
                })
                .ToList();

            return await Task.FromResult(templateType);
        }


        #endregion
    }
}
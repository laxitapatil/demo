using Api.Provider;
using AutoMapper;
using Core.Domain;
using Core.Request;
using Core.Response;
using Infrastructure;
using Infrastructure.Base;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Api.Controllers
{
    [Tags("Case Status Log")]
    [Authorize]
    [Route("api/case-status-log")]
    [ApiController]
    public class CaseStatusLogController : BaseController
    {
        private readonly string CASE_STATUS_LOG = "Case status log";
        private readonly string CASE = "Case";

        public CaseStatusLogController(IConfiguration configuration, IMapper mapper, DBContext dbContext)
            : base(configuration, mapper, dbContext) { }

        /// <summary>
        /// Retrieve information about a specific / all Case Status Logs based on the ID.
        /// </summary>
        /// <param name="id">if null then all, else specific</param>
        /// <param name="caseId">filter by case ID</param>
        /// <returns>200 - Case Status Log detail, 401 Unauthorized, 500 Internal Server Error - Error message</returns>
        [HttpGet]
        public async Task<IActionResult> Get(int? id, string? caseId)
        {
            try
            {
                using CaseRepository repo = new(dbContext);

                Case? caseEntity = null;
                if (int.TryParse(caseId, out int intCaseId))
                {
                    caseEntity = await repo.SelectOne(intCaseId);
                }
                else
                {
                    caseEntity = await repo.SelectByCaseId(caseId);
                }
                if (caseEntity == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE), statusCode: StatusCodes.Status404NotFound);

                return Ok(await new CaseStatusLogRepository(dbContext).SelectAll(id, caseEntity.Id));
            }
            catch (Exception ex)
            {
                return Problem(ex.ToString(), statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Create a new Case Status Log.
        /// </summary>
        /// <param name="req">Id Optional</param>
        /// <returns>200 - Success message, 401 Unauthorized, 400 Bad request - Error message, 500 Internal Server Error - Error message</returns>
        [HttpPost]
        public async Task<IActionResult> Post(CaseStatusLogRequest req)
        {
            try
            {
                CaseStatusLog caseStatusLog = mapper.Map<CaseStatusLogRequest, CaseStatusLog>(req);

                caseStatusLog.Last_modified_by = TokenName;
                caseStatusLog.Last_modified_date = CurrentTime;

                using CaseStatusLogRepository repoCaseStatusLog = new(dbContext);
                int result = await repoCaseStatusLog.Insert(caseStatusLog);

                return result > 0
                    ? Ok(string.Format(MessageProvider.INSERT_SUCCESS, CASE_STATUS_LOG))
                    : Problem(string.Format(MessageProvider.INSERT_FAILED, CASE_STATUS_LOG), statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Modify the details of an existing Case Status Log.
        /// </summary>
        /// <param name="req"></param>
        /// <returns>200 - Success message, 401 Unauthorized, 400 Bad request - Error message, 500 Internal Server Error - Error message</returns>
        [HttpPut]
        public async Task<IActionResult> Put(CaseStatusLogRequest req)
        {
            try
            {
                if (!req.Id.HasValue || req.Id < 1)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_STATUS_LOG), statusCode: StatusCodes.Status404NotFound);

                using CaseStatusLogRepository repoCaseStatusLog = new(dbContext);
                CaseStatusLog caseStatusLog = await repoCaseStatusLog.SelectOne(req.Id.Value);

                if (caseStatusLog == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_STATUS_LOG), statusCode: StatusCodes.Status404NotFound);

                caseStatusLog.Case_id = req.Case_id;
                caseStatusLog.Case_status_id = req.Case_status_id;
                caseStatusLog.Remark = req.Remark;
                caseStatusLog.Last_modified_by = TokenName;
                caseStatusLog.Last_modified_date = CurrentTime;

                int result = await repoCaseStatusLog.Update(caseStatusLog);
                return result > 0
                    ? Ok(string.Format(MessageProvider.INSERT_SUCCESS, CASE_STATUS_LOG))
                     : Problem(string.Format(MessageProvider.UPDATE_FAILED, CASE_STATUS_LOG), statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Delete an existing Case Status Log.
        /// </summary>
        /// <param name="id"></param>
        /// <returns>200 - Success message, 401 Unauthorized, 400 Bad request - Error message, 500 Internal Server Error - Error message</returns>
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(int id)
        {
            try
            {
                using CaseStatusLogRepository repoCaseStatusLog = new(dbContext);
                CaseStatusLog caseStatusLog = await repoCaseStatusLog.SelectOne(id);

                if (caseStatusLog == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_STATUS_LOG), statusCode: StatusCodes.Status404NotFound);

                await repoCaseStatusLog.Delete(caseStatusLog);
                return Ok(string.Format(MessageProvider.DELETE_SUCCESS, CASE_STATUS_LOG));
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk"))
                    return Problem(MessageProvider.CHILD_FOUND, statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }
    }
}
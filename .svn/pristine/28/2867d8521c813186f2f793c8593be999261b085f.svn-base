const BankVerticalModule = (() => {

    const VERTICAL_API = "bank-vertical";
    const VERTICAL_TABLE = "#tblBankVertical";

    const $verticalTable = $(VERTICAL_TABLE);
    let dataTable = null;
    

    function verticalInit() {

        if (!branchId) {
            errorToastr("Invalid Branch.");
            window.location.href = "/BankBranch";
            return;
        }

        verticalGet();
    }

    function verticalGet() {
        callBaseGetAPI(`${VERTICAL_API}?branchId=${branchId}`, verticalFill, commonError);
    }

    function verticalFill(data) {

        if (!Array.isArray(data)) {
            errorToastr("Bank vertical data not found.");
            return;
        }

        if (dataTable) {
            dataTable.clear().rows.add(data).draw();
            return;
        }

        dataTable = setDataTable($verticalTable, {
            data: data,
            scrollY: '600px',
            scrollCollapse: false,
            autoWidth: false,
            columnDefs: [
                {
                    targets: 0,
                    width: '80px',
                    orderable: false,
                    className: "dt-center"
                },
                {
                    targets: 1,
                    width: '60px',
                    orderable: false
                },
                {
                    targets: 3,
                    width: '80px',
                    orderable: false,
                    className: "dt-center"
                }
            ],
            columns: [

                // ACTION
                {
                    data: "id",
                    render: function (id) {
                        return `
                            <div class="dropdown text-center">
                                <a href="javascript:void(0);" 
                                   class="fw-semibold font-size-18 link-secondary"
                                   data-bs-toggle="dropdown">
                                    <i class="fi fi-rr-menu-dots"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-item"
                                           onclick="BankVerticalCreateModule.verticalEdit(${id})">
                                           <i class="fi fi-rr-edit me-2"></i> Edit
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger"
                                           onclick="BankVerticalModule.verticalDelete(${id})">
                                           <i class="fi fi-rr-trash me-2"></i> Delete
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        `;
                    }
                },

                // SR NO
                {
                    data: null,
                    render: (_, __, ___, meta) =>
                        meta.row + meta.settings._iDisplayStart + 1
                },

                // VERTICAL NAME
                {
                    data: "name"
                },

                // STATUS
                {
                    data: "is_active",
                    render: function (isActive, type, row) {
                        return `
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                    type="checkbox"
                                    ${isActive ? "checked" : ""}
                                    onchange="BankVerticalModule.verticalStatusUpdate(${row.id})">
                            </div>
                        `;
                    }
                }
            ],
            initComplete: function () {
                applyColumnFilters(this.api(), {
                    noFilterColumns: [0, 3]
                });
            }
        });
    }

    function verticalDelete(id) {
        lov.genericDelete(id, VERTICAL_API, "Bank Vertical", verticalGet);
    }

    function verticalStatusUpdate(id) {
        lov.genericStatusUpdate(id, VERTICAL_API, verticalGet);
    }

    return {
        verticalInit,
        verticalDelete,
        verticalStatusUpdate
    };

})();

$(document).ready(BankVerticalModule.verticalInit);
@{
    ViewData["Title"] = "Create Case";
}
@section Styles {
    <style>
        .table-responsive {
            overflow-x: auto;
            overflow-y: visible !important;
        }
    </style>
}
<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">

            <!-- At left -->
            <div class="d-flex align-items-center gap-3">

                <h4 class="mb-0">
                    Case Details
                    <small id="caseCreateDateShow" class="text-muted ms-2"></small>
                </h4>

                <div class="d-flex align-items-center gap-2">
                    <label class="badge badge-new-case m-0" id="caseCreateStatus"></label>

                    <a href="javascript:void(0)" class="text-primary case-status-btn" title="Update Status">
                        <i class="fi fi-rr-refresh"></i>
                    </a>
                </div>

            </div>

            <!-- At right -->
            <div class="page-title-right d-flex align-items-center gap-2">
                <a href="/case" id="btnBackToCases" class="btn btn-outline-light">
                    <i class="fi-rr-arrow-small-left me-2"></i>Back to Cases
                </a>
            </div>

        </div>
    </div>
</div>

<form id="caseCreateForm" method="post">
    <div class="card">
        <div class="card-body">
            <div class="row gy-3 mb-3">
                <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <div>
                        <label>Billing Month</label>
                        <input type="month" class="form-control" id="caseBillingDate" name="caseBillingDate" />
                    </div>
                </div>
                <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <div>
                        <label>Case ID</label>
                        <input type="text" class="form-control" id="caseCreateNo" name="caseCreateNo" readonly />
                    </div>
                </div>
                <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <div>
                        <label>Case Type</label>
                        <select class="form-control select2" select2="true" id="caseCreateType" name="caseCreateType">
                        </select>
                    </div>
                </div>

                <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label>Bank</label>
                    <select class="form-control select2" select2="true" id="caseCreateBank" name="caseCreateBank">
                    </select>
                </div>
                <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label>Bank Branch</label>
                    <select class="form-control select2" select2="true" id="caseCreateBankBranch" name="caseCreateBankBranch">
                    </select>
                </div>
                <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label>Bank Dept.</label>
                    <select class="form-control select2" select2="true" id="caseCreatebankDept" name="caseCreatebankDept">
                    </select>
                </div>
                <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label>Bank Case ID</label>
                    <input type="text" class="form-control" id="caseCreateBankCaseId" name="caseCreateBankCaseId" placeholder="Bank Case ID" maxlength="64"/>
                </div>
                <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label>Visitor</label>
                    <select class="form-control select2" select2="true" id="caseCreateVisitor" name="caseCreateVisitor">
                    </select>
                </div>
                <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label>Report Maker</label>
                    <select class="form-control select2" select2="true" id="caseCreateReportMaker" name="caseCreateReportMaker">
                    </select>
                </div>
                <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <label>Fees</label>
                    <input type="number" class="form-control" id="caseCreateFees" name="caseCreateFees" placeholder="₹" min="0" />
                </div>
                <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-sm-6">

                    <label>Priority</label>

                    <div class="d-flex align-items-center gap-3">

                        <div class="form-check form-radio-danger">
                            <input class="form-check-input" type="radio" name="caseCreatePriority" id="highPriority" value="1">
                            <label class="form-check-label text-danger" for="highPriority">High</label>
                        </div>

                        <div class="form-check form-radio-warning">
                            <input class="form-check-input" type="radio" name="caseCreatePriority" id="mediumPriority" value="2" checked>
                            <label class="form-check-label text-warning" for="mediumPriority">Medium</label>
                        </div>

                        <div class="form-check form-radio-success">
                            <input class="form-check-input" type="radio" name="caseCreatePriority" id="lowPriority" value="3">
                            <label class="form-check-label text-success" for="lowPriority">Low</label>
                        </div>

                    </div>

                </div>
                
            </div>
            <div class="d-flex align-items-center justify-content-between gap-3">
                <h4 class="card-title m-0">Customer Details</h4>
            </div>
            <hr />
            <div class="row gy-3 mb-3">
                <div class="col-lg-3">
                    <label>Customer Name</label>
                    <input type="text" class="form-control" id="caseCreateCustName" name="caseCreateCustName" placeholder="Customer Name" maxlength="64"/>
                </div>
                <div class="col-lg-3">
                    <label>Contact No.</label>
                    <input type="number" class="form-control" id="caseCreateCustContactNo" name="caseCreateCustContactNo" placeholder="+9198XXXXXXXX" maxlength="12" />
                </div>
            </div>
            <div>
                <button type="submit" id="btnSaveCase" class="btn btn-primary"><i class="fi fi-rr-disk me-2"></i>Save</button>
                <a href="~/case" class="btn btn-outline-light"><i class="fi fi-rr-cross-circle me-2"></i>Cancel</a>
            </div>
        </div>
    </div>
</form>
<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1">Property Details</h4>
            </div>
        </div>
    </div>
</div>

<div class="d-md-flex gap-2">
    <div class="card filemanager-sidebar">
        <div class="card-body">
            <button type="button" class="btn btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#propertyModal" onclick="CaseCreateModule.resetPropertyForm()">
                <i class="fi fi-rr-plus-small me-2"></i>Add Property
            </button>
            <hr />
            <ul class="list-unstyled categories-list mb-0 p-0" id="propertyList">
            </ul>
        </div>
    </div>
    @* document details *@
    <div class="w-100">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <form id="caseUpdatePropertyForm" method="post" class="w-100">

                        <div class="row g-3">

                            <div class="col-12 col-lg-8">
                                <div class="row g-3 h-100">

                                    <div class="col-12">
                                        <label>Property Name</label>
                                        <input type="text" class="form-control"
                                               id="caseUpdatePropertyName"
                                               name="caseUpdatePropertyName">
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label>Property Type</label>
                                        <select class="form-control select2"
                                                id="caseUpdatePropertyType"
                                                name="caseUpdatePropertyType"></select>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label>State</label>
                                        <select class="form-control select2"
                                                id="caseUpdateState"
                                                name="caseUpdateState"></select>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label>Distance</label>
                                        <div class="input-group">
                                            <input type="number" class="form-control text-end"
                                                   id="caseUpdatePropertyDistance">
                                            <span class="input-group-text">Km</span>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label>Size</label>
                                        <div class="input-group">
                                            <input type="number" class="form-control text-end"
                                                   id="caseUpdatePropertySize">
                                            <span class="input-group-text">Sq. Ft.</span>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label>Latitude</label>
                                        <input type="text" class="form-control"
                                               id="caseUpdateLatitude">
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label>Longitude</label>
                                        <input type="text" class="form-control"
                                               id="caseUpdateLongitude">
                                    </div>
                                </div>
                            </div>

                            <!-- Right Side -->
                            <div class="col-12 col-lg-4">
                                <div class="row g-3 h-100">

                                    <div class="col-12 d-flex flex-column">
                                        <label>Note</label>
                                        <textarea class="form-control flex-grow-1"
                                                  id="caseUpdatePropertyNote"
                                                  name="caseUpdatePropertyNote"
                                                  rows="4"></textarea>
                                    </div>

                                    <div class="col-12 d-flex flex-column">
                                        <label>Address</label>
                                        <textarea class="form-control flex-grow-1" id="caseUpdatePropertyAddress" name="caseUpdatePropertyAddress" rows="5"></textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12 d-flex justify-content-between align-items-center">

                                <div>
                                    <button type="submit" class="btn btn-primary" id="btnCaseUpdateProperty">
                                        <i class="fi fi-rr-edit me-1"></i> Update Property
                                    </button>
                                </div>

                                <div class="d-flex gap-2">
                                    <a href="javascript:void(0);" class="btn btn-outline-danger" id="btnViewLocation">
                                        <i class="fi fi-rr-marker me-1"></i> View Location
                                    </a>

                                    <button type="button" id="btnDownloadAllMedia" class="btn btn-outline-success">
                                        <i class="fi fi-rr-download me-1"></i> Download All Media
                                    </button>
                                </div>

                            </div>

                        </div>
                    </form>
                </div>
                <hr />
                <div class="card border shadow-none">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            <input type="file" id="bankDocInput" accept=".jpg,.jpeg,.png,.avif,.heic,.webp,.pdf,.doc,.docx,.xls,.xlsx,.csv,.mp3,.wav,.m4a" multiple hidden>
                            <h4 class="font-size-16 m-0">Bank Documents</h4>
                            <button type="button" class="btn btn-outline-primary" id="btnAddBankDoc"><i class="fi fi-rr-plus-small me-2"></i>Add Bank Doc</button>
                        </div>
                        <hr />
                        <div class="row gy-3 upload-multiple" id="bankDocumentContainer">
                        </div>
                    </div>
                </div>
                <div class="card border shadow-none">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            <input type="file" id="propertyImagesInput" accept="image/*" multiple hidden>

                            <h4 class="font-size-16 m-0">Property Images</h4>
                            <button type="button" class="btn btn-outline-primary" id="btnAddPropertyImages">
                                <i class="fi fi-rr-plus-small me-2"></i>Add Property Images
                            </button>
                        </div>
                        <hr />
                        <div class="upload-multiple row gy-3" data-name="propertyImage" data-accept="image/*" id="propertyDocumentContainer">
                        </div>
                    </div>
                </div>
                <div class="card border shadow-none">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            <input type="file" id="visitSheetInput" accept="z.pdf,.doc,.docx,.xls,.xlsx" multiple hidden>
                            <h4 class="font-size-16 m-0">Visit Sheet</h4>
                            <button type="button"
                                    id="btnAddVisitSheet"
                                    class="btn btn-outline-primary">
                                <i class="fi fi-rr-plus-small me-2"></i>Add Visit Sheet
                            </button>
                        </div>
                        <hr />
                        <div class="upload-multiple row gy-3" data-name="visitSheet" id="visitSheetContainer">
                        </div>
                    </div>
                </div>
                <div class="card border shadow-none">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            <input type="file" id="otherDocInput" accept=".jpg,.jpeg,.png,.avif,.heic,.webp,.pdf,.doc,.docx,.xls,.xlsx,.csv,.mp3,.wav,.m4a" multiple hidden>

                            <h4 class="font-size-16 m-0">Documents</h4>
                            <button type="button" class="btn btn-outline-primary" id="btnAddOtherDoc"> <i class="fi fi-rr-plus-small me-2"></i>Add Doc</button>
                        </div>
                        <hr />
                        <div class="row gy-3 upload-multiple" id="caseDocumentContainer">
                        </div>
                    </div>
                </div>
                @* report section *@
                <div class="card border shadow-none mt-3">
                    <div class="card-body final-report-section" data-property-id="">

                        <div class="d-flex align-items-center justify-content-between">
                            <h4 class="font-size-16 m-0">Final Report</h4>
                        </div>

                        <hr />

                        <div class="row gy-3">

                            <div class="col-lg-6">
                                <label>Final Report (Doc)</label>

                                <input type="file" id="finalDocInput" name="FinalDoc"
                                       class="finalDocInput" accept=".doc,.docx" hidden>

                                <div class="text-center p-4 border rounded finalDocBox">
                                    <i class="fi fi-rr-cloud-upload fs-2"></i>
                                    <p class="mb-0">Upload Document</p>
                                </div>

                                <div id="finalDocPreview" class="finalDocPreview mt-2"></div>
                            </div>

                            <div class="col-lg-6">
                                <label>Final Report (PDF)</label>

                                <input type="file" id="finalPdfInput" name="FinalPdf"
                                       class="finalPdfInput" accept=".pdf" hidden>

                                <div class="text-center p-4 border rounded finalPdfBox">
                                    <i class="fi fi-rr-cloud-upload fs-2"></i>
                                    <p class="mb-0">Upload PDF</p>
                                </div>

                                <div id="finalPdfPreview" class="finalPdfPreview mt-2"></div>
                            </div>

                            <div class="col-lg-6">
                                <label>Final Valuation Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" id="finalAmount" name="ValuationAmount"
                                           class="form-control finalAmount">
                                </div>
                            </div>

                            <div class="col-lg-6 d-flex align-items-center">
                                <div class="form-check mt-4">
                                    <input class="form-check-input isFinalReport"
                                           id="isFinalReport"
                                           name="IsFinal"
                                           type="checkbox">
                                    <label class="form-check-label">
                                        Mark as Final
                                    </label>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <button type="button" id="btnSaveFinalReport"
                                        class="btn btn-success btnSaveFinalReport mt-2">
                                    <i class="fi fi-rr-disk me-1"></i> Save Final Report
                                </button>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="text-end mt-4">
    <button type="button" id="btnSubmitCaseDocument" class="btn btn-success">
        <i class="fi fi-rr-paper-plane me-2"></i>Site-Visit Complete
    </button>
</div>
<div class="modal fade" id="propertyModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="myExtraLargeModalLabel">Add Property</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="caseCreatePropertyForm" method="post">
                    <div class="row gy-3">
                        <div class="col-lg-4">
                            <label>Property Type <span class="text-danger">*</span></label>
                            <select class="form-control select2" select2="true" id="caseCreatePropertyType" name="caseCreatePropertyType" data-dropdown-parent="#propertyModal">
                            </select>
                        </div>
                        <div class="col-lg-8">
                            <label>Property Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="caseCreatePropertyName" id="caseCreatePropertyName" placeholder="Property Name" maxlength="64">
                        </div>
                        <div class="col-lg-4">
                            <label>Distance</label>
                            <div class="input-group">
                                <input type="number" class="form-control text-end" id="caseCreatePropertyDistance" name="caseCreatePropertyDistance" placeholder="0.00" min="0" />
                                <span class="input-group-text bg-primary bg-opacity-10">Km</span>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <label>Size</label>
                            <div class="input-group">
                                <input type="number" class="form-control text-end" id="caseCreatePropertySize" name="caseCreatePropertySize" placeholder="0.00" min="0"/>
                                <span class="input-group-text bg-primary bg-opacity-10">Sq. Ft.</span>
                            </div>
                        </div>
                        <div class="col-lg-12 ">
                            <label>Address <span class="text-danger">*</span></label>
                            <input class="form-control" type="text" name="caseCreatePropertyAddress" id="caseCreatePropertyAddress" placeholder="Address" maxlength="512"/>
                        </div>
                        <div class="col-lg-4">
                            <label>State</label>
                            <select class="form-control select2" select2="true" id="caseCreateState" name="caseCreateState" data-dropdown-parent="#propertyModal">
                            </select>
                        </div>
                        <div class="col-lg-12 ">
                            <label>Note</label>
                            <textarea class="form-control" maxlength="1024" name="propertyNote" id="propertyNote" placeholder="Notes" rows="3"></textarea>
                        </div>
                        <div class="col-lg-12">
                            <button type="submit" class="btn btn-primary" id="btnSaveProperty"><i class="fi fi-rr-disk me-2"></i>Save</button>
                            <button type="button" class="btn btn-secondary" id="btnPropertySaveAndNext"><i class="fi fi-rr-disk me-2"></i>Save & Add New</button>
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="fi fi-rr-cross-circle me-2"></i>Cancel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bankDocModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-md modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="myExtraLargeModalLabel">Add Bank Document</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="bankDocForm" enctype="multipart/form-data">
                    <div class="row gy-3">
                        <div class="document-upload-wrapper">

                            @* Upload Section  *@
                            <div class="upload-section">
                                <input type="file" id="bankDocument" name="bankDocument" class="form-control document-input" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                            </div>

                            @* Preview Section *@
                            <div class="document-preview d-none mt-2">
                                <a href="#" class="documentLink"></a>
                            </div>

                        </div>
                        <div class="col-lg-12 ">
                            <label>Bank Document Name</label>
                            <input typeof="text" class="form-control" name="bankDocName" id="bankDocName" placeholder="Bank Document Name" maxlength="32"/>
                        </div>
                        <div class="col-lg-12">
                            <button class="btn btn-primary"><i class="fi fi-rr-disk me-2"></i>Save</button>
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="fi fi-rr-cross-circle me-2"></i>Cancel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* <div class="modal fade" id="docModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-md modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="myExtraLargeModalLabel">Add Document</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="caseDocForm" enctype="multipart/form-data">
                    <div class="row gy-3">
                        <div class="col-lg-12">
                            <label>Attach Document</label>

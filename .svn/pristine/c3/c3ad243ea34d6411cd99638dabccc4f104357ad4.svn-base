using Core.Domain;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class BankVerticalRepository : BaseRepository
    {
        public BankVerticalRepository(DBContext dbContext) : base(dbContext) { }


        #region AutoGenerated

        public async Task<int> Insert(BankVertical bankVertical)
        {
            await dbContext.Set<BankVertical>().AddAsync(bankVertical);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(BankVertical bankVertical)
        {
            dbContext.Set<BankVertical>().Update(bankVertical);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(BankVertical bankVertical)
        {
            dbContext.Set<BankVertical>().Remove(bankVertical);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<BankVertical?> SelectOne(int id)
        {
            return await dbContext.Set<BankVertical>()
                .Where(x => x.Id == id)
                .FirstOrDefaultAsync();
        }

        public async Task<BankVertical?> SelectByName(int branchId, string name)
        {
            return await dbContext.Set<BankVertical>()
                .Where(x => x.Branch_id == branchId && x.Name.ToLower() == name.ToLower()).FirstOrDefaultAsync();
        }

        public async Task<JsonNode?> SelectAll(int? id, int? branchId, int? bankId, bool? isActive)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_branch_id", branchId);
            parameter.Add("_bank_id", bankId);
            parameter.Add("_is_active", isActive);

            string? response = await connection.QueryFirstAsync<string>( @"SELECT public.bank_vertical_selectall(@_id, @_branch_id, @_bank_id, @_is_active)", parameter);
            return string.IsNullOrWhiteSpace(response) ? JsonNode.Parse("[]") : JsonNode.Parse(response);
        }

        #endregion

        #region Dropdown

        public async Task<List<SelectListResponse>> SelectVerticalByBranch(int? branchId)
        {
            var query = dbContext.Set<BankVertical>()
                .Where(x => x.Is_active);

            if (branchId.HasValue)
            {
                query = query.Where(x => x.Branch_id == branchId.Value);
            }

            return await query
                .OrderBy(x => x.Name)
                .Select(x => new SelectListResponse
                {
                    id = (short)x.Id,
                    name = x.Name
                })
                .ToListAsync();
        }

        #endregion
    }
}
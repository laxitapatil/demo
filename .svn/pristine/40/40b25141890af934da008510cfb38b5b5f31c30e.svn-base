@{
    ViewData["Title"] = "Bank Master";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1">Banks</h4>
                <p class="m-0 text-secondary">Organize your bank list</p>
            </div>
            <div class="page-title-right d-flex align-items-center gap-2">
                <button type="button" class="btn btn-primary" data-bs-target="#bankModal" data-bs-toggle="modal"><i class="fi fi-rr-plus-small me-2"></i>Add Bank</button>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <div>
                    <table id="tblBank" class="table table-hover align-middle">
                        <thead>
                            <tr class="bg-light">
                                <th>Sr. No.</th>
                                <th>Bank Name</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>01</td>
                                <td>Bank of Baroda</td>
                                <td>
                                    <div class="form-check form-switch" dir="ltr">
                                        <input class="form-check-input" type="checkbox" id="statusBank" checked="">
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <a href="javascript:void(0)" class="fw-semibold font-size-18 link-secondary" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fi fi-rr-menu-dots"></i>
                                        </a>
                                        <ul class="dropdown-menu border dropdown-menu-end shadow-sm">
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-edit me-2"></i> Edit Bank
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="#">
                                                    <i class="fi fi-rr-trash me-2"></i> Delete Bank
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-eye me-2"></i> View Report Template
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>02</td>
                                <td>State Bank of India</td>
                                <td>
                                    <div class="form-check form-switch" dir="ltr">
                                        <input class="form-check-input" type="checkbox" id="statusBank" checked="">
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <a href="javascript:void(0)" class="fw-semibold font-size-18 link-secondary" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fi fi-rr-menu-dots"></i>
                                        </a>
                                        <ul class="dropdown-menu border dropdown-menu-end shadow-sm">
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-edit me-2"></i> Edit Bank
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="#">
                                                    <i class="fi fi-rr-trash me-2"></i> Delete Bank
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-eye me-2"></i> View Report Template
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>03</td>
                                <td>Canara Bank</td>
                                <td>
                                    <div class="form-check form-switch" dir="ltr">
                                        <input class="form-check-input" type="checkbox" id="statusBank" checked="">
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <a href="javascript:void(0)" class="fw-semibold font-size-18 link-secondary" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fi fi-rr-menu-dots"></i>
                                        </a>
                                        <ul class="dropdown-menu border dropdown-menu-end shadow-sm">
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-edit me-2"></i> Edit Bank
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="#">
                                                    <i class="fi fi-rr-trash me-2"></i> Delete Bank
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-eye me-2"></i> View Report Template
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bankModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="myExtraLargeModalLabel">Add Bank</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row gy-3">
                    <div class="col-lg-12 ">
                        <label>Bank Name</label>
                        <input class="form-control" name="bankName" id="bankName" placeholder="Bank Name" />
                    </div>
                    <div class="col-lg-12">
                        <label>Report Template</label>
                        <div class="upload-box"
                             data-name="bankPropertyDoc"
                             data-accept=".pdf,.doc,.jpg">
                        </div>
                    </div>
                    <div class="col-lg-12 ">
                        <label>Report Template Name</label>
                        <input class="form-control" name="reportTemplateName" id="reportTemplateName" placeholder="Report Template Name" />
                    </div>
                    <div class="col-lg-12">
                        <div class="form-check form-switch" dir="ltr">
                            <input class="form-check-input" type="checkbox" id="statusBankForm" checked="">
                            <label class="form-check-label" for="statusBankForm">Active</label>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <button class="btn btn-primary"><i class="fi fi-rr-disk me-2"></i>Save</button>
                        <button type="button" class="btn btn-light"><i class="fi fi-rr-disk me-2"></i>Save & Add New</button>
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="fi fi-rr-cross-circle me-2"></i>Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/bank/index.js"></script>
    <script>
        $(document).ready(function(){
            $(".upload-box").uploadBox();
        })
    </script>
}
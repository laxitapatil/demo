<div class="modal fade" id="stateModal" tabindex="-1" role="dialog" aria-labelledby="stateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form id="stateForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="stateModalLabel">Add State</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row gy-3">

                        <!-- State Name -->
                        <div class="col-lg-12">
                            <label>State Name</label>
                            <input type="text"
                                   class="form-control"
                                   name="stateName"
                                   id="stateName"
                                   placeholder="Enter State Name"
                                   maxlength="64" />
                        </div>

                        <!-- Active Status -->
                        <div class="col-lg-12">
                            <div class="form-check form-switch" dir="ltr">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="stateStatus"
                                       checked>
                                <label class="form-check-label" for="stateStatus">
                                    Active
                                </label>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="col-lg-12">
                            <button id="btnSaveState" class="btn btn-primary">
                                <i class="fi fi-rr-disk me-2"></i>Save
                            </button>

                            <button type="button" id="btnSaveAddNewState" class="btn btn-light">
                                <i class="fi fi-rr-disk me-2"></i>Save & Add New
                            </button>

                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                                <i class="fi fi-rr-cross-circle me-2"></i>Cancel
                            </button>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Cases";
}
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1">Cases</h4>
                <p class="m-0 text-secondary">Manage your cases</p>
            </div>

            <div class="page-title-right d-flex align-items-center gap-2">
                <a href="#" class="btn btn-light"><i class="fi fi-rr-refresh me-2"></i>Refresh</a>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#caseModal">
                    <i class="fi fi-rr-plus-small me-2"></i>New Case
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="row align-items-center gx-2 gy-2">
                    <div class="col-xl-2 col-lg-4">
                        <div>
                            <input class="form-control" id="searchCase" name="searchCase" placeholder="Search case" />
                        </div>
                    </div>
                    <div class="col-xl-10 col-lg-8 d-flex flex-md-nowrap items-center gap-2">
                        <div class="w-100">
                            <select class="form-control select2" select2="true" id="customerFilter">
                                <option>All Customers</option>
                                <option>Sunita Shah</option>
                                <option>Deepak Shah</option>
                                <option>Daxesh Trading Co.</option>
                                <option>Neelam Textiles</option>
                                <option>Kamal Mills Pvt. Ltd.</option>
                                <option>Vikash Patel</option>
                                <option>Nirali Fashion</option>
                            </select>
                        </div>
                        <div class="w-100">
                            <select class="form-control select2" select2="true" id="bankFilter">
                                <option>All Banks</option>
                                <option>State Bank of India</option>
                                <option>Bank of Baroda</option>
                                <option>Yes Bank</option>
                                <option>HDFC Bank</option>
                                <option>Axis Bank</option>
                                <option>The Sutex Co. Op. Bank</option>
                                <option>Uco Bank</option>
                            </select>
                        </div>
                        <div class="w-100">
                            <select class="form-control select2" select2="true" id="assigneeFilter">
                                <option>All Assignee</option>
                                <option>Hitanshu</option>
                                <option>Ayush</option>
                                <option>Karishma</option>
                                <option>Neelam</option>
                                <option>Abdul</option>
                                <option>Anees</option>
                            </select>
                        </div>
                        <div class="w-100">
                            <select class="form-control select2" select2="true" id="typeFilter">
                                <option>All Types</option>
                                <option>Residential</option>
                                <option>Industrial</option>
                                <option>Plot</option>
                                <option>Commercial</option>
                            </select>
                        </div>
                        <div class="w-100">
                            <select class="form-control select2" select2="true" id="statusFilter">
                                <option>All Statuses</option>
                                <option>New Case</option>
                                <option>Site Visit</option>
                                <option>Report In Progress</option>
                                <option>Under Review</option>
                                <option>Completed</option>
                                <option>Hold</option>
                                <option>Cancelled</option>
                            </select>
                        </div>
                        <div>
                            <select class="form-control select2" select2="true" id="sortBy" searchable="false">
                                <option>Date (New to Old)</option>
                                <option>Date (Old to New)</option>
                                <option>Priority (High to Low)</option>
                                <option>Priority (Low to High)</option>
                            </select>
                        </div>
                    </div>
                </div>
                <hr />
                <div>
                    <table id="tblCase" class="table align-middle table-hover table-nowrap">
                        <thead>
                            <tr class="bg-light">
                                <th class="text-center">Action</th>
                                <th>Sr. No.</th>
                                <th>Case ID</th>
                                <th>Date</th>
                                <th>Bank Detail</th>
                                <th>Case type</th>
                                <th>Customer Name</th>
                                <th>Property</th>
                                <th>Visitor & Reporter</th>
                                <th>Current Status</th>
                                <th>Last Updated at</th>
                                <th>Billing Detail</th>
                                <th>Fees (₹)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="bg-danger bg-opacity-5">
                                <td class="text-center">
                                    <div class="dropdown">
                                        <a href="javascript:void(0)" class="fw-semibold font-size-18 link-secondary" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fi fi-rr-menu-dots"></i>
                                        </a>
                                        <ul class="dropdown-menu border dropdown-menu-start shadow-sm">
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-eye me-2"></i> View Details
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-edit me-2"></i> Edit Case
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="#">
                                                    <i class="fi fi-rr-trash me-2"></i> Delete Case
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-cross-circle me-2"></i> Mark as Hold
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-cross-circle me-2"></i> Mark as Cancelled
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                                <td>01</td>
                                <td><a href="#" class="fw-medium">MLK-1024</a></td>
                                <td>06-11-2025</td>
                                <td>
                                    <div>
                                        <p class="fw-medium mb-1">Bank of Baroda</p>
                                        <p class="text-secondary m-0">ID: IND-13582153</p>
                                    </div>
                                </td>
                                <td>Desktop</td>
                                <td>
                                    <div>
                                        <p class="fw-medium mb-1">Hitesh Gadhiya</p>
                                        <a href="#" class="link-secondary m-0"><i class="fi fi-rr-phone-call me-2"></i>+91 98765 43210</a>
                                    </div>
                                </td>
                                <td>3 x Commercial</td>
                                <td>
                                    <div>
                                        <p class="fw-medium mb-1">Hitanshu</p>
                                        <p class="fw-medium mb-0">Ayush</p>
                                    </div>
                                </td>
                                <td>
                                    <label class="badge badge-new-case m-0">New</label>
                                </td>
                                <td>07-11-2025</td>
                                <td>November 25</td>
                                <td>5,000.00</td>

                                <td>04</td>
                                <td><a href="#" class="fw-medium">MLK-1024</a></td>
                                <td>06-11-2025</td>
                                <td>
                                    <div>
                                        <p class="fw-medium mb-1">Bank of Baroda</p>
                                        <p class="text-secondary m-0">ID: IND-13582153</p>
                                    </div>
                                </td>
                                <td>Desktop</td>
                                <td>
                                    <div>
                                        <p class="fw-medium mb-1">Hitesh Gadhiya</p>
                                        <a href="#" class="link-secondary m-0"><i class="fi fi-rr-phone-call me-2"></i>+91 98765 43210</a>
                                    </div>
                                </td>
                                <td>1 x Industrial</td>
                                <td>
                                    <div>
                                        <p class="fw-medium mb-1">Hitanshu</p>

                                <td>1 x Residential</td>
                                <td>
                                    <div>
                                        <p class="fw-medium mb-1">Hitanshu</p>
                                        <p class="fw-medium mb-0">Ayush</p>
                                    </div>
                                </td>
                                <td>
                                    <label class="badge badge-new-case m-0">New</label>
                                </td>
                                <td>07-11-2025</td>
                                <td>November 25</td>
                                <td>5,000.00</td>
                            </tr>
                            <tr class="bg-warning bg-opacity-5">
                                <td class="text-center">
                                    <div class="dropdown">
                                        <a href="javascript:void(0)" class="fw-semibold font-size-18 link-secondary" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fi fi-rr-menu-dots"></i>
                                        </a>
                                        <ul class="dropdown-menu border dropdown-menu-start shadow-sm">
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-eye me-2"></i> View Details
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="fi fi-rr-edit me-2"></i> Edit Case

                            </tr>
                        </tbody>
                    </table>
                    <div class="d-flex align-items-center gap-2 mt-3">
                        <div class="alert bg-danger bg-opacity-5 p-2 m-0">
                            <p class="text-danger m-0 font-size-12"><i class="fi fi-rr-info me-2"></i>Red color indicates <span class="fw-medium">High priority</span></p>
                        </div>
                        <div class="alert bg-warning bg-opacity-5 p-2 m-0">
                            <p class="text-warning m-0 font-size-12"><i class="fi fi-rr-info me-2"></i>Yellow color indicates <span class="fw-medium">Medium priority</span></p>
                        </div>
                        <div class="alert bg-success bg-opacity-5 p-2 m-0">
                            <p class="text-success m-0 font-size-12"><i class="fi fi-rr-info me-2"></i>Green color indicates <span class="fw-medium">Low priority</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="caseModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="myExtraLargeModalLabel">Create Case</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row gy-3">
                    <div class="col-lg-4">
                        <div>
                            <label>Case Date</label>
                            <input type="date" class="form-control" id="caseDate" name="caseDate" value="28-01-2026" readonly />
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div>
                            <label>Case ID</label>
                            <input type="text" class="form-control" id="caseID" name="caseID" value="MLK-1025" readonly />
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div>
                            <label>Case Type</label>
                            <select class="form-control select2" select2="true" searchable="false" id="caseType" name="caseType">
                                <option>Select Case Type</option>
                                <option>NPA</option>
                                <option>Desktop</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="col-lg-4">
                        <label>Bank</label>
                        <select class="form-control select2" select2="true" id="bank" name="bank" data-dropdown-parent="#caseModal">
                            <option>Select Bank</option>
                            <option>State Bank of India</option>
                            <option>Bank of Baroda</option>
                            <option>Yes Bank</option>
                            <option>HDFC Bank</option>
                            <option>Axis Bank</option>
                            <option>The Sutex Co. Op. Bank</option>
                            <option>Uco Bank</option>
                        </select>
                    </div>
                    <div class="col-lg-4">
                        <label>Bank Branch</label>
                        <select class="form-control select2" select2="true" id="bankBranch" name="bankBranch" data-dropdown-parent="#caseModal">
                            <option>Select Bank Branch</option>
                            <option>Althan</option>
                            <option>Adajan</option>
                            <option>Bhagal</option>
                            <option>Citylight</option>
                            <option>Dindoli</option>
                            <option>Pal</option>
                            <option>Piplod</option>
                            <option>Vesu</option>
                        </select>
                    </div>
                    <div class="col-lg-4">
                        <label>Bank Case ID</label>
                        <input type="text" class="form-control" id="bankCaseId" name="bankCaseId" placeholder="Bank Case ID" />
                    </div>
                    <div class="col-lg-4">
                        <label>Visitor</label>
                        <select class="form-control select2" select2="true" id="caseVisitor" data-dropdown-parent="#caseModal">
                            <option>All Assignee</option>
                            <option>Hitanshu</option>
                            <option>Ayush</option>
                            <option>Karishma</option>
                        </select>
                    </div>
                    <div class="col-lg-4">
                        <label>Report Maker</label>
                        <select class="form-control select2" select2="true" id="caseReportMaker" data-dropdown-parent="#caseModal">
                            <option>Select Report Maker</option>
                            <option>Neelam</option>
                            <option>Abdul</option>
                            <option>Anees</option>
                        </select>
                    </div>
                    <div class="col-lg-4">
                        <div>
                            <label>Priority</label>
                            <div class="d-flex align-items-center gap-3">
                                <div>
                                    <div class="form-check form-radio-danger">
                                        <input class="form-check-input" type="radio" name="casePriority" id="highPriority" checked="">
                                        <label class="form-check-label text-danger" for="highPriority">
                                            High
                                        </label>
                                    </div>
                                </div>
                                <div>
                                    <div class="form-check form-radio-warning">
                                        <input class="form-check-input" type="radio" name="casePriority" id="mediumPriority" checked="">
                                        <label class="form-check-label text-warning" for="mediumPriority">
                                            Medium
                                        </label>
                                    </div>
                                </div>
                                <div>
                                    <div class="form-check form-radio-success">
                                        <input class="form-check-input" type="radio" name="casePriority" id="lowPriority" checked="">
                                        <label class="form-check-label text-success" for="lowPriority">
                                            Low
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12">
                        <hr />
                    </div>
                    <div class="col-lg-6">
                        <label>Customer Name</label>
                        <input type="text" class="form-control" id="custName" name="custName" placeholder="Customer Name" />
                    </div>
                    <div class="col-lg-6">
                        <label>Contact No.</label>
                        <input type="text" class="form-control" id="custContactNo" name="custContactNo" placeholder="+919876543210" />
                    </div>
                    <div class="col-lg-4">
                        <label>Property Type</label>
                        <select class="form-control select2" select2="true" id="propertyType" name="propertyType" searchable="false" data-dropdown-parent="#propertyModal">
                            <option>Select Property Type</option>
                            <option>Residential</option>
                            <option>Industrial</option>
                            <option>Plot</option>
                            <option>Commercial</option>
                        </select>
                    </div>
                    <div class="col-lg-8">
                        <label>Property Name</label>
                        <input type="text" class="form-control" name="propertyName" id="propertyName" placeholder="Property Name">
                    </div>
                    <div class="col-lg-12 ">
                        <label>Address</label>
                        <input class="form-control" name="propertyAddress" id="propertyAddress" placeholder="Address" />
                    </div>

                    <div class="col-lg-12">
                        <a href="~/case/create" class="btn btn-primary"><i class="fi fi-rr-disk me-2"></i>Create</a>
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="fi fi-rr-cross-circle me-2"></i>Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/case/index.js"></script>
}
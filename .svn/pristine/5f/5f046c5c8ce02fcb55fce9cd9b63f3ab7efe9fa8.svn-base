        /// <returns></returns>
        [Authorize]
        [HttpGet("document-type")]
        public async Task<IActionResult> GetDocumentType()
        {
            try
            {
                using CaseDocumentRepository repo = new(dbContext);
                return Ok(await repo.SelectDocumentType());
            }
            catch (Exception ex)
            {
                return Problem(ex.Message,
                    statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Documents Download for selected property
        /// </summary>
        /// <returns></returns>
        [Authorize]
        [HttpGet("download-all/property/{propertyId}")]
        public async Task<IActionResult> DownloadAll(int propertyId)
        {
            using CaseDocumentRepository repo = new(dbContext);

            var docsJson = await repo.SelectAll(null, propertyId);

            if (docsJson == null)
                return NotFound("No documents found");

            var documents = docsJson["documents"];

            if (documents == null)
                return NotFound("No documents found");

            var docsList = new List<JsonNode>();

            docsList.AddRange(documents["bank_documents"]?.AsArray() ?? new JsonArray());
            docsList.AddRange(documents["property_documents"]?.AsArray() ?? new JsonArray());
            docsList.AddRange(documents["visit_sheet"]?.AsArray() ?? new JsonArray());
            docsList.AddRange(documents["case_documents"]?.AsArray() ?? new JsonArray());

            if (!docsList.Any())
                return NotFound("No files available for download");

            using var memoryStream = new MemoryStream();

            using (var archive = new ZipArchive(memoryStream, ZipArchiveMode.Create, true))
            {
                foreach (var doc in docsList)
                {
                    var filePath = doc?["file_path"]?.ToString();
                    if (string.IsNullOrWhiteSpace(filePath)) continue;

                    var fullPath = Path.Combine(_webHostEnvironment.WebRootPath, filePath);
                    if (!System.IO.File.Exists(fullPath)) continue;

                    var originalFileName = Path.GetFileName(fullPath);
                    var extension = Path.GetExtension(originalFileName);

                    var title = doc?["title"]?.ToString();

                    var safeName = !string.IsNullOrWhiteSpace(title)
                        ? string.Concat(title.Split(Path.GetInvalidFileNameChars()))
                        : Path.GetFileNameWithoutExtension(originalFileName);

                    var fileName = $"{doc?["id"]}_{safeName}{extension}";

                    var entry = archive.CreateEntry(fileName, CompressionLevel.Fastest);

                    using var entryStream = entry.Open();
                    using var fileStream = System.IO.File.OpenRead(fullPath);

                    await fileStream.CopyToAsync(entryStream);
                }
            }
            var zipFileName = $"Property_{propertyId}_Documents_{DateTime.Now:yyyy-MM-dd}.zip";
            Response.Headers.Add("Access-Control-Expose-Headers", "Content-Disposition");
            return File(memoryStream.ToArray(), "application/zip", zipFileName);
        }

        #region prvivate methods
        private (bool isValid, string errorMessage) ValidateFile(IFormFile file)
        {
            if (file == null || file.Length == 0)
                return (false, "File is required.");

            string extension = Path.GetExtension(file.FileName).ToLower();

            // Allowed extensions
            string[] allowedExtensions =
            { ".jpg", ".jpeg", ".png", ".avif", ".heic", ".webp", ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".csv", ".mp3", ".wav", ".m4a"};

            if (!allowedExtensions.Contains(extension))
                return (false, "File type is not allowed.");

            // Image extensions
            string[] imageExtensions = { ".jpg", ".jpeg", ".png", ".avif", ".webp", ".heic" };
               
            long fileSize = file.Length;

            if (imageExtensions.Contains(extension))
            {
                if (fileSize > 10 * 1024 * 1024)
                    return (false, "Image size cannot exceed 10 MB.");
            }
            else
            {
                if (fileSize > 25 * 1024 * 1024)
                    return (false, "Document size cannot exceed 25 MB.");
            }

            return (true, string.Empty);
        }
        #endregion
    }
}
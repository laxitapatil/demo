$(document).ready(function () {
    fillCaseTable()
});

function fillCaseTable(){
    setDataTable("#tblCase", options = {
        scrollY: '500px', // fixed height
        scrollCollapse: false,
        columnDefs: [
            {
                targets: 0,
                orderable: false,
                width: '30px',
            }
        ],
        autoWidth: false
    });
}
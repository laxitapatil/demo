@font-face {
    font-family: "uicons-regular-rounded";
    src: url("./fonts/uicons-regular-rounded.eot#iefix") format("embedded-opentype"), url("./fonts/uicons-regular-rounded.woff2") format("woff2"), url("./fonts/uicons-regular-rounded.woff") format("woff");
}

@font-face {
    font-family: "uicons-solid-straight";
    src: url("./fonts/uicons-solid-straight.eot#iefix") format("embedded-opentype"), url("./fonts/uicons-solid-straight.woff2") format("woff2"), url("./fonts/uicons-solid-straight.woff") format("woff");
}

@font-face {
    font-family: "uicons-brands";
    src: url("./fonts/uicons-brands.woff2") format("woff2"),url("./fonts/uicons-brands.woff") format("woff"),url("./fonts/uicons-brands.eot#iefix") format("embedded-opentype");
    font-display: swap;
}

i[class^="fi-rr-"]:before, i[class*=" fi-rr-"]:before, span[class^="fi-rr-"]:before, span[class*="fi-rr-"]:before {

@{
    ViewData["Title"] = "Bank Master";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1">Banks</h4>
                <p class="m-0 text-secondary">Organize your bank list</p>
            </div>
            <div class="page-title-right d-flex align-items-center gap-2">
                <button type="button" class="btn btn-primary" data-bs-target="#bankModal" data-bs-toggle="modal"><i class="fi fi-rr-plus-small me-2"></i>Add Bank</button>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <div>
                    <table id="tblBank" class="table table-hover align-middle">
                        <thead>
                            <tr class="bg-light">
                                <th class="text-center">Action</th>
                                <th>Sr. No.</th>
                                <th>Bank Name</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Bank/_Create.cshtml")

@section Scripts {
    <script src="~/js/bank/bank.js?@ViewData["jsVersion"]"></script>
    <script src="~/js/bank/bank-create.js?@ViewData["jsVersion"]"></script>
    <script>
        $(document).ready(function(){
            $(".upload-box").uploadBox();
        })
    </script>
}
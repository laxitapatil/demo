@{
    ViewData["Title"] = "Bank Vertical";
    var branchId = TempData["branchId"];
}
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1">Bank Vertical</h4>
                <p class="m-0 text-secondary">Organize your bank vertical list</p>
            </div>
            <div class="page-title-right d-flex align-items-center gap-2">
                <button type="button" class="btn btn-primary" data-bs-target="#bankVerticalModal" data-bs-toggle="modal"><i class="fi fi-rr-plus-small me-2"></i>Add Vertical</button>
            </div>
            @* <div class="page-title-right d-flex align-items-center gap-2">
                <a href='@Url.Action("Index", "BankBranch", new { bankId = @TempData["bankId"] })' class="btn btn-light"><i class="fi-rr-arrow-small-left me-2"></i>Back to Branch</a>
            </div> *@
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card">
            <div class="card-body">
                <div>
                    <table id="tblBankVertical" class="table table-hover align-middle">
                        <thead>
                            <tr class="bg-light">
                                <th class="text-center">Action</th>
                                <th>Sr. No.</th>
                                <th>Vertical Name</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Views/BankVertical/_Create.cshtml")

@section Scripts {
    <script> let branchId = '@branchId'; </script>
    <script src="~/js/bank-vertical/bank-vertical.js?@ViewData["jsVersion"]"></script>
    <script src="~/js/bank-vertical/bank-vertical-create.js?@ViewData["jsVersion"]"></script>
}
using Api.Provider;
using AutoMapper;
using Core.Domain;
using Core.Request;
using Core.Response;
using Infrastructure;
using Infrastructure.Base;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Api.Controllers
{
    [Tags("Bank Branch")]
    [Authorize]
    [Route("api/bank-branch")]
    [ApiController]
    public class BankBranchController : BaseController
    {
        private readonly string BANK_BRANCH = "Bank Branch";
        private readonly string BANK = "Bank";

        public BankBranchController(IConfiguration configuration, IMapper mapper, DBContext dbContext)
            : base(configuration, mapper, dbContext) { }

        /// <summary>
        /// Get All Bank Branches (Optional: Filter by Id, Bank Id or Active Status)
        /// </summary>
        /// <param name="id">Optional bank branch id</param>
        /// <param name="bankId">Optional bank id filter</param>
        /// <param name="isActive">Optional active status filter</param>
        /// <returns></returns>
        [Authorize]
        [HttpGet]
        public async Task<IActionResult> Get(int? id, int? bankId, bool? isActive)
        {
            try
            {
                return Ok(await new BankBranchRepository(dbContext).SelectAll(id, bankId, isActive));

            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get Bank Branch by Id
        /// </summary>
        /// <param name="id">Bank branch id</param>
        /// <returns></returns>
        [Authorize]
        [HttpGet("{id}")]
        public async Task<IActionResult> GetOne(int id)
        {
            try
            {
                using BankBranchRepository repo = new(dbContext);
                BankBranch? bankBranch = await repo.SelectOne(id);

                if (bankBranch == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_BRANCH),
                        statusCode: StatusCodes.Status404NotFound);

                var response = mapper.Map<BankBranch, BankBranchResponse>(bankBranch);

                return Ok(response);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get Bank Branch Dropdown List based on bank
        /// </summary>
        /// <param name="bankId">Optional bank id to filter branches</param>
        /// <returns></returns>
        [Authorize]
        [HttpGet("name")]
        public async Task<IActionResult> GetName(int? bankId)
        {
            try
            {
                using BankBranchRepository repo = new(dbContext);
                return Ok(await repo.SelectBranchByBank(bankId));
            }
            catch (Exception ex)
            {
                return Problem(ex.Message,
                    statusCode: StatusCodes.Status500InternalServerError);
            }
        }
        /// <summary>
        /// Create Bank Branch
        /// </summary>
        /// <param name="request">Bank branch details</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPost]
        public async Task<IActionResult> Post(BankBranchRequest request)
        {
            try
            {
                using BankBranchRepository repo = new(dbContext);
                using BankRepository bankRepo = new(dbContext);

                // Check if bank exists
                Bank? bank = await bankRepo.SelectOne(request.Bank_id);
                if (bank == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK),statusCode: StatusCodes.Status404NotFound);

                BankBranch? existingBranch = await repo.SelectByName(request.Bank_id, request.Name.Trim());
                if (existingBranch != null)
                    return Problem($"Bank branch with name '{request.Name}' already exists for this bank.",
                        statusCode: StatusCodes.Status400BadRequest);

                BankBranch bankBranch = mapper.Map<BankBranchRequest, BankBranch>(request);
                bankBranch.Name = request.Name.Trim();
                bankBranch.Modified_by = TokenName;
                bankBranch.Modified_date = CurrentTime;

                int result = await repo.Insert(bankBranch);

                if (result > 0)
                {
                    var response = mapper.Map<BankBranch, BankBranchResponse>(bankBranch);
                    return Ok(response);
                }

                return Problem(string.Format(MessageProvider.INSERT_FAILED, BANK_BRANCH),
                    statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk_bank_branch_bank"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK), statusCode: StatusCodes.Status404NotFound);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Update Bank Branch
        /// </summary>
        /// <param name="request">Bank branch details</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPut]
        public async Task<IActionResult> Put(BankBranchRequest request)
        {
            try
            {
                if (!request.Id.HasValue || request.Id < 1)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_BRANCH),
                        statusCode: StatusCodes.Status404NotFound);

                using BankBranchRepository repo = new(dbContext);
                using BankRepository bankRepo = new(dbContext);

                BankBranch? bankBranch = await repo.SelectOne(request.Id.Value);
                if (bankBranch == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_BRANCH), statusCode: StatusCodes.Status404NotFound);


                // Check if bank exists
                Bank? bank = await bankRepo.SelectOne(request.Bank_id);
                if (bank == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK), statusCode: StatusCodes.Status404NotFound);


                // Check if new name already exists for this bank (excluding current branch)
                BankBranch? existingBranch = await repo.SelectByName(request.Bank_id, request.Name.Trim());
                if (existingBranch != null && existingBranch.Id != bankBranch.Id)
                    return Problem($"Bank branch with name '{request.Name}' already exists for this bank.",
                        statusCode: StatusCodes.Status400BadRequest);

                bankBranch.Name = request.Name.Trim();
                bankBranch.Bank_id = request.Bank_id;
                bankBranch.Is_active = request.Is_active;
                bankBranch.Modified_by = TokenName;
                bankBranch.Modified_date = CurrentTime;

                int result = await repo.Update(bankBranch);

                if (result > 0)
                {
                    var response = mapper.Map<BankBranch, BankBranchResponse>(bankBranch);
                    return Ok(response);
                }

                return Problem(string.Format(MessageProvider.UPDATE_FAILED, BANK_BRANCH),
                    statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk_bank_branch_bank"))
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK), statusCode: StatusCodes.Status404NotFound);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Delete Bank Branch
        /// </summary>
        /// <param name="id">Bank branch id</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(int id)
        {
            try
            {
                using BankBranchRepository repo = new(dbContext);
                BankBranch? bankBranch = await repo.SelectOne(id);

                if (bankBranch == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_BRANCH),
                        statusCode: StatusCodes.Status404NotFound);

                await repo.Delete(bankBranch);

                return Ok(string.Format(MessageProvider.DELETE_SUCCESS, BANK_BRANCH));
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk"))
                    return Problem(MessageProvider.CHILD_FOUND, statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Update Bank Branch Active Status
        /// </summary>
        /// <param name="id">Bank branch id</param>
        /// <returns></returns>
        [Authorize(Roles = "Admin")]
        [HttpPut("update-status/{id}")]
        public async Task<IActionResult> UpdateStatus(int id)
        {
            try
            {
                using BankBranchRepository repo = new(dbContext);
                BankBranch? bankBranch = await repo.SelectOne(id);

                if (bankBranch == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, BANK_BRANCH),
                        statusCode: StatusCodes.Status404NotFound);

                bankBranch.Is_active = !bankBranch.Is_active;
                bankBranch.Modified_by = TokenName;
                bankBranch.Modified_date = CurrentTime;

                int result = await repo.Update(bankBranch);

                return result > 0
                    ? Ok(string.Format(MessageProvider.UPDATE_SUCCESS, BANK_BRANCH))
                    : Problem(string.Format(MessageProvider.UPDATE_FAILED, BANK_BRANCH),statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message,
                    statusCode: StatusCodes.Status500InternalServerError);
            }
        }

    }
}
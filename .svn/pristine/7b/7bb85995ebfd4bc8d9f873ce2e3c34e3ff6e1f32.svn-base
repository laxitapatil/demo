const BankCreateModule = (() => {

    const BANK_API = "bank";
    const $bankForm = $("#bankForm");

    let bankId = null;
    let isEditMode = false;
    let bankValidator = null;

    function bankCreateInit() {

        bankFormValidation();
        modalEvents();
        bindEvents();

        $("#btnSaveBank").on("click", bankSave);
        $("#btnSaveAddNewBank").on("click", bankSaveAddNew);
    }
    function bindEvents() {

        // File change preview
        $("#bankDocument").on("change", function () {

            const file = this.files[0];

            if (!file) return;

            showPreview(file.name);
        });


        //Reset Doc button
        $(".reset-document").on("click", function (e) {
            e.preventDefault();
            resetDocument();
        });

        // Delete button
        $(".delete-document").on("click", function (e) {
            e.preventDefault();
            deleteDocument();
        });

        // Template toggle
        $("input[name='templateType']").on("change", toggleTemplateType);
    }

    function toggleTemplateType() {

        const selected = $("input[name='templateType']:checked").val();

        if (selected === "1") {
            $("#documentTemplateSection").removeClass("d-none");
            $("#portalLinkSection").addClass("d-none");
            $("#portalLinkInput").val("");
        }
        else {
            $("#documentTemplateSection").addClass("d-none");
            $("#portalLinkSection").removeClass("d-none");

            resetDocumentUI();
        }
    }

    function modalEvents() {

        $("#bankModal").on("hidden.bs.modal", function () {
            resetForm();

        });

        $("#bankModal").on("shown.bs.modal", function () {

            if (!isEditMode) {
                $("#templateDocument")
                    .prop("checked", true)
                    .trigger("change");
            }
        });
    }

    function openBankModal(id = null) {

        bankId = id;
        isEditMode = !!id;

        $("#myExtraLargeModalLabel").text(
            isEditMode ? "Edit Bank" : "Add Bank"
        );

        $("#bankModal").modal("show");
    }

    function resetForm() {

        $bankForm[0].reset();
        bankId = null;
        isEditMode = false;

        resetDocumentUI();

        if (bankValidator) {
            bankValidator.resetForm();
            $(".is-invalid").removeClass("is-invalid");
        }

    }

    function resetDocumentUI() {

        $("#bankDocument").val("");
        $(".document-preview").addClass("d-none");
        $(".upload-section").removeClass("d-none");
        $(".documentLink").attr("href", "").text("");
        $(".delete-document").addClass("d-none")
    }

    function bankFormValidation() {

        bankValidator = $bankForm.validate({
            errorElement: "span",
            rules: {
                bankName: { required: true, minlength: 2 },
            },
            messages: {
                bankName: {
                    required: "Please enter Bank Name",
                    minlength: "Bank name must be at least 2 characters"
                }
            },
            errorPlacement: function (error, element) {
                error.insertAfter(element);
                error.addClass("text-danger");
            }
        });
    }

    function bankSave(event) {

        event.preventDefault();

        if (!bankValidator.form()) return;

        const selectedType =
            $("input[name='templateType']:checked").val();

        const formData = new FormData();

        formData.append("Id", bankId || 0);
        formData.append("Name", $("#bankName").val().trim());
        formData.append("Template_name", $("#reportTemplateName").val().trim());
        formData.append("Is_active", $("#bankStatus").is(":checked"));
        formData.append("Template_type", selectedType);

        if (selectedType === "1") {

            const file = $("#bankDocument")[0].files[0];
            if (file) {
                formData.append("Template_path_doc", file);
            }
        }
        else {
            formData.append(
                "Template_path",
                $("#portalLinkInput").val().trim()
            );
        }

        if (isEditMode) {
            callBasePutFileAPI(BANK_API, formData, updateSuccess, commonError);
        }
        else {
            callBasePostFileAPI(BANK_API, formData, insertSuccess, commonError);
        }
    }

    function bankSaveAddNew(e) {
        e.preventDefault();
        bankSave(e);
    }

    function insertSuccess() {
        successToastr(MessageProvider.format(MessageProvider.INSERT_SUCCESS, "Bank"));
        $("#bankModal").modal("hide");
        BankModule.bankInit();
    }

    function updateSuccess() {
        successToastr(MessageProvider.format(MessageProvider.UPDATE_SUCCESS, "Bank"));
        $("#bankModal").modal("hide");
        BankModule.bankInit();
    }


    function bankDataGet(data) {

        const bank = Array.isArray(data) ? data[0] : data;

        if (!bank) return;

        $("#bankName").val(bank.name);
        $("#reportTemplateName").val(bank.template_name);
        $("#bankStatus").prop("checked", bank.is_active);

        if (bank.template_type === 1) {

            $("#templateDocument")
                .prop("checked", true)
                .trigger("change");

            if (bank.template_path) {

                showPreview(
                    bank.template_path,
                    generateImageURL(
                        "uploads",
                        "bank",
                        bank.template_path
                    )
                );

                $(".delete-document").removeClass("d-none")
                $(".reset-document").addClass("d-none")
            }
        }
        else {

            $("#templatePortalLink")
                .prop("checked", true)
                .trigger("change");

            $("#portalLinkInput").val(bank.template_path);
        }

        bankId = bank.id;
        isEditMode = true;
    }

    //Preview document
    function showPreview(fileName, fileUrl = null) {

        let url;

        if (fileUrl) {
            url = fileUrl; // edit mode
        }
        else {
            // new upload (local preview)
            const file = $("#bankDocument")[0].files[0];
            url = URL.createObjectURL(file);
        }

        $(".documentLink")
            .attr("href", url)
            .attr("target", "_blank")
            .text(fileName);

        //$(".upload-section").addClass("d-none");
        $(".document-preview").removeClass("d-none");
    }

    function resetDocument() {
        resetDocumentUI();
    }

    function deleteDocument() {

        if (!bankId || !isEditMode) {
            errorToastr("Document cannot be deleted before saving.");
            return;
        }

        lov.confirmDelete("Document", function () {

            callBaseDeleteAPI(
                `${BANK_API}/delete-document/${bankId}`, documentDeletedsucessfully, commonError
            );
        });
    }

    function documentDeletedsucessfully() {
        resetDocumentUI();
        successToastr(MessageProvider.format( MessageProvider.DELETE_SUCCESS, "Document" ));
    }
    return {
        bankCreateInit,
        openBankModal,
        bankDataGet,
        resetDocument,
        deleteDocument
    };

})();

$(document).ready(BankCreateModule.bankCreateInit);
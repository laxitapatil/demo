const CaseHistoryModule = (() => {

    const CASESTATUSLOGAPI = "case-status-log";
    const CASE_HISTORY_TABLE_BODY = "#tblCaseHistory tbody";

    function caseHistory(caseId) {

        // reset summary
        $("#historyClientId").text("");
        $("#historyServiceId").text("");
        $("#historyCountryId").text("");
        $("#historyAppointment").html("");

        // clear table
        $(CASE_HISTORY_TABLE_BODY).empty();

        callBaseGetAPI(
            `${CASESTATUSLOGAPI}?caseId=${caseId}`,
            function (data) {

                if (!Array.isArray(data) || !data.length) {
                    $("#caseHistoryModal").modal("show");
                    return;
                }

                // case summary (first row)
                const first = data[0];
                $("#historyClientId").text(first.client);
                $("#historyServiceId").text(first.service);
                $("#historyCountryId").text(first.country);

                let appointmentText = "—";
                let appointmentClass = "text-muted";

                if (first.appointment_require === true) {
                    appointmentText = "Yes";
                    appointmentClass = "text-success fw-semibold";
                } else if (first.appointment_require === false) {
                    appointmentText = "No";
                    appointmentClass = "text-danger";
                }

                $("#historyAppointment").html(
                    `<span class="${appointmentClass}">${appointmentText}</span>`
                );
                let rowsHtml = "";

                data.forEach((row, index) => {
                    const statusName = row.case_status_name?.trim() || "";
                    const badgeClass = lov.getCaseStatusBadgeClass(statusName);

                    rowsHtml += `
                        <tr>
                            <td>${index + 1}</td>
                            <td>
                                <span class="badge ${badgeClass} font-size-13">
                                    ${statusName}
                                </span>
                            </td>
                            <td>${row.remark || ""}</td>
                            <td>${row.last_modified_date ? lov.formatDate(row.last_modified_date) : ""}</td>
                            <td>${row.last_modified_by || ""}</td>
                        </tr>
                    `;
                });

                $(CASE_HISTORY_TABLE_BODY).html(rowsHtml);

                $("#caseHistoryModal").modal("show");
            },
            commonError
        );
    }

    return {
        caseHistory
    };

})();

const CaseModule = (() => {

    const CASE_API = "case";
    const CASE_TABLE = "#tblCase";

    const $caseTable = $(CASE_TABLE);
    let dataTable = null;

    function caseInit() {
        lov.setDefaultDateRange();
        bindEvents();
        caseGet();
        initEditor();
        loadDropdowns();
    }

    function bindEvents() {

        // Refresh
        $(".btn-light").click(function (e) {
            e.preventDefault();
            caseFilterReset();

        });

        // Submit Filter Form
        $("#caseFilterForm").on("submit", function (e) {
            e.preventDefault();
            caseGet();
        });

        // reset
        $("#caseFilterForm").on("reset", function (event) {
            event.preventDefault();
            caseFilterReset();
        });
    }

    function caseFilterReset() {
        $("#caseFilterBankId").val("").trigger('change');
        $("#caseFilterStatusId").val("").trigger('change');
        $("#caseFilterVisitorId").val("").trigger('change');
        $("#caseFilterReportMakerId").val("").trigger('change');
        $("#caseFilterSearch").val("");
        lov.setDefaultDateRange();
        caseGet();
    }
    function loadDropdowns() {

        lov.populateDropdown("bank/name", "#caseFilterBankId", "Select All", null, null, false);
        lov.populateDropdown("case-status/name", "#caseFilterStatusId", "");
        lov.populateUserDropdown("user?role=Visitor", "#caseFilterVisitorId", "Select All", null, null, false);
        lov.populateUserDropdown("user?role=Report Maker", "#caseFilterReportMakerId", "Select All", null, null, false);
    }
    function getFilterRequest() {

        return {
            from_date: $("#fromDate").val() || null,
            to_date: $("#toDate").val() || null,

            bank_id: getSelectedId("#caseFilterBankId"),
            status: getSelectedIds("#caseFilterStatusId"),
            visitor_id: getSelectedId("#caseFilterVisitorId"),
            reporter_id: getSelectedId("#caseFilterReportMakerId"),

            search_text: $("#caseFilterSearch").val()?.trim() || null,

            id: null,
            case_id: null
        };

    }

    function getSelectedId(selector) {
        const val = $(selector).val();
        if (!val || isNaN(val)) return null;
        return parseInt(val);
    }

    function getSelectedIds(selector) {
        const val = $(selector).val();
        if (!val || val.length === 0) return null;
        return val.map(x => parseInt(x));
    }

    function caseGet() {
        callBasePostAPI(`${CASE_API}/get-by-filter`, getFilterRequest(), caseFill, commonError);
    }

    function caseFill(data) {

        if (!Array.isArray(data)) {
            errorToastr("Case data not found.");
            return;
        }

        if (dataTable) {
            dataTable.clear().rows.add(data).draw();
            return;
        }

        dataTable = setDataTable($caseTable, {
            data: data,
            scrollY: '500px',
            scrollCollapse: false,
            columns: [
                {
                    data: "case_id",
                    orderable: false,
                    render: function (case_id, type, row) {
                        return `
                            <div class="d-flex align-items-center gap-2 justify-content-center">
                                <a href="/case/edit/${case_id}" class="link-info" title="Edit Case">
                                    <i class="fi fi-rr-pencil"></i>
                                </a>
                                <a href="javascript:void(0);"
                                   class="link-danger"
                                   onclick="CaseHistoryModule.caseHistory(${row.id})"
                                   title="Case History">
                                   <i class="fi fi-rr-time-past"></i>
                                </a>
                            </div>
                        `;
                    }
                },
                { data: 'id' },
                { data: "created_date", render: d => lov.formatDate(d) },
                {
                    data: "bank",
                    render: (_, __, row) => `
                        <div>
                            <p class="fw-medium mb-1">${row.bank || "-"}</p>
                            <p class="text-secondary m-0">ID: ${row.bank_case_id || "-"}</p>
                        </div>
                    `
                },
                { data: "case_type" },
                {
                    data: "customer_name",
                    render: (_, __, row) => `
                        <div>
                            <span class="d-block mb-1 editable" data-field="tblCustomerName" data-type="text">${row.customer_name}</span>
                            <i class="fi fi-rr-phone-call me-2"></i>
                            <span class="link-secondary" data-field="tblCustomerContactNo" data-type="tel">${row.customer_contact}</span>
                        </div>
                    `
                },
                { data: "property_summary" },
                {
                    data: null,
                    render: row => `
                        <div>
                            <span class="d-block editable mb-1" data-type="select"
                                data-field="tblVisitor"
                                data-source="user?role=Visitor"
                                data-value="${row.visitor_id}">
                                ${row.visitor_name || "-"}
                            </span>
                            <span class="d-block editable" data-type="select"
                                data-field="tblReportMaker"
                                data-source="user?role=Report Maker"
                                data-value="${row.report_maker_id}">
                                ${row.report_maker_name || "-"}
                            </span>
                        </div>
                    `
                },
                { data: "visit_date", render: d => lov.formatDate(d) },
                {
                    data: "case_status_id",
                    render: (_, __, row) => {
                        const badgeClass = lov.getCaseStatusBadgeClass(row.case_status);
                        return `<label class="badge ${badgeClass}">${row.case_status || "-"}</label>`;
                    }
                },
                { data: "submit_date", render: d => lov.formatDate(d) },
                { data: "bill_date", render: d => lov.formatMonthYear(d) },
                { data: "fees" },
                { data: "modified_date", render: d => lov.formatDate(d) }
            ],
            rowCallback: function (row, data) {

                // First remove previous priority classes
                $(row).removeClass("priority-high priority-medium priority-low");

                if (data.priority_id === 1) {
                    $(row).addClass("priority-high");
                }       
                else if (data.priority_id === 2) {
                    $(row).addClass("priority-medium");
                }
                else if (data.priority_id === 3) {
                    $(row).addClass("priority-low");
                }
            },
            initComplete: function () {
                applyColumnFilters(this.api(), {
                    noFilterColumns: [0, 1, 3, 7, 10, 14],
                    selectFilterColumns: [4]
                });
            }
        });

    }

    function initEditor() {
        $('#tblCase').inlineEditor({
            save: function (data) {

                const rowData = dataTable.row(data.row).data();
                const caseId = rowData.case_id;

                const field = data.field;

                let value = data.newValue ? data.newValue.trim() : "";

                // If empty, set "-"
                if (!value) {
                    value = "-";
                }

                if (field === "tblCustomerName") {

                    if (value.length > 64) {
                        errorToastr("Customer name cannot exceed 64 characters.");
                        return false;
                    }
                }

                if (field === "tblCustomerContactNo") {

                    if (value.length > 32) {
                        errorToastr("Customer contact cannot exceed 32 characters.");
                        return false;
                    }
                }

                callBasePutAPI(
                    "case/update-field",
                    {
                        case_id: caseId,
                        field: field,
                        value: value
                    }, fieldEditedSuccessfully
                    , commonError
                );
            }
        });
    }

    function fieldEditedSuccessfully() {
        successToastr(MessageProvider.format(MessageProvider.UPDATE_SUCCESS, "Field"));
        caseGet();
    }


    return {
        caseInit,
    };

})();

$(document).ready(CaseModule.caseInit);
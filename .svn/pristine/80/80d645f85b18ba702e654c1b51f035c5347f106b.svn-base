const CaseCreateModule = (() => {

    const CASE_API = "case";
    const $caseForm = $("#caseCreateForm");
    const $propertyForm = $("#caseCreatePropertyForm");

    let caseId = null;
    let caseUId = null;
    let caseValidator = null;
    let caseStatusId = null;

    let propertyValidator = null;
    let properties = [];
    let propertyEditId = null;
    let isPropertySaveAndNew = false;
    let selectedPropertyId = null;
    function caseCreateInit() {

        if (!$caseForm.length) return;



        const uid = getCaseIdFromUrl();

        if (!uid) {
            errorToastr("Case not found");
            return;
        }

        caseUId = uid;

        loadDropdowns();
        loadCaseDetails(uid);
        bindEvents();
        caseFormValidation();
        propertyFormValidation();
    }
    function bindEvents() {

        $("#btnSaveCase").on("click", caseSave);
        $propertyForm.on("submit", saveProperty);

        $("#btnPropertySaveAndNext").on("click", function () {
            isPropertySaveAndNew = true;
            $propertyForm.submit();
        });
        $("#btnAddProperty").on("click", function () {
            resetPropertyForm();
            $("#btnPropertySaveAndNext").removeClass("d-none");
            $("#propertyModal  .modal-title").text("Add Property");

        });

        $("#caseCreateBank").on("change", loadBranches);

        $(document).on("click", ".btn-edit-property", function () {
            const propertyId = $(this).data("id");
            openPropertyModal(propertyId);
        });

        $(document).on("click", ".property-select", function () {
            const item = $(this).closest(".property-item");
            $(".property-item").removeClass("active");
            item.addClass("active");
            const propertyId = item.data("id");
            selectedPropertyId = item.data("id");
            loadProperty(propertyId);
        });

        $(document).on("click", ".case-status-btn", function () {
            openCaseStatus();
        });

        $(document).on("click", ".btn-delete-doc", function () {

            const id = $(this).data("id");

            if (!id) return;

            lov.genericDelete(id, "case-document", "Document",
                function () {
                    loadCaseDetails(caseUId);

                }
            );
        });
    }
    function openCaseStatus() {
        const caseData = {
            case_id: caseUId,
            case_no: caseId,
            customer_name: $("#caseCreateCustName").val(),
            case_status_id: caseStatusId,
            case_status_name: $("#caseCreateStatus").text()
        };
        CaseStatusModule.openCaseStatusModal(caseData);
    }
    function loadDropdowns() {

        lov.populateDropdown("case-type/name", "#caseCreateType", "Select");
        lov.populateDropdown("state/name", "#caseCreateState", "Select");
        lov.populateDropdown("bank/name", "#caseCreateBank", "Select");
        //lov.populateDropdown("bank-branch/name", "#caseCreateBankBranch", "Select");
        lov.populateDropdown("bank-vertical/name", "#caseCreatebankDept", "Select");

        lov.populateUserDropdown("user?role=Visitor", "#caseCreateVisitor", "Select");
        lov.populateUserDropdown("user?role=Report Maker", "#caseCreateReportMaker", "Select");

        lov.populateDropdown("case-property/property-type", "#caseCreatepropertyType", "Select");
        $("#caseCreateBankBranch").empty().append(`<option value="">Select</option>`);


    }
    function loadBranches() {

        const bankId = $("#caseCreateBank").val();

        const $branch = $("#caseCreateBankBranch");

        $branch.empty().append(`<option value="">Select</option>`);

        if (!bankId) return;

        lov.populateDropdown(`bank-branch/name?bankId=${bankId}`, "#caseCreateBankBranch", "Select");
    }

    function getCaseIdFromUrl() {

        const segments = window.location.pathname
            .toLowerCase()
            .split("/")
            .filter(Boolean);

        if (segments.length === 3 && segments[0] === "case") {
            return segments[2];
        }

        return null;
    }
    // Load case details along with properties in one API call to avoid multiple calls and ensure data consistency
    function loadCaseDetails(uid) {

        callBaseGetAPI(`${CASE_API}/case-details/${uid}`, loadCaseAndProperties, commonError);
    }

    function loadCaseAndProperties(response) {

        if (!response) return;

        if (response.case_details) {
            fillCaseForm(response.case_details);
        }

        loadProperties(response);
    }
    function fillCaseForm(data) {

        if (!data) return;

        caseId = data.id;
        caseUId = data.case_id;

        $("#caseCreateNo").val(data.id || "");
        $("#caseCreateDate").val(lov.formatDateForInput(data.bill_date));
        lov.populateDropdown("case-type/name", "#caseCreateType", "Select", data.case_type);
        lov.populateDropdown("bank/name", "#caseCreateBank", "Select", data.bank_id);
        if (data.bank_id) {
            lov.populateDropdown(`bank-branch/name?bankId=${data.bank_id}`, "#caseCreateBankBranch", "Select", data.bank_branch_id);
        }
        lov.populateDropdown("bank-vertical/name", "#caseCreatebankDept", "Select", data.bank_vertical_id);
        $("#caseCreateBankCaseId").val(data.bank_case_id || "");
        lov.populateUserDropdown("user?role=Visitor", "#caseCreateVisitor", "Select", data.visitor_id);
        lov.populateUserDropdown("user?role=Report Maker", "#caseCreateReportMaker", "Select", data.report_maker_id);

        $("#caseCreateCustName").val(data.customer_name || "");
        $("#caseCreateCustContactNo").val(data.customer_contact || "");
        $("#caseCreateFees").val(data.fees || "");

        if (data.priority === 1) $("#highPriority").prop("checked", true);
        else if (data.priority === 2) $("#mediumPriority").prop("checked", true);
        else $("#lowPriority").prop("checked", true);

        const createStatusClass = (lov.getCaseStatusBadgeClass(data.case_status_name) || "");

        $("#caseCreateStatus")
            .removeClass()
            .addClass(`badge ${createStatusClass} m-0`)
            .text(data.case_status_name);
        caseStatusId = data.case_status_id;
    }


    function caseFormValidation() {

        caseValidator = $caseForm.validate({

            errorElement: "span",

            rules: {
                caseCreateType: { required: true },
                caseCreateBank: { required: true }
            },

            errorPlacement: function (error, element) {

                error.addClass("text-danger");
                error.insertAfter(element);
            }
        });
    }

    function getFormData() {

        return {

            id: caseId,
            case_id: caseUId,

            case_type: parseInt($("#caseCreateType").val()) || null,
            priority: getPriorityValue(),
            case_status_id: caseStatusId,

            bank_id: parseInt($("#caseCreateBank").val()) || null,
            bank_branch_id: parseInt($("#caseCreateBankBranch").val()) || null,
            bank_vertical_id: parseInt($("#caseCreatebankDept").val()) || null,

            visitor_id: parseInt($("#caseCreateVisitor").val()) || null,
            report_maker_id: parseInt($("#caseCreateReportMaker").val()) || null,

            bank_case_id: $("#caseCreateBankCaseId").val()?.trim() || null,

            customer_name: $("#caseCreateCustName").val()?.trim() || null,
            customer_contact: $("#caseCreateCustContactNo").val()?.trim() || null,
            fees: $("#caseCreateFees").val()?.trim() || null,

            bill_date: $("#caseCreateDate").val() || null
        };
    }

    function caseSave(e) {

        e.preventDefault();

        if (!caseValidator.form()) return;

        const data = getFormData();
        callBasePutAPI(CASE_API, data, updateSuccess, commonError);
    }

    function updateSuccess() {
        successToastr(MessageProvider.format(MessageProvider.UPDATE_SUCCESS, "Case"));
        loadCaseDetails(caseUId);
    }
    // property detail (insert/update) 
    function getPriorityValue() {
        return parseInt($("input[name='caseCreatePriority']:checked").val()) || 2;
    }
    function propertyFormValidation() {

        propertyValidator = $propertyForm.validate({

            ignore: [],

            errorElement: "span",

            rules: {
                caseCreatepropertyType: { required: true },
                caseCreatePropertyName: { required: true },
                caseCreatePropertyAddress: { required: true }
            },

            messages: {
                caseCreatepropertyType: "Please select Property Type ",
                caseCreatePropertyName: "Please enter Property Name",
                caseCreatePropertyAddress: "Please enter Address"
            },

            errorPlacement: function (error, element) {

                error.addClass("text-danger");

                if (element.hasClass("select2-hidden-accessible")) {
                    error.insertAfter(element.next(".select2"));
                } else {
                    error.insertAfter(element);
                }
            }
        });
    }

    function saveProperty(e) {
        e.preventDefault();
        if (!$propertyForm.valid()) return;

        if (!caseId) {
            errorToastr("Save case first");
            return;
        }

        const data = {

            id: propertyEditId,
            case_id: caseId,
            property_type: parseInt($("#caseCreatepropertyType").val()) || null,
            name: $("#caseCreatePropertyName").val()?.trim(),
            distance: $("#caseCreatePropertyDistance").val() || null,
            size_sqft: $("#caseCreatePropertySize").val() || null,
            address: $("#caseCreatePropertyAddress").val()?.trim(),
            state_id: parseInt($("#caseCreateState").val()) || null,
            note: $("#propertyNote").val()?.trim()
        };

        if (propertyEditId) {
            callBasePutAPI("case-property", data, propertyUpdateSuccess, commonError);
        } else {
            callBasePostAPI("case-property", data, propertyInsertSuccess, commonError);
        }
    }

    function propertyInsertSuccess() {
        successToastr(MessageProvider.format(MessageProvider.INSERT_SUCCESS, "Property"));
        loadCaseDetails(caseUId);
        if (isPropertySaveAndNew) {
            resetPropertyForm();
            isPropertySaveAndNew = false;
            new bootstrap.Modal(document.getElementById("propertyModal")).show();

            return;
        }
        bootstrap.Modal.getInstance(document.getElementById("propertyModal")).hide();
        resetPropertyForm();
    }

    function propertyUpdateSuccess() {
        successToastr(MessageProvider.format(MessageProvider.UPDATE_SUCCESS, "Property"));
        loadCaseDetails(caseUId);
        bootstrap.Modal.getInstance(document.getElementById("propertyModal")).hide();
        resetPropertyForm();
    }

    function resetPropertyForm() {

        propertyEditId = null;
        $propertyForm[0].reset();
        $("#btnPropertySaveAndNext").removeClass("d-none");
        $("#caseCreatepropertyType").val(null).trigger("change");
        $("#caseCreateState").val(null).trigger("change");
        $("#caseCreatePropertyDistance").val("");
        $("#caseCreatePropertySize").val("");
        $("#propertyNote").val("");
        $("#caseCreatePropertyName").val("");
        $("#caseCreatePropertyAddress").val("");
        if (propertyValidator)
            propertyValidator.resetForm();
    }

    function loadProperty(propertyId) {
        const property = properties.find(p => p.id == propertyId);

        if (!property) return;

        $("#propertyTitle").text(property.name || "Property");
        $("#caseCreatePropertyName").val(property.name);
        $("#caseCreatePropertyAddress").val(property.address);
        $("#caseCreatePropertyDistance").val(property.distance);
        $("#caseCreatePropertySize").val(property.size_sqft);

        // render document based on property 
        renderDocuments(property.documents.bank_documents, "#bankDocumentContainer", CaseDocumentModule.DocumentType.BANK_DOCUMENT);
        renderDocuments(property.documents.property_documents, "#propertyDocumentContainer", CaseDocumentModule.DocumentType.PROPERTY_IMAGE);
        renderDocuments(property.documents.visit_sheet, "#visitSheetContainer", CaseDocumentModule.DocumentType.VISIT_SHEET);
        renderDocuments(property.documents.case_documents, "#caseDocumentContainer", CaseDocumentModule.DocumentType.CASE_DOCUMENT);
    }

    function openPropertyModal(propertyId) {

        resetPropertyForm();

        const property = properties.find(p => p.id == propertyId);
        if (!property) return;

        propertyEditId = property.id;
        $("#btnPropertySaveAndNext").addClass("d-none");
        $("#propertyModal .modal-title").text("Edit Property");
        $("#caseCreatePropertyName").val(property.name);
        $("#caseCreatePropertyAddress").val(property.address);
        $("#caseCreatepropertyType").val(property.property_type_id).trigger("change");
        $("#caseCreatePropertyDistance").val(property.distance);
        $("#caseCreatePropertySize").val(property.size_sqft);
        $("#propertyNote").val(property.note);
        lov.populateDropdown("state/name", "#caseCreateState", "Select", property.state_id);

        new bootstrap.Modal(document.getElementById("propertyModal")).show();
    }

    function loadProperties(response) {

        if (!response || !response.properties) return;

        properties = response.properties;

        renderProperties();
    }

    function renderProperties() {

        const container = $("#propertyList");
        container.empty();

        if (!properties.length) return;

        let html = "";
        properties.forEach((p, index) => {

            const name = p.name || `Property ${index + 1}`;
            const property_type_name = p.property_type || "";
            const isActive = selectedPropertyId ? p.id == selectedPropertyId : index === 0;
            html += `
                <li class="property-item d-flex justify-content-between align-items-center ${isActive ? "active" : ""}" data-id="${p.id}">
                    <div class="property-select flex-grow-1">
                        <div class="fw-semibold">${name}</div>
                        <span class="text-muted">${property_type_name}</span>
                    </div>

                    <button class="btn btn-sm btn-light btn-edit-property ms-2" data-id="${p.id}">
                        <i class="fi fi-rr-pencil"></i>
                    </button>

                </li>
            `;
        });

        container.html(html);
        const propertyId = selectedPropertyId || properties[0].id;
        loadProperty(propertyId);
    }

    //document section 
    function getFileIcon(file) {

        if (!file) return "file.png";

        const ext = file.split(".").pop().toLowerCase();

        if (["jpg", "jpeg", "png", "webp"].includes(ext)) return "image.png";
        if (ext === "pdf") return "pdf.png";
        if (["doc", "docx"].includes(ext)) return "doc.png";
        if (["xls", "xlsx", "csv"].includes(ext)) return "google-sheet.png";

        return "file.png";
    }

    function isImage(file) {

        if (!file) return false;

        const ext = file.split(".").pop().toLowerCase();

        return ["jpg", "jpeg", "png", "webp", "bmp"].includes(ext);
    }

    function renderDocuments(docs, containerId, docType) {

        const container = $(containerId);
        container.empty();

        if (!docs || !docs.length) {
            container.append(`<p class="text-muted">No documents uploaded</p>`);
            return;
        }

        const showEdit = !(docType === CaseDocumentModule.DocumentType.PROPERTY_IMAGE ||
            docType === CaseDocumentModule.DocumentType.VISIT_SHEET);

        let html = "";

        docs.forEach(d => {

            let preview = "";

            if (isImage(d.file_path)) {

                const imageUrl = generateCaseDocURL(d.file_path);

                preview = `<img src="${imageUrl}" class="preview-img w-100" style="object-fit:cover;height:150px;">`;

            } else {

                const icon = getFileIcon(d.file_path);

                preview = `<img src="/assets/images/icons/${icon}" class="preview-img w-50">`;
            }

            html += `
                <div class="col-xl-2 col-lg-3 col-md-6">

                    <div class="upload-ui" style="height:200px">
                        <div class="upload-preview text-center">
                            ${preview}
                        </div>
                    </div>

                    <div class="upload-actions text-center">

                        <button class="btn btn-success btn-sm"
                         onclick="CaseCreateModule.viewDocument('${d.file_path}')">
                            <i class="fi fi-rr-eye"></i>
                        </button>
                        ${showEdit ? `
                                <button class="btn btn-primary btn-sm btn-edit-doc"
                                        data-id="${d.id}"
                                        data-title="${d.title}"
                                        data-type="${docType}"
                                         data-file="${d.file_path}">
                                    <i class="fi fi-rr-pencil"></i>
                                </button>
                            ` : ""
                         }
                         <button class="btn btn-danger btn-sm btn-delete-doc" data-id="${d.id}">
                            <i class="fi fi-rr-trash"></i>
                        </button>

                    </div>

                    <div class="mt-2">
                        <p class="mb-1 fw-medium">${d.title || "Document"}</p>

                        <p class="small text-secondary mb-0">
                            Created: ${d.created_by},
                            ${lov.formatDateTime(d.created_date)}
                        </p>
                         ${d.modified_by && d.modified_date ? `
                        <p class="small text-secondary mb-0">
                            Modified: ${d.modified_by},
                            ${lov.formatDateTime(d.modified_date)}
                        </p>` : ""}
                    </div>

                </div>
            `;
        });

        container.html(html);
    }
    function viewDocument(filePath) {

        if (!filePath) return;

        const fileUrl = generateCaseDocURL(filePath);
        const ext = filePath.split(".").pop().toLowerCase();

        // Browser supported preview types
        const previewTypes = [
            "jpg", "jpeg", "png", "gif", "webp", "bmp",
            "pdf",
            "mp4", "webm", "ogg",
            "mp3", "wav"
        ];

        if (previewTypes.includes(ext)) {
            window.open(fileUrl, "_blank");
        }
        else {
            // Force download
            const link = document.createElement("a");
            link.href = fileUrl;
            link.download = filePath.split("/").pop();
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    }
    function getCaseId() {
        return caseId;
    }

    function getCaseUid() {
        return caseUId;
    }

    function getSelectedPropertyId() {

        const active = $(".property-item.active");

        if (!active.length) return null;

        return active.data("id");
    }
    return {
        caseCreateInit,
        resetPropertyForm,
        loadCaseDetails,
        viewDocument,
        getCaseId,
        getCaseUid,
        getSelectedPropertyId
    };

})();

$(document).ready(function () {

    CaseCreateModule.caseCreateInit();

    CaseDocumentModule.caseDocInit();

});
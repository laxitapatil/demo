using Api.Provider;
using AutoMapper;
using Core.Domain;
using Core.Request;
using Core.Response;
using Infrastructure;
using Infrastructure.Base;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Api.Controllers
{
    [Tags("Case Status")]
    [Authorize]
    [Route("api/case-status")]
    [ApiController]
    public class CaseStatusMasController : BaseController
    {
        private readonly string CASE_STATUS = "Case status";

        public CaseStatusMasController(IConfiguration configuration, IMapper mapper, DBContext dbContext)
            : base(configuration, mapper, dbContext) { }

        /// <summary>
        /// Retrieve information about a specific / all Case Statuses based on the ID.
        /// </summary>
        /// <param name="id">if null then all, else specific</param>
        /// <param name="isActive">filter by active status</param>
        /// <returns>200 - Case Status detail, 401 Unauthorized, 500 Internal Server Error - Error message</returns>
        [Authorize]
        [HttpGet]
        public async Task<IActionResult> Get(short? id, bool? isActive)
        {
            try
            {
                return Ok(await new CaseStatusMasRepository(dbContext).SelectAll(id, isActive));
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Get name of active case status for dropdown
        /// </summary>
        /// <returns></returns>
        [Authorize]
        [HttpGet("name")]
        public async Task<IActionResult> GetName()
        {
            try
            {
                using CaseStatusMasRepository repoCaseStatusMas = new(dbContext);
                var response = await repoCaseStatusMas.SelectName();
                return Ok(response);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }
        /// <summary>
        /// Create a new Case Status.
        /// </summary>
        /// <param name="request">Id Optional</param>
        /// <returns>200 - Success message, 401 Unauthorized, 400 Bad request - Error message, 500 Internal Server Error - Error message</returns>
        [Authorize(Roles = "Admin,Staff")]
        [HttpPost]
        public async Task<IActionResult> Post(CaseStatusMasRequest request)
        {
            try
            {
                CaseStatusMas caseStatus = mapper.Map<CaseStatusMasRequest, CaseStatusMas>(request);
                using CaseStatusMasRepository repoCaseStatus = new(dbContext);

                caseStatus.Modified_by = TokenName;
                caseStatus.Modified_date = CurrentTime;

                int result = await repoCaseStatus.Insert(caseStatus);

                return result > 0
                    ? Ok(mapper.Map<CaseStatusMas, CaseStatusMasResponse>(caseStatus))
                    : Problem(string.Format(MessageProvider.INSERT_FAILED, CASE_STATUS), statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Modify the details of an existing Case Status.
        /// </summary>
        /// <param name="request"></param>
        /// <returns>200 - Success message, 401 Unauthorized, 400 Bad request - Error message, 500 Internal Server Error - Error message</returns>
        [Authorize(Roles = "Admin,Staff")]
        [HttpPut]
        public async Task<IActionResult> Put(CaseStatusMasRequest request)
        {
            try
            {
                if (!request.Id.HasValue || request.Id < 1)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_STATUS), statusCode: StatusCodes.Status404NotFound);

                using CaseStatusMasRepository repoCaseStatus = new(dbContext);
                CaseStatusMas? caseStatus = await repoCaseStatus.SelectOne(request.Id.Value);

                if (caseStatus == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_STATUS), statusCode: StatusCodes.Status404NotFound);

                caseStatus.Name = request.Name;
                caseStatus.Is_active = request.Is_active;
                caseStatus.Modified_by = TokenName;
                caseStatus.Modified_date = CurrentTime;

                int result = await repoCaseStatus.Update(caseStatus);
                return result > 0
                     ? Ok(mapper.Map<CaseStatusMas, CaseStatusMasResponse>(caseStatus))
                     : Problem(string.Format(MessageProvider.UPDATE_FAILED, CASE_STATUS), statusCode: StatusCodes.Status500InternalServerError);
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }

        /// <summary>
        /// Delete an existing Case Status.
        /// </summary>
        /// <param name="id"></param>
        /// <returns>200 - Success message, 401 Unauthorized, 400 Bad request - Error message, 500 Internal Server Error - Error message</returns>
        [Authorize(Roles = "Admin,Staff")]
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(short id)
        {
            try
            {
                using CaseStatusMasRepository repoCaseStatus = new(dbContext);
                CaseStatusMas? caseStatus = await repoCaseStatus.SelectOne(id);

                if (caseStatus == null)
                    return Problem(string.Format(MessageProvider.NOT_FOUND, CASE_STATUS), statusCode: StatusCodes.Status404NotFound);

                await repoCaseStatus.Delete(caseStatus);
                return Ok(string.Format(MessageProvider.DELETE_SUCCESS, CASE_STATUS));
            }
            catch (Exception ex)
            {
                if (ex.ToString().ToLower().Contains("fk"))
                    return Problem(MessageProvider.CHILD_FOUND, statusCode: StatusCodes.Status400BadRequest);

                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }
    }
}
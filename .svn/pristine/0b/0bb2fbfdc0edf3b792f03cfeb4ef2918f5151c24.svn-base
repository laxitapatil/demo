using Core.Domain;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.Data;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class CaseTypeMasRepository : BaseRepository
    {
        private readonly DBContext _dbContext;

        public CaseTypeMasRepository(DBContext dBContext) => _dbContext = dBContext;

        #region AutoGenerated

        public async Task<int> Insert(CaseTypeMas caseTypeMas)
        {
            await _dbContext.CaseTypeMas.AddAsync(caseTypeMas);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(CaseTypeMas caseTypeMas)
        {
            _dbContext.CaseTypeMas.Update(caseTypeMas);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(CaseTypeMas caseTypeMas)
        {
            _dbContext.CaseTypeMas.Remove(caseTypeMas);
            return await _dbContext.SaveChangesAsync();
        }

        public async Task<JsonNode?> SelectAll(short? id, bool? isActive)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_is_active", isActive);
            using NpgsqlConnection connection = new(connectionString);
            string? response = await connection.QueryFirstAsync<string>("SELECT case_type_mas_selectall(@_id, @_is_active)", parameter);
            return string.IsNullOrWhiteSpace(response) ? JsonNode.Parse("[]") : JsonNode.Parse(response);
        }

        public async Task<CaseTypeMas?> SelectOne(short id) =>
            await _dbContext.CaseTypeMas.Where(x => x.Id == id).FirstOrDefaultAsync();

        public async Task<List<SelectListResponse>> SelectName()
        {
            return await _dbContext.CaseTypeMas
                .Where(caseType => caseType.Is_active)
                .OrderBy(caseType => caseType.Name)
                .Select(caseType => new SelectListResponse
                {
                    id = caseType.Id,
                    name = caseType.Name
                })
                .ToListAsync();
        }

        #endregion AutoGenerated

    }
}
using Core.Domain;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class BankBranchRepository : BaseRepository
    {
        public BankBranchRepository(DBContext dbContext) : base(dbContext) { }


        #region AutoGenerated

        public async Task<int> Insert(BankBranch bankBranch)
        {
            await dbContext.Set<BankBranch>().AddAsync(bankBranch);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(BankBranch bankBranch)
        {
            dbContext.Set<BankBranch>().Update(bankBranch);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(BankBranch bankBranch)
        {
            dbContext.Set<BankBranch>().Remove(bankBranch);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<BankBranch?> SelectOne(int id)
        {
            return await dbContext.Set<BankBranch>()
                .Where(x => x.Id == id)
                .FirstOrDefaultAsync();
        }

        public async Task<BankBranch?> SelectByName(int bankId, string name)
        {
            return await dbContext.Set<BankBranch>()
                .Where(x => x.Bank_id == bankId && x.Name.ToLower() == name.ToLower()).FirstOrDefaultAsync();
        }

        public async Task<JsonNode?> SelectAll(int? id, int? bankId, bool? isActive)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_bank_id", bankId);
            parameter.Add("_is_active", isActive);

            string? response = await connection.QueryFirstAsync<string>( @"SELECT public.bank_branch_selectall(@_id, @_bank_id, @_is_active)", parameter);

            return string.IsNullOrWhiteSpace(response)? JsonNode.Parse("[]"): JsonNode.Parse(response);
        }

        #endregion

        #region Dropdown

        public async Task<List<SelectListResponse>> SelectBranchByBank(int? bankId)
        {
            var query = dbContext.Set<BankBranch>()
                .Where(x => x.Is_active);

            if (bankId.HasValue)
            {
                query = query.Where(x => x.Bank_id == bankId.Value);
            }

            return await query
                .OrderBy(x => x.Name)
                .Select(x => new SelectListResponse
                {
                    id = (short)x.Id,
                    name = x.Name
                })
                .ToListAsync();
        }

        #endregion
    }
}
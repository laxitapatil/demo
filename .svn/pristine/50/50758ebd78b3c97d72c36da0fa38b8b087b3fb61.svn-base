using AutoMapper;
using Core.Domain;
using Core.Enumeration;
using Core.Request;
using Core.Response;

namespace Core
{
    public class AutoMapperProfile : Profile
    {
        public AutoMapperProfile()
        {
            CreateMap<UserRequest, AspNetUsers>()
                .ForMember(destionation => destionation.PasswordHash, option => option.MapFrom(source => source.Password));

            CreateMap<AspNetUsers, UserResponse>();
            CreateMap<AspNetUsers, LoginResponse>();

            CreateMap<MenuRequest, Menu>();
            CreateMap<MenuRightsRequest, MenuRights>();

            CreateMap<CaseDocumentRequest, CaseDocument>()
                .ForMember(destination => destination.Doc_type, option => option.MapFrom(source => (short)source.Doc_type));


            CreateMap<CaseDocument, CaseDocumentResponse>()
                .ForMember(destination => destination.Doc_type, option => option.MapFrom(source => (DocumentType)source.Doc_type));

            CreateMap<CaseStatusLogRequest, CaseStatusLog>().ReverseMap();

            //=============================
            CreateMap<BankRequest, Bank>()
                .ForMember(destination => destination.Template_type, option => option.MapFrom(source => (short?)source.Template_type));

            CreateMap<Bank, BankResponse>()
                .ForMember(destination => destination.Template_type, option => option.MapFrom(source => (TemplateType?)source.Template_type));

            CreateMap<BankBranchRequest, BankBranch>().ReverseMap();
            CreateMap<BankBranch, BankBranchResponse>().ReverseMap();

            CreateMap<BankVerticalRequest, BankVertical>().ReverseMap();
            CreateMap<BankVertical, BankVerticalResponse>().ReverseMap();

            CreateMap<CaseRequest, Case>()
               .ForMember(destination => destination.Priority, option => option.MapFrom(source => (short)source.Priority));

            CreateMap<Case, CaseResponse>()
                .ForMember(destination => destination.Priority, option => option.MapFrom(source => (CasePriority)source.Priority));

            CreateMap<StateMasRequest, StateMas>().ReverseMap();
            CreateMap<StateMas, StateMasResponse>().ReverseMap();

            CreateMap<CaseTypeMasRequest, CaseTypeMas>().ReverseMap();
            CreateMap<CaseTypeMas, CaseTypeMasResponse>().ReverseMap();

            CreateMap<PropertyTypeMasRequest, PropertyTypeMas>().ReverseMap();
            CreateMap<PropertyTypeMas, PropertyTypeMasResponse>().ReverseMap();

            CreateMap<CaseStatusMasRequest, CaseStatusMas>().ReverseMap();
            CreateMap<CaseStatusMas, CaseStatusMasResponse>().ReverseMap();

            CreateMap<CasePropertyRequest, CaseProperty>()
               .ForMember(destination => destination.Property_type, option => option.MapFrom(source => (short)source.Property_type));

            CreateMap<CaseProperty, CasePropertyResponse>()
                .ForMember(destination => destination.Property_type, option => option.MapFrom(source => (PropertyType)source.Property_type));
        }
    }
}

<div class="modal fade" id="bankModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-md modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form id="bankForm" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Add Bank</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row gy-3">
                        <div class="col-lg-12 ">
                            <label>Bank Name</label>
                            <input type="text" class="form-control" name="bankName" id="bankName" placeholder="Bank Name" maxlength="64"/>
                        </div>
                        <div class="col-lg-12">
                            <label>Bank Code</label>
                            <input type="text" class="form-control" name="bankCode" id="bankCode" placeholder="E.x BOB" maxlength="12" />
                        </div>
                        <div class="col-lg-12">
                            <label class="form-label">Template Type</label>

                            <div class="d-flex gap-4 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio"
                                           name="templateType"
                                           id="templateDocument"
                                           value="1"
                                           checked>
                                    <label class="form-check-label" for="templateDocument">
                                        Document
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio"
                                           name="templateType"
                                           id="templatePortalLink"
                                           value="2">
                                    <label class="form-check-label" for="templatePortalLink">
                                        Portal Link
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12" id="documentTemplateSection">

                            <label>Report Template</label>

                            <div class="document-upload-wrapper">

                                <!-- Upload Section -->
                                <div class="upload-section">
                                    <input type="file"
                                           id="bankDocument"
                                           class="form-control document-input"
                                           accept=".pdf,.doc,.docx" />
                                </div>

                                <!-- Preview Section -->
                                <div class="document-preview d-none mt-2">
                                    <a href="#" class="documentLink"></a>
                                    <button type="button" class="btn btn-sm btn-warning reset-document ms-2">
                                        <i class="fi fi-rr-cross"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger delete-document d-none ms-2">
                                        <i class="fi fi-rr-trash"></i>
                                    </button>
                                </div>

                            </div>
                        </div>
                        <div class="col-lg-12 d-none" id="portalLinkSection">
                            <label>Portal Link</label>
                            <input type="url"
                                   class="form-control"
                                   id="portalLinkInput"
                                   name="portalLink"
                                   placeholder="Enter portal link (https://example.com)" />
                        </div>
                        <div class="col-lg-12 ">
                            <label>Report Template Name</label>
                            <input type="text" maxlength="64" class="form-control" name="reportTemplateName" id="reportTemplateName" placeholder="Report Template Name" />
                        </div>
                        <div class="col-lg-12">
                            <div class="form-check form-switch" dir="ltr">
                                <input class="form-check-input" type="checkbox" id="bankStatus" checked="">
                                <label class="form-check-label" for="statusBankForm">Active</label>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <button id="btnSaveBank" class="btn btn-primary"><i class="fi fi-rr-disk me-2"></i>Save</button>
                            <button type="button" id="btnSaveAddNewBank" class="btn btn-secondary"><i class="fi fi-rr-disk me-2"></i>Save & Add New</button>
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="fi fi-rr-cross-circle me-2"></i>Cancel</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

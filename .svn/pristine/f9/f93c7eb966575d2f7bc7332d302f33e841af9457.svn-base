using AutoMapper;
using Core.Request;
using Infrastructure;
using Infrastructure.Base;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Api.Controllers
{
    [Tags("Report")]
    [Authorize]
    [Route("api/report")]
    [ApiController]
    public class ReportController : BaseController
    {
        private readonly string REPORT = "Report";

        public ReportController(IConfiguration configuration, IMapper mapper, DBContext dbContext)
            : base(configuration, mapper, dbContext) { }

        /// <summary>
        /// Get Report Property List (With Filters)
        /// </summary>
        /// <param name="request">Report filters</param>
        /// <returns></returns>
        [Authorize]
        [HttpPost("case-analysis")]
        public async Task<IActionResult> Get(ReportFilterRequest request)
        {
            try
            {
                return Ok(await new ReportRepository(dbContext).SelectAll(request));
            }
            catch (Exception ex)
            {
                return Problem(ex.Message, statusCode: StatusCodes.Status500InternalServerError);
            }
        }
    }
}
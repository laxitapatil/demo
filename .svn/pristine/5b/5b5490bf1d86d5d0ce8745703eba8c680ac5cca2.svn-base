const CaseModalCreateModule = (() => {

    const CASE_API = "case";
    const $caseCreateForm = $("#quickCaseForm");
    let caseCreateValidator = null;

    let tempFilesOnCreate = [];

    function caseCreateInit() {
        $("#bankDocInputOnCreate").off("change");
        $("#btnAddBankDocOnCreate").off("click");

        $caseCreateForm.find("select").on("change", function () {
            if (caseCreateValidator) {
                $(this).valid();   // Re-validate this field only
            }
        });
        caseCreateFormValidation();
        $("#bank").on("change", loadBranches);

        $('#caseModal').on('shown.bs.modal', function () {

            setDefaultValues();
            loadDropdowns();

        });

        $("#btnSaveQuickCase").on("click", saveQuickCase);
        $("#saveAndRedirect").on("click", saveAndRedirect);

        $("#caseModal").on("hidden.bs.modal", resetForm);

        $("#btnAddBankDocOnCreate").on("click", function () {
            $("#bankDocInputOnCreate").trigger("click");
        });

        $("#bankDocInputOnCreate").on("change", function () {

            const files = this.files;

            console.log(" files selected:", files);

            if (!files || !files.length) return;

            for (let file of files) {
                tempFilesOnCreate.push(file);
            }

            console.log(" Temp files:", tempFilesOnCreate);

            successToastr(files.length + " file(s) added");

            this.value = "";
        });
    }
    function setDefaultValues() {

        const today = new Date();
        const formattedDate = today.toISOString().split("T")[0];

        $("#caseDate").val(formattedDate);
        $("#caseID").val("");
    }
    function loadDropdowns() {

        lov.populateDropdownForSelect2("case-type/name", "#caseTypeId", "Select");
        lov.populateDropdownForSelect2("bank/name", "#bank", "Select");
        lov.populateDropdownForSelect2("property-type/name", "#propertyType", "Select");
        lov.populateUserDropdown("user?role=Visitor", "#caseVisitor", "Select");
    }
    function loadBranches() {

        const bankId = $("#bank").val();

        if (!bankId) {
            $("#bankBranch").empty().append(`<option value="">Select Bank Branch</option>`);
            return;
        }

        lov.populateDropdownForSelect2(`bank-branch/name?bankId=${bankId}`, "#bankBranch", "Select");
    }
    function caseCreateFormValidation() {

        $.validator.setDefaults({
            ignore: ":hidden:not(.select2-hidden-accessible)"
        });

        caseCreateValidator = $("#caseModal").find("form").validate({
            errorElement: "span",
            rules: {
                caseDate: {
                    required: true
                },
                caseTypeId: {
                    required: true
                },
                bank: {
                    required: true
                },
                propertyType: {
                    required: true
                },
                custContactNo: {
                    digits: true,
                    minlength: 10,
                    maxlength: 10
                },
                custContactNo: {
                    minlength: 10,
                    maxlength: 10,
                    digits: true
                },

                propertyName: {
                    required: true,
                    minlength: 2,
                    notBlank: true
                },

                propertyAddress: {
                    required: true,
                    minlength: 5,
                    notBlank: true
                },

                bankCaseId: {
                    required: true,
                    minlength: 2,
                    notBlank: true
                }
            },

            messages: {
                caseDate: "Select Case Date",
                caseTypeId: "Select Case Type",
                bank: "Select Bank",
                propertyType: "Select Property Type",

                custContactNo: {
                    minlength: "Must be exactly 10 digits",
                    maxlength: "Must be exactly 10 digits",
                    digits: "Only numbers are allowed"
                },

                propertyName: {
                    required: "Please enter Property Name",
                    minlength: "Property Name must be at least 2 characters",
                    notBlank: "Property Name cannot be blank"
                },

                propertyAddress: {
                    required: "Please enter Address",
                    minlength: "Address must be at least 5 characters",
                    notBlank: "Address cannot be blank"
                },

                bankCaseId: {
                    required: "Please enter Bank Case ID",
                    minlength: "Bank Case ID must be at least 2 characters",
                    notBlank: "Bank Case ID cannot be blank"
                },
                custContactNo: {
                    minlength: "Contact No must be 10 numbers",
                    //notBlank: "Contact No  cannot be blank"
                }
            },

            errorPlacement: function (error, element) {
                error.addClass("text-danger");

                if (element.hasClass("select2-hidden-accessible")) {
                    error.insertAfter(element.next(".select2"));
                } else {
                    error.insertAfter(element);
                }
            }
        });
    }

    function getFormData() {

        return {
            case_type: $("#caseTypeId").val() ? parseInt($("#caseTypeId").val()) : null,
            bank_id: $("#bank").val() ? parseInt($("#bank").val()) : null,
            bank_branch_id: $("#bankBranch").val() || null,
            bank_case_id: $("#bankCaseId").val(),
            visitor_id: $("#caseVisitor").val() ? parseInt($("#caseVisitor").val()) : null,
            customer_name: $("#custName").val() || "- ",
            customer_contact: $("#custContactNo").val() || "" ,
            bill_date: $("#caseDate").val(),
            property_name: $("#propertyName").val(),
            property_type: $("#propertyType").val() ? parseInt($("#propertyType").val()) : null,
            property_address: $("#propertyAddress").val(),
            property_notes: $("#propertyNotes").val(),
        };
    }
    function saveQuickCase() {

        if (!caseCreateValidator.form()) return;

        const data = getFormData();
        const formData = new FormData();

        formData.append("Case_type", data.case_type);
        formData.append("Bank_id", data.bank_id);
        formData.append("Property_type", data.property_type);
        formData.append("Property_name", data.property_name);
        formData.append("Property_address", data.property_address);

        appendIfExists(formData, "Property_notes", data.property_notes);
        appendIfExists(formData, "Customer_name", data.customer_name);
        appendIfExists(formData, "Customer_contact", data.customer_contact);
        appendIfExists(formData, "Visitor_id", data.visitor_id);
        appendIfExists(formData, "Bank_branch_id", data.bank_branch_id);

        formData.append("Bill_date", data.bill_date);
        formData.append("Bank_case_id", data.bank_case_id);
        formData.append("Doc_type", "1");

        tempFilesOnCreate.forEach(file => {
            formData.append("Files", file);
        });

        callBasePostFileAPI(
            `${CASE_API}/create-with-documents`,
            formData,
            caseCreateSuccess,
            commonError
        );
    }

    function appendIfExists(formData, key, value) {
        if (value !== null && value !== undefined && value !== "") {
            formData.append(key, value);
        }
    }

    function saveAndRedirect() {

        if (!caseCreateValidator.form()) return;

        const data = getFormData();

        callBasePostAPI(CASE_API, data,
            function (response) {
                successToastr(MessageProvider.format(MessageProvider.INSERT_SUCCESS, "Case"));
                window.location.href = "/case/edit/" + response.case_id;
            },
            commonError
        );
    }

    function caseCreateSuccess(response) {

        successToastr("Case + Property + Documents created successfully");

        tempFilesOnCreate = []; // clear

        $("#caseModal").modal("hide");

        if (typeof CaseModule !== 'undefined' && CaseModule.caseGet) {
            CaseModule.caseGet();
        }
    }

    function resetForm() {

        $("#caseModal input").val("");
        $("#caseModal textarea").val("");
        $("#caseModal select").val("").trigger("change");
        $("#bankDocInputOnCreate").val("");
        tempFilesOnCreate = [];

        if (caseCreateValidator) {
            caseCreateValidator.resetForm();
            $(".is-invalid").removeClass("is-invalid");
        }
    }

    return {
        caseCreateInit
    };

})();

$(document).ready(function () {
    CaseModalCreateModule.caseCreateInit();
});
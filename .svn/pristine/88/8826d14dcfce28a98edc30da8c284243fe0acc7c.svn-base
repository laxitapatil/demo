using Api.Provider;
using AutoMapper;
using Coravel;
using Core.Domain;
using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using Microsoft.IdentityModel.Tokens;
using Microsoft.OpenApi.Models;
using Swashbuckle.AspNetCore.SwaggerUI;
using System.Text;

var builder = WebApplication.CreateBuilder(args);

// Add services to the container.

builder.Services.AddControllers();
// Learn more about configuring Swagger/OpenAPI at https://aka.ms/aspnetcore/swashbuckle
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen();

#region AspNet Table

// DBContext : Add Connection to DB Context
builder.Services.AddEntityFrameworkNpgsql().AddDbContext<Infrastructure.Base.DBContext>(options =>
{
    options.UseNpgsql(builder.Configuration.GetConnectionString("DBConnectionString"));
});

builder.Services.Configure<IdentityOptions>(options =>
{
    options.Password.RequiredLength = 4;             
    options.Password.RequireNonAlphanumeric = false;
    options.Password.RequireDigit = true;   
    options.Password.RequireLowercase = true;       
    options.Password.RequireUppercase = false;    
});

// Identity Context : Add Connection to Identity Context from DBContext
builder.Services.AddIdentity<AspNetUsers, IdentityRole>(options => options.SignIn.RequireConfirmedAccount = true).AddDefaultTokenProviders()
    .AddEntityFrameworkStores<Infrastructure.Base.DBContext>().AddDefaultTokenProviders().AddDefaultUI();

#endregion AspNet Table

#region Swagger

// Swagger Token Authentication
builder.Services.AddSwaggerGen(swagger =>
{
    swagger.SwaggerDoc("v1", new OpenApiInfo { Title = "Mulyankan - " + builder.Environment.EnvironmentName, Version = "v1" });

    // Add this for Bearer JWT Authorization
    swagger.AddSecurityDefinition("Bearer", new OpenApiSecurityScheme()
    {
        Name = "Authorization",
        Type = SecuritySchemeType.Http,
        Scheme = "Bearer",
        In = ParameterLocation.Header,
        BearerFormat = "JWT",
    });

    // Add Authorization Icon in Swagger UI
    swagger.AddSecurityRequirement(new OpenApiSecurityRequirement {
        {
            new OpenApiSecurityScheme
            {
                Reference = new OpenApiReference
                {
                    Type = ReferenceType.SecurityScheme,
                    Id = "Bearer"
                }
            },
            Array.Empty<string>()
        }
    });

    // Add this for API Documentation of <summary>, <param>, <returns> Keys
    // To add this file Go to Project Property. In Build Tab => Check the XML Documentation file & Add File Name.
    swagger.IncludeXmlComments(Path.Combine(AppContext.BaseDirectory, "API.xml"));
});

#endregion Swagger

#region JWT

//For JWTSettings
builder.Services.Configure<Core.JwtSettings>(
    builder.Configuration.GetSection("JWT"));

// Authentication : Adding Authentication
builder.Services.AddAuthentication(options =>
{
    options.DefaultAuthenticateScheme = JwtBearerDefaults.AuthenticationScheme;
    options.DefaultChallengeScheme = JwtBearerDefaults.AuthenticationScheme;
    options.DefaultScheme = JwtBearerDefaults.AuthenticationScheme;
})

// JWT : Adding Jwt Bearer  
.AddJwtBearer(options =>
{
    //options.SaveToken = true;
    //options.RequireHttpsMetadata = false;
    var jwt = builder.Configuration.GetSection("JWT").Get<Core.JwtSettings>();

    options.TokenValidationParameters = new TokenValidationParameters
    {
        ValidateIssuer = true,
        ValidateAudience = true,
        ValidateLifetime = true,
        ValidateIssuerSigningKey = true,

        ValidIssuer = jwt.Issuer,
        ValidAudience = jwt.Audience,
        IssuerSigningKey =
            new SymmetricSecurityKey(
                Encoding.UTF8.GetBytes(jwt.Secret)),

        ClockSkew = TimeSpan.Zero
    };

    options.Events = new JwtBearerEvents
    {
        OnForbidden = async context =>
        {
            context.Response.StatusCode = StatusCodes.Status403Forbidden;
            await context.Response.WriteAsJsonAsync(new ProblemDetails
            {
                Status = StatusCodes.Status403Forbidden,
                Title = "Forbidden",
                Detail = MessageProvider.USER_UNAUTHORIZED
            });
        }
    };
});

#endregion JWT

#region Auto Mapper

// Auto Mapper : Add Mapper Class for Auto Mapper
builder.Services.AddSingleton(
    new MapperConfiguration(mapper =>
    {
        mapper.AddProfile(new Core.AutoMapperProfile());
    })
    .CreateMapper());

#endregion Auto Mapper

builder.Services.AddTransient<ViewRender>();
builder.Services.AddTransient<EmailProvider>();
builder.Services.AddScoped<Infrastructure.UserRepository>();
builder.Services.AddScoped<Infrastructure.TokenRepository>();
builder.Services.AddScoped<WhatsAppProvider>();
builder.Services.AddTransient<WhatsAppProvider>();
builder.Services.AddSingleton<IFileUpload, FileUpload>();

#region Register Scheduler / Cron Jobs

builder.Services.AddScheduler();
builder.Services.AddTransient<AppointmentCron>();

#endregion Register Scheduler / Cron Jobs

var app = builder.Build();

// Postgre sql date time configuration (Enable DateTime.Now property).
AppContext.SetSwitch("Npgsql.EnableLegacyTimestampBehavior", true);

// Cors Allowed : Same Server "Localhost" Prevent Cors Error
app.UseCors(policy => policy.AllowAnyHeader().AllowAnyMethod().AllowCredentials().SetIsOriginAllowed(_ => true));

// Use this out of IsDevelopment Condition for Swagger UI on Hosting
app.UseSwagger();
//app.UseSwaggerUI(c => c.SwaggerEndpoint("/swagger/v1/swagger.json", "API v1"));
app.UseSwaggerUI(options =>
{
    options.DocumentTitle = "Mulyankan - " + builder.Environment.EnvironmentName;
    options.DocExpansion(DocExpansion.None);
    options.DefaultModelRendering(ModelRendering.Model);
    options.EnablePersistAuthorization();
});

#region Start Scheduler / Cron Jobs
//currently stopped appointment scheduler as per client requriemtnent
//app.Services.UseScheduler(scheduler => scheduler.Schedule<AppointmentCron>().EveryFifteenMinutes()
//        .Zoned(TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata")));

#endregion Start Scheduler / Cron Jobs

app.UseHttpsRedirection();
app.UseStaticFiles();

app.UseAuthentication();
app.UseAuthorization();

app.MapControllers();

app.Run();

const CaseModule = (() => {

    // APIs
    const CASE_API = "case";

    // Elements
    const CASE_TABLE = "#tblCase";
    const CASE_FILTER_FORM = "#caseFilterForm";

    const $caseTable = $(CASE_TABLE);
    const $caseForm = $(CASE_FILTER_FORM);

    let isDashboardLoad = true;
    let dataTable = null;

    const DashboardStatusMap = {
        "new": 1,
        "site-visit": 2,
        "report-progress": 3,
        "under-review": 4,
        "completed": 5,
        "hold-cancelled": [6, 7]
    };

    const PriorityClassMap = {
        1: "priority-high",
        2: "priority-medium",
        3: "priority-low"
    };

    const InlineFieldLimits = {
        "tblCustomerName": 64,
        "tblCustomerContactNo": 32
    };

    function caseInit() {
        lov.setDefaultDateRange();
        caseBindEvents();
        casePopulateFilters();
        caseApplyDashboardFilter();
        caseGet();
        caseInitInlineEditor();
    }

    function getQueryParam(name) {
        const params = new URLSearchParams(window.location.search);
        return params.get(name);
    }

    function getSelectedId(selector) {
        const val = $(selector).val();
        if (!val || isNaN(val)) return null;
        return parseInt(val);
    }

    function getDashboardStatusValue(statusKey) {
        if (!statusKey || !DashboardStatusMap[statusKey]) return null;
        const mapped = DashboardStatusMap[statusKey];
        return Array.isArray(mapped) ? mapped[0] : mapped;
    }

    function caseClearDateRange() {
        $("#fromDate").val("");
        $("#toDate").val("");
        $("#dateRange").val("");
    }
    function caseApplyDashboardFilter() {
        const statusKey = getQueryParam("status");
        const statusValue = getDashboardStatusValue(statusKey);

        if (!statusValue) return;

        $("#caseFilterStatusId")
            .val(statusValue)
            .trigger("change.select2");

        caseClearDateRange();
    }

    function caseBindEvents() {
        $(".btn-light").click(function (e) {
            e.preventDefault();
            caseFilterReset();
        });

        $caseForm.on("submit", function (e) {
            e.preventDefault();
            caseGet();
        });

        $caseForm.on("reset", caseFilterReset);
    }

    function caseFilterReset(event) {
        if (event) event.preventDefault();

        $("#caseFilterBankId").val("").trigger('change');
        $("#caseFilterStatusId").val("").trigger('change');
        $("#caseFilterVisitorId").val("").trigger('change');
        $("#caseFilterReportMakerId").val("").trigger('change');
        $("#caseFilterSearch").val("");

        lov.setDefaultDateRange();
        caseGet();
    }

    function casePopulateFilters() {
        lov.populateDropdown("bank/name", "#caseFilterBankId", "Select All", null, null, false);
        lov.populateDropdown("case-status/name", "#caseFilterStatusId", "Select All", null, null, false);
        lov.populateUserDropdown("user?role=Visitor", "#caseFilterVisitorId", "Select All", null, null, false);
        lov.populateUserDropdown("user?role=Report Maker", "#caseFilterReportMakerId", "Select All", null, null, false);
    }

    function caseGet() {
        const statusKey = getQueryParam("status");

        let fromDate = $("#fromDate").val() || null;
        let toDate = $("#toDate").val() || null;
        let statusValue = getSelectedId("#caseFilterStatusId");

        if (statusKey && isDashboardLoad) {
            fromDate = null;
            toDate = null;
            statusValue = getDashboardStatusValue(statusKey);
        }
        
        const data = {
            from_date: fromDate,
            to_date: toDate,
            bank_id: getSelectedId("#caseFilterBankId"),
            status: statusValue,
            visitor_id: getSelectedId("#caseFilterVisitorId"),
            reporter_id: getSelectedId("#caseFilterReportMakerId"),
            search_text: $("#caseFilterSearch").val()?.trim() || null,
            id: null,
            case_id: null
        };

        callBasePostAPI(`${CASE_API}/get-by-filter`, data, function (response) {
            isDashboardLoad = false;
            caseFill(response);
        }, commonError);
    }

    function caseFill(data) {
        if (!Array.isArray(data)) {
            errorToastr("Case data not found.");
            return;
        }

        if (dataTable) {
            caseRefresh(data);
            return;
        }

        caseRenderTable(data);
    }

    function caseRefresh(data) {
        dataTable.clear().rows.add(data).draw();
    }

    function caseRenderTable(data) {
        dataTable = setDataTable($caseTable, {
            data: data,
            scrollY: '500px',
            scrollCollapse: false,
            columns: [
                {
                    data: "case_id",
                    orderable: false,
                    render: function (case_id, type, row) {
                        return `
                            <div class="d-flex align-items-center gap-2 justify-content-center">
                                <a href="/case/edit/${case_id}" class="link-info" title="Edit Case">
                                    <i class="fi fi-rr-pencil"></i>
                                </a>
                                <a href="javascript:void(0);"
                                   class="link-danger"
                                   onclick="CaseHistoryModule.caseHistory(${row.id})"
                                   title="Case History">
                                   <i class="fi fi-rr-time-past"></i>
                                </a>
                            </div>
                        `;
                    }
                },
                { data: 'id' },
                { data: "created_date", render: d => lov.formatDate(d) },
                {
                    data: "bank",
                    render: (_, __, row) => `
                        <div>
                            <p class="fw-medium mb-1">${row.bank || "-"}</p>
                            <p class="text-secondary m-0">ID: ${row.bank_case_id || "-"}</p>
                        </div>
                    `
                },
                { data: "case_type" },
                {
                    data: "customer_name",
                    render: (_, __, row) => `
                        <div>
                            <span class="d-block mb-1 editable" data-field="tblCustomerName" data-type="text">${row.customer_name}</span>
                            <i class="fi fi-rr-phone-call me-2"></i>
                            <span class="link-secondary" data-field="tblCustomerContactNo" data-type="tel">${row.customer_contact}</span>
                        </div>
                    `
                },
                { data: "property_summary" },
                {
                    data: null,
                    render: row => `
                        <div>
                            <span class="d-block editable mb-1" data-type="select"
                                data-field="tblVisitor"
                                data-source="user?role=Visitor"
                                data-value="${row.visitor_id}">
                                ${row.visitor_name || "-"}
                            </span>
                            <span class="d-block editable" data-type="select"
                                data-field="tblReportMaker"
                                data-source="user?role=Report Maker"
                                data-value="${row.report_maker_id}">
                                ${row.report_maker_name || "-"}
                            </span>
                        </div>
                    `
                },
                { data: "visit_date", render: d => lov.formatDate(d) },
                {
                    data: "case_status_id",
                    render: (_, __, row) => {
                        const badgeClass = lov.getCaseStatusBadgeClass(row.case_status);
                        return `<label class="badge ${badgeClass}">${row.case_status || "-"}</label>`;
                    }
                },
                { data: "submit_date", render: d => lov.formatDate(d) },
                { data: "bill_date", render: d => lov.formatMonthYear(d) },
                { data: "fees" },
                { data: "modified_date", render: d => lov.formatDate(d) }
            ],
            rowCallback: function (row, data) {
                caseApplyRowPriority(row, data);
            },
            initComplete: function () {
                applyColumnFilters(this.api(), {
                    noFilterColumns: [0, 1, 3, 7, 10, 14],
                    selectFilterColumns: [4]
                });
            }
        });
    }

    function caseApplyRowPriority(row, data) {
        $(row).removeClass("priority-high priority-medium priority-low");
        const cls = PriorityClassMap[data.priority_id];
        if (cls) $(row).addClass(cls);
    }

    function caseInitInlineEditor() {
        if (!$caseTable.length) return;

        $caseTable.inlineEditor({
            save: function (data) {
                const caseId = data.row.find(".case-link").data("case-id");
                const field = data.field;

                let value = data.newValue ? data.newValue.trim() : "";
                if (!value) value = "-";

                if (!caseValidateInlineField(field, value)) return false;

                callBasePutAPI(
                    "case/update-field",
                    {
                        case_id: caseId,
                        field: field,
                        value: value
                    },
                    caseFieldUpdated,
                    commonError
                );
            }
        });
    }

    function caseValidateInlineField(field, value) {
        const limit = InlineFieldLimits[field];
        if (!limit) return true;

        if (value.length > limit) {
            const label = field === "tblCustomerName" ? "Customer name" : "Customer contact";
            errorToastr(`${label} cannot exceed ${limit} characters.`);
            return false;
        }

        return true;
    }

    function caseFieldUpdated() {
        successToastr(MessageProvider.format(MessageProvider.UPDATE_SUCCESS, "Field"));
        caseGet();
    }

    return {
        caseInit
    };

})();

$(document).ready(CaseModule.caseInit);
<div id="userModal" class="modal fade" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="myModalTitle"></h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <form id="userForm" autocomplete="off" method="post">

                    <input type="hidden" id="userId" />

                    <div class="row gy-3">

                        <div class="col-md-4">
                            <label class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="fullName" name="fullName" maxlength="64" placeholder="John Doe"/>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Username / Contact No.</label>
                            <input type="tel" class="form-control" id="contactNo" name="contactNo" maxlength="10" placeholder="91XXXXXXXX"/>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" maxlength="64"/>
                        </div>

                        <div class="col-md-4" id="passwordGroup">
                            <label class="form-label">Password</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="password" name="password" minlength="6" />
                                <span class="input-group-text password-addon">
                                    <i class="fi fi-rr-eye"></i>
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">User Role</label>
                            <select class="form-control select2" id="role" name="role" multiple data-dropdown-parent="#userModal">
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label d-block">Status</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" name="isActive" checked />
                                <label class="form-check-label" for="isActive" id="isActiveText"> Active </label>
                            </div>
                        </div>

                        <!-- BUTTONS -->
                        <div class="col-12 mt-3">
                            <button type="submit" class="btn btn-primary"><i class="fi fi-rr-disk me-2"></i>Save</button>
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="fi fi-rr-cross-circle me-2"></i>Cancel</button>

                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>  
const FinalReportModule = (() => {

    const FINAL_REPORT_API = "case-property";
    let selectedDocFile = null;
    let selectedPdfFile = null;

    let existingDocPath = null;
    let existingPdfPath = null;
    let finalReportValidator = null;

    const MAX_FILE_SIZE_MB = 5;
    const MAX_FILE_NAME_LENGTH = 96;

    const roles = AuthModule.getRolesFromToken();

    const canManageFinalReport =
        roles.includes("Admin") ||
        roles.includes("ReportMaker");

    const canUpload =
        roles.includes("Admin") ||
        roles.includes("ReportMaker");

    function finalReportInit() {
        finalReportFormValidation();

        finalReportUploadBoxBind();
        finalReportSave();
        finalReportDragDropEnable();

        if (!canUpload) {
            $(".finalDocBox").hide();
            $(".finalPdfBox").hide();
            $("#btnSaveFinalReport").hide();
        }
    }
    function finalReportUploadBoxBind() {

        $(".finalDocBox, .finalPdfBox").off("click").on("click", function (e) {

            e.preventDefault();
            e.stopImmediatePropagation(); 

            if ($(e.target).closest("a, button").length) {
                return;
            }

            const input = this.classList.contains("finalDocBox")
                ? document.getElementById("finalDocInput")
                : document.getElementById("finalPdfInput");

            input.value = null;
            input.click();
        });

        $("#finalDocInput").off("change").on("change", function () {

            if (!this.files.length) return;

            const file = this.files[0];

            if (!finalReportFileSizeValidation(file)) {
                this.value = "";
                return;
            }

            if (!finalReportFileNameValidation(file)) {
                this.value = "";
                return;
            }

            if (!finalReportDocValidation(file)) {
                this.value = "";
                return;
            }

            selectedDocFile = file;

            finalReportPreviewRender("doc", selectedDocFile.name);
        });

        $("#finalPdfInput").off("change").on("change", function () {

            if (!this.files.length) return;

            const file = this.files[0];

            if (!finalReportFileSizeValidation(file)) {
                this.value = "";
                return;
            }

            if (!finalReportFileNameValidation(file)) {
                this.value = "";
                return;
            }

            if (!finalReportPdfValidation(file)) {
                this.value = "";
                return;
            }

            selectedPdfFile = file;

            finalReportPreviewRender("pdf", selectedPdfFile.name);
        });

        $(document).off("click", ".btnReplaceFinalFile").on("click", ".btnReplaceFinalFile", function (e) {

                e.preventDefault();
                e.stopPropagation();

                const type = $(this).data("type");

                if (type === "doc") {
                    $("#finalDocInput").trigger("click");
                }
                else {
                    $("#finalPdfInput").trigger("click");
                }
            });
    }
    function finalReportPreviewRender(type, fileName, filePath = null) {

        const isDoc = type === "doc";
        const container = isDoc ? $("#finalDocPreview") : $("#finalPdfPreview");

        if (isDoc) {
            $(".finalDocBox").hide();
        } else {
            $(".finalPdfBox").hide();
        }

        const icon = isDoc
            ? "/assets/images/icons/doc.png"
            : "/assets/images/icons/pdf.png";

        let fileUrl = "#";

        if (filePath) {
            fileUrl = generateCaseDocURL(filePath);
        } else {
            fileUrl = URL.createObjectURL(isDoc ? selectedDocFile : selectedPdfFile);
        }


        const html = `
            <div class="position-relative border rounded p-2 text-center">

                <a href="javascript:void(0);" onclick="window.open('${fileUrl}', '_blank'); event.stopPropagation();">
                    <img src="${icon}" class="img-fluid" style="max-height:120px;">
                </a>

                ${canManageFinalReport ? `

                    <div class="position-absolute top-0 end-0 m-1 d-flex gap-1">

                        <button class="btn btn-primary btn-sm btnReplaceFinalFile"
                            data-type="${type}">
                            <i class="fi fi-rr-pencil"></i>
                        </button>

                        <button class="btn btn-danger btn-sm btnDeleteFinalFile"
                            data-type="${type}">
                            <i class="fi fi-rr-trash"></i>
                        </button>

                    </div>

                ` : ""}

                <p class="small mt-2 mb-0 text-truncate">${fileName}</p>
            </div>
        `;

        container.html(html);
    }

    // Delete
    $(document).off("click", ".btnDeleteFinalFile").on("click", ".btnDeleteFinalFile", function (e) {

        e.preventDefault();
        e.stopPropagation();

        const type = $(this).data("type");

        const propertyId = CaseCreateModule.getSelectedPropertyId();

        if (!propertyId) {
            errorToastr("Property not found");
            return;
        }

        callBaseDeleteAPI(
            `${FINAL_REPORT_API}/final-report/${propertyId}/${type}`,
            () => finalReportFileDeleteSuccess(type),
            commonError
        );
    });

    function finalReportFileDeleteSuccess(type) {

        if (type === "doc") {

            selectedDocFile = null;
            existingDocPath = null;

            $("#finalDocPreview").empty();
            $(".finalDocBox").show();
        }
        else {

            selectedPdfFile = null;
            existingPdfPath = null;

            $("#finalPdfPreview").empty();
            $(".finalPdfBox").show();
        }

        successToastr("File deleted successfully");
    }

    function finalReportSave() {

        $("#btnSaveFinalReport").on("click", function () {

            const propertyId = CaseCreateModule.getSelectedPropertyId();

            if (!propertyId) {
                errorToastr("Select property first");
                return;
            }

            const amount = $("#finalAmount").val();
            const isFinal = $("#isFinalReport").is(":checked");

            if (!finalReportValidator.form()) {
                return;
            }

            if (!finalReportValidation(propertyId, amount, isFinal)) {
                return;
            }

            const formData = new FormData();

            formData.append("PropertyId", propertyId);

            if (selectedDocFile)
                formData.append("FinalDoc", selectedDocFile);

            if (selectedPdfFile)
                formData.append("FinalPdf", selectedPdfFile);

            if (amount)
                formData.append("ValuationAmount", amount);

            formData.append("IsFinal", isFinal);

            callBasePostFileAPI (`${FINAL_REPORT_API}/final-report`, formData, finalReportSaveSuccess, commonError);
        });
    }

    function finalReportValidation(propertyId, isFinal) {

        if (!finalReportPropertyValidation(propertyId))
            return false;

        if (!finalReportFilesValidation(isFinal))
            return false;

        //if (!finalReportAmountValidation(amount))
        //    return false;

        return true;
    }

    function finalReportPropertyValidation(propertyId) {

        if (!propertyId) {

            errorToastr("Select property first");

            return false;
        }

        return true;
    }

    function finalReportFilesValidation(isFinal) {

        const hasDoc = selectedDocFile || existingDocPath;
        const hasPdf = selectedPdfFile || existingPdfPath;

        if (isFinal && (!hasDoc || !hasPdf)) {

            errorToastr("DOC & PDF required to finalize");

            return false;
        }

        return true;
    }

    //function finalReportAmountValidation(amount) {

    //    if (!amount || Number(amount) <= 0) {

    //        errorToastr("Enter valid valuation amount");

    //        return false;
    //    }

    //    return true;
    //}

    function finalReportDocValidation(file) {

        if (!file)
            return true;

        const allowedDocExtensions = [
            ".doc",
            ".docx"
        ];

        const docExtension =
            "." + file.name.split(".").pop().toLowerCase();

        if (!allowedDocExtensions.includes(docExtension)) {

            errorToastr("Only DOC and DOCX files are allowed");

            return false;
        }

        return true;
    }

    function finalReportPdfValidation(file) {

        if (!file)
            return true;

        const pdfExtension =
            "." + file.name.split(".").pop().toLowerCase();

        if (pdfExtension !== ".pdf") {

            errorToastr("Only PDF files are allowed");

            return false;
        }

        return true;
    }

    function finalReportSaveSuccess() {
        successToastr("Final report saved");

        CaseCreateModule.loadCaseDetails(
            CaseCreateModule.getCaseUid()
        );
    }

    function finalReportDataBind(property) {

        if (!property) return;

        existingDocPath = property.report_doc_path || null;
        existingPdfPath = property.report_pdf_path || null;

        if (existingDocPath) {
            finalReportPreviewRender(
                "doc",
                existingDocPath.split("/").pop(),
                existingDocPath
            );
        } else {
            $("#finalDocPreview").empty();
            $(".finalDocBox").show();
        }

        if (existingPdfPath) {
            finalReportPreviewRender(
                "pdf",
                existingPdfPath.split("/").pop(),
                existingPdfPath
            );
        } else {
            $("#finalPdfPreview").empty();
            $(".finalPdfBox").show();
        }

        $("#finalAmount").val(property.valuation_amount || "");
        $("#isFinalReport").prop("checked", property.is_final);
    }

    function finalReportFileSizeValidation(file) {

        const maxBytes = MAX_FILE_SIZE_MB * 1024 * 1024;

        if (file.size > maxBytes) {
            errorToastr(`${file.name} exceeds ${MAX_FILE_SIZE_MB} MB limit`);
            return false;
        }

        return true;
    }

    function finalReportDragDropEnable() {

        finalReportDragDropSetup(".finalDocBox", "#finalDocInput", "doc");

        finalReportDragDropSetup(".finalPdfBox", "#finalPdfInput", "pdf" );
    }

    function finalReportDragDropSetup(containerSelector, inputSelector, type) {

        const container = document.querySelector(containerSelector);
        const input = document.querySelector(inputSelector);

        if (!container || !input) return;

        container.addEventListener("dragover", (e) => {

            e.preventDefault();
            e.stopPropagation();

            container.classList.add("drag-over");
        });

        container.addEventListener("dragleave", () => {

            container.classList.remove("drag-over");
        });

        container.addEventListener("drop", (e) => {

            e.preventDefault();
            e.stopPropagation();

            container.classList.remove("drag-over");

            const files = e.dataTransfer.files;

            if (!files.length) return;

            const file = files[0];

            if (!finalReportFileSizeValidation(file)) return;
            if (!finalReportFileNameValidation(file)) return;

            const dt = new DataTransfer();

            dt.items.add(file);

            input.files = dt.files;

            if (type === "doc") {

                selectedDocFile = file;

                finalReportPreviewRender("doc", file.name);
            }
            else {

                selectedPdfFile = file;

                finalReportPreviewRender("pdf", file.name);
            }

            successToastr("File added");
        });
    }

    function finalReportFileNameValidation(file) {

        if (file.name.length > MAX_FILE_NAME_LENGTH) {
            errorToastr(`${file.name} exceeds ${MAX_FILE_NAME_LENGTH} characters`);
            return false;
        }

        return true;
    }

    function finalReportFormValidation() {

        finalReportValidator = $("#finalReportForm").validate({

            ignore: ".finalDocInput, .finalPdfInput",
            errorElement: "span",

            errorPlacement: function (error, element) {

                error.addClass("text-danger");

                if (element.closest('.input-group').length) {
                    error.insertAfter(element.closest('.input-group'));
                }
                else {
                    error.insertAfter(element);
                }
            },

            rules: {

                finalAmount: {
                    required: true,
                    number: true,
                    min: 1
                }
            },

            messages: {

                finalAmount: {
                    required: "Please enter Valuation Amount",
                    number: "Valuation Amount must be a valid number",
                    min: "Valuation Amount must be greater than 0"
                }
            },

            highlight: function (element) {
                $(element).addClass("is-invalid");
            },

            unhighlight: function (element) {
                $(element).removeClass("is-invalid");
            }
        });
    }

    function finalReportViewDocument(fileUrl, fileName) {

        const ext = fileName.split(".").pop().toLowerCase();

        const previewTypes = [
            "jpg", "jpeg", "png", "gif", "webp", "bmp",
            "pdf",
            "mp4", "webm", "ogg",
            "mp3", "wav"
        ];

        if (previewTypes.includes(ext)) {

            window.open(fileUrl, "_blank");
        }
        else {

            const link = document.createElement("a");

            link.href = fileUrl;
            link.download = fileName;

            document.body.appendChild(link);

            link.click();

            document.body.removeChild(link);
        }
    }

    return {
        finalReportInit,
        finalReportDataBind,
        finalReportViewDocument
    };

})();
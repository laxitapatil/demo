
<div class="modal fade" id="bankModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form id="bankForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Add Bank</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row gy-3">
                        <div class="col-lg-12 ">
                            <label>Bank Name</label>
                            <input class="form-control" name="bankName" id="bankName" placeholder="Bank Name" />
                        </div>
                        <div class="col-lg-12">
                            <label>Report Template</label>
                            <div class="upload-box"
                                 data-name="bankPropertyDoc"
                                 data-accept=".pdf,.doc,.jpg">
                            </div>
                        </div>
                        <div class="col-lg-12 ">
                            <label>Report Template Name</label>
                            <input class="form-control" name="reportTemplateName" id="reportTemplateName" placeholder="Report Template Name" />
                        </div>
                        <div class="col-lg-12">
                            <div class="form-check form-switch" dir="ltr">
                                <input class="form-check-input" type="checkbox" id="bankStatus" checked="">
                                <label class="form-check-label" for="statusBankForm">Active</label>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <button id="btnSaveBank" class="btn btn-primary"><i class="fi fi-rr-disk me-2"></i>Save</button>
                            <button type="button" id="btnSaveAddNewBank" class="btn btn-light"><i class="fi fi-rr-disk me-2"></i>Save & Add New</button>
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="fi fi-rr-cross-circle me-2"></i>Cancel</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

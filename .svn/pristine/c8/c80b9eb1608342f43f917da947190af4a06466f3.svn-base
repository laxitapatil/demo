CREATE OR REPLACE FUNCTION public.case_document_selectall(
	_id integer,
	_property_id integer)
    RETURNS jsonb
    LANGUAGE 'plpgsql'
    COST 100
    VOLATILE PARALLEL UNSAFE
AS $BODY$
BEGIN
    RETURN (
        SELECT JSON_AGG(document_data)
        FROM (
            SELECT
                case_document.id,
                case_document.case_id,
                "case".case_id AS case_uid,
                case_document.property_id,
                case_property.name AS property_name,
                case_property.address AS property_address,
                case_document.doc_type_id,

                -- Enum Name Mapping
                CASE case_document.doc_type
                    WHEN 1 THEN 'BankDocument'
                    WHEN 2 THEN 'PropertyImage'
                    WHEN 3 THEN 'VisistSheet'
                    WHEN 4 THEN 'CaseDocument'
                END AS doc_type,

                case_document.title,
                case_document.file_path,
                case_document.created_by,
                case_document.created_date,
                case_document.modified_by,
                case_document.modified_date

            FROM public.case_document

            LEFT JOIN public."case" ON case_document.case_id = "case".id

            LEFT JOIN public.case_property ON case_document.property_id = case_property.id

            WHERE
                (_id IS NULL OR case_document.id = _id)
                AND (_property_id IS NULL OR case_document.property_id = _property_id)

            ORDER BY case_document.created_date DESC

        ) AS document_data
    );
END;
$BODY$;

ALTER FUNCTION public.case_document_selectall(_id integer, _property_id integer)
    OWNER TO postgres;

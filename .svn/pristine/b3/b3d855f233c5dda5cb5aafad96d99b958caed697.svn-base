using Core.Domain;
using Core.Enumeration;
using Core.Response;
using Dapper;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Npgsql;
using System.ComponentModel.DataAnnotations;
using System.Reflection;
using System.Text.Json.Nodes;

namespace Infrastructure
{
    public class CasePropertyRepository : BaseRepository
    {
        public CasePropertyRepository(DBContext dbContext) : base(dbContext) { }

        #region AUTOGENERATED 

        public async Task<int> Insert(CaseProperty caseProperty)
        {
            await dbContext.Set<CaseProperty>().AddAsync(caseProperty);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Update(CaseProperty caseProperty)
        {
            dbContext.Set<CaseProperty>().Update(caseProperty);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<int> Delete(CaseProperty caseProperty)
        {
            dbContext.Set<CaseProperty>().Remove(caseProperty);
            return await dbContext.SaveChangesAsync();
        }

        public async Task<CaseProperty?> SelectOne(int id)
        {
            return await dbContext.Set<CaseProperty>()
                .Where(x => x.Id == id)
                .FirstOrDefaultAsync();
        }

        public async Task<List<CaseProperty>> SelectByCaseId(int caseId)
        {
            return await dbContext.Set<CaseProperty>()
                .Where(x => x.Case_id == caseId)
                .OrderBy(x => x.Created_date)
                .ToListAsync();
        }

        public async Task<JsonNode?> SelectAll(int? id, int? caseId)
        {
            DynamicParameters parameter = new();
            parameter.Add("_id", id);
            parameter.Add("_case_id", caseId);

            string? response = await connection.QueryFirstAsync<string>(@"SELECT public.case_property_selectall(@_id, @_case_id)", parameter );

            return string.IsNullOrWhiteSpace(response) ? JsonNode.Parse("[]") : JsonNode.Parse(response);
        }

        #endregion

        #region Dropdown

        //public async Task<List<SelectListResponse>> SelectPropertyType()
        //{
        //    var typeValues = Enum.GetValues(typeof(PropertyType))
        //        .Cast<PropertyType>()
        //        .Select(status => new SelectListResponse
        //        {
        //            id = (short)status,
        //            name = status.ToString()
        //        })
        //        .ToList();

        //    return await Task.FromResult(typeValues);
        //}
        #endregion
    }
}
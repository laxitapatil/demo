using Core.Enumeration;
using System.ComponentModel.DataAnnotations;

namespace Core.Request
{
    public class CaseRequest
    {
        public int? Id { get; set; }

        public string? Case_id { get; set; }

        [Required(ErrorMessage = "Case type is required")]
        public int Case_type { get; set; }

        [Required(ErrorMessage = "Priority is required")]
        public CasePriority Priority { get; set; }

        [Required(ErrorMessage = "Case status is required")]
        public int Case_status_id { get; set; }

        [Required(ErrorMessage = "Bank is required")]
        public int Bank_id { get; set; }
        public int? Bank_branch_id { get; set; }

        public int? Bank_vertical_id { get; set; }

        [StringLength(64, ErrorMessage = "Bank case ID cannot exceed 64 characters")]
        public string? Bank_case_id { get; set; }

        public int? Visitor_id { get; set; }

        public int? Report_maker_id { get; set; }

        [Range(0, float.MaxValue, ErrorMessage = "Fees must be a positive value")]
        public float? Fees { get; set; }

        [StringLength(64, ErrorMessage = "Customer name cannot exceed 64 characters")]
        public string? Customer_name { get; set; }

        [StringLength(32, ErrorMessage = "Customer contact cannot exceed 32 characters")]
        public string? Customer_contact { get; set; }
        public DateTime? Bill_date { get; set; }

        [Required(ErrorMessage = "Property Address is required")]
        [StringLength(512, ErrorMessage = "Address cannot exceed 512 characters")]
        public string Property_address { get; set; }
        
        [Required(ErrorMessage = "Property Name is required")]
        [StringLength(64, ErrorMessage = "Name cannot exceed 64 characters")]
        public string Property_name { get; set; }
        public short? Property_type { get; set; }
    }
}
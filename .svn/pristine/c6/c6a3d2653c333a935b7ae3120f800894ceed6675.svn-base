using Core.Domain;
using Infrastructure.Base;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Internal;
using System.Data;

namespace Infrastructure
{
    public class SettingRepository : BaseRepository, IRepository<Setting>
    {
        private readonly DBContext _dbContext;

        public SettingRepository(DBContext dBContext) => _dbContext = dBContext;

        #region AutoGenerated

        public async Task<Setting> SelectOne(int id) =>
            await _dbContext.Settings.Where(setting => setting.Id == id).FirstOrDefaultAsync();

        public async Task Insert(Setting setting)
        {
            await _dbContext.Settings.AddAsync(setting);
            await _dbContext.SaveChangesAsync();
        }

        public async Task Update(Setting setting)
        {
            _dbContext.Settings.Update(setting);
            await _dbContext.SaveChangesAsync();
        }

        public async Task Delete(Setting setting)
        {
            _dbContext.Settings.Remove(setting);
            await _dbContext.SaveChangesAsync();
        }

        public async Task<IEnumerable<Setting>> SelectAll(string? key) =>
            await _dbContext.Settings.Where(setting => key == null || setting.Key == key).ToListAsync();

        #endregion AutoGenerated
    }
}
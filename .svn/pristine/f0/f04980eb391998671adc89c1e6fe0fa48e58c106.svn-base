const StateModule = (() => {

    const STATE_API = "state";
    const STATE_TABLE = "#tblState";

    const $stateTable = $(STATE_TABLE);
    let dataTable = null;

    function stateInit() {
        stateGet();
    }

    function stateGet() {
        callBaseGetAPI(STATE_API+"/get", stateFill, commonError);
    }

    function stateFill(data) {

        if (!Array.isArray(data)) {
            errorToastr("State data not found.");
            return;
        }

        if (dataTable) {
            dataTable.clear().rows.add(data).draw();
            return;
        }

        dataTable = setDataTable($stateTable, {
            data: data,
            scrollY: '600px',
            scrollCollapse: false,
            autoWidth: false,
            columnDefs: [
                { targets: 0, width: '80px', orderable: false, className: "dt-center" },
                { targets: 1, width: '60px', orderable: false },
                { targets: 3, width: '80px', orderable: false, className: "dt-center" }
            ],
            columns: [

                // ACTION
                {
                    data: "id",
                    render: id => `
                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <a href="javascript:void(0);"
                               class="link-info"
                               onclick="StateCreateModule.stateEdit(${id})"
                               title="Edit State">
                                <i class="fi fi-rr-pencil"></i>
                            </a>
                            <a href="javascript:void(0);"
                               class="link-danger"
                               onclick="StateModule.stateDelete(${id})"
                               title="Delete State">
                                <i class="fi fi-rr-trash"></i>
                            </a>
                        </div>
                    `
                },

                // SR NO
                {
                    data: null,
                    render: (_, __, ___, meta) =>
                        meta.row + meta.settings._iDisplayStart + 1
                },

                // NAME
                {
                    data: "name"
                },

                // STATUS
                {
                    data: "is_active",
                    render: function (isActive, type, row) {
                        return `
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       ${isActive ? "checked" : ""}
                                       onchange="StateModule.stateStatusUpdate(${row.id}, this)">
                            </div>
                        `;
                    }
                }
            ],
            initComplete: function () {
                applyColumnFilters(this.api(), {
                    noFilterColumns: [0, 1, 3]
                });
            }
        });
    }
    

    function stateEdit(id) {
        callBaseGetAPI(`${STATE_API}/${encodeURIComponent(id)}`,
            function (data) {
                StateCreateModule.stateDataGet(data);
                StateCreateModule.openStateModal(id);
            },
            commonError
        );
    }

    function stateDelete(id) {
        lov.genericDelete(id, STATE_API, "State", stateGet);
    }

    function stateStatusUpdate(id, checkBox) {
        lov.confirmStatusToggle(id, STATE_API, checkBox, stateGet);
    }

    return {
        stateInit,
        stateEdit,
        stateDelete,
        stateStatusUpdate
    };
})();

$(document).ready(function () {
    const roles = AuthModule.getRolesFromToken();
    if (!roles.includes("Admin")) {
        return;
    }
    StateModule.stateInit();
});
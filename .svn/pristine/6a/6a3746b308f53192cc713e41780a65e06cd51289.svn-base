@{
    ViewData["Title"] = "Users";
    ViewData["currpage"] = "mUsers";
    ViewData["pagename"] = "User Management";
}

<div>
    <!-- PAGE HEADER -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-sm-0 font-size-18">Users</h4>
                <div>
                    <!-- ✅ FIXED BUTTON -->
                    <button type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#userModal"
                            class="btn btn-primary">
                        <i class="fi fi-ss-plus-small"></i> Add User
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- USER TABLE -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div>
                        <table id="tblUser" class="table table-striped table-bordered w-100">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-center">Action</th>
                                    <th>#</th>
                                    <th class="text-center">Username</th>
                                    <th class="text-center">Role</th>
                                    <th class="text-center">Mobile</th>
                                    <th class="text-center">Email</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody></tbody> <!-- ✅ Important for DataTable -->
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================
    CHANGE PASSWORD MODAL
========================================= -->
<div id="changeUserPassModal"
     class="modal fade"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Change Password for <span id="modalUsername"></span>
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <form id="resetPasswordForm">

                    <!-- ✅ MATCHES JS -->
                    <input type="hidden" id="resetPassUserId" />

                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <div class="input-group">
                            <input type="password"
                                   class="form-control"
                                   id="resetPassword"
                                   placeholder="Enter new password"
                                   required />
                            <span class="input-group-text password-addon">
                                <i class="fi fi-rr-eye"></i>
                            </span>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">
                            Save
                        </button>
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

<!-- USER CREATE / EDIT MODAL -->
@Html.Partial("~/Views/User/_Create.cshtml")

@section Scripts {
    <script src="~/js/user/user.js?@ViewData["jsVersion"]"></script>
    <script src="~/js/user/user-create.js?@ViewData["jsVersion"]"></script>
}
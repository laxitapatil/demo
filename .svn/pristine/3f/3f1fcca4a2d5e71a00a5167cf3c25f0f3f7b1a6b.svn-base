using Core.Enumeration;
using System.ComponentModel.DataAnnotations;

namespace Core.Request
{
    public class CasePropertyRequest
    {
        public int? Id { get; set; }

        [Required(ErrorMessage = "Case is required")]
        public int Case_id { get; set; }

        [Required(ErrorMessage = "Property type is required")]
        public PropertyType Property_type { get; set; }

        [Required(ErrorMessage = "Name is required")]
        [StringLength(64, ErrorMessage = "Name cannot exceed 64 characters")]
        public string Name { get; set; }

        public float? Distance { get; set; }

        public float? Size_sqft { get; set; }

        [Required(ErrorMessage = "Address is required")]
        [StringLength(512, ErrorMessage = "Address cannot exceed 512 characters")]
        public string Address { get; set; }

        [StringLength(32, ErrorMessage = "City cannot exceed 32 characters")]
        public string? City { get; set; }

        //[Required(ErrorMessage = "State is required")]
        public int? State_id { get; set; }

        [StringLength(6, ErrorMessage = "Pincode must be 6 characters")]
        public string? Pincode { get; set; } 

        public float? Latitude { get; set; }

        public float? Longitude { get; set; }

        [StringLength(128, ErrorMessage = "Location cannot exceed 128 characters")]
        public string? Location { get; set; }

        public float? Valuation_amount { get; set; }

        //[Required(ErrorMessage = "Is final status is required")]
        public bool? Is_final { get; set; }

        [StringLength(64, ErrorMessage = "Report doc path cannot exceed 64 characters")]
        public string? Report_doc_path { get; set; }

        [StringLength(64, ErrorMessage = "Report pdf path cannot exceed 64 characters")]
        public string? Report_pdf_path { get; set; }

        public DateTime? Report_updated_date { get; set; }

        [StringLength(1024, ErrorMessage = "Note cannot exceed 1024 characters")]
        public string? Note { get; set; }
    }
} 
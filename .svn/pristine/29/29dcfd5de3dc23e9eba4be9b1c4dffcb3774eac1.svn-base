using Microsoft.AspNetCore.Mvc;

namespace Web.Controllers
{
    [Route("case")]
    public class CaseController : Controller
    {
        public IActionResult Index()
        {
            return View();
        }
        [HttpGet("create")]
        public IActionResult Create(string id)
        {
            ViewBag.CaseId = id;
            return View();
        }
        [HttpGet("edit/{id}")]
        public IActionResult Edit(string id)
        {
            return View("Create"); 
        }
    }
}

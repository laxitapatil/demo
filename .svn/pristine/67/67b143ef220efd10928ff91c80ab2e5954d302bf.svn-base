const BankModule = (() => {

    const BANK_API = "bank";
    const BANK_TABLE = "#tblBank";

    const $bankTable = $(BANK_TABLE);
    let dataTable = null;

    function bankInit() {
        bankGet();
    }

    function bankGet() {
        callBaseGetAPI(BANK_API, bankFill, commonError);
    }

    function bankFill(data) {

        if (!Array.isArray(data)) {
            errorToastr("Bank data not found.");
            return;
        }

        if (dataTable) {
            dataTable.clear().rows.add(data).draw();
            return;
        }

        dataTable = setDataTable($bankTable, {
            data: data,
            scrollY: '600px',
            scrollCollapse: false,
            autoWidth: false,
            columns: [
                // ACTION
                {
                    data: "id",
                    width: '80px',
                    render: id => `
                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <a href="javascript:void(0);"
                                class="link-info"
                               onclick="BankModule.bankEdit(${id})" title="Edit Bank">
                                <i class="fi fi-rr-pencil"></i>
                            </a>
                            <a href="javascript:void(0);"
                               class="link-danger"
                              onclick="BankModule.bankDelete(${id})" title="Delete Bank">
                                <i class="fi fi-rr-trash"></i>
                            </a>
                        </div>
                    `
                },
                // SR NO
                {
                    data: null,
                    width: '60px',
                    orderable: false,
                    className: "dt-left",
                    render: (_, __, ___, meta) =>
                        meta.row + meta.settings._iDisplayStart + 1
                },
                // BANK NAME
                {
                    data: "name"
                },
                //Manage Branch
                {
                    data: "id",
                    render: function (id) {
                        return `
                                <div class="text-center">
                                    <form action="/BankBranch/" method="post" style="display:inline;">
                                        <input type="hidden" name="bankId" value="${id}" />
                                        <button type="submit" class="btn btn-link p-0">
                                            Manage Branch
                                        </button>
                                    </form>
                                </div>
                                `;
                    }
                },
                // STATUS
                {
                    data: "is_active",
                    orderable: false,
                    width: '80px',
                    className: "dt-center",
                    render: function (isActive, type, row) {
                        return `
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                    type="checkbox"
                                    ${isActive ? "checked" : ""}
                                    onchange="BankModule.bankStatusUpdate(${row.id})">
                            </div>
                        `;
                    }
                }
            ],
            initComplete: function () {
                applyColumnFilters(this.api(), {
                    noFilterColumns: [0, 1, 3, 4]
                });
            }
        });
    }
    function bankEdit(id) {
        callBaseGetAPI(`${BANK_API}/${encodeURIComponent(id)}`,
            function (data) {
                BankCreateModule.bankDataGet(data);
                BankCreateModule.openBankModal(id);
            },
            commonError
        );
    }
    function bankDelete(id) {
        lov.genericDelete(id, BANK_API, "Bank", bankGet);
    }
    function bankStatusUpdate(id) {

        lov.genericStatusUpdate(id, BANK_API, bankGet);
    }

    return {
        bankInit,
        bankEdit,
        bankDelete,
        bankStatusUpdate
    };

})();

$(document).ready(BankModule.bankInit);
